}2\\pi \\delta(w+2\\pi k)","collabId":"ec32f536-a518-4f09-8eb6-3eba2e7e98c9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"839f51f3-f493-4fe9-af4d-d2b1b3652de5","children":[{"type":"formatted","text":"对 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"e^{jw_{0}n}","collabId":"72319f72-5911-426d-a7ac-f504db274efa","children":[{"type":"formatted","text":"e^{jw_{0}n}"}]},{"type":"formatted","text":" 进行变换"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"e^{jw_0n}\\xrightarrow{DTFT}\\sum_{n=-\\infty}^{\\infty}e^{-j(w-w_0)n}=\\sum_{k=-\\infty}^{\\infty}2\\pi \\delta(w-w_0+2\\pi k)","collabId":"c9c8003d-8693-4af2-8dbb-66b176c8ba79","children":[{"type":"formatted","text":""}]}]},{"type":"highlight-block","color":"orange","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"feaaacc0-c99a-469a-bebb-be5161de45cd","children":[{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\alpha^n\\mu[n](\\vert \\alpha \\vert < 1)\\xleftrightarrow{DTFT}\\frac{1}{1-\\alpha e^{-jw}}","collabId":"01ce6863-d8f7-4fbd-82d6-0fbf97cf6568","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f918526a-9234-4e10-8751-c7afbb266e65","children":[{"type":"formatted","text":"证明：该序列是绝对可和序列，所以可用 DTFT 的定义直接求和"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\sum_{n=-\\infty}^{\\infty}\\alpha^{n}\\mu[n]e^{-jwn}=\\sum_{n=0}^{\\infty}(\\alpha e^{-jw})^n=\\frac{1}{1-\\alpha e^{-jw}}","collabId":"baa1b581-d533-4baa-9d39-1df55533df3a","children":[{"type":"formatted","text":""}]}]}],"tags":[],"bannerBg":"https://blog