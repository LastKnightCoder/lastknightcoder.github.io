elf = originalObj;\n\nconst copyObj = structuredClone(originalObj);\ncopyObj.j.set('c', 3);\ncopyObj.k.add(4);\ncopyObj.l.a = 2;","collabId":"24b42360-8fa5-4308-a0da-b65c8e905583","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"a0546584-ab52-4de1-bc94-9759fb46ffb3","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b7e211b8-8c19-4cb3-958d-507b62eabeed"},{"children":[{"text":"","type":"formatted"}],"collabId":"beab46c0-60e5-4942-8eb5-d4beb849cec2","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_b86298bb-b4dc-4115-962e-f62c7d9a67d4.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_b86298bb-b4dc-4115-962e-f62c7d9a67d4.png","width":540},{"children":[{"text":"也可以使用 ","type":"formatted"},{"code":true,"text":"MessageChannel","type":"formatted"},{"text":" 对数据进行拷贝，使用 ","type":"formatted"},{"code":true,"text":"postMessage","type":"formatted"},{"text":" 传递数据时，也是深拷贝，其使用的算法和 ","type":"formatted"},{"code":true,"text":"structuredClone","type":"formatted"},{"text":" 相同，不同之处在于 ","type":"formatted"},{"code":true,"text":"MessageChannel","type":"formatted"},{"text":" 拷贝数据是异步的","type":"formatted"}],"collabId":"a12a35a6-05dc-40c7-98b3-006a06d16110","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const deepCopy = (obj) => {\n    const channel = new MessageChannel();\n    return new Promise((resolve) => {\n        channel.port2.onmessage = (e) => {\n            resolve(e.data);\n        }\n        channel.port1.postMessage(obj);\n    });\n}","collabId":"3855819b-8ea6-4cd1-b3be-c3918da13b1f","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1a88490b-6b4c-4305-a66e-56a8abbd35c3","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"e80787b3-7224-4ce8-a1b9-cedbcb5a6db5"},{"children":[{"text":"","type":"formatted"}],"collabId":"55a0cb61-f276-4f17-93d5-b1f09a951200","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8a39e453-6f72-474f-92d4-cf30b540a256.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8a39e453-6f72-474f-92d4-cf30b540a256.png","width":519.5},{"children":[{"text":"手动递归拷贝","type":"formatted"}],"collabId":"1d574633-6e14-4d59-9c0a-7abcc3769959","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"除了使用已有的 API，还可以手动递归对象来进行深拷贝。首先实现基本的递归拷贝","type":"formatted"}],"collabId":"2f1ccaa0-95ff-474e-854b-fd161d628f72","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const deepCopy = (value) => {\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    const newObj = Array.isArray(value) ? [] : {};\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key]);\n        }\n    }\n    return newObj;\n}","collabId":"d374f6c3-0809-4bd6-bb86-3873a805a2df","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"4d039459-7361-4e4c-8e10-093c52e639c4","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"9097949b-c01f-45e4-a084-a69f171f7bc6"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: {\n        a: 1,\n    },\n    i: [1, 2, 3]\n}\n\nconst copyObj = deepCopy(originalObj);\ncopyObj.h.a = 2;\ncopyObj.i.push(4);","collabId":"dfac054d-650e-4969-9165-f13dda17a2c0","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"586ff810-f038-4f29-b51c-fc7711a511be","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"d6e96be5-4506-4065-8a02-b6bc2147c87e"},{"children":[{"text":"","type":"formatted"}],"collabId":"9d55e378-b908-4a9c-b836-24bf3d0989ba","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_93c3e1b9-798b-426b-b999-374b1f0246c9.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_93c3e1b9-798b-426b-b999-374b1f0246c9.png","width":483},{"children":[{"text":"对于基本的对象和数组拷贝没有问题，但是如果存在循环引用，如果自己引用自己，两个对象之间互相引用等，那么就会陷入无限的递归，直至爆栈","type":"formatted"}],"collabId":"05a728d0-025d-43fd-b6a6-724a27cea891","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: {\n        a: 1,\n    },\n    i: [1, 2, 3]\n}\noriginalObj.self = originalObj;\n\nconst copyObj = deepCopy(originalObj);","collabId":"207ed9eb-8460-48e7-8b1a-817c21360e9a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"f053d620-b1af-43ef-947d-29ba3e0fd746","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"f972c182-924d-4923-9494-25884a57018c"},{"children":[{"text":"","type":"formatted"}],"collabId":"3578207d-9a2d-43ce-8342-e440e6c10349","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8302f60d-2c2c-48fa-80ce-71842a755a12.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8302f60d-2c2c-48fa-80ce-71842a755a12.png","width":445.5},{"children":[{"text":"为了解决这个问题，需要在递归的过程中维护已处理过的对象，当后续访问到相同对象时，直接返回该对象而不用递归处理","type":"formatted"}],"collabId":"ff9f52bb-d088-4575-b3ef-0ede2cba0ad5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const deepCopy = (value, weakMap = new WeakMap()) => {\n    if (weakMap.has(value)) return weakMap.get(value);\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    const newObj = Array.isArray(value) ? [] : {};\n    weakMap.set(value, newObj);\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key], weakMap);\n        }\n    }\n    return newObj;\n}","collabId":"efc10130-3c8c-4036-83b5-81e161bf9811","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"ad9a4cca-3085-4722-8b59-46d08ba61844","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"13db24f2-5b7c-4aa6-9abf-c31eee4784e5"},{"children":[{"text":"","type":"formatted"}],"collabId":"63c577cc-00d6-4ffa-b584-c94d44be5166","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_28812919-419f-4fe9-8fef-2522308ad701.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_28812919-419f-4fe9-8fef-2522308ad701.png","width":464.09089903200976},{"children":[{"text":"接下来需要对一些特殊的对象进行处理，如 ","type":"formatted"},{"code":true,"text":"Function","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"Date","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"Map","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"Set","type":"formatted"},{"text":" 等，对于不能进行深拷贝的对象当作普通对象处理，如 ","type":"formatted"},{"code":true,"text":"WeakMap","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"WeakSet","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":" 等","type":"formatted"}],"collabId":"05803eda-1b8d-4b9e-94b0-17197f083d8b","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const deepCopy = (value, weakMap = new WeakMap()) => {\n    if (weakMap.has(value)) return weakMap.get(value);\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    let newObj;\n    if (typeof value === 'function') {\n        newObj = new Function('return ' + value.toString())();\n    } else if (Array.isArray(value)) {\n        newObj = [];\n    } else if (value instanceof Date) {\n        newObj = new Date(value);\n    } else if (value instanceof RegExp) {\n        const { source, flags } = value;\n        newObj = new RegExp(source, flags);\n        // lastIndex 不可遍历\n        newObj.lastIndex = value.lastIndex;\n    } else if (value instanceof Map) {\n        newObj = new Map();\n        for (const [key, val] of value) {\n            newObj.set(deepCopy(key, weakMap), deepCopy(val, weakMap));\n        }\n    } else if (value instanceof Set) {\n        newObj = new Set();\n        for (const val of value) {\n            newObj.add(deepCopy(val, weakMap));\n        }\n    } else {\n        newObj = {};\n    }\n    weakMap.set(value, newObj);\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key], weakMap);\n        }\n    }\n    return newObj;\n}","collabId":"560c46c4-67df-4169-b71f-e54d08f53b1d","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"18c2118a-ff06-43e6-8735-7edc8df0f752","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"78fad060-439b-4b55-96cb-3512b1032e05"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: Symbol(\"symbol\"),\n    i: BigInt(123),\n    j: {\n        a: 1,\n    },\n    k: [1, 2, 3],\n    l: new Date(),\n    m: /\\d{2}/,\n    n: new Map([['a', 1], ['b', 2]]),\n    o: new Set([1, 2, 3]),\n    p: new WeakMap(),\n    q: new WeakSet(),\n    r: function () {\n        return 'Hello'\n    },\n    s: Promise.resolve(\"Hello\")\n}\noriginalObj.self = originalObj;\n\nconst copyObj = deepCopy(originalObj);\ncopyObj.j.a = 2;\ncopyObj.k.push(4);\ncopyObj.n.set('c', 3);\ncopyObj.o.add(4);\nconst value = copyObj.r();\nconsole.log(value); // Hello","collabId":"9f7ae555-2559-462e-817f-e4426c5d872c","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"bcc64b39-618e-45d5-a7ee-665bdbba1260","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"e1216959-bd22-4e12-adcc-eb02de7d8576"},{"children":[{"text":"","type":"formatted"}],"collabId":"f445384c-621e-4e45-bc41-556ab43e74fb","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9fd48582-11f2-4a10-b187-61a840be0445.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9fd48582-11f2-4a10-b187-61a840be0445.png","width":466.8181717001704},{"children":[{"text":"参考","type":"formatted"}],"collabId":"7c5c509c-86e3-4bc3-b43c-c996442ca89c","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"Window: structuredClone() method","type":"formatted"}],"collabId":"955e23a1-4b8a-44d5-a9bf-ff244d05c673","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Window/structuredClone"}],"collabId":"36fe3b74-7106-4772-82b8-2fcf310251e2","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"e81ddf55-4ec5-4fdb-9418-e56d0b4a02c3","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"The structured clone algorithm","type":"formatted"}],"collabId":"ffc08700-cddc-4d9f-9cb7-b2ce73f883d4","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Web_Workers_API/Structured_clone_algorithm"}],"collabId":"05955607-8f4a-4434-8fa6-808db19508a9","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"2e36c534-777a-4c02-aef6-04eaa177375c","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"JS 从零手写一个深拷贝（进阶篇）","type":"formatted"}],"collabId":"449cbe69-f16e-4331-b830-5b4ef5843ab0","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://www.cnblogs.com/echolun/p/16157161.html"}],"collabId":"9f7f4731-a980-43ff-8638-03b24645fb57","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"f3dc6d29-2ecf-48ce-b58a-a65641755062","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"844eb300-908a-4e55-a313-c17804078d7e","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"tags":[],"bannerBg":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/zach-wear-DY8Fb_RbJC0-unsplash_4ef9bd8e-4dd6-4b59-a2f3-62ebc75356ca.jpg","createTime":1733580079712,"updateTime":1793532531814},"meta":{"type":"article","publishTime":1793532531814}}