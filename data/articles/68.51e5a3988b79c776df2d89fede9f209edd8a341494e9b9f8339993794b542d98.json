: 1,\n    b: NaN,\n    c: Infinity,\n}\nconst copyObj = JSON.parse(JSON.stringify(originalObj));","collabId":"dfb928d5-c739-4bb2-ba24-5e23c1faedae","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"578d1de1-151f-4bc4-a2f4-9cdee285c5d5","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"56fd1b73-c4de-4cfc-9381-50d588f9227c"},{"children":[{"text":"","type":"formatted"}],"collabId":"47a8cfc3-596f-464b-92e5-d5a84fadc9ad","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8861ec48-2dc1-408a-9a0e-6e2be3a617bb.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8861ec48-2dc1-408a-9a0e-6e2be3a617bb.png","width":347.5}],"collabId":"106f6624-69dd-4d35-9c4a-6771a72e81b7","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"1c1edc8a-2079-4e22-976a-c40c41b5748f","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"structuredClone 和 postMessage","type":"formatted"}],"collabId":"0ae38386-fd47-4794-a5ce-147744b4d1db","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"浏览器提供了一个  ","type":"formatted"},{"code":true,"text":"structuredClone","type":"formatted"},{"text":"  API，它可以对数据进行深拷贝，它会递归的对输入对象进行拷贝，并且在递归的过程中会维护一个存储访问过的对象的表，防止无限递归和解决循环引用的问题。","type":"formatted"}],"collabId":"c7aff684-96b1-4d16-baf8-850cc69d7189","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"该 API 较新，可能存在","type":"formatted"},{"children":[{"text":"兼容性","type":"formatted"}],"collabId":"b1c326f7-942e-4b1c-ae98-81cd1