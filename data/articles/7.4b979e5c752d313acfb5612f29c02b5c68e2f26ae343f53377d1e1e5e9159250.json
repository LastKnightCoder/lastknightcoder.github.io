guage":"Shell","uuid":"d4a5808b-2c46-4ca0-b8fe-af58ccfb8b5e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f563aa41-f5a1-4e3e-bac1-e8723761361d","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"'sha1:43b95b731276:5d330ee6f6054613b3ab4cc59c5048ff7c70f549'","collabId":"63b2aa50-9dfd-406b-ba59-43a7027e0b4e","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dae5899b-9af3-4187-bd26-bdd533dbcfc5","children":[{"type":"formatted","text":"这个密文字符串在 jupyter 的配置文件中会用到，先保存/复制下来。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"365dbda1-d423-43fa-a3c4-37d6e2cdd631","children":[{"type":"formatted","text":"jupyter 配置文件"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4c97c1d9-0acf-4aa2-864f-666dc6a375cb","children":[{"type":"formatted","text":"接着我们便要配置 jupyter 的配置文件，在命令行运行"}]},{"type":"code-block","language":"Shell","uuid":"5707c257-f400-4a7f-925d-2ba83c89a1e8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9eae4c9d-c122-4be3-bafc-35dcac643f32","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"jupyter notebook --generate-config","collabId":"b7c8ba7d-029c-431d-a4aa-f1914bc6dc0b","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6a2810c3-4598-4a17-b3d3-0a53c967c8ec","children":[{"type":"formatted","text":"会生成 ~/.jupyter/jupyter_notebook_config.py 这个文件，我们打开编辑"}]},{"type":"code-block","language":"Shell","uuid":"d96c76ba-6783-4f0b-9c14-907ecf32ceff","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9a74897f-f1f7-4620-a6ca-9cf4d5aeca09","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"vi ~/.jupyter/jupyter_notebook_config.py","collabId":"96a05aa9-8717-438e-8841-22c1ccb85c9e","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1884c9b5-963c-49ea-a8fa-18b9db49be8f","children":[{"type":"formatted","text":"在其中添加如下配置"}]},{"type":"code-block","language":"Python","uuid":"72504f4f-7ad5-4927-b9ee-1434d730b302","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9639bd3e-e888-42b1-8e05-cb9540e1ccee","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"c.NotebookApp.ip='*' #设置远程访问 jupyter 的ip，*表示所有 ip 都可以访问\nc.NotebookApp.allow_remote_access = True # 允许远程访问\nc.NotebookApp.password = 'sha1:5df252f58b7f:bf65d53125bb36c085162b3780377f66d73972d1' #填写刚刚生成的密文  \nc.NotebookApp.open_browser = False # 禁止notebook启动时自动打开浏览器(在 linux 服务器一般都是 ssh 命令行访问，没有图形界面的。所以，启动也没啥用)  \nc.NotebookApp.port =8888 #指定访问的端口，默认是8888","collabId":"a36c9513-10f6-4481-8c51-9de584cc9e06","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"6de8794e-5a53-41cd-b6a9-159ae486b304","children":[{"type":"formatted","text":"启动 jupyter"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"00c6653e-24e2-432a-8c42-386c49402d61","children":[{"type":"formatted","text":"下面我们就可以在命令行输入如下命令启动 jupyter"}]},{"type":"code-block","language":"Shell","uuid":"77f24ad5-ce46-4544-a9ff-5e8ccabe19ba","tauContract":"44e7818805504c164294bff3