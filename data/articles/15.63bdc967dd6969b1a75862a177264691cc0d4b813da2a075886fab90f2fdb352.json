},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"1e559020-43d7-4f08-a7a3-b855a20c6a4e","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"3a7e40b4-e5fe-4baf-88e0-74c03129893d","children":[{"type":"formatted","text":"http://www.baidu.com"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"d3d634b8-1c57-4c95-927f-99b75999d6a1","children":[{"type":"formatted","text":"http://www.taobao.com"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"bb6db114-b2a1-4f92-bb76-2c249fb59191","children":[{"type":"formatted","text":"否"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"da438350-8224-41bf-a2e0-f66930d19eb5","children":[{"type":"formatted","text":"域名不同"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"ece12311-9f25-47e1-a010-324c615ea1f4","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"43ee3638-b9bf-4ccf-9d24-484ad692cb60","children":[{"type":"formatted","text":"http://127.0.0.1:8080"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"43afa840-9015-4d60-944a-7fc689a58de2","children":[{"type":"formatted","text":"http://localhost:8080"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"736cd5c7-f797-47a2-b7de-0269962f51ea","children":[{"type":"formatted","text":"否"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"12d4478a-d10c-404b-8f88-87c4c82861f6","children":[{"type":"formatted","text":"域名与域名对应的IP地址不同源"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"d06443c1-448e-457b-9208-b8247d5e9a66","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"c59e01f1-5e10-4980-adc0-7c299f2d52cb","children":[{"type":"formatted","text":"http://example.com:8000/a.js"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"b41ec72a-9567-4c48-83ad-40d20dafaf7d","children":[{"type":"formatted","text":"http://example.com:8000/b.js"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"3212727a-2a5a-493c-a62d-165553d98919","children":[{"type":"formatted","text":"是"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"2c509a5a-1d96-451a-8edc-3e00220c3523","children":[{"type":"formatted","text":"协议，域名，端口相同，子域名不同"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"546f5deb-f2bb-4516-8c6f-0d42a63e95e1","children":[{"type":"formatted","text":"我们首先启动一个 Node 程序作为服务端，启动在本地的 4000 端口，如下"}]},{"type":"code-block","language":"js","uuid":"dc92e1eb-de80-4ffc-aeb4-dcc4eae2ec2b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6d327fbf-09c8-4d44-b09f-1eca876ef695","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const http = require('http');\n\nconst server = http.createServer();\n\nserver.on('request', function(req, res) {\n    res.end('hello world');\n})\n\nserver.listen(4000, function() {\n    console.log('服务启动在4000端口...');\n})","collabId":"87b16c3f-fb79-4355-9f43-63753dca30e4","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ac3a2fda-7bd7-464f-a146-c50a82a0f106","children":[{"type":"formatted","text":"现在我们同时在本地的 5501 端口启动一个静态服务器显示网页，在网页中我们发起一个 ajax 请求，向本地的 4000 端口请求数据，即我们刚刚搭的 Node 程序"}]},{"type":"code-block","language":"js","uuid":"0d09104d-f0ad-4464-83e9-6108e875d009","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"63513a8e-6f57-4dd5-a6cf-dbccb1f911c2","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const xhr = new XMLHttpRequest();\nxhr.onreadystatechange = function () { \n    if (xhr.readyState == 4 && xhr.status == 200) {\n        console.log(xhr.responseText);\n    } \n }\n xhr.onerror = function() {\n     console.error('出错了')\n }\nxhr.open('get', 'http://127.0.0.1:4000');\nxhr.send(null);","collabId":"7c9e5206-60eb-457b-b285-b0946f964464","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cff303db-b7cc-4345-8d2f-0e9c9597f422","children":[{"type":"formatted","text":"这个时候我们打开控制台，发现给出这样的错误信息"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_21e4e682-0ce1-4a77-bf1d-d428d414935b.webp","uuid":"9fd5c57a-3338-451d-8074-645a3d1a1f3f","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_21e4e682-0ce1-4a77-bf1d-d428d414935b.webp","width":822.8571428571429,"naturalWidth":1354,"naturalHeight":75,"borderRadius":"none","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"f2b21ed6-70e0-4271-8893-b4cd89c326a4","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"042affc6-3547-4a8b-8e27-cd84449d1266","children":[{"type":"formatted","text":"因为网页的地址 http://127.0.0.1:5501 与服务器的地址 http://127.0.0.1:4000 它们的域名是不同的，所以它们是不同源的，所以这个请求是跨域的请求，而浏览器是不允许跨域请求的。那么浏览器为什么会提出同源策略，这是出于安全的考虑。同源策略包括两种："}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"2a6e7b8e-e4e0-44ff-ba07-cf8ffe2b5bdb","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"77ee6b76-8f97-4cf9-8ac1-562375559d76","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ff9d1547-9acd-41dd-8740-2bb1dbf4ba1f","children":[{"type":"formatted","text":"DOM 同源策略：禁止对不同源页面 DOM 进行操作，这里主要场景是 iframe 跨域的情况，不同域名的 iframe 是限制互相访问的"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"4737188c-b71e-430e-be2b-36fa7580b057","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6dd465a6-c6df-4ebf-97bf-4fa6491e605e","children":[{"type":"formatted","text":"XMLHttpRequest 同源策略：禁止使用 xhr 对象向不同源的服务器地址发起 HTTP 请求"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d2421d0b-b3f1-4898-ba72-e18070a32589","children":[{"type":"formatted","text":"在这里我们只关注 ajax 跨域，我们来看一下如果没有同源策略会有什么危害："}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"9b154739-8f9b-4371-bb33-1c49da0d6eec","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"5c61c428-272b-4100-9b20-6ce9b52e41a9","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"67683c81-2861-4219-950f-410c4737d224","children":[{"type":"formatted","text":"用户登录了自己的银行页面 http://mybank.com， http://mybank.com 向用户的 cookie 中添加用户标识"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"36bb8273-7301-488d-8107-6f76f3a5dfb7","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3bdd9eca-2a42-4b4b-a755-924a7a88cdaa","children":[{"type":"formatted","text":"用户浏览了恶意页面 http://evil.com， 执行了页面中的恶意 AJAX 请求代码"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"8a8a8638-91be-4f6b-92e2-9468a6313051","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a83c6c12-26a5-4832-addd-e6107f6f06b7","children":[{"type":"formatted","text":"http://evil.com 向 http://mybank.com 发起 AJAX HTTP 请求，请求会默认把 http://mybank.com 对应 cookie 也同时发送过去"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"8d6b08f7-317b-4c9a-a49f-eec30b872ac9","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8fcb5eea-df4f-463a-80ae-57281ba8793d","children":[{"type":"formatted","text":"银行页面从发送的 cookie 中提取用户标识，验证用户无误，response 中返回请求数据，此时数据就泄露了"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"132cc771-932e-4202-95ad-bfe9f2689630","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5c3c58a5-5099-4bac-a20a-868249d68f61","children":[{"type":"formatted","text":"而且由于 Ajax 在后台执行，用户无法感知这一过程"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9dcf2359-f7e6-4765-a566-78f750233fb1","children":[{"type":"formatted","text":"所以有了同源策略我们才能够安全的上网，但是很多时候我们还是有跨域的需求的，并且现在随着前后端分离的流行，前端与后端的不同源是很有可能，所以迫切需要解决这个问题，下面就介绍两种跨域的方法。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"c0d5d80a-ed23-4308-ba04-82e9de91052c","children":[{"type":"formatted","text":"JSONP"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"911d23c3-84c7-4eb9-b80f-5af6472e8358","children":[{"type":"formatted","text":"同源策略提升了 Web 前端的安全性，但牺牲了 Web 拓展上的灵活性。设想若把 html、js、css、flash、image 等文件全部布置在一台服务器上，小网站这样凑活还行，大中网站如果这样做服务器根本受不了的。所以，现代浏览器在安全性和可用性之间选择了一个平衡点。在遵循同源策略的基础上，选择性地为同源策略开放了后门， 例如 img script style 等标签，都允许垮域引用资源，严格说这都是不符合同源要求的。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2d563ea0-af0d-4b72-8981-d8503a0e34b6","children":[{"type":"formatted","text":"正是利用 script 等标签引用的资源没有同源策略的限制，我们可以通过 script 向服务器发送请求，而服务器返回一个回调，将数据作为参数返回，可能你现在不能明白是什么意思，看下面的代码，我们在页面中添加下面的内容"}]},{"type":"code-block","language":"HTML","uuid":"fc4662fd-0a93-47d4-a760-dec577be7708","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e3fa08a4-6e02-4e64-ad35-1251b67bb83f","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<script>\n    function getData(data) {\n        console.log(data);\n    }\n    // 创建一个 script 标签用以请求数据\n    let scriptElement = document.createElement('script');\n    // 设置请求的地址 并且设置了回调函数\n    scriptElement.src = 'http://127.0.0.1:4000?callback=getData';\n    // 这一步很重要，不设置的话浏览器会报错 Uncaught SyntaxError: Unexpected identifier\n    scriptElement.setAttribute('type', 'text/javascript');\n    // 将这个 script 标签添加到 body 中\n    document.getElementsByTagName('body')[0].appendChild(scriptElement);\n</script>","collabId":"786fbe14-4f32-40f3-bdd1-46753634ad00","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6c364e40-2485-40d2-ab31-661a632f7cbe","children":[{"type":"formatted","text":"Node 服务端的代码"}]},{"type":"code-block","language":"js","uuid":"0829c664-8f2f-4b2c-b4fa-e2784fa7d8bb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"5f004eb8-8828-4c0f-85b5-be54ea9a439e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const http = require('http');\nconst querystring = require('querystring');\n\nconst server = http.createServer();\n\nserver.on('request', function(req, res) {\n    let qs = querystring.parse(req.url.split('?')[1]); // 解析请求参数\n    \n    let data = \"Hello World\"; // 返回的数据\n    \n    // 一定要在 ${data} 两端加上双引号，否则浏览器得到的是 getData(Hello World)会报错\n    res.end(`${qs.callback}(\"${data}\")`); // 即getData(data)\n})\n\nserver.listen(4000, function() {\n    console.log('服务启动在4000端口...');\n})","collabId":"5360a77b-9b8f-4d06-9636-c5347f0bf503","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d594e8a3-e2ab-4028-bd3a-f3439fa2e8ef","children":[{"type":"formatted","text":"结果如下"}]},{"type":"code-block","language":"js","uuid":"bdfc7336-6598-43ee-8d4c-4b3a308a99be","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e69bdab3-4483-4b6f-b814-3f731db0ec08","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"Hello World","collabId":"1fead7dc-dc8d-427d-a08e-90faa159b349","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"01a1f974-264b-4a25-b292-5e0b499f649f","children":[{"type":"formatted","text":"我来理一下上面的步骤"}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"728d8024-5034-40da-bd1d-c29d9f8fc817","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"33c10ff3-860f-4102-937c-f30de0d0350b","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"94d79870-62c9-4411-ace2-d7da7f274e84","children":[{"type":"formatted","text":"首先创建了一个函数 "},{"type":"formatted","code":true,"text":"getData"},{"type":"formatted","text":"，该函数的作用是用来处理数据的，接收的那个参数就是数据"}]},{"type":"code-block","language":"js","uuid":"bfd62a5c-61f9-4306-9009-684321e4b97e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"db8f51cb-43dc-4a04-a175-42fed87522d6","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function getData(data) {\n    console.log(data);\n}","collabId":"9efd8b97-724e-41d9-85ad-6c5f476a3817","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"1627590d-6153-4a81-8611-e679dca55852","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cdfcc6bc-420a-49b8-8625-742084e3704a","children":[{"type":"formatted","text":"创建一个 "},{"type":"formatted","code":true,"text":"script"},{"type":"formatted","text":" 标签，并且设置了请求的地址，以及将处理数据函数的名称即 "},{"type":"formatted","code":true,"text":"getData"},{"type":"formatted","text":" 作为参数传入"}]},{"type":"code-block","language":"js","uuid":"9c4c4917-9548-4d63-9694-6d0f3870bb50","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"89e79bf7-c503-4ee0-96f1-9c37172f1d7c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"script.src = 'http://127.0.0.1:4000?callback=getData';","collabId":"9b604334-f63e-49fa-8dce-23295d0936b8","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"fc80a7cf-6bba-4e99-836e-1e8c06bdbb58","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"01828281-3700-476f-afa2-f3d3d8b8b31d","children":[{"type":"formatted","text":"服务器接到请求，将要返回的数据作为传入的回调函数的参数传入"}]},{"type":"code-block","language":"js","uuid":"cfaf9035-418e-478e-93b7-fb95384b8d92","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a8b69cae-caf6-4f1c-a3fd-cd27289a5f87","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"res.end(`${qs.callback}(\"${data}\")`); // 即getData(data)","collabId":"4a82081a-a2ab-4110-a942-bee00129e4e0","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"049db0d8-0a93-41c6-bf14-570225620d75","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9b437b1d-babc-46c9-92eb-4d127570da84","children":[{"type":"formatted","code":true,"text":"script"},{"type":"formatted","text":" 标签得到服务器返回的数据，即 "},{"type":"formatted","code":true,"text":"getData(\"Hello World\")"},{"type":"formatted","text":"，然后执行，这样数据 "},{"type":"formatted","code":true,"text":"Hello World"},{"type":"formatted","text":" 就作为参数传递给了 "},{"type":"formatted","code":true,"text":"getData()"}]}]}]},{"type":"callout","calloutType":"info","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"4c3b43bb-1e4a-4ac5-95d4-e8a860b2bb09","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"900491d7-3cb6-4535-8334-dc5fa787eb44","children":[{"type":"formatted","text":"优点："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"8a1cd15e-0239-44f6-a2c1-245a86e2a4e9","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"ece094bb-247f-4645-b998-22baa7a673a4","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6141519e-2dbc-4170-bd6c-5e2ca6ea51da","children":[{"type":"formatted","text":"使用简便，没有兼容性问题，是目前最流行的跨域方法"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5e3af42a-dd70-41eb-bb5b-cd6eb017e1b6","children":[{"type":"formatted","text":"缺点："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"23407e6f-e861-4f76-ae7d-2688bc56850c","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"0edc0686-30c5-4928-b80e-e17d8463b323","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9ad49b68-0aa5-4306-94a2-ceb013311b2e","children":[{"type":"formatted","text":"只支持 GET 请求，并且代码是从其他域得到的，不排除可能有恶意代码，所以使用该方法，服务端必须确保值得信任"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"248690ba-dd0b-4617-9fff-255578f5123e","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6a6160f9-34cd-43ab-a849-14de819c3ea0","children":[{"type":"formatted","text":"要确定 JSONP 请求失败并不容易"}]}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"17bbe31b-3661-4334-9418-07bbd9b65240","children":[{"type":"formatted","text":"CORS"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fcf2fdc6-a720-4211-80af-2d053d691c3d","children":[{"type":"formatted","text":"CORS(Cross-origin resource sharing，跨域资源共享) 是一个 W3C 标准，定义了在必须访问跨域资源时，浏览器与服务器应该如何沟通。CORS 背后的基本思想，就是使用自定义的 HTTP 头部让浏览器与服务器进行沟通，从而决定请求或响应是应该成功，还是应该失败。CORS 需要浏览器和服务器同时支持。目前，所有浏览器都支持该功能，IE 浏览器不能低于 IE10。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b743c077-3c6f-4a9e-b9d2-290368dbaf28","children":[{"type":"formatted","text":"对于开发者来说，我们只要正常的发出 ajax 请求即可，与之前没有任何区别，如"}]},{"type":"code-block","language":"js","uuid":"2b6bb200-bc76-40d4-99ab-841a06abe209","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"442ba375-432f-4d1f-a58d-8b091c3b294a","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const xhr = new XMLHttpRequest();\nxhr.onreadystatechange = function () { \n    if (xhr.readyState == 4 && xhr.status == 200) {\n        console.log(xhr.responseText);\n    } \n }\n xhr.onerror = function() {\n     console.error('出错了')\n }\nxhr.open('get', 'http://127.0.0.1:4000');\nxhr.send(null);","collabId":"3c5d4efc-bbc6-4a76-93ab-656f8ec3c189","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"89811464-1ebc-4635-befc-ecf0aac14469","children":[{"type":"formatted","text":"但是在服务端，我们要设置一下信赖的请求来源，如下"}]},{"type":"code-block","language":"js","uuid":"96e4841c-5a11-4132-a400-d03c4b170208","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9a53afe6-7b42-440a-abf8-c2da47726cf7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const http = require('http');\n\nconst server = http.createServer();\n\nserver.on('request', function(req, res) {\n    // 表示来自 http://127.0.0.1:5501 的请求可以拿到数据\n    res.setHeader('Access-Control-Allow-Origin', 'http://127.0.0.1:5501')\n    res.end('hello world');\n})\n\nserver.listen(4000, function() {\n    console.log('服务启动在4000端口...');\n})","collabId":"a1e10f73-0df6-423c-ba8f-26d3c26eb4f1","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0ed37dc4-01ac-4ee2-bd49-515c3c682f92","children":[{"type":"formatted","text":"除了可以设置请求来源，还可以设置允许的方法，允许的头部等等"}]},{"type":"table","tauContract":"6b49184b8918108ccf1636963138d105f679894dfe0d7b7abd75a6e6db67056b","collabId":"79165f80-2e93-43f2-91d8-a8f32a47d254","children":[{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"95f78bd8-58bf-4397-b612-460aea863156","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"56e7b509-29e7-404b-8662-8626f0375bfb","children":[{"type":"formatted","text":"响应头"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"a5f76cd0-0f1e-49a7-b9e7-175041ad7202","children":[{"type":"formatted","text":"作用"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"cd8a92f1-734c-49f6-9048-bf8826d6c744","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"43c9f151-7fa4-4ab3-81bc-6cae