:""}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a3dab4bc-3513-4590-bdd5-39a87b1287ad","children":[{"type":"formatted","text":"为了生成 sourcemap 文件，需要修改构建脚本的配置，脚本位于 "},{"type":"styled-text","color":"gray","tauContract":"d18485913856addbefa2ced1511da60261ef67fcb40faff6190f86232aa01390","collabId":"201595a1-672c-4053-9616-d0ffe5f668a7","children":[{"type":"formatted","text":"scripts/rollup/build.js"}]},{"type":"formatted","text":" 中，首先需要将 sourcemap 为 true"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_2aa358ad-a6ee-4514-8876-54681d4d1676.png","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_2aa358ad-a6ee-4514-8876-54681d4d1676.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"b9af77bf-4781-4b5e-abe9-299ed14ab6d3","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"45dfce20-e61a-4013-b20a-acc83df4f6f2","children":[{"type":"formatted","text":"这时如果直接运行构建脚本 "},{"type":"formatted","code":true,"text":"npm run build"},{"type":"formatted","text":"，会发现报错"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9b84ebcd-2927-4bd2-991d-bdd23461ae3c.png","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9b84ebcd-2927-4bd2-991d-bdd23461ae3c.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"380dfdd3-98b0-4ab0-ae2f-46c2e75d0354","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a721586d-6b7a-46f9-a768-43b9b21a107c","children":[{"type":"formatted","text":"上述问题是因为构建的过程中会进行多次转换，会生成多次 sourcema