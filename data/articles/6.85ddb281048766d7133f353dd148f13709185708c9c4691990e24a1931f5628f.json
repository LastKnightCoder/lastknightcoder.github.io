{"version":1,"key":"article:6","content":{"id":6,"title":"JavaScript 访问对象中的属性","author":"","content":[{"type":"paragraph","children":[{"type":"formatted","text":"本篇文章关于遍历对象属性的问题，包括 "},{"type":"formatted","text":"for ...in","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":"Object.keys()","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":"Reflect.ownKeys()","code":true},{"type":"formatted","text":"， "},{"type":"formatted","text":"Object.getOwnPropertyNames()","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":"Object.getOwnPropertySymbols()","code":true},{"type":"formatted","text":" 等方法及区别。"}],"disableDrag":false},{"type":"header","children":[{"type":"formatted","text":"Object.keys()"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"Object.keys(obj)","code":true},{"type":"formatted","text":" 方法返回对象 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上所有可枚举的属性，不包括其原型上的属性"}],"disableDrag":false},{"type":"code-block","code":"let parent = {\n    category: 'parent'\n}\n\n// 设置 person 为 child 的原型\nlet child = Object.create(parent)\n\nchild.name = 'Alice'\nchild[Symbol('age')] = 18\nObject.defineProperty(child, 'gender', {\n    enumerable: false,\n    value: 'female'\n})\n\nconsole.log(Object.keys(child)) // [ 'name' ]","language":"js","uuid":"2d50f360-a40d-46be-8067-2b3f3473d010","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"需要注意的是，"},{"type":"formatted","text":"Object.keys()","code":true},{"type":"formatted","text":" 无法得到键为 "},{"type":"formatted","text":"symbol","code":true},{"type":"formatted","text":" 类型的属性。"}],"disableDrag":false},{"type":"header","children":[{"type":"formatted","text":"Reflect.ownKeys()"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"Reflect","code":true},{"type":"formatted","text":" 是在 ES6 中提出的，我们可以通过 "},{"type":"formatted","text":"Reflect.ownKeys(obj)","code":true},{"type":"formatted","text":" 取得对象 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上所有的属性，包括不可枚举的属性以及 "},{"type":"formatted","text":"symbol","code":true},{"type":"formatted","text":" 类型的属性，但是它不能获得其原型上的属性。"}],"disableDrag":false},{"type":"code-block","code":"// [ 'name', 'gender', Symbol(age) ]\nconsole.log(Reflect.ownKeys(child)) ","language":"js","uuid":"8f75e14e-f031-4e72-ab5d-516115e4433e","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"for ... in"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"for ... in","code":true},{"type":"formatted","text":" 同样可以得到对象 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上所有可枚举的属性(不包括 "},{"type":"formatted","text":"symbol","code":true},{"type":"formatted","text":" 类型的属性)，除此之外，它还可以获得其原型上的属性"}],"disableDrag":false},{"type":"code-block","code":"const keys = []\nfor (key in child) {\n    keys.push(key)\n}\nconsole.log(keys) // [ 'name', 'category' ]","language":"js","uuid":"617f2e5c-a485-437f-9ab3-90b25acf3d5c","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如果希望只获得当前对象上的属性，可以通过 "},{"type":"formatted","text":"obj.hasOwnProperty(key)","code":true},{"type":"formatted","text":" 方法进行过滤，如果 "},{"type":"formatted","text":"key","code":true},{"type":"formatted","text":" 是 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上的属性，而不是其原型上的属性，则会返回 "},{"type":"formatted","text":"true","code":true},{"type":"formatted","text":"，否则返回 "},{"type":"formatted","text":"false","code":true}],"disableDrag":false},{"type":"code-block","code":"const keys = []\nfor (key in child) {\n    if (child.hasOwnProperty(key)) {\n        keys.push(key)\n    }\n}\nconsole.log(keys) // [ 'name' ]","language":"js","uuid":"bcbde946-3ffd-4bd6-a5a7-1c8fefd55a0b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"也可对 "},{"type":"formatted","text":"Object.keys()","code":true},{"type":"formatted","text":" 或 "},{"type":"formatted","text":"Reflect.ownKeys()","code":true},{"type":"formatted","text":" 进行遍历"}],"disableDrag":false},{"type":"code-block","code":"let keys = []\nfor (key of Object.keys(child)) {\n    keys.push(key)\n}\nconsole.log(keys) // [ 'name' ]\n\nkeys = []\nfor (key of Reflect.ownKeys(child)) {\n    keys.push(key)\n}\nconsole.log(keys) // [ 'name', 'gender', Symbol(age) ]","language":"js","uuid":"fe89a163-4972-4055-8c03-974176ecb06e","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"Object.getOwnPropertyNames()"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","text":"Object.getOwnPropertyNames(obj)","code":true},{"type":"formatted","text":" 可以获得对象 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上所有类型为 "},{"type":"formatted","text":"string","code":true},{"type":"formatted","text":" 的属性，包括不可枚举的，但不包括其原型上的属性值"}],"disableDrag":false},{"type":"code-block","code":"// [ 'name', 'gender' ]\nconsole.log(Object.getOwnPropertyNames(child)); ","language":"js","uuid":"f0161e7e-c215-4f4f-9dd0-fea987dde904","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"Object.getOwnPropertySymbols()"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","text":"Object.getOwnPropertySymbols(obj)","code":true},{"type":"formatted","text":" 可以获得对象 "},{"type":"formatted","text":"obj","code":true},{"type":"formatted","text":" 上所有类型为 "},{"type":"formatted","text":"symbol","code":true},{"type":"formatted","text":" 的属性，包括不可枚举的，但不包含其原型上的属性"}],"disableDrag":false},{"type":"code-block","code":"// [ Symbol(age) ]\nconsole.log(Object.getOwnPropertySymbols(child)) ","language":"js","uuid":"5ce7bd63-2d12-4681-b705-e374e769581f","children":[{"type":"formatted","text":""}]}],"tags":["for ... in","Object.keys","Reflect.ownKeys","Object.getOwnPropertyNames()","Object.getOwnPropertySymbols()"],"bannerBg":"https://github.com/LastKnightCoder/image-for-2023/raw/master/111_eec885a2-bc9f-4ffc-b896-b70e61cf686e.jpg","createTime":1619753135000,"updateTime":1781859502972},"meta":{"type":"article","publishTime":1781859502972}}