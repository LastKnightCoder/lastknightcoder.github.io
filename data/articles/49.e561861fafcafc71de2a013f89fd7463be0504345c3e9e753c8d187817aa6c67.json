7e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"055cfe5b-4a80-412d-a896-d74aaa1a3d3a","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"aaf836f8-a581-4943-af7f-7d707ba8a6f3","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a05ef88a-4b0b-4086-b63d-d74fc6dde8f9","children":[{"type":"formatted","code":true,"text":"Restricted"},{"type":"formatted","text":": 不允许任何脚本运行，仅允许交互式命令"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"60f0b020-daa7-4839-aefd-829d1f86fb6a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"68058397-30c9-438f-b21d-ff77ebd56ecc","children":[{"type":"formatted","code":true,"text":"AllSigned"},{"type":"formatted","text":": 只运行由受信任发布者签名的脚本"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"64db008e-3161-4f81-a18c-47a37b139dac","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2bf253c0-48fc-4ecd-8932-95f97178fbf9","children":[{"type":"formatted","code":true,"text":"RemoteSigned"},{"type":"formatted","text":": 可以运行本地脚本，但需要远程脚本有可信的签名"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"19f89ce8-876d-4999-95e6-609b87117b88","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"eeb06fdb-e9fa-4ef5-aae0-37989da03aef","children":[{"type":"formatted","code":true,"text":"Unrestricted"},{"type":"formatted","text":": 允许运行所有脚本，但会有安全警告"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"25ae70ab-d557-4978-9351-a5ce6fc175bf","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0c83171a-c3e3-4b07-ae7e-ee9fb0c727e7","children":[{"type":"formatted","code":true,"text":"Bypass"},{"type":"formatted","text":": 无任何限制，类似于禁用执行策略"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"37634e76-d1a3-4ddd-af12-b71c5920655a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"54d31b15-5475-4942-9470-42e48710d196","children":[{"type":"formatted","code":true,"text":"Undefined"},{"type":"formatted","text":": 删除当前作用域的执行策略设置，使其继承更高层次的策略"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f1a39cde-4347-44c7-a4b7-74b57e7f1825","children":[{"type":"formatted","text":"之所以会出现上面的提示，一般是因为当前的执行策略是 "},{"type":"formatted","code":true,"text":"Restricted"},{"type":"formatted","text":"，可以通过 "},{"type":"formatted","code":true,"text":"Get-ExecutionPolicy"},{"type":"formatted","text":" 命令查看当前的执行策略"}]},{"type":"code-block","language":"shell","uuid":"c5a34933-73d1-4621-ae3b-1a52e21cfb3f","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"4d68ddfa-c084-4445-8cb0-9360fc02e121","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"> Get-ExecutionPolicy\nRestricted","collabId":"dbfc6718-f962-41c4-af83-2752f523158a","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cbe48e03-1edd-43d7-bd33-ad9c8d014dc6","children":[{"type":"formatted","text":"可以通过 "},{"type":"formatted","code":true,"text":"Set-ExecutionPolicy"},{"type":"formatted","text":" 修改执行策略"}]},{"type":"code-block","language":"shell","uuid":"9f28c1b8-56d8-42f4-aabc-870cfd4950c6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9c62a0f2-c939-48a9-a05b-f6085bb39201","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"> Set-ExecutionPolicy RemoteSigned","collabId":"5b746d90-1192-47fa-b284-dbf0e80b8e53","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"10d7e3c2-8e6d-4486-8839-8371833a076e","children":[{"type":"formatted","text":"如果遇到【"},{"type":"formatted","bold":true,"text":"在此系统上禁止运行脚本"},{"type":"formatted","text":"】这个问题，通过 "},{"type":"formatted","code":true,"text":"Set-ExecutionPolicy"},{"type":"formatted","text":" 设置执行策略就行，一般设置为 "},{"type":"formatted","code":true,"text":"RemoteSigned"},{"type":"formatted","text":" 就可以。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9f165855-2bd7-42f6-b3b4-5b3794770807","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"99309f55-aab9-4e39-bf28-053a6edb2430","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"743871f9-bd71-47f6-b15e-899ee4660689","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"64de3f41-180d-4ce6-9cd2-7ccc794f6d3a","children":[{"type":"link","url":"https://www.jianshu.com/p/4eaad2163567","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"4a4398fe-8f97-40ac-96e9-6ede82d