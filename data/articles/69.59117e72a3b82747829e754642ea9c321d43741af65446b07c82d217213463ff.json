1a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const originalObj = {\n    a: 1,\n    b: \"Hello\",\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: new Date(),\n    i: /\\d{2}/,\n    j: new Map([['a', 1], ['b', 2]]),\n    k: new Set([1, 2, 3]),\n    l: {\n        a: 1,\n    }\n}\noriginalObj.self = originalObj;\n\nconst copyObj = structuredClone(originalObj);\ncopyObj.j.set('c', 3);\ncopyObj.k.add(4);\ncopyObj.l.a = 2;","collabId":"55094b81-9ebd-4752-8384-817600ee4943","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_b86298bb-b4dc-4115-962e-f62c7d9a67d4.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_b86298bb-b4dc-4115-962e-f62c7d9a67d4.png","width":336,"naturalWidth":1080,"naturalHeight":1026,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"6e8cdce9-99c1-4087-88f6-40e6a2caa7aa","children":[{"type":"formatted","text":""}]},{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ef42e38b-9bf9-4fdb-9f3b-698159e8913f","children":[{"type":"formatted","text":"也可以使用 "},{"type":"formatted","code":true,"text":"MessageChannel"},{"type":"formatted","text":" 对数据进行拷贝，使用 "},{"type":"formatted","code":true,"text":"postMessage"},{"type":"formatted","text":" 传递数据时，也是深拷贝，其使用的算法和 "},{"type":"formatted","code":true,"text":"structuredClone"},{"type":"formatted","text":" 相同，不同之处在于 "},{"type":"formatted","code":true,"text":"MessageChannel"},{"type":"formatted","text":" 拷贝数据是异步的"}]},{"language":"JavaScript","type":"code-block","uuid":"e80787b3-7224-4ce8-a1b9-cedbcb5a6db5","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"953a189b-2d85-4175-b9a2-1f106b04714d","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const deepCopy = (obj) => {\n    const channel = new MessageChannel();\n    return new Promise((resolve) => {\n        channel.port2.onmessage = (e) => {\n            resolve(e.data);\n        }\n        channel.port1.postMessage(obj);\n    });\n}","collabId":"5f91fd0f-4077-443c-b25c-546a5f3d6a53","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8a39e453-6f72-474f-92d4-cf30b540a256.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8a39e453-6f72-474f-92d4-cf30b540a256.png","width":336,"naturalWidth":1039,"naturalHeight":1042,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"25817526-1ea7-415c-8445-aa08b1d6854a","children":[{"type":"formatted","text":""}]},{"level":2,"type":"header","tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"122d3f1c-4562-4b87-b510-f5cd7115da47","children":[{"type":"formatted","text":"手动递归拷贝"}]},{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c0a2535d-a8b4-4544-b3ed-f23e9a87ca67","children":[{"type":"formatted","text":"除了使用已有的 API，还可以手动递归对象来进行深拷贝。首先实现基本的递归拷贝"}]},{"language":"JavaScript","type":"code-block","uuid":"9097949b-c01f-45e4-a084-a69f171f7bc6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"140500ad-2276-42de-8e0e-9252081d4df7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const deepCopy = (value) => {\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    const newObj = Array.isArray(value) ? [] : {};\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key]);\n        }\n    }\n    return newObj;\n}","collabId":"7b3d4659-2554-40af-ad18-f0478345af1e","children":[{"type":"formatted","text":""}]}]},{"language":"JavaScript","type":"code-block","uuid":"d6e96be5-4506-4065-8a02-b6bc2147c87e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"bd702fc0-33c0-49bc-b2d1-b746d7abab3b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: {\n        a: 1,\n    },\n    i: [1, 2, 3]\n}\n\nconst copyObj = deepCopy(originalObj);\ncopyObj.h.a = 2;\ncopyObj.i.push(4);","collabId":"15761745-7c81-4d00-98c5-bca392594e01","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_93c3e1b9-798b-426b-b999-374b1f0246c9.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_93c3e1b9-798b-426b-b999-374b1f0246c9.png","width":336,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"279733d6-dd6d-475d-bf96-82cdbf924351","children":[{"type":"formatted","text":""}]},{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5bf51b0c-fb58-4fdf-bed8-c59fc1aeae82","children":[{"type":"formatted","text":"对于基本的对象和数组拷贝没有问题，但是如果存在循环引用，如果自己引用自己，两个对象之间互相引用等，那么就会陷入无限的递归，直至爆栈"}]},{"language":"JavaScript","type":"code-block","uuid":"f972c182-924d-4923-9494-25884a57018c","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"bb0c1684-633e-4aa9-a9bc-e59d5555f04a","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: {\n        a: 1,\n    },\n    i: [1, 2, 3]\n}\noriginalObj.self = originalObj;\n\nconst copyObj = deepCopy(originalObj);","collabId":"167366a6-780d-4c3d-9c7c-e1545e08a89f","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8302f60d-2c2c-48fa-80ce-71842a755a12.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8302f60d-2c2c-48fa-80ce-71842a755a12.png","width":316.8,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"3674cdf9-353b-4e24-8c55-c46e4caf29a3","children":[{"type":"formatted","text":""}]},{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e81aed85-058e-4de0-b306-842bc216b228","children":[{"type":"formatted","text":"为了解决这个问题，需要在递归的过程中维护已处理过的对象，当后续访问到相同对象时，直接返回该对象而不用递归处理"}]},{"language":"JavaScript","type":"code-block","uuid":"13db24f2-5b7c-4aa6-9abf-c31eee4784e5","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b69a7883-cbde-45ff-80ad-a5ccb620a4e4","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const deepCopy = (value, weakMap = new WeakMap()) => {\n    if (weakMap.has(value)) return weakMap.get(value);\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    const newObj = Array.isArray(value) ? [] : {};\n    weakMap.set(value, newObj);\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key], weakMap);\n        }\n    }\n    return newObj;\n}","collabId":"f13131df-dfb2-45bb-9529-9b113be2270a","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_28812919-419f-4fe9-8fef-2522308ad701.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_28812919-419f-4fe9-8fef-2522308ad701.png","width":464.09089903200976,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"ee44d310-02c7-4117-a6ac-f04f8d1f4142","children":[{"type":"formatted","text":""}]},{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f3b84663-6311-41da-9e0e-b6338832e660","children":[{"type":"formatted","text":"接下来需要对一些特殊的对象进行处理，如 "},{"type":"formatted","code":true,"text":"Function"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"Date"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"Map"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 等，对于不能进行深拷贝的对象当作普通对象处理，如 "},{"type":"formatted","code":true,"text":"WeakMap"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"WeakSet"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 等"}]},{"language":"JavaScript","type":"code-block","uuid":"78fad060-439b-4b55-96cb-3512b1032e05","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"1d07cef8-f323-43f0-b4be-d680c4eacc21","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const deepCopy = (value, weakMap = new WeakMap()) => {\n    if (weakMap.has(value)) return weakMap.get(value);\n    if (typeof value !== 'object' || value === null) {\n        return value;\n    }\n    let newObj;\n    if (typeof value === 'function') {\n        newObj = new Function('return ' + value.toString())();\n    } else if (Array.isArray(value)) {\n        newObj = [];\n    } else if (value instanceof Date) {\n        newObj = new Date(value);\n    } else if (value instanceof RegExp) {\n        const { source, flags } = value;\n        newObj = new RegExp(source, flags);\n        // lastIndex 不可遍历\n        newObj.lastIndex = value.lastIndex;\n    } else if (value instanceof Map) {\n        newObj = new Map();\n        for (const [key, val] of value) {\n            newObj.set(deepCopy(key, weakMap), deepCopy(val, weakMap));\n        }\n    } else if (value instanceof Set) {\n        newObj = new Set();\n        for (const val of value) {\n            newObj.add(deepCopy(val, weakMap));\n        }\n    } else {\n        newObj = {};\n    }\n    weakMap.set(value, newObj);\n    for (const key in value) {\n        if (value.hasOwnProperty(key)) {\n            newObj[key] = deepCopy(value[key], weakMap);\n        }\n    }\n    return newObj;\n}","collabId":"f15ba46e-38be-4876-97c8-55a87b878051","children":[{"type":"formatted","text":""}]}]},{"language":"JavaScript","type":"code-block","uuid":"e1216959-bd22-4e12-adcc-eb02de7d8576","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e7d7225d-33ff-4aff-9c36-db9e298bc79a","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const originalObj = {\n    a: 1,\n    b: 'hello',\n    c: true,\n    d: undefined,\n    e: null,\n    f: NaN,\n    g: Infinity,\n    h: Symbol(\"symbol\"),\n    i: BigInt(123),\n    j: {\n        a: 1,\n    },\n    k: [1, 2, 3],\n    l: new Date(),\n    m: /\\d{2}/,\n    n: new Map([['a', 1], ['b', 2]]),\n    o: new Set([1, 2, 3]),\n    p: new WeakMap(),\n    q: new WeakSet(),\n    r: function () {\n        return 'Hello'\n    },\n    s: Promise.resolve(\"Hello\")\n}\noriginalObj.self = originalObj;\n\nconst copyObj = deepCopy(originalObj);\ncopyObj.j.a = 2;\ncopyObj.k.push(4);\ncopyObj.n.set('c', 3);\ncopyObj.o.add(4);\nconst value = copyObj.r();\nconsole.log(value); // Hello","collabId":"60fef5f6-bf53-44f3-a60f-e955eed24629","children":[{"type":"formatted","text":""}]}]},{"pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9fd48582-11f2-4a10-b187-61a840be0445.png","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9fd48582-11f2-4a10-b187-61a840be0445.png","width":336,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"1f3bed50-e08e-4be2-8be7-1a21669792f8","children":[{"type":"formatted","text":""}]},{"level":2,"type":"header","tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"d690c978-2bc0-4de5-ab2b-147bb37b9f3d","children":[{"type":"formatted","text":"参考"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"cfecb180-b4b8-499d-a0f0-96d1cba0a314","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f2340d09-4e80-46d4-9ad5-f5a2039b24bc","children":[{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"12fbbac7-12d8-4143-a65c-64a134c37803","children":[{"openEdit":false,"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Window/structuredClone","tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"2cb40623-0ade-4416-a19f-80927a8ae341","children":[{"type":"formatted","text":"Window: structuredClone() method"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"733bb3bb-9308-4177-b633-074c9912ee7b","children":[{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4e98c9ee-9cea-4edb-b17b-39d5dffa7078","children":[{"openEdit":false,"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Web_Workers_API/Structured_clone_algorithm","tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"716cbe72-e47a-4192-939d-efe12e84eea9","children":[{"type":"formatted","text":"The structured clone algorithm"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"02805ed4-16fa-4c21-8a30-767469c0b3fa","children":[{"disableDrag":false,"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"29f5bc6c-4982-4e39-b0e0-8fe7cb8e11a4","children":[{"openEdit":false,"type":"link","url":"https://www.cnblogs.com/echolun/p/16157161.html","tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"284c88fc-7e4a-4c29-b3fd-80359faa1550","children":[{"type":"formatted","text":"JS 从零手写一个深拷贝（进阶篇）"}]}]}]}]}],"tags":[],"bannerBg":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/evgeni-tcherkasski-m9FIXWpx6bI-unsplash_bbd66ad3-7e35-4edc-9f8c-f2ef3f26a895.jpg","createTime":1734053984486,"updateTime":1791084804433},"meta":{"type":"article","publishTime":1791084804433}}