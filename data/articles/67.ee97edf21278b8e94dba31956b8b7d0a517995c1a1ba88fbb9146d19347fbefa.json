4-e23efbe425e4","tauContract":"6b49184b8918108ccf1636963138d105f679894dfe0d7b7abd75a6e6db67056b","type":"table"},{"children":[{"text":"在 H5 中一般有两种方法通过 URL Schema 打开 APP","type":"formatted"}],"collabId":"83eb7320-573a-49e3-80bb-87940dbcf36d","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"通过 ","type":"formatted"},{"code":true,"text":"iframe","type":"formatted"},{"text":" 来访问 URL Schema","type":"formatted"}],"collabId":"58fcd546-7f75-43dc-8b98-4d69de0ebd11","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const CALL_APP_IFRAME_ID = 'call-app-iframe';\nlet callAppIframe = document.getElementById(CALL_APP_IFRAME_ID);\nif (!callAppIframe) {\n  callAppIframe = document.createElement('iframe');\n  callAppIframe.display = 'none';\n  callAppIframe.id = CALL_APP_IFRAME_ID;\n  document.body.append(callAppIframe);\n}\n\ncallAppIframe.src = schema;","collabId":"40b2ae8c-b61e-43d4-beb3-5c82b1302f5a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e77b8e11-cd70-4a53-8e40-b5dd5ee4ecd1","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"44f80109-a7a2-43b9-ab67-efa04e2aef30"},{"children":[{"code":true,"text":"iframe","type":"formatted"},{"text":" 是使用最多的了，因为在未安装 APP 的情况下，不会去跳转错误页面。但是在 iOS 9+ 的 Safari、QQ、UC 等浏览器中，均无法通过此种方式唤端，因此该种方式常用于在 Android 中唤端。","type":"formatted"}],"collabId":"58aff5b4-b7f1-4664-850b-6c82b5fd27d8","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"460e7687-985c-4046-9eb0-f14575c5e6f9","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"通过 ","type":"formatted"},{"code":true,"text":"location.href ","type":"formatted"},{"text":"直接访问 URL Schema，常见于 iOS","type":"formatted"}],"collabId":"23a8791f-fade-4084-be3c-b656f960c2a9","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const schema = 'amapuri://root';\nlocation.href = schema;","collabId":"a0ed5e9d-d8a6-4493-86dd-eccf72476718","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"64b44a4a-3ef2-478d-acf3-475fae9c9b78","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"1a622517-05ca-4265-b0c0-f35ef618736a"},{"children":[{"children":[{"text":"在 QQ 中需要通过 ","type":"formatted"},{"code":true,"text":"top.location.href","type":"formatted"},{"text":" 进行唤端。","type":"formatted"}],"collabId":"603fdb37-95a6-4220-bc17-2e243efd0045","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"a174bc20-8e5e-4e3e-b616-060deda9783e","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","type":"highlight-block"}],"collabId":"5d73b51c-04be-4d6a-ae4d-0c761fd1618d","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"881e4552-6f04-4b54-a447-137bb1544edb","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"},{"children":[{"text":"Universal Link","type":"formatted"}],"collabId":"131c2fff-8ff3-4b8d-8ea9-01f772b9ecf3","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"Universal Link 是在 WWDC 2015 上为 iOS9 引入的新功能，通过传统的 HTTP 链接即可打开 APP。如果用户未安装 APP，则会跳转到该链接所对应的页面。","type":"formatted"}],"collabId":"492d13d8-3f23-460f-83d1-7d08f9c6293c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"首先在构建应用程序时需要在 XCode 中指定支持哪些域名，接着需要在所有的域名服务器上准备一个名为 apple-app-site-association(AASA) 的 JSON 文件，这个文件放在服务器的根目录或者 .well-known 目录下，这个文件定义了当访问哪些路径时打开 APP，一个示例如下，各字段含义可参考","type":"formatted"},{"children":[{"text":"文档","type":"formatted"}],"collabId":"611028a0-d8d4-4e3e-9eda-f88827dcc481","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developer.apple.com/documentation/xcode/supporting-associated-domains"},{"text":"。","type":"formatted"}],"collabId":"c51c54fd-ddb9-4d96-bd70-ea651f9251ba","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"{\n  \"applinks\": {\n      \"details\": [\n           {\n             \"appIDs\": [ \"ABCDE12345.com.example.app\", \"ABCDE12345.com.example.app2\" ],\n             \"components\": [\n               {\n                  \"#\": \"no_universal_links\",\n                  \"exclude\": true,\n                  \"comment\": \"Matches any URL with a fragment that equals no_universal_links and instructs the system not to open it as a universal link.\"\n               },\n               {\n                  \"/\": \"/buy/*\",\n                  \"comment\": \"Matches any URL with a path that starts with /buy/.\"\n               },\n               {\n                  \"/\": \"/help/website/*\",\n                  \"exclude\": true,\n                  \"comment\": \"Matches any URL with a path that starts with /help/website/ and instructs the system not to open it as a universal link.\"\n               },\n               {\n                  \"/\": \"/help/*\",\n                  \"?\": { \"articleNumber\": \"????\" },\n                  \"comment\": \"Matches any URL with a path that starts with /help/ and that has a query item with name 'articleNumber' and a value of exactly four characters.\"\n               }\n             ]\n           }\n       ]\n   },\n   \"webcredentials\": {\n      \"apps\": [ \"ABCDE12345.com.example.app\" ]\n   },\n\n\n    \"appclips\": {\n        \"apps\": [\"ABCDE12345.com.example.MyApp.Clip\"]\n    }\n}","collabId":"955e4bb1-1047-4dcf-ac5a-be5b6d4f2cc8","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"fdb67f2f-644a-422f-96a9-95c5563ea378","language":"json","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"99e9be75-19dc-454a-96d9-ca56fc24254c"},{"children":[{"text":"当我们安装或更新应用程序时，都会从服务器中拉取此配置文件，并根据文件内容向系统进行注册，当我们访问 H5 链接时，如果命中了 Universal Link，就打开 APP，如果没命中则直接跳转 H5 页面。","type":"formatted"}],"collabId":"dd30d5a4-ebe6-4094-b0ca-cc7af174ade0","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"从 macOS 11 和 iOS 14 开始，应用程序不再将 AASA 文件请求直接发送到 Web 服务器，而是将这些请求发送到专用于关联域的 Apple CDN，Apple CDN 会定时从我们的服务器拉取文件","type":"formatted"}],"collabId":"ecb744ab-7703-4a86-9854-eca23396d2f7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"44a3a8be-25af-40b8-a5bf-b9cbf271c647","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","type":"highlight-block"},{"calloutType":"info","children":[{"children":[{"text":"即使页面打开是 404，只要网址格式符合规则，都可以命中并成功唤起，但是一般我们会准备一个 H5 页面，未命中跳转到这个页面时可以跳转到 App Store 引导用户下载 APP。","type":"formatted"}],"collabId":"ddc0a483-c70d-4544-b09b-dc30554c7e1c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"3df426f1-363c-4d11-8870-a020c33d751f","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","title":"","type":"callout"},{"children":[{"text":"注意：","type":"formatted"}],"collabId":"192b7f1d-afe6-4dae-84de-8c4d250e1b4b","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"同域名无法唤端","type":"formatted"}],"collabId":"2f1edfc1-7fe5-4deb-9985-404b4f8da35a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"bd9a9d01-e2c3-41e4-8f8f-c6f02d953f86","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"必须使用有效证书的 ","type":"formatted"},{"code":true,"text":"https://","type":"formatted"},{"text":" 托管 AASA 文件，且不得重定向","type":"formatted"}],"collabId":"698f8477-e0b9-4d5c-a5ee-d60d5272bcd2","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"10b3373d-0cca-4585-b3a6-e1a11dd42799","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"安装了软件但是无法通过 Universal Link 唤端，可能原因是软件安装时无法获取到 AASA 文件，当程序安装后大约每隔一周才会从 CND 重新校验 AASA 文件，此时需要重新安装或更新 APP 以重新拉取此文件，大部分情况下可以唤端成功","type":"formatted"}],"collabId":"dd8a2106-9ad3-4d70-8dfc-c6e0b663ec81","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"211b9d4f-74c0-417c-81df-94f7d218f685","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"b6073eb8-426f-4c82-898d-ab3b527f2e38","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"},{"children":[{"text":"微信开放标签","type":"formatted"}],"collabId":"75201d13-4f41-49c2-9b3f-988b329a7685","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"由于微信对 URL Schema 这种唤端方式进行了拦截，在微信中无法直接通过 URL Schema 进行唤端，iOS 虽然可以通过 Universal Link 唤端，但是 Android 只能引导用户到浏览器打开唤端，或者使用应用宝唤端（但这种方式需要用户下载应用宝），这无疑会影响回流量。","type":"formatted"}],"collabId":"8abc545d-014c-464a-a623-d30e8f5cd4cc","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"在这种情况下需要借助微信提供的","type":"formatted"},{"children":[{"text":"开放标签","type":"formatted"}],"collabId":"b1e6b085-dd35-4e73-9443-381c604d94db","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developers.weixin.qq.com/doc/offiaccount/OA_Web_Apps/Wechat_Open_Tag.html"},{"text":"进行唤端，此功能仅开放给已认证的服务号，服务号绑定","type":"formatted"},{"children":[{"text":"JS 接口安全域名","type":"formatted"}],"collabId":"6656c3a8-8c68-48d7-a8da-111f635058b6","color":"blue","tauContract":"d18485913856addbefa2ced1511da60261ef67fcb40faff6190f86232aa01390","type":"styled-text"},{"text":"下的网页可使用此标签跳转 App，关于安全域名设置操作可参考此","type":"formatted"},{"children":[{"text":"文档","type":"formatted"}],"collabId":"a6218174-fe48-4763-9882-17ebac8f3d74","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developers.weixin.qq.com/doc/oplatform/Mobile_App/WeChat_H5_Launch_APP.html"},{"text":"，除此之外，在 APP 中还需要接入微信提供的 SDK，接入可参考此","type":"formatted"},{"children":[{"text":"文档","type":"formatted"}],"collabId":"3ec1dfd7-b5e5-4b48-8960-a87c80f370b1","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developers.weixin.qq.com/doc/oplatform/Mobile_App/Access_Guide/Android.html"},{"text":"。","type":"formatted"}],"collabId":"86e0f413-ce75-406e-97ff-e6c740e31e82","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"当这些前置工作准备就绪后，下面介绍在 H5 页面使用微信的 SDK 进行唤端：","type":"formatted"}],"collabId":"8dcaaa92-f446-4c5e-9130-c55d4ae5bbb6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"在项目中引入微信 JS SDK：https://res.wx.qq.com/open/js/jweixin-1.6.0.js，可以通过 ","type":"formatted"},{"code":true,"text":"script","type":"formatted"},{"text":" 直接引入，当然可以判断当前浏览器环境，当仅在微信环境下才引入此脚本，当脚本加载成功后在 ","type":"formatted"},{"code":true,"text":"window","type":"formatted"},{"text":" 下会有一个 ","type":"formatted"},{"code":true,"text":"wx","type":"formatted"},{"text":" 对象，可以通过判断该对象是否存在来知道脚本是否加载成功","type":"formatted"}],"collabId":"5fd10908-dc7e-4e1f-812b-25ac3695bfdf","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const loadScript = async (url) => {\n  return new Promise((resolve, reject) => {\n    const script = document.createElement('script');\n    \n    \n    script.addEventListener('load', () => {\n      resolve();\n    });\n    script.addEventListener('error', () => {\n      reject();\n    });\n    \n    script.setAttribute('type', 'text/javascript');\n    script.setAttribute('src', url);\n    document.head.appendChild(script);\n  })\n}\nconst loadWechatSDK = async () => {\n  if (window.wx) {\n    return window.wx;\n  }\n  const wxJsSDK = \"https://res.wx.qq.com/open/js/jweixin-1.6.0.js\";\n  try {\n    await loadScript(wxJsSDK);\n  } finally {\n    return window.wx;\n  }\n}","collabId":"a3f049dc-86bc-495e-821a-b93f68233115","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"b7e1cd92-5782-4d92-ab46-6ab4182b98c2","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"614a5ac6-d78f-40d4-8207-1d36a21efd73"}],"collabId":"11cdda2a-b3e5-4d7e-a97b-0f5fbfc7183a","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"签名，签名算法可以参考此","type":"formatted"},{"children":[{"text":"文档","type":"formatted"}],"collabId":"3e479a74-5e0c-4530-9743-68985088795a","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developers.weixin.qq.com/doc/offiaccount/OA_Web_Apps/JS-SDK.html#62"},{"text":"，由于牵涉到一些密钥，签名操作一般放在服务端，因此需要服务提供一个接口获取签名信息，获取到签名信息后，调用 wx.config 进行配置","type":"formatted"}],"collabId":"f1050873-3f59-4c59-a02b-23ae977ac8f4","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const wx = await loadWechatSDK();\nif (!wx) return;\nwx.config({\n  appId: '',     // 必填，公众号的唯一标识\n  timestamp: xxx,   // 必填，生成签名的时间戳\n  nonceStr: '',  // 必填，生成签名的随机串\n  signature: '', // 必填，签名\n  jsApiList: [], // 必填，需要用到的 JS API，比如打开相册\n  openTagList: [\"wx-open-launch-app\"], // 选填，需要用到的开放标签\n});\n\nwx.ready(() => {\n  // config 验证成功\n});\nwx.error(() => {\n  // config 验证失败\n})","collabId":"3998b884-2747-449b-8212-8b6dbf0e60f1","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e2a04473-e368-47f0-a2a6-41adb9bccd9b","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"42faafcd-24eb-4241-ba7b-70a187cfc493"}],"collabId":"4a6d302d-be42-4acc-ae6a-0226a438719c","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"使用开放标签，因为无法通过 API 的方式唤端，需要用户实际点击才可以唤端，因此我们会将开放标签作为蒙层盖住被点击的对象，这样点击时就可以触发唤端","type":"formatted"}],"collabId":"825ca284-692c-4866-aca7-04977fac8df7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<wx-open-launch-app\n  appid=\"公众号的唯一标识\"\n  extinfo=\"携带的扩展信息\"\n  path=\"跳转的 schema\"\n>\n  <script type=\"text/wxtag-template\">\n    <style>\n      .wx-btn {\n\t\t\t\tposition: \"absolute\";\n        width: 100%;\n        height: 100%;\n        top: 0;\n        left: 0;\n        opacity: 0;\n      }\n    </style>\n  </script>\n  <div class=\"wx-btn\"></div>\n</wx-open-launch-app>","collabId":"414991df-cf29-4277-a8d1-e018c9b02d5d","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"a2891c90-34d3-402a-b515-a55065192072","language":"HTML","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"8a5b108c-9874-4a71-9507-6f2a840e8f11"}],"collabId":"a2afc209-af3c-4e6b-bbb7-36a0b2d665da","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"c8f31bfd-c57b-438e-9c6c-20480c75faa4","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"},{"children":[{"text":"因为必须要用户点击才能唤端，因此就会带来一个缺点，无法自动唤端。","type":"formatted"}],"collabId":"96f0c67a-8d45-4a23-9bc6-d39549120ba3","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"唤端成功和失败","type":"formatted"}],"collabId":"4b827ce5-2e7f-430e-886b-7f4ccd8e354f","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"对于使用微信开放标签，微信提供了事件可以知道唤端是否失败","type":"formatted"}],"collabId":"a933f111-0a05-46ea-b966-030361a1fd0a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<wx-open-launch-app\n  appid=\"公众号的唯一标识\"\n  extinfo=\"携带的扩展信息\"\n  path=\"跳转的 schema\"\n>\n  <script type=\"text/wxtag-template\">\n    <style>\n      .wx-btn {\n\t\t\t\tposition: \"absolute\";\n        width: 100%;\n        height: 100%;\n        top: 0;\n        left: 0;\n        opacity: 0;\n      }\n    </style>\n  </script>\n  <div class=\"wx-btn\"></div>\n</wx-open-launch-app>\n<script>\n  var btn = document.getElementById('launch-btn');\n  btn.addEventListener('launch', function (e) {\n    console.log('success');\n  });\n  btn.addEventListener('error', function (e) {\n    console.log('fail', e.detail);\n  });\n</script>","collabId":"c2d13375-b214-4000-93ee-c71f2ff55d16","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"f4b0e82a-44be-4b01-8c5f-11131e94a6aa","language":"HTML","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"28de5d4b-5cb2-462d-b041-1dacca5477e9"},{"children":[{"text":"对于非 SDK 唤端，没有事件透出，只能通过监听当前页面是否隐藏来判断是否唤端，唤端成功后，会打开 APP，当前 H5 页面就会隐藏，如果没有打开 APP，那么就会没有反应，停留在当前页面，通过监听几秒内 ","type":"formatted"},{"code":true,"text":"visibilitychange","type":"formatted"},{"text":" 事件是否有触发并且状态是否为 ","type":"formatted"},{"code":true,"text":"hidden","type":"formatted"},{"text":" 来判断是否唤端成功","type":"formatted"}],"collabId":"a53d586d-53ed-4961-ac14-fd61f578ce9c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const checkCallAppSuccess = (timeout = 3000) => {\n  return new Promise((resolve) => {\n    const onVisibilityChange = () => {\n      if (document.visibilityState === 'hidden') {\n        resolve(true);\n        document.removeEventListener('visibilitychange', onVisibilityChange);\n      }\n    }\n    setTimeout(() => {\n      resolve(false);\n      document.removeEventListener('visibilitychange', onVisibilityChange);\n    }, timeout);\n    \n    document.addEventListener('visibilitychange', onVisibilityChange);\n  });\n}","collabId":"1cd26ec9-1c06-463b-9fc7-a046b339b6af","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"5af6f884-aa62-42d7-962c-588b266ed834","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"088d2e79-c5c6-483e-84ff-680952a09899"},{"children":[{"text":"实践","type":"formatted"}],"collabId":"39afd1ad-7c17-4b4d-b119-99df108ad6ee","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"我们的目标是提供一个 ","type":"formatted"},{"code":true,"text":"callApp","type":"formatted"},{"text":" 的异步方法，接收一个 ","type":"formatted"},{"code":true,"text":"schema","type":"formatted"},{"text":" 参数，返回之是一个 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":"，如果唤端成功，值就是 ","type":"formatted"},{"code":true,"text":"true","type":"formatted"},{"text":"，否则就是 ","type":"formatted"},{"code":true,"text":"false","type":"formatted"},{"text":"，该方法不适用于微信开放标签，因为微信开放标签不提供 API 进行唤端。","type":"formatted"}],"collabId":"2a7a1182-60a2-4ab4-8e01-9e672473d9e4","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"为了不在代码中充斥着 ","type":"formatted"},{"code":true,"text":"if-else","type":"formatted"},{"text":"，我们使用一个配置来说明在各个平台和操作系统下的唤端方式：","type":"formatted"}],"collabId":"63d440ac-ac1d-4b3a-98d4-163f0e8203fc","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const config = {\n  Safari: {\n    // Android 没有 Safari 浏览器\n    Android: {\n      action: '',\n      fallback: ''\n    },\n    iOS: {\n      action: 'ul', // Universal Link 唤端\n      fallback: 'appstore' // 跳转应用商店\n    }\n  },\n  Taobao: {\n    Android: {\n      action: 'schema',\n      fallback: 'offcial', // 跳转官网\n    },\n    iOS: {\n      action: 'schema',\n      fallback: 'appstore',\n    }\n  },\n  // 微信空配置，因为微信开放标签无法通过 API 唤端\n  // 如果没有配置微信开放标签，可以在这里添加配置\n  // 比如 Android 打开应用宝，iOS 使用 Universal Link\n  Wechat: {\n    Android: {\n      action: '',\n      fallback: '',\n    },\n    iOS: {\n      action: '',\n      fallback: '',\n    }\n  },\n  // ...\n}","collabId":"dda1a56e-cc5a-4423-9138-963d61c83cf6","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1d3953ec-18a9-4756-a7c1-23462fa34d8f","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"ab366d0e-b5b1-4af9-9edf-4add44f72526"},{"children":[{"text":"准备好所有的唤端方式：","type":"formatted"}],"collabId":"181ba600-2cbf-4b77-b40f-5ab04ea965db","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const callBySchema = (schema) => {\n  if (isAndroid) {\n    callByIframe(schema);\n  } else {\n    callByLocation(schema);\n  }\n}\n\nconst callbyUniversalLink = (schema) => {\n  location.href = `${universalLink}?schema=${schema}`\n}\n\n// 其他唤端方式，跳转官方，App Store 等\n\nconst methodConfig = {\n  'schema': callBySchema,\n  'ul': callByUniversalLink\n}\nconst getCallMethod = (method) => {\n  return methodConfig[method];\n}\n","collabId":"c0579c26-20a3-4c35-927e-e93fd67f4760","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"b69ee722-0731-4abc-9d12-7ddb2024481c","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"f7ea0358-52e7-44c3-ade8-adc94779b049"},{"children":[{"text":"最后提供一个对外的 ","type":"formatted"},{"code":true,"text":"callApp ","type":"formatted"},{"text":"方法：","type":"formatted"}],"collabId":"49d1773f-b090-4ea4-8464-5a89f25331a3","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const callApp = async (schema) => {\n  // 获取操作系统，是 Android 还是 iOS\n  const system = getSystem();\n  const ruleWithSystem = config[system];\n  const action = ruleWithSystem.action;\n  const fallback = ruleWithSystem.fallback;\n  if (!action) {\n    return false;\n  }\n  const callMethod = getCallMethod(action);\n  callMetod?.(schema);\n  const isSuccess = await checkCallAppSuccess();\n  if (!isSuccess && fallback) {\n    const fallbackCallMethod = getCallMethod(action);\n    fallbackCallMethod?.(schema);\n  }\n  \n  return isSuccess;\n}","collabId":"75d83b8f-2372-40f0-8f13-4b5b24e51709","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"bea114f3-87fe-48bd-9214-35a79f439fba","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"23d7bf19-aba8-4017-98a7-6c54dfe06c92"},{"children":[{"text":"参考","type":"formatted"}],"collabId":"6eae5102-a901-449f-8d52-33f822d7d17e","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"H5 唤起 APP 指南","type":"formatted"}],"collabId":"9f02904f-1037-4f46-953c-42a7a3496ff5","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://www.zhangxinxu.com/php/myRecommBackup?id=h5-up-app"}],"collabId":"f93f97b3-1d52-47f6-9d16-79b6a52b63c7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"8af2fe0d-90f9-46d3-8107-6dc1301b791a","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"闲鱼唤端的背后","type":"formatted"}],"collabId":"ba9845e1-30f7-458c-87b3-bfaa95bc7730","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://juejin.cn/post/7028409312175194149"}],"collabId":"c100b1c5-958e-43f6-96cb-f0292523e887","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"2877d1d7-c5ef-4c30-b41a-c820acf2ac36","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"唤端技术方案","type":"formatted"}],"collabId":"640f0f88-5f49-4535-9902-2501c7331558","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://tsejx.github.io/cross-platform-guidebook/hybird/call-app/"}],"collabId":"da6d2f63-0e1d-448f-8900-c57f8a268aea","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"500e7799-02d2-46d6-97cf-74e242f18d38","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"Universal Link (通用链接) - 唤起App","type":"formatted"}],"collabId":"2cba7674-e458-4c87-bdb7-19722696a7b3","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://juejin.cn/post/6970990060577488909"}],"collabId":"23c51268-c4b4-4d49-b205-bdfa7ec8b621","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"1bea580c-61f4-4232-8d09-fed52dcfb329","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"Allowing apps and websites to link to your content","type":"formatted"}],"collabId":"09f272b1-5cd9-427e-bd7b-fb9b8acd0f17","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developer.apple.com/documentation/xcode/allowing-apps-and-websites-to-link-to-your-content/"}],"collabId":"af976421-4fa4-413a-98a5-b08f8844e823","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"bea475db-808e-4850-80af-7a089148a4c4","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"Supporting associated domains","type":"formatted"}],"collabId":"6fd6b7c2-8971-43a6-9fc4-6b08e136f351","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://developer.apple.com/documentation/xcode/supporting-associated-domains#Add-the-associated-domains-entitlement-to-your-app"}],"collabId":"269005ae-c7c1-4d11-bf90-dcc06169b12c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"5c24128e-6cf5-45d0-94fe-16a7e73f54b7","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"245a2f0c-bbcd-43b4-bf9b-149f9a6e3a60","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"tags":[],"bannerBg":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/georg-b-fMOkGhZH798-unsplash_4735b36c-3db6-477d-b35c-1491ddbe7c14.jpg","createTime":1733498065186,"updateTime":1793532531725},"meta":{"type":"article","publishTime":1793532531725}}