\ndelete window.a; // false，不可配置","collabId":"da324285-3986-451a-a904-5d2720670e06","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6ba1e406-2869-4f35-a38b-aa872c5669c0","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b5c341ff-3ac4-4deb-9245-f09da13b527c","children":[{"type":"formatted","text":"重复声明"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9c2eada0-1271-405e-82a5-e1bdbc0b65e8","children":[{"type":"formatted","text":"在同一个作用域中，"},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明的变量可重复声明，重新声明后值也不会丢失，除非重新进行了初始化"}]},{"type":"code-block","language":"js","uuid":"ec6992b5-da19-478d-a4f4-17d874d096b8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"46af39cb-af4d-46a2-bd14-b57db995bbf1","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"var a = 1;\nconsole.log(a); // 1\n\nvar a;\nconsole.log(a); // 1\n\na = 10;\nconsole.log(a); // 10","collabId":"99885402-ff32-43a1-91b1-3b45b4b960db","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2a1b1eac-90e4-4156-858f-59a58c0ccd3e","children":[{"type":"formatted","text":"如果 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"function"},{"type":"formatted","text":" 在同一作用域声明了同一变量，那么 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 初始化会覆盖 "},{"type":"formatted","code":true,"text":"function"},{"type":"formatted","text":" 的值，因为 "},{"type":"formatted","code":true,"text":"funct