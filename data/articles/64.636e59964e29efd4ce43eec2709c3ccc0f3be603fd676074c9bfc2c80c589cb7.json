t":"const"},{"type":"formatted","text":" 是 "},{"type":"formatted","code":true,"text":"ES6"},{"type":"formatted","text":" 新引入的变量声明方式，解决 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明变量的很多问题，基本上已经不使用 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 来声明变量了。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"7442db05-c419-464a-acf5-c081716b9b31","children":[{"type":"formatted","text":"var"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5087a8f8-d0e1-424b-b1fa-780286e86b89","children":[{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明变量有三个特点："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"c2e70d66-be49-4dc8-abb6-29cd8a1bbf60","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"077fbf05-6c86-49a4-bb12-3492cb9d1c0e","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"56188bd3-69ca-4a48-a248-342c80f3e70f","children":[{"type":"formatted","text":"声明提升"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5731ed0e-216d-4fbd-9d20-0ee921dab361","children":[{"type":"formatted","text":"正常情况下，变量需要先声明才能使用，如果在声明之前使用了还未定义的变量，那么会报错，但是在 JavaScript 中，对于使用 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明的变量，可以在声明之前访问，因为 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明的变量其作用域会提升到其所在作用域的顶部，不过只有声明会被提升，变量的初始化不会提升，因此在初始化之前访问的值是 "},{"type":"formatted","code":true,"text":"undefined"},{"type":"formatted","text":"，在初始化之后访问才能获取到值"}]},{"type":"code-block","language":"js","uuid":"4660a8ff-7a65-4138-addf-00444778c3b7","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8c83b20e-4f6d-4412-b3e2-96c9fef2f6e4","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"console.log(a); // undefined，在变量 a 定义之前访问，不会报错，访问到的是 undefined\nvar a = 10;\nconsole.log(a); // 10，在定义之后访问，可以访问到初始的值","collabId":"dad72856-5fbf-429b-aa6f-e3abc363fec6","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4dffdb5c-bf1f-4838-b0f8-b0155543e6d9","children":[{"type":"formatted","text":"上面的语句相当于"}]},{"type":"code-block","language":"js","uuid":"1ba87c3b-d98b-481f-a47f-f47325ac6b07","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a6979e7a-ab51-4317-bea3-fcd419cc14fe","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"var a; // 声明提升\nconsole.log(a); // undefined\na = 10;\nconsole.log(a); // 10","collabId":"99686fe8-153d-4f33-bed1-6d1643ff20e7","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"d5b051a4-f0ba-4c35-aeb1-293ba55a8a84","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"83a37023-5ec1-47d0-a206-11cce1bb71a1","children":[{"type":"formatted","text":"无块级作用域"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1ecb962a-677c-4b60-910c-e6a9951270e6","children":[{"type":"formatted","code":true,"text":"var"},{"type":"formatted","text":" 声明的变量的作用域是离其最近的"},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","text":"函数主体"},{"type":"formatted","text":"或"},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","text":"类静态初始化块"},{"type":"formatted","text":"，在除此之外的块作用域中，如 "},{"type":"formatted","code":true,"text":"if"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"for"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"while"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"try...catch"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"switch"},{"type":"formatted","text":" 等块级作用域中声明的变量可以在其外部访问到"}]},{"type":"code-block","language":"js","uuid":"eb260837-b298-4184-88a5-651918029f01","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c383ff53-9973-406a-8cdb-4b21b5ee71ac","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"var a = true;\n\nif (a) {\n    var b = 2;\n}\n\nconsole.log(b); // 2，如果 a 是 false，那么这里访问到的就是 undefined","collabId":"36ea2937-03a9-46be-b952-65d91485535a","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"js","uuid":"ab6ecad0-ad94-4eee-86e0-742ca186a327","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f24a5bdd-c3e2-4ad6-8a07-73eac6e4c8db","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function func () {\n  // 变量 a 的作用域在 func 内，因此在函数外无法访问到 a\n  var a = 1;\n}\n\nfunc();\n\nconsole.log(a); // ReferenceError: a is not defined","collabId":"bbfc12b5-6687-4eaa-b779-294c4ede2af1","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"267edb9a-3c5f-4222-a6ad-7254d20b86e1","children":[{"type":"formatted","text":"如果不是在函数或类静态初始化块中使用 "},{"type":"formatted","code":true,"text":"var"},{"type":"formatted","t