数组，默认是 "},{"type":"formatted","code":true,"text":"0"},{"type":"formatted","text":"，即元素一出现在视口中就执行"}]},{"type":"code-block","language":"JavaScript","uuid":"99dde441-9758-41bf-afdb-dbcaf520770f","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b05b8742-b7a4-426c-9aed-ae10be64717e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new IntersectionObserver(entries => {  \n  console.log(entries);  \n}, {  \n  threshold: [0.5, 1]  \n});","collabId":"11f0ad02-3c39-4fca-8d73-eb18ff0cb04a","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a0d33472-ea56-43eb-b2a4-c474de89b9d6","children":[{"type":"formatted","text":"上述代码表示当元素一半出现在视口中或者元素全部出现在视口中时，均会执行回调函数。"}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video controls src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-threshold.mp4\" style=\"max-width: 100%;\"></video>","collabId":"e4171a51-c4a3-41b3-b874-6b950ea294e8","children":[{"type":"formatted","text":""}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"2a3dd86c-33a1-43d9-9b93-1f2d3d6dd9d5","children":[{"type":"formatted","text":"root"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"82409b14-6b3c-4258-8063-2529a05a07d6","children":[{"type":"formatted","text":"我们不止可以监听元素在视口中出现与消失，在任意可滚动的元素中均可以监听，我们通过 "},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 来指定滚动的容器，"},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 的默认值为 "},{"type":"formatted","code":true,"text":"null"},{"type":"formatted","text":"，当值为 "},{"type":"formatted","code":true,"text":"null"},{"type":"formatted","text":"，使用 "},{"type":"formatted","code":true,"text":"document"},{"type":"formatted","text":" 作为滚动容器。"}]},{"type":"tabs","tauContract":"0256f72bf503014a7ea32d073aa02da06da7e88c98797870e4d49fa627404693","collabId":"2c5671ab-6748-4b27-85a8-2ec6a718b9fd","children":[{"type":"tab-pane","tabKey":"e69b876f-c9de-4a90-b541-66922e2ab63c","title":"HTML","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"e5c1af98-917c-4cc7-a2f8-75e6a26e98aa","children":[{"type":"code-block","language":"HTML","uuid":"88d3be1a-4b80-40ff-a3e5-664521a76381","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f11089cd-343b-4d69-8d74-39bb21186070","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"box-container\">\n  <div id=\"box\"></div>\n  <div id=\"box-after\"></div>\n</div>","collabId":"20fc3dec-e63d-439a-b3e7-625fffdc7355","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"acd2b46b-8598-460d-8982-78e997539cbc","title":"CSS","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"25f8e25c-5717-49bb-96e0-04e10655860a","children":[{"type":"code-block","language":"CSS","uuid":"e88a8c80-7a5a-426f-9202-9a96d745f228","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"4a7efdd2-6f1b-471c-9062-6b1280609140","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"body {\n    margin: 0;\n    padding: 0;\n}\n\n#box-container {\n    height: 300px;\n    overflow: auto;\n    width: 300px;\n    margin: 100px auto;\n}\n\n#box {\n    width: 100%;\n    height: 300px;\n    background: deepskyblue;\n    position: relative;\n    top: 300px;\n}\n\n#box-after {\n    position: relative;\n    height: 300px;\n    top: 300px;\n}","collabId":"21bcb6b0-a0a4-47e2-93fd-7727feb1a718","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"440abdab-2da2-44fb-baae-78b0fa84dcbc","title":"JavaScript","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"e446067c-22e9-40e3-bad0-5b43136b89f7","children":[{"type":"code-block","language":"JavaScript","uuid":"3582631a-f304-47a6-8a8e-33bfb87cb160","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"55af264f-9fcf-42d5-b62a-a81affc5cf35","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new IntersectionObserver(entries => {\n  console.log('entries: ', entries);\n}, {\n  threshold: [0.5, 1],\n  root: document.getElementById('box-container'),\n});\n\nobserver.observe(document.getElementById('box'));","collabId":"fa8ee7da-ebee-4bd7-aa95-72871f470f58","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video controls style=\"max-width: 100%;\" src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-root.mp4\"></video>","collabId":"6ee2cd48-5934-4239-a09d-b9914e7f7b8b","children":[{"type":"formatted","text":""}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"f2568820-cc99-404d-9ca7-2b03d082d939","children":[{"type":"formatted","text":"rootMargin"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a1b918c6-9ebb-4c88-875a-20eba161e6b8","children":[{"type":"formatted","code":true,"text":"rootMargin"},{"type":"formatted","text":" 可以增大或缩小视口的区域，与 "},{"type":"formatted","code":true,"text":"margin"},{"type":"formatted","text":" 属性的取值相似，不过这里的 "},{"type":"formatted","code":true,"text":"rootMargin"},{"type":"formatted","text":" 还可以为负值。"}]},{"type":"tabs","tauContract":"0256f72bf503014a7ea32d073aa02da06da7e88c98797870e4d49fa627404693","collabId":"4a41661a-ee77-4ce9-b541-119320d16a8d","children":[{"type":"tab-pane","tabKey":"b8c33b66-39b5-409d-96d2-fc2a7d074faf","title":"HTML","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"c900b579-b241-4309-be1b-e919fae52dc3","children":[{"type":"code-block","language":"HTML","uuid":"4953c071-da36-48eb-8e00-a0328241f2cb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b9fd4624-d576-44bf-a65b-a38162a420c4","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"box\"></div>","collabId":"8041332d-51cf-4a3d-9908-83066668c582","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"28cc658b-2907-4350-b54d-88490e834876","title":"CSS","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"b88c40fb-13d1-4768-8ffd-4ee703c67b82","children":[{"type":"code-block","language":"CSS","uuid":"5ab4d6f1-2237-4267-b084-48633ce030db","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"01262106-3016-4f98-944c-d8ea82708263","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#box {\n  width: 100%;\n  height: 500px;\n  background: deeppink;\n  position: relative;\n  top: calc(100vh + 100px);\n}","collabId":"96041ec0-6e25-49d3-9d49-1dc726f4abcc","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"8cbae387-2217-4c06-82b6-c8d22cf14961","title":"JavaScript","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"d492dee4-b673-4a09-ab3a-def8b16ced6d","children":[{"type":"code-block","language":"JavaScript","uuid":"59f54c9d-0336-4e8e-a46e-98066929b656","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cbf857c9-4d4d-4680-beb6-f632f12269cd","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new IntersectionObserver(entries => {\n  console.log(entries);\n}, {\n  threshold: [0.5, 1],\n  rootMargin: '-100px 0px -100px 0px'\n});","collabId":"5ba29482-a497-4d9c-860f-4822668aacc9","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2d805896-834e-4669-9a0b-4ff1b194e230","children":[{"type":"formatted","text":"上面设置了 "},{"type":"formatted","code":true,"text":"rootMargin"},{"type":"formatted","text":" 为 "},{"type":"formatted","code":true,"text":"-100px 0px 0px -100px"},{"type":"formatted","text":"，使得视口与元素交叉区域的计算不再是蓝色，而变为了黄色"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_540eb95f-5995-49f7-8593-28183036bc95.png","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_540eb95f-5995-49f7-8593-28183036bc95.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"4daa73b8-599a-4ba5-bf13-a9cd9fa1514a","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"349d5270-4602-4e65-ae7c-1833bc48ff51","children":[{"type":"formatted","text":"如果元素下面没有其他空间，那么元素不可能完全位于黄色区域中，"},{"type":"formatted","code":true,"text":"threshold"},{"type":"formatted","text":" 设置为 "},{"type":"formatted","code":true,"text":"1"},{"type":"formatted","text":" 没有意义。"}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video controls style=\"max-width: 100%;\" src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-r