ntersecting.mp4\"></video>","collabId":"44936367-0c71-41d5-a090-92af9a440e15","children":[{"type":"formatted","text":""}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"6ff997b6-a326-4b95-b0a7-2dd3a8f661c4","children":[{"type":"formatted","text":"time"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c0279e12-cd3d-4bd7-9d8b-4ec1c361f948","children":[{"type":"formatted","text":"可见性发生变化的时间，是一个高精度时间戳，单位为毫秒。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"d6437a1b-5379-45e0-b5ad-7cf24c2a2d46","children":[{"type":"formatted","text":"案例"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"4dc2113b-6e9c-4ed3-aa8a-24cdf9ff2d1e","children":[{"type":"formatted","text":"图片懒加载"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4d17c13f-14c1-483f-8464-023dadea025b","children":[{"type":"formatted","text":"如果一个页面中图片的数量太多，会影响页面的加载速度，对网站性能造成影响，我们可以当图片出现在视口中时才对图片进行加载，传统的方法需要监听 "},{"type":"formatted","code":true,"text":"scroll"},{"type":"formatted","text":" 事件，然后判断图片是否在视口中。但是 "},{"type":"formatted","code":true,"text":"scroll"},{"type":"formatted","text":" 触发的十分频繁，具有性能问题。现在可以通过 "},{"type":"formatted","code":true,"text":"IntersectionObserver"},{"type":"formatted","text":" 来实现，并且有较好的性能。"}]},{"type":"tabs","tauContract":"0256f72bf503014a7ea32d073aa02da06da7e88c98797870e4d49fa627404693","collabId":"c6444764-8d25-463c-a285-5af8393359ea","children":[{"type":"tab-pane","tabKey":"7aba3dbc-273c-44ac-b1e9-aa9676c185d0","title":"HTML","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"cc135807-3061-4480-b688-51aee71062a0","children":[{"type":"code-block","language":"HTML","uuid":"7eda9347-b2c8-4af5-a560-b02f98dc83a0","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8d41198c-d32d-4630-944c-626e696f96cf","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"before\"></div>\n<div id=\"image-list\">\n  <img class=\"lazy-image\" data-src=\"images/01.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/02.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/03.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/04.jpg\" />\n</div>","collabId":"10a5f6b4-1ea1-4fa4-a16e-fb199ca9555a","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"89e39b5e-bf86-4f09-85c5-304fd3f67b54","title":"CSS","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"601a000b-01cd-4375-aac0-f92f0019b946","children":[{"type":"code-block","language":"CSS","uuid":"c12016ff-bc3e-42bd-9fb5-846f8a11a89b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"73e46b19-2b68-4129-8db9-b33bfe889d32","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#before {\n  height: calc(100vh + 10px);\n}\n\n#image-list {\n  display: flex;\n  justify-content: space-between;\n  margin: 100px 50px;\n}\n\n#image-list .lazy-image {\n  width: 200px;\n  height: 200px;\n  object-fit: cover;\n}","collabId":"2670368b-91b6-4f70-8d92-fc2a55e472f6","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"dcd8bbaa-f487-4339-b5d1-7131e5715bb4","title":"JavaScript","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"01959820-76d0-4f18-9f42-f4afa286f2f5","children":[{"type":"code-block","language":"JavaScript","uuid":"f0456cf5-c882-4838-a56a-409d798fa8fe","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cfa6e0b0-1ac3-46e0-935a-29287a677d63","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#before {\n  height: calc(100vh + 10px);\n}\n\n#image-list {\n  display: flex;\n  justify-content: space-between;\n  margin: 100px 50px;\n}\n\n#image-list .lazy-image {\n  width: 200px;\n  height: 200px;\n  object-fit: cover;\n}","collabId":"2a6f5625-e22a-465f-b693-3743bc7f3551","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8b512640-90f7-4c54-bef9-a0898c5520a4","children":[{"type":"formatted","text":"我们将图片的链接设置在自定义属性 "},{"type":"formatted","code":true,"text":"data-src"},{"type":"formatted","text":" 上，而不是 "},{"type":"formatted","code":true,"text":"src"},{"type":"formatted","text":" 属性，然后我们监听这些图像，当图像出现在视口中时，我们获取图像的 "},{"type":"formatted","code":true,"text":"data-src"},{"type":"formatted","text":" 属性，并设置到 "},{"type":"formatted","code":true,"text":"src"},{"type":"formatted","text":" 属性上，并且取消监听对象。"}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video controls=\"\" src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-%E5%9B%BE%E7%89%87%E6%87%92%E5%8A%A0%E8%BD%BD.mp4\" style=\"max-width: 100%;\"></video>","collabId":"41b564dd-e0ce-479d-a4bd-e0941209caa5","children":[{"type":"formatted","text":""}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"23b5d079-7425-4f78-a9c2-38a852805842","children":[{"type":"formatted","text":"无限滚动"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"62818768-50de-4170-b5ae-03cd18be6e31","children":[{"type":"formatted","text":"假设有一个商品展示页，因为商品太多，我们不会一次性全部请求，而是当用户向下浏览查看商品时，当到达页面底部时，请求更多的商品进行展示。一般的做法是监听 "},{"type":"formatted","code":true,"text":"scroll"},{"type":"formatted","text":" 事件，查询滚动条离底部的距离，当小于一定阈值时，自动的请求数据加载。现在我们可以通过 "},{"type":"formatted","code":true,"text":"IntersectionObserver"},{"type":"formatted","text":" 获得更好的性能。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"93c568be-3a3a-402f-b218-a8a93116837b","children":[{"type":"formatted","text":"我们在商品的下面放置一个元素，当滑到底部时，该元素出现在视口中，此时加载更多的商品。"}]},{"type":"tabs","tauContract":"0256f72bf503014a7ea32d073aa02da06da7e88c98797870e4d49fa627404693","collabId":"09c743fd-0a25-457c-9f8a-602106ccf198","children":[{"type":"tab-pane","tabKey":"a91813db-8b32-40a6-92de-2388688e126a","title":"HTML","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"10d64625-15af-452e-b0e5-26c3e88c229b","children":[{"type":"code-block","language":"HTML","uuid":"7b1e5a91-3c26-4727-96cc-ae4dac9d6776","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"3ce03453-6c78-4a1b-adb4-29f93e08e75b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"goods\">\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n  <div class=\"good\"></div>\n</div>\n<div id=\"footer\"></div>","collabId":"006d147b-495e-48c3-ae98-2b733578bce5","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"8c8f3c4f-cb1b-4209-b87e-6fb8c51d956f","title":"CSS","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"81ad87e4-b0e4-4ae4-886b-99691730fe13","children":[{"type":"code-block","language":"CSS","uuid":"177483d0-9b85-4b93-925a-fad6e08339ab","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"47ddc26c-3594-4887-ae83-c59bb8732107","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#goods {\n  width: 320px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin: 20px auto;\n}\n\n.good {\n  height: 150px;\n  background: deeppink;\n}\n\n#footer {\n  background: transparent;\n  height: 10px;\n}","collabId":"3190fbdb-246a-4eac-8a94-bf795090746c","children":[{"type":"formatted","text":""}]}]}]},{"type":"tab-pane","tabKey":"742a1f5b-ce77-452d-a7c1-fbb161a9ed27","title":"JavaScript","tauContract":"fcfba932818e04e88c2c071bc4f973b1244251a453f417037be7051a453b8f66","collabId":"b82055af-d84e-4cc7-a559-7d7b616b2bbf","children":[{"type":"code-block","language":"JavaScript","uuid":"52c2e54e-1ac1-47a6-8846-05a4623f9646","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"48325e31-3284-4fb1-95ee-b5d99e633650","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new IntersectionObserver(entries => {\n  entries.forEach(entry => {\n    if (entry.isIntersecting) {\n      loadMore(10);\n    }\n  });\n}, {\n  // 扩展视口的底部区域，提前加载\n  rootMargin: '0px 0px 100px 0px'\n});\n\nconst loadMore = (n) => {\n  let appendedGoods = '';\n  for (let i = 0; i < n; i++) {\n    appendedGoods += '<div class=\"good\"></div>'\n  }\n  const goods = document.getElementById('goods');\n  goods.innerHTML = goods.innerHTML + appendedGoods;\n}\n\nconst footer = document.getElementById('footer');\nobserver.observe(footer);","collabId":"598dcd13-4c96-4476-b121-9d8d51a6a196","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video controls=\"\" src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-%E6%97%A0%E9%99%90%E5%8A%A0%E8%BD%BD.mp4\" style=\"max-width: 100%;\"></video>","collabId":"a8b3d2bd-e978-439c-b094-f14e473d4fea","children":[{"type":"formatted","text":""}]},{"type":"callout","calloutType":"info","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"eed6e590-7a44-435f-9b44-3c544603606d","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4fb48200-05e2-4516-abdf-6d20ef621682","children":[{"type":"formatted","code":true,"text":"IntersectionObserver"},{"type":"formatted","text":" API 是异步的，不随着目标元素的滚动同步触发。"}]}]}],"tags":[],"bannerBg":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/sheng-hu-SJ9Z6yuSIL0-unsplash_bd1ef8d7-e05d-4950-afd1-5560eb20a6ca.jpg","createTime":1664362560000,"updateTime":1775928133323},"meta":{"type":"article","publishTime":1775928133323},"pluginRenderers":[{"runtimeVersion":1,"manifest":{"id":"tau.html","name":"HTML","version":"0.1.11","categories":["editor","ai"],"keywords":["HTML","网页","嵌入"],"apiVersion":1,"format":"cjs","main":"main.js","styles":"main.css","skills":["authoring"],"integrity":{"main.js":"968d6dd4153a56e6a91e0990d98b68c75255776b56b323facc1bfd5037fe0602","main.css":"468f2feb73a33e5711b1583b609e4ab3818e83d5f19a38dcd9d027b77eb269d8","skills/authoring/SKILL.md":"5a476fc110584964ab053cb40f0399ec27125bc1d315b6d50b019fbd9b112aa0"},"formatVersion":3,"platform":"portable","profile":"web-v1","description":"在文档中编辑行内与块级 HTML，支持 Tailwind 样式、博客发布和静态导出。","targets":{"desktop":{"minAppVersion":"0.59.5"},"android":{"minAppVersion":"0.2.7"},"ios":{"minAppVersion":"0.2.7"}}},"entry":"../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/main.js","styles":"../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/style.css","nodeTypes":["html-block","html-inline"]}],"contentStyles":[{"href":"../styles/0467f22880859c05fbdf329c2106a9b3ceef1b03dbcca513429ea7b368302bcf.css","integrity":"0467f22880859c05fbdf329c2106a9b3ceef1b03dbcca513429ea7b368302bcf"}]}