317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f72abf30-a285-4092-9fc3-99a3752a3dfb","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1e5b04e4-2ff8-4fe8-bc6c-acd4728b17a3","children":[{"type":"formatted","code":true,"text":"isIntersecting"},{"type":"formatted","text":"：是出现还是消失"}]}]}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"7d6b3041-dc34-4bc2-aaaf-c52abf025bbd","children":[{"type":"formatted","text":"intersectionRatio"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"77e8c5ba-0f05-4632-b15e-db1e0c34c68e","children":[{"type":"formatted","code":true,"text":"intersectionRatio"},{"type":"formatted","text":" 表示元素出现在视口中的部分与元素整体的比例"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a9e726ee-b158-43a6-9fc5-5253ea994252.png","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a9e726ee-b158-43a6-9fc5-5253ea994252.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"7596a11c-efbc-4ae0-8dde-9998bf81827a","children":[{"type":"formatted","text":""}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"a4145be3-eab3-4389-8233-86d50b564bac","children":[{"type":"formatted","text":"boundingClientRect、intersectionRect 与 rootBounds"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2871f217-7e77-4cab-9f89-4c760d8a756b","children":[{"type":"formatted","code":true,"text":"boundingClientRect"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"intersectionRect"},{"type":"formatted","text":" 与 "},{"type":"formatted","code":true,"text":"rootBounds"},{"type":"formatted","text":" 的值都是 "},{"type":"formatted","code":true,"text":"DOMRect"},{"type":"formatted","text":" 对象，提供了元素的大小以及相对于视口的位置关系，具体可以参考 "},{"type":"formatted","code":true,"text":"Element.getBoundingClientRect()"},{"type":"formatted","text":" 方法，各字段含义如下所示。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_26950078-f6db-4df3-bcee-6022ee255a05.png","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_26950078-f6db-4df3-bcee-6022ee255a05.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"6f697745-12f6-49f5-b5d4-063669c7c1bf","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"451ac4e1-2e52-44c6-bf56-c5f28447e673","children":[{"type":"formatted","code":true,"text":"boundingClientRect"},{"type":"formatted","text":" 表示的是被监听的元素的大小与 "},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 的位置关系，"},{"type":"formatted","code":true,"text":"intersectionRect"},{"type":"formatted","text":" 表示元素与视口交叉区域部分的大小与 "},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 的位置关系，"},{"type":"formatted","code":true,"text":"rootBounds"},{"type":"formatted","text":" 表示的是 "},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 的大小与视口的位置关系。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d1eae18f-b4d6-4b05-8df7-8eb3441c78ec","children":[{"type":"formatted","code":true,"text":"rootBounds"},{"type":"formatted","text":" 的大小及位置均会收到 "},{"type":"formatted","code":true,"text":"rootMargin"},{"type":"formatted","text":" 的影响。"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"e44d0f11-760f-4b77-9b14-fd4