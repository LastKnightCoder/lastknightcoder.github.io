ng.oss-cn-beijing.aliyuncs.com/1731408645299_7de11dd6-2194-41ff-8b2e-86610fa7cede.jpg","width":3000,"height":4000},{"id":"5862bb39-9807-4d87-865c-2e362292d6ba","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645280_a6046c2b-4aab-4f1c-b8eb-012adb881bc9.jpg","width":1440,"height":1080},{"id":"76528041-08cb-445d-8ad6-cc92fc2242e0","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645285_ebd46e25-2097-4a8c-97bb-68e94f1f8e28.jpg","width":1440,"height":1080},{"id":"91674c52-62b3-448d-8e39-1afe282f233f","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645327_7191d4c4-c1d3-4c5c-9685-9a19a75422eb.jpg","width":3000,"height":4000},{"id":"9ebe930d-b651-4b19-9f26-371ab6c2c893","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645335_6e8114b0-1e10-44fc-8257-14fdd89518ed.jpg","width":4000,"height":3000},{"id":"4f74dfc3-d18b-4b7c-a4b1-554a54e14f7a","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645339_324552a0-e60b-40ad-848d-578a1e986965.jpg","width":3264,"height":2448},{"id":"8afd1d0a-469b-4c58-b940-90bebfae030f","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645330_5590b46d-e845-4168-bc08-ec6ef19da266.jpg","width":1080,"height":1920},{"id":"d989707c-fea1-4e48-8097-068d1e747ef4","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/1731408645323_c2e361bc-bd84-486e-a2d4-45dee30dc0af.jpg","width":1080,"height":1920}],"height":200,"tauContract":"286419ae74266206afa208d4e4067de696bc7f50bae0379b10693da8ca71c38d","collabId":"b4c2dea8-ecbe-4102-a0ff-7b42622354fe","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cd402f90-3298-4852-835b-1aa81669aee4","children":[{"type":"formatted","text":"去参观的地点全是佛像，鄙人没什么文化，品不出什么东西，不过山西的刀削面蛮好吃的，而且物价特别的经济实惠！"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"8a7de709-e690-46cd-ae36-aaece8823e09","children":[{"type":"formatted","text":"吉他"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8f6e1eb7-000a-40c0-a720-6e6c4306f740","children":[{"type":"formatted","text":"今年十一月份丁文慧和他男朋友来北京玩，我陪他们逛了圆明园，然后闲聊问丁文慧闲时在干什么，她说在练吉他，我心中一动，我不也一直幻想着学会一门乐器吗，何不一起呢，平时多交流也能坚持下去，于是和丁文慧要了吉他链接，入手了我的第一把吉他。"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/645919824a8f644119a0aa7b28d261d_31182bad-3989-4c15-98b3-4f57ded06972.jpg","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/645919824a8f644119a0aa7b28d261d_31182bad-3989-4c15-98b3-4f57ded06972.jpg","width":720,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c283c07b-c8fd-4a80-a43c-57a795e17c40","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"be31290f-1f6e-4c53-9415-24d55a73c348","children":[{"type":"formatted","text":"在每天晚上吃饭的时间，我都会回来练吉他，大概每天 30-40 分钟，除非特殊情况，否则不会中断，现在左手的手指头已经出茧子了，跟着视频学习吉他的基本支持，目前可以顺利的爬格子，一些和弦也能按到了，还在练习各种基础，就是不会弹曲子，争取 2025 年能弹几首曲子。"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"b549ee71-0470-4c77-b33a-641eb9d2a72d","children":[{"type":"formatted","text":"运动"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2a0d9e44-fd96-4a69-a51c-05082aa1d9ab","children":[{"type":"formatted","text":"在今年的前半年我的运动还是比较多的，每天晚饭的时候打乒乓球，有的时候出去打羽毛球，打篮球，不过自从进了 AI 平台，我就再也没时间去打乒乓球了，也没心思去打乒乓球了，可见此时一份压力大的工作对生活各方面的影响。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"978adff4-68f0-4039-a30e-361220689c8c","children":[{"type":"formatted","text":"在五月份和廖权去青岛玩时，拍照看到自己在照片里面那么胖，我就决定要减肥，当时和他打赌，下次见到我时，我一定瘦十斤，当时我的体重已经快逼近 140 了。旅游回来后我就开始减肥，每天早上我跟着刘耕宏的视频跳操，一遍是 30 分钟，一开始连一遍都很难跳下来，练了两个月，我可以把高潮部分跳两遍，大约跳 45 分钟，然后洗澡去上班，坚持了一个半月。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b093be51-82ea-4e7d-8ad8-1cd4ae0af1a9","children":[{"type":"formatted","text":"那段时间我每天早上都要称一下看下体重的变化，看着每天体重能少半斤，一斤，到了六月底，体重快降到 120 斤，减掉了快 20 斤，但是这个时候正如上述的身体原因，提出辞职后回去暂时休假了，休假期间把这个习惯断了，然后也就一直没续上，现在又胖回来了，不知道又胖了多少，现在我也不敢上称，不敢面对。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f6ad338d-277f-4d25-9220-9fd487d428bb","children":[{"type":"formatted","text":"这个让人非常的遗憾，后面也尝试过重新开始，但完全坚持不了，那股心气，那股意志已经没了，可见变化对于习惯的破坏之大。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"84867b49-156e-4581-8e70-d6208c94a17c","children":[{"type":"formatted","text":"规划"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7a881d49-6178-4415-83e0-cfc10748ac55","children":[{"type":"formatted","text":"在《高效能人士的七个习惯》中的第二个习惯是以终为始，在做任何事情之前，先明确最终的目标或结果，然后根据这个目标来规划和指导整个过程。咱小小的实践一把，立一立 2025 年的 flag："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"df103649-26b5-41f7-bf24-2296e1aa0916","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"458bb336-0a98-4997-aa29-7f20e8e426dd","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4b0dd88b-969b-4244-ae9d-e4db0ba8ebb9","children":[{"type":"formatted","text":"吉他能顺利的弹几首曲子"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02"