x(0) - x(1)z^{-1}) - 2z(X(z) - x(0))","type":"block-math"},{"children":[{"text":"而是","type":"formatted"}],"collabId":"20118b15-786d-486d-9937-c0ce20493728","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"20370269-506d-4428-8c72-f7ee43f8ffb7","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"z^2(Y(z) - y_{zi}(0) - y_{zi}(1)z^{-1}) - \\dfrac{7}{10}z(Y(z) - y_{zi}(0)) + \\dfrac{1}{10}Y(z) = 7z^2X(z) - 2zX(z)","type":"block-math"}],"collabId":"f7d92495-abd4-46e5-9d17-35d4353f2237","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"19f296dc-c5a1-41f6-99f9-10b38b8857f8","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"}],"collabId":"990ab026-3edb-4fab-b995-6b4fe5169aff","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"给出","type":"formatted"},{"children":[{"text":"y(-2), y(-1)","type":"formatted"}],"collabId":"8d33e73c-d8e5-4a9d-b282-34c3a2e0e852","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y(-2), y(-1)","type":"inline-math"},{"text":"，同样两种解法，因为 y","type":"formatted"},{"children":[{"text":"_{zs}(-2) = y_{zs}(-1) = 0","type":"formatted"}],"collabId":"7eaecdf6-f533-4ab7-ade7-dadc9f10d700","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"_{zs}(-2) = y_{zs}(-1) = 0","type":"inline-math"},{"text":"，所以 ","type":"formatted"},{"children":[{"text":"y_{zi}(-2) = y(-2), y_{zi}(-1) = y(-1)","type":"formatted"}],"collabId":"3760b39e-1a81-4da4-a09d-c5b41afd44e4","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y_{zi}(-2) = y(-2), y_{zi}(-1) = y(-1)","type":"inline-math"},{"text":"，这时同第二种情况是一样的了","type"