{"version":1,"key":"card:455","content":{"id":455,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"三种进行循环控制的方式："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"break","code":true},{"type":"formatted","text":"：结束（跳出）循环"}]},{"type":"paragraph","children":[{"type":"formatted","text":"找出小于 "},{"type":"formatted","text":"100","code":true},{"type":"formatted","text":" 的最大平方值"}]},{"type":"code-block","code":"from math import sqrt\nfor n in range(99, 0, -1):\n    root = sqrt(n)\n    if root == int(root):\n      print(n)\n      break\n\n81","language":"py","uuid":"19fc1d41-95b0-4635-9c78-f196f3a062ba","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"continue","code":true},{"type":"formatted","text":"：结束当前迭代，并跳到下一次迭代开头。"}]},{"type":"code-block","code":"for num in range(0, 4):\n  if num == 3:\n    continue\n  \n  print(num)\n\n0\n1\n2","language":"py","uuid":"19c06afa-8c61-4b29-a862-fdc76b6c66f0","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"else","code":true},{"type":"formatted","text":"：在循环正常结束时才采取某种措施，"},{"type":"formatted","text":"else","code":true},{"type":"formatted","text":" 子句，它仅在没有调用 "},{"type":"formatted","text":"break","code":true},{"type":"formatted","text":" 时才执行"}]},{"type":"code-block","code":"from math import sqrt\nfor n in range(99, 81, -1):\n    root = sqrt(n)\n    if root == int(root):\n      print(n)\n      break\n\n\nelse:\n    print(\"Didn't find it!\")","language":"py","uuid":"af9e4f14-b19f-4c56-84ab-7659bbc0e33e","children":[{"type":"formatted","text":""}]},{"type":"callout","calloutType":"info","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"else","code":true},{"type":"formatted","text":" 循环控制是 Python 独有的。"}]}]}]}]}],"tags":["Python/循