{"version":1,"key":"card:667","content":{"id":667,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":" 的对比："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"相同点"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"都是假值，转化为 "},{"type":"formatted","text":"Boolean","code":true},{"type":"formatted","text":" 都是 "},{"type":"formatted","text":"false","code":true}]},{"type":"code-block","code":"Boolean(undefined) // -> true\nBoolean(null)      // -> true","language":"JavaScript","uuid":"d28b1bde-a2f7-4ad3-b5cc-a2b85e8899dd","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"通过 "},{"type":"formatted","text":"==","code":true},{"type":"formatted","text":" 比较时返回 "},{"type":"formatted","text":"true","code":true}]},{"type":"code-block","code":"undefined == null // -> true","language":"JavaScript","uuid":"d948045e-56fb-4c38-97d9-84a2e8a32aad","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"不同点"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"语义不同，","type":"formatted"},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 表示的是表示值未定义，即仅进行了声明但是没有显式赋值"}]},{"type":"code-block","code":"// 定义变量 a 但是未赋值\nlet a;    // -> undefined\n\n// 访问对象上不存在的属性\nwindow.a; // -> undefined\n\n// 访问没有传递值的函数参数\n((a) => {\n  console.log(a); // undefined\n})()\n\n// 函数没有返回任何值\nconst a = (() => {\n  // 不返回任何内容\n})()","language":"JavaScript","uuid":"f9c4ae5a-03da-445c-ba59-6002e62620e6","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"而 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":" 表示设置的是空值，一般用来表示对象的空值"}],"disableDrag":false},{"type":"code-block","code":"let obj = null\nif (condition) {\n  obj = {}\n}","language":"JavaScript","uuid":"8d312b9f-86a1-4d9f-9f6a-5f949920285e","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"typeof","code":true},{"type":"formatted","text":" 操作符的返回值不同"}]},{"type":"code-block","code":"typeof undefined === \"undefined\" // -> true\ntypeof null === \"object\"         // -> true","language":"JavaScript","uuid":"96fcd428-4681-4721-b74e-a2ba2a830de5","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","code":true,"text":"undefined"},{"type":"formatted","text":" 不是关键字，是全局对象（在浏览器中是 "},{"type":"formatted","text":"window","code":true},{"type":"formatted","text":"，在 Node.js 中是 "},{"type":"formatted","text":"global","code":true},{"type":"formatted","text":"）的一个属性，而 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":" 则是关键字"}]},{"type":"code-block","code":"window.undefined               // -> undefined\nwindow.undefined === undefined // -> true","language":"JavaScript","uuid":"4426424d-a4d3-436a-b2ae-af4e00c125a6","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"在比较的古老的版本（ECMAScript 3），"},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 是可以被重新赋值的，因为代码中大量依赖于对 "},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 的判断，因此如果可以赋值则会出现大问题，因此一些代码压缩库会将 "},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 的判断修改为 "},{"type":"content-link","contentId":1598,"contentType":"card","contentTitle":"","refId":600,"children":[{"type":"formatted","text":"void 0","code":true}]},{"type":"formatted","text":"。"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"在 ECMAScript 5，"},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 被配置为只读以及不可配置，因此"}]},{"type":"code-block","code":"Object.getOwnPropertyDescriptor(window, \"undefined\")\n{\n    \"writable\": false,\n    \"enumerable\": false,\n    \"configurable\": false\n}","language":"JavaScript","uuid":"b9f4db24-7f26-4b9b-b49b-816b5a59b8cb","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"转化为 "},{"type":"formatted","text":"Number","code":true},{"type":"formatted","text":" 时，"},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 转化为 "},{"type":"formatted","text":"NaN","code":true},{"type":"formatted","text":"，而 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":" 会被转化为 "},{"type":"formatted","text":"0","code":true}]},{"type":"code-block","code":"Number(undefined) // -> NaN\nNumber(null)      // -> 0","language":"JavaScript","uuid":"bdbfe8d5-df62-497a-abc4-18f14fef5a2c","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"比较奇怪的是，调用 "},{"type":"formatted","text":"Number()","code":true},{"type":"formatted","text":" 不传递任何参数，应该就相当于传递 "},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":"，得到的应该是 "},{"type":"formatted","text":"NaN","code":true},{"type":"formatted","text":" 才对，但是返回的却是 "},{"type":"formatted","text":"0","code":true}],"disableDrag":false},{"type":"code-block","code":"Number()          // -> 0","language":"JavaScript","uuid":"fc713c23-5855-4fc4-ae85-51580e6d1f65","children":[{"type":"formatted","text":""}]}]}]}]}]}],"tags":["JavaScript","概念对比"],"createTime":1768560177895,"updateTime":1769183791934,"linkedCards":[]},"meta":{"type":"card","publishTime":1769183791934},"links":{"card:600":{"key":"card:600","type":"card","id":600}}}