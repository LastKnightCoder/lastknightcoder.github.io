5（Bad Request / Unsupported Media Type）错误"}]},{"type":"code-block","language":"JavaScript","uuid":"9d7943eb-cc85-4829-8d1f-5c62ad129283","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cce28186-efa2-419b-b803-7439028c93d6","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"fetch('/api', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: new URLSearchParams({ a: 1 }).toString() // 实际传递的是查询字符串，但是服务端会尝试解析为 JSON 对象，导致解析报错\n})","collabId":"be790b0c-3d74-4851-9407-1843f99e92fa","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"83766fa5-97fa-4f45-9ba1-5b000257b0cc","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f7ebeec6-13b2-42f5-b8f7-0480763f21ff","children":[{"type":"formatted","text":"如果手动指定为 "},{"type":"formatted","code":true,"text":"multipart/form-data"},{"type":"formatted","text":"，但是忘记了 boundary 边界字符串，会导致服务端无法解析，通常会报错 \"miss boundary\""}]},{"type":"code-block","language":"JavaScript","uuid":"fb5a01ca-d982-4dda-bac0-7747603372f9","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"abe91df2-d6be-41ed-a9a6-34c93ad6fa9b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const fd = new FormData();\nfd.append('a', '1');\n\nfetch('/upload', {\n  method: 'POST',\n  headers: { 'Content-Type': 'multipart/form-data' }, // ❌ 不要这么写\n  body: fd\n});","collabId":"7dc0bf42-1377-465d-853b-1f3904798a6e","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"98181c7e-de15-4fe6-bc9c-c8bfa72f0aaf","childr