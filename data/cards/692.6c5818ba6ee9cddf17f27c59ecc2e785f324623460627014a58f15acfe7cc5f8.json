":"HTML","uuid":"55e9f27f-0b1f-4042-b092-01b23c9eee87","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"de02296c-3d4c-4d61-bed6-93da86dc3ed0","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- 默认，不写就是这个 -->\n<form method=\"POST\" enctype=\"application/x-www-form-urlencoded\">\n\n<!-- 有文件上传时必须用这个 -->\n<form method=\"POST\" enctype=\"multipart/form-data\">\n\n<!-- 几乎不用，仅调试用途，值之间用换行分隔，不做任何编码 -->\n<form method=\"POST\" enctype=\"text/plain\">","collabId":"d4970213-14d2-45bd-a168-1d42f8af263f","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8cd0c6b4-06aa-40c5-b1d1-1e983e106e75","children":[{"type":"formatted","text":"两个注意事项："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"ad76e417-32de-480c-aa5f-3aefc1e800d9","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7c6e6625-79a9-437d-8c6f-8b5b7ec23cbb","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"43efef53-ee79-4b38-9dda-32e6e233a4a4","children":[{"type":"formatted","text":"如果表单包含文件，但是通过 "},{"type":"formatted","code":true,"text":"application/x-www-form-urlencoded"},{"type":"formatted","text":" 编码提交会怎么样，会导致文件会被序列化为 "},{"type":"formatted","code":true,"text":"[object File]"},{"type":"formatted","text":" 字符串"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"05e99e06-cdf3-4563-bb9f-ce78b7dbd975","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"38208041-155f-441b-9c5d-b212329d96ea","children":[{"type":"formatted","text":"如果包含文件，但是通过 GET 提交会怎么样，首先通过 "},{"type":"formatted","code":true,"text":"enctype"},{"type":"formatted","text":" 指定的值无效，会被直接忽略，然后会通过查询字符串传递参数，如果包含文件，文件内容也会被序列化为 "},{"type":"formatted","code":true,"text":"[object File]"}]}]}]},{"type":"callout","calloutType":"warning","title":"误区","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"b358f51b-fbf0-4d89-9381-49682419405b","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"87b1fda0-7690-47d3-b6dc-1fa9c827fd60","children":[{"type":"formatted","text":"一开始我以为浏览器如果在不指定 "},{"type":"formatted","code":true,"text":"enctype"},{"type":"formatted","text":" 属性的情况下，会根据表单中是否存在文件自行选择编码方式，比如如果不存在文件，那么就使用 "},{"type":"formatted","code":true,"text":"urlencoded"},{"type":"formatted","text":" 编码，如果存在则使用 "},{"type":"formatted","code":true,"text":"multipart"},{"type":"formatted","text":" 编码，但是浏览器是不会这么做的，默认值就是 "},{"type":"formatted","code":true,"text":"urlencoded"},{"type":"formatted","text":"，所以如果存在文件并且没有手动指定 "},{"type":"formatted","code":true,"text":"enctype"},{"type":"formatted","text":" 的话，文件的值都会被序列化为 "},{"type":"formatted","code":true,"text":"[object File]"},{"type":"formatted","text":"。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"88a5f713-5b37-4c14-9961-7023698e8baa","children":[{"type":"formatted","text":"相比之下 fetch 手动提交要智能一些，浏览器会根据 "},{"type":"formatted","code":true,"text":"body"},{"type":"formatted","text":" 的类型来确定 "},{"type":"formatted","code":true,"text":"Content-Type"},{"type":"formatted","text":"："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"e57b5c9c-fad4-47f8-ae7a-054587e24f77","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","colla