"type":"formatted","text":" 定义，当变量需要改变时，在使用 "},{"type":"formatted","text":"let","code":true},{"type":"formatted","text":" 定义。"}]}]}],"tags":["JavaScript/语法/变量声明"],"createTime":1728969363195,"updateTime":1743303640445,"linkedCards":[{"id":505,"target":{"key":"card:505","type":"card","id":505},"summary":"let 声明的变量与其他语言声明的变量特性一致： 在变量声明之前不能使用 console.log(a); // ReferenceError: Cannot access 'a' before initialization let a = ...","tags":["JavaScript/语法/变量声明"]}]},"meta":{"type":"card","publishTime":1743303640445},"links":{"card:505":{"key":"card:505","type":"card","id":505}}}