{"version":1,"key":"card:377","content":{"id":377,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"不同定位的包含块："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position: relative","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"position: static","code":true},{"type":"formatted","text":"：包含块由其最近的块级元素的 "},{"type":"formatted","text":"content-box","code":true},{"type":"formatted","text":" 形成"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position: fixed","code":true},{"type":"formatted","text":"，其包含块由初始包含块形成"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position: absolute","code":true},{"type":"formatted","text":"，其包含块由其最近的"},{"type":"formatted","text":"包含块的 ","highlight":"purple"},{"type":"formatted","text":"padding-box","code":true,"highlight":"purple"},{"type":"formatted","text":" 形成","highlight":"purple"},{"type":"formatted","text":"，其包含块是以下两种之一："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"初始包含块（html 根元素）"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position","code":true},{"type":"formatted","text":" 属性不为 "},{"type":"formatted","text":"static","code":true},{"type":"formatted","text":" 的元素"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"行内元素也可以是绝对定位的包含块"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"行内元素的包含块的规则是，在行内元素的左右两侧各加上一个宽度为 0 的行内盒子，这两个行内盒子 "},{"type":"formatted","text":"padding-box","code":true},{"type":"formatted","text":" 形成的包围盒"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"对于行内元素跨行的问题，标准并未规定其包含块，由浏览器自行实现，浏览器实现之间有差异"}],"disableDrag":false}]}]}]}]}]}]}],"tags":["CSS/定位/包含块"],"createTime":1699768417322,"updateTime":1745152678308,"linkedCards":[]},"meta":{"type":"card","publishTime":1745152678308}}