{"version":1,"key":"card:86","content":{"id":86,"content":[{"type":"paragraph","disableDrag":false,"collabId":"09c231a6-0165-4c76-b257-63951451ab6d","children":[{"type":"formatted","text":"捕获信号，基本形式"}]},{"type":"code-block","language":"Bash","uuid":"d746d3d5-2629-42b8-a523-aa8ad684aef4","collabId":"ba57a1d1-3930-4dfd-9ed1-9b29898be590","children":[{"text":"","type":"formatted"}],"code":"trap commands signal"},{"type":"paragraph","disableDrag":false,"collabId":"c806803f-58b4-48f0-9965-9134e6d5d454","children":[{"type":"formatted","text":"当捕获到 "},{"type":"formatted","code":true,"text":"signal"},{"type":"formatted","text":" 信号，执行 "},{"type":"formatted","code":true,"text":"commands"}]},{"type":"code-block","language":"bash","uuid":"2d725890-0f18-4f12-aa59-4925c4c81d5a","collabId":"c0a22111-c622-4168-9e52-580703a277fc","children":[{"text":"","type":"formatted"}],"code":"#!/bin/zsh\n\ntrap \"echo 'Sorry, I trap the Ctrl + C signal.'\" SIGINT\n\nfor (( i = 1; i < 10; i++ ))\ndo\n\techo \"number$i\"\n\tsleep 1\ndone"},{"type":"code-block","language":"bash","uuid":"abd886b5-22f0-4485-858e-4604f58cd765","collabId":"0485c68d-c953-4ac0-9cab-4223ef345f18","children":[{"text":"","type":"formatted"}],"code":"xt in ~/shell/sig λ ./01.sh\nnumber1\nnumber2\n^CSorry, I trap the Ctrl + C signal.\nnumber3\nnumber4\nnumber5\n^CSorry, I trap the Ctrl + C signal.\nnumber6\nnumber7\nnumber8\n^CSorry, I trap the Ctrl + C signal.\nnumber9"},{"type":"paragraph","disableDrag":false,"collabId":"64288e68-a53d-4dbe-8602-93a692714748","children":[{"type":"formatted","text":"捕获脚本退出信号 "},{"type":"formatted","code":true,"text":"EXIT"}]},{"type":"code-block","language":"bash","uuid":"f1b10d19-5467-442a-a0f0-0b71ccf1b15c","collabId":"96139669-2d2e-43b8-ac77-57dfd367414b","children":[{"text":"","type":"formatted"}],"code":"#!/bin/zsh\n\ntrap \"echo 'Goodbye ...'\" EXIT\n\nfor (( i = 1; i <= 3; i++ ))\ndo\n\techo \"number$i\"\n\tsleep 0.5\ndone"},{"type":"code-block","language":"bash","uuid":"9b3b9ae3-263b-448d-b48a-015d3391ce0a","collabId":"f38caa3b-517d-478c-907e-07949d21ec22","children":[{"text":"","type":"formatted"}],"code":"xt in ~/shell/sig λ ./02.sh\nnumber1\nnumber2\nnumber3\nGoodbye ..."},{"type":"paragraph","disableDrag":false,"collabId":"4d26541f-6ceb-43b7-86e0-c92593c8f10c","children":[{"type":"formatted","text":"在脚本不同位置设置捕获（修改捕获）"}]},{"type":"code-block","language":"Bash","uuid":"90a602fb-e989-4633-9ca1-40a7050aface","collabId":"2e5aa15a-a2bc-472a-9682-ef9b647cdeb6","children":[{"text":"","type":"formatted"}],"code":"#!/bin/zsh\n\ntrap \"echo 'I set trap.'\" SIGINT\nfor (( i = 1; i <= 3; i++ ))\ndo\n\techo \"first loop, number$i\"\n\tsleep 1\ndone\n\ntrap \"echo 'I modified trap.'\" SIGINT\nfor (( i = 1; i <= 3; i++ ))\ndo\n\techo \"second loop, number$i\"\n\tsleep 1\ndone"},{"type":"code-block","language":"bash","uuid":"4dc44bf8-5dd7-4d51-a8bd-22f28a7a1b85","collabId":"68a09427-1479-481a-aeee-520f09beb015","children":[{"text":"","type":"formatted"}],"code":"xt in ~/shell/sig λ ./03.sh\nfirst loop, number1\nfirst loop, number2\n^CI set trap.\nfirst loop, number3\nsecond loop, number1\nsecond loop, number2\n^CI modified trap.\nsecond loop, number3"},{"type":"paragraph","disableDrag":false,"collabId":"4948da7c-f87a-4945-9ae8-81e75dc0520e","children":[{"type":"formatted","text":"删除捕获"}]},{"type":"code-block","language":"bash","uuid":"d6d0cf2d-50e6-4589-a47a-be25f727a458","collabId":"9a91a535-bf96-4950-96f3-cf23a99e5dc6","children":[{"text":"","type":"formatted"}],"code":"# 删除信号，双（单）破折号\ntrap -- SIGINT\ntrap - SIGINT"}],"tags":["Shell编程"],"createTime":1689173013741,"updateTime":1791951450354,"linkedCards":[]},"meta":{"type":"card","publishTime":1791951450354}}