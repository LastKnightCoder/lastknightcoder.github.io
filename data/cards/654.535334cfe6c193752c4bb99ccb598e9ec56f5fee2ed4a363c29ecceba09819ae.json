{"version":1,"key":"card:654","content":{"id":654,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"requestSubmit","code":true},{"type":"formatted","text":" 都是用来提交表单的，但是在行为上有所不同："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 会直接发送 HTTP 请求提交表单数据，绕过原生的 HTML 校验，也不会触发 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件，因此如果通过 "},{"type":"formatted","text":"addEventListener()","code":true},{"type":"formatted","text":" 监听 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件是不会执行的"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"一般用于需要自行校验数据的场景"}]},{"type":"code-block","code":"const form = document.getElementById('myForm');\nconst submitBtn = document.getElementById('submitBtn');\n\nsubmitBtn.addEventListener('click', async (e) => {\n  e.preventDefault();\n\n  // 获取表单数据\n  const username = document.getElementById('username').value;\n  const email = document.getElementById('email').value;\n  const age = document.getElementById('age').value;\n\n  // 自定义验证逻辑\n  const errors = [];\n\n  if (username.length < 3) {\n    errors.push('用户名至少需要 3 个字符');\n  }\n\n  if (!email.includes('@')) {\n    errors.push('邮箱格式不正确');\n  }\n\n  if (age < 18) {\n    errors.push('必须年满 18 岁');\n  }\n\n  // 如果有错误，显示并返回\n  if (errors.length > 0) {\n    toast.error('验证失败：\\n' + errors.join('\\n'));\n    return;\n  }\n\n  // 验证通过，直接提交表单到服务器\n  // 注意：这会导致页面刷新/跳转\n  form.submit();\n});","language":"JavaScript","uuid":"c6ffdbfe-a6ab-4b85-b246-55767d8f1283","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"requestSubmit","code":true},{"type":"formatted","text":" 相当于模拟用户点击提交，会触发原生的 HTML 校验，只有当校验通过之后才会提交表单，也会触发 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件，并且可以被 "},{"type":"formatted","text":"preventDefault()","code":true},{"type":"formatted","text":" 阻止提交"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"调用 "},{"type":"formatted","text":"requestSubmit","code":true},{"type":"formatted","text":" 还可以指定 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":"，如果没有指定，那么 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 就是 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 本身"}]},{"type":"code-block","code":"form.requestSubmit()\nform.requestSubmit(submitter)","language":"JavaScript","uuid":"9e4faf97-68e5-43ec-8c19-0001915d85b4","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"常用于需要使用原生的 HTML5 校验，或者在 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件中阻止默认表单提交行为（表单提交会导致页面刷新），自行通过 "},{"type":"formatted","text":"ajax","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"fetch","code":true},{"type":"formatted","text":" 进行提交表单数据自行处理提交结果"}],"disableDrag":false},{"type":"code-block","code":"form.addEventListener('submit', async (e) => {\n  // 阻止默认的表单提交行为（防止页面刷新）\n  e.preventDefault();\n\n  const formData = new FormData(form);\n  const data = Object.fromEntries(formData.entries());\n\n  // 自定义校验逻辑\n  if (data.username === 'admin') {\n    toast.error('用户名 \"admin\" 已被占用');\n    return;\n  }\n\n  try {\n    const response = await fetch('/api/register', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n      },\n      body: JSON.stringify(data)\n    });\n\n    const result = await response.json();\n\n    if (response.ok) {\n      toast.success('注册成功！');\n      form.reset(); // 重置表单\n      // 可以跳转到其他页面\n      // window.location.href = '/dashboard';\n    } else {\n      toast.error('注册失败：' + result.message);\n    }\n  } catch (error) {\n    toast.error('网络错误：' + error.message);\n  }\n});","language":"JavaScript","uuid":"45fa3ef5-16c0-41ce-aba1-b9057322a210","children":[{"type":"formatted","text":""}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"关于 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 有一些注意事项："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 必须是提交按钮，即 "},{"type":"formatted","text":"type=\"submit\"","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"type=\"image\"","code":true},{"type":"formatted","text":"的元素（"},{"type":"formatted","text":"button","code":true},{"type":"formatted","text":" 元素的默认值就是 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":"），否则会抛出 "},{"type":"formatted","text":"TypeError","code":true},{"type":"formatted","text":" 的异常"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"提交按钮也必须是表单的成员，否则会抛出 "},{"type":"formatted","text":"NotFoundError","code":true},{"type":"formatted","text":"，也就是说提交按钮要么是 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 的子元素，要么使用了 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 属性引用了表单"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"通常提交行为（"},{"type":"formatted","text":"action","code":true},{"type":"formatted","text":"）和提交方式（"},{"type":"formatted","text":"method","code":true},{"type":"formatted","text":"）都是写在 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 上的，但是如果 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 中有提供 "},{"type":"formatted","text":"form* ","code":true},{"type":"formatted","text":"属性，如 "},{"type":"formatted","text":"formaction","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"formmethod","code":true},{"type":"formatted","text":"，那么就会覆盖原有的提交行为和提交方式"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"一种应用场景：一个表单同时实现「保存草稿」和「正式发布」"}]},{"type":"code-block","code":"<form action=\"/save-draft\" method=\"GET\">\n    <input type=\"text\" name=\"title\" value=\"我的文章\">\n    <button type=\"submit\">保存草稿</button>\n    <button type=\"submit\" \n            formaction=\"/publish\" \n            formmethod=\"POST\">\n        正式发布\n    </button>\n</form>","language":"HTML","uuid":"269cefd2-0d96-49db-af99-2c41a0bea419","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"当点击「保存草稿」时，会发送 "},{"type":"formatted","text":"GET /save-draft?title=\"我的文章\"","code":true},{"type":"formatted","text":" 到服务器，当点击「正式发布」时则会发送 "},{"type":"formatted","text":"POST /publish","code":true},{"type":"formatted","text":"（数据在 "},{"type":"formatted","text":"body","code":true},{"type":"formatted","text":" 中）到服务器"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"如果 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 携带了 "},{"type":"formatted","text":"name","code":true},{"type":"formatted","text":" 属性，那么其 "},{"type":"formatted","text":"name","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"value","code":true},{"type":"formatted","text":" 会一并提交"}]},{"type":"code-block","code":"<form action=\"/process-decision\" method=\"POST\">\n    <input type=\"hidden\" name=\"id\" value=\"101\">\n\n    <button type=\"submit\" name=\"decision\" value=\"approve\">同意</button>\n    <button type=\"submit\" name=\"decision\" value=\"reject\">拒绝</button>\n</form>","language":"HTML","uuid":"1ef8e139-254b-4bff-b5a3-70f7c6621b07","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"当点击「同意」的时候发送的数据是 "},{"type":"formatted","text":"id=101&decision=approve","code":true},{"text":"，点击「拒绝」的时候发送的数据就是 ","type":"formatted"},{"type":"formatted","text":"id=101&decision=reject","code":true}],"disableDrag":false},{"type":"callout","calloutType":"info","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"对于 "},{"type":"formatted","text":"type=\"image\"","code":true},{"type":"formatted","text":" 类型的 "},{"type":"formatted","text":"submitter","code":true},{"type":"formatted","text":" 提交的数据比较特殊，它携带的是点击的坐标 "},{"type":"formatted","text":"${name}.x","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"${name}.y","code":true}],"disableDrag":false},{"type":"code-block","code":"<form action=\"/handle-submit\" method=\"GET\">\n    <!-- 图片提交按钮 -->\n    <input type=\"image\" src=\"save-icon.png\" name=\"picBtn\" />\n</form>","language":"HTML","uuid":"c2d63d6a-3eac-4ed7-9500-55c7d7249eb5","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"假设点击了图片上 "},{"type":"formatted","text":"(15, 20)","code":true},{"type":"formatted","text":" 坐标的位置，那么携带的数据就是 "},{"type":"formatted","text":"picBtn.x=15&picBtn.y=20","code":true},{"text":"，服务端会根据坐标计算出点击的区域，从而有不同的处理逻辑。","type":"formatted"}],"disableDrag":false}]}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"","type":"formatted"},{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/HTMLFormElement/requestSubmit","openEdit":false,"children":[{"type":"formatted","text":"HTMLFormElement: requestSubmit() method"}]},{"text":"","type":"formatted"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"","type":"formatted"},{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Glossary/Submit_button","openEdit":false,"children":[{"type":"formatted","text":"Submit button"}]},{"text":"","type":"formatted"}]}]}]}],"tags":["概念对比","HTML/form","JavaScript/表单"],"createTime":1767178514912,"updateTime":1769086453862,"linkedCards":[]},"meta":{"type":"card","publishTime":1769086453862}}