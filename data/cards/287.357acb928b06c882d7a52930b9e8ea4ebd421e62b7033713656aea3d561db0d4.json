{"version":1,"key":"card:287","content":{"id":287,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"document.importNode","code":true},{"type":"formatted","text":" 可以从另一个 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":" 中复制一个 "},{"type":"formatted","text":"Node","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"DocumentFragment","code":true},{"type":"formatted","text":"，被复制的 "},{"type":"formatted","text":"Node","code":true},{"type":"formatted","text":" 尚未在 "},{"type":"formatted","text":"DOM","code":true},{"type":"formatted","text":" 树中，需要手动插入。"}]},{"type":"paragraph","children":[{"type":"formatted","text":"语法如下："}]},{"type":"code-block","code":"document.importNode(externalNode, deep = false);","language":"js","uuid":"b5d88a99-d6a2-44b8-92ff-cf4b86b8cbd3","children":[{"type":"formatted","text":""}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"externalNode","code":true},{"type":"formatted","text":"：需要导入到当前文档的 "},{"type":"formatted","text":"Node","code":true},{"type":"formatted","text":" 或 "},{"type":"formatted","text":"DocumentFragment","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"deep","code":true},{"type":"formatted","text":"：是否复制的子元素，默认是 "},{"type":"formatted","text":"false","code":true},{"type":"formatted","text":"，即不导入子元素"}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"例子🌰："}]},{"type":"code-block","code":"<!-- 01.html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Document</title>\n</head>\n<body>\n  <div style=\"color: red;\">\n    <button id=\"btn\">导入</button>\n  </div>\n  <iframe id=\"iframe\" src=\"./2.html\"></iframe>\n  <script>\n    const btn = document.getElementById('btn');\n    const iframe = document.getElementById('iframe');\n    btn.addEventListener('click', () => {\n      const oldNode = iframe.contentDocument.getElementById('imported');\n      const newNode = document.importNode(oldNode, true);\n      btn.insertAdjacentElement('afterend', newNode);\n    });\n  </script>\n</body>\n</html>","language":"html","uuid":"dad28095-4f03-42a4-beed-7e8f361cf948","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"<!-- 02.html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Document</title>\n</head>\n<body>\n  <p id=\"imported\">被导入的段落</p>\n</body>\n</html>","language":"html","uuid":"fe499323-9951-4ad9-8936-c8e1635be4ec","children":[{"type":"formatted","text":""}]}],"tags":["DOM/importNode"],"createTime":1692191552823,"updateTime":1743303640423,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640423}}