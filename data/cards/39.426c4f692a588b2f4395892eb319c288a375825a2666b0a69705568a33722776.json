{"version":1,"key":"card:39","content":{"id":39,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"浏览器上传文件的两种方式："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 标签"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"拖拽"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"将 "},{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 标签的 "},{"type":"formatted","text":"type","code":true},{"type":"formatted","text":" 设置为 "},{"type":"formatted","text":"file","code":true},{"type":"formatted","text":" 即可上传文件"}],"disableDrag":false},{"type":"code-block","code":"<input id=\"fileInput\" type=\"file\" />","language":"html","uuid":"d0d2fd17-1d1d-4c0f-a4cd-9d6d07ae696e","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"const input = document.getElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n  // file.name 文件名称\n  // file.size 文件大小\n  // file.path 文件路径\n  // file.type 文件 MIME TYPE（如果存在的话）\n  // file.lastModified 文件最后更改时间（时间戳）\n  // file.lastModifiedDate 文件最后更改时间（对象）\n});","language":"JavaScript","uuid":"532317e9-2ac9-405e-ba5b-5c1ed453b3bb","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"有时候浏览器默认的样式较丑，我们会将 "},{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 隐藏"}],"disableDrag":false},{"type":"code-block","code":"<input id=\"inputFile\" type=\"file\" style=\"display: none;\" />\n<button id=\"btn\">上传文件</button>","language":"html","uuid":"b29a0ff2-18bf-4350-88e2-6f42e481b968","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"const btn = document.getElementById(\"btn\");\nconst input = document.getElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n});\n\n\nbtn.addEventListener('click', () => {\n  // 调起上传文件页面\n  input.click();\n})","language":"JavaScript","uuid":"a3fe35de-f215-4d4d-a6af-0eefcb092fd9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"拖拽也可上传文件，监听 "},{"type":"formatted","text":"drop","code":true},{"type":"formatted","text":" 事件，并通过 "},{"type":"formatted","text":"e.dataTransfer","code":true},{"type":"formatted","text":" 获得拖拽的文件"}],"disableDrag":false},{"type":"code-block","code":"<div id=\"drop\">拖拽文件至此</div>","language":"html","uuid":"022af81c-987e-4809-a0f6-c05757a1da00","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"const drop = document.getEelementById(\"drop\");\ndrop.addEventListener('drop', (e) => {\n  const files = e.dataTransfer.files;\n  const file = files[0];\n})","language":"JavaScript","uuid":"2384d1c4-bd11-4672-914f-24a6f41f0394","children":[{"type":"formatted","text":""}]}],"tags":["DOM"],"createTime":1688964589813,"updateTime":1775120502160,"linkedCards":[]},"meta":{"type":"card","publishTime":1775120502160}}