{"version":1,"key":"card:181","content":{"id":181,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a39d82be-2f8b-4b78-b4bb-edf68221a4b9","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"canvas"},{"type":"formatted","text":" 对象的 "},{"type":"formatted","code":true,"text":"toDataURL(type)"},{"type":"formatted","text":" 方法，可以将画布转化为图片，其中 "},{"type":"formatted","code":true,"text":"type"},{"type":"formatted","text":" 指定图片的类型，默认为 "},{"type":"formatted","code":true,"text":"image/png"}]},{"type":"code-block","language":"JavaScript","uuid":"93c782f8-b45b-45d1-9d5c-28054debca72","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"754f567f-199c-4046-9b31-b872c16f823d","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"ctx.fillRect(0, 0, 200, 100)\n\nconst canvasToPNG = canvas => {\n  return new Promise(resolve => {\n    const img = new Image()\n    img.addEventListener('load', () => {\n      resolve(img)\n    })\n    img.src = canvas.toDataURL('image/png')\n  })\n}\n\ncanvasToImage(canvas).then(img => {\n  document.body.appendChild(img)\n})","collabId":"85c872d2-072a-4931-87e4-a2eceb04c9c8","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"19c617ec-842e-48b7-a26a-c9bfbe9d2055","children":[{"type":"formatted","text":"当 "},{"type":"formatted","code":true,"text":"toDataURL"},{"type":"formatted","text":" 的第一个参数 "},{"type":"formatted","code":true,"text":"image/jpeg"},{"type":"formatted","text":" "},{"type":"formatted","code":true,"text":"image/webp"},{"type":"formatted","text":" 等可压缩的图片时，可以传入第二个数字参数表示压缩的质量，质量位于 0-1 之间，当不传入时，默认值为 0.92"}]},{"type":"code-block","language":"JavaScript","uuid":"32999d7f-c345-4e48-a65a-e4f1d9861b1d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"12037d00-cd49-49ec-97f9-280298fe2720","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"canvas.toDataURL('image/jpeg', 0.8)","collabId":"bedc3759-5472-42d7-9726-8a043d15be0d","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"52a3f374-da4a-421d-a7c8-fa907d56f358","children":[{"type":"formatted","text":"下面给出将 Canvas 转化为图片并进行下载的代码"}]},{"type":"code-block","language":"JavaScript","uuid":"e681bd45-f025-44fd-8853-69c28ce8873a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"077d32c4-1977-4bd5-bd92-2b05c09277a7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const downLoadCanvas = (canvas, filename = 'download') => {\n  const a = document.createElement('a')\n  a.download = `${filename}.png`\n  a.href = canvas.toDataURL('image/png')\n  a.click()\n}","collabId":"6c973395-574c-44e7-94f0-f87db7ae4e36","children":[{"type":"formatted","text":""}]}]}],"tags":["Canvas"],"createTime":1690379782819,"updateTime":1743303640408,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640408}}