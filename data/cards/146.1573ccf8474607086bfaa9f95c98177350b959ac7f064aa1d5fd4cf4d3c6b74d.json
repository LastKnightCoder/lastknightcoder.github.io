{"version":1,"key":"card:146","content":{"id":146,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2c01fe6f-1ec4-4868-af22-cde1653aa51b","children":[{"type":"formatted","text":"使用 "},{"type":"formatted","code":true,"text":"IntersectionObserver"},{"type":"formatted","text":" 进行图片的懒加载。我们监控文档中所有的图片，这些图片的地址都设置在 "},{"type":"formatted","code":true,"text":"data-src"},{"type":"formatted","text":" 上，当图片出现在视口中时，我们从 "},{"type":"formatted","code":true,"text":"data-src"},{"type":"formatted","text":" 中取出地址，设置在 "},{"type":"formatted","code":true,"text":"src"},{"type":"formatted","text":" 属性上，从而实现页面的懒加载，提高页面的加载速度"}]},{"type":"code-block","language":"html","uuid":"a4f8bcb6-0192-45b7-996d-5e7c2523e96b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"508a383b-bdf0-406e-8ea8-fb68351ac949","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"image-list\">\n  <img class=\"lazy-image\" data-src=\"images/01.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/02.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/03.jpg\" />\n  <img class=\"lazy-image\" data-src=\"images/04.jpg\" />\n</div>","collabId":"901b104c-b44b-4a16-b5fd-6ff4ef4c61e3","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"css","uuid":"fd6b9ccd-32df-4f12-84af-51473342bf93","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"816ad630-95b9-4372-9d75-9511bda654f8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#image-list {\n    display: flex;\n    justify-content: space-between;\n    margin: 100px 50px;\n}\n\n// 为了防止布局抖动，需要给图片一个宽度和高度\n#image-list .lazy-image {\n    width: 200px;\n    height: 200px;\n    object-fit: cover;\n}","collabId":"921ea627-0c0d-432d-90c5-6ce0425fee85","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"b61e524a-c98e-4e7b-b4e7-693a7a1e0b4a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7bb426bf-add1-4515-b7f7-797893d8b583","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new IntersectionObserver(entries => {\n  entries.forEach(entry => {\n    // 当图片出现在视口中的时候\n    if (entry.isIntersecting) {\n      // 取出地址，设置在 src 属性上\n      const img = entry.target;\n      const src = img.dataset.src;\n      img.src = src;\n      // 取消监听，只监听一次\n      observer.unobserve(img);\n    }\n  });\n});\n\nconst lazyImages = document.getElementsByClassName('lazy-image');\nfor (let lazyImage of lazyImages) {\n  observer.observe(lazyImage);\n}","collabId":"209ecea4-24f2-469b-8d2c-57a2e846e4b4","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<video style=\"max-width: 100%;\" controls src=\"https://video-obsidian.oss-cn-beijing.aliyuncs.com/IntersectionObserver-%E5%9B%BE%E7%89%87%E6%87%92%E5%8A%A0%E8%BD%BD.mp4\"></video>","collabId":"a064149f-7447-4687-86fc-b832f2093641","children":[{"type":"formatted","text":""}]}],"tags":["DOM/Intersection Observer"],"createTime":1690124509702,"updateTime":1743303640404,"linkedCards":[{"id":145,"target":{"key":"card:145","type":"card","id":145},"summary":"使用 IntersectionObserver 可以监听元素是否出现在视口中，其使用方法如下 // 创建 observer，接收两个参数 // 1. fn，被监听的元素出现在视口中时触发的回调函数 // 2. 创建 observer 的选项...","tags":["DOM/Intersection Observer"]}]},"meta":{"type":"card","publishTime":1743303640404},"pluginRenderers":[{"runtimeVersion":1,"manifest":{"id":"tau.html","name":"HTML","version":"0.1.11","categories":["editor","ai"],"keywords":["HTML","网页","嵌入"],"apiVersion":1,"format":"cjs","main":"main.js","styles":"main.css","skills":["authoring"],"integrity":{"main.js":"968d6dd4153a56e6a91e0990d98b68c75255776b56b323facc1bfd5037fe0602","main.css":"468f2feb73a33e5711b1583b609e4ab3818e83d5f19a38dcd9d027b77eb269d8","skills/authoring/SKILL.md":"5a476fc110584964ab053cb40f0399ec27125bc1d315b6d50b019fbd9b112aa0"},"formatVersion":3,"platform":"portable","profile":"web-v1","description":"在文档中编辑行内与块级 HTML，支持 Tailwind 样式、博客发布和静态导出。","targets":{"desktop":{"minAppVersion":"0.59.5"},"android":{"minAppVersion":"0.2.7"},"ios":{"minAppVersion":"0.2.7"}}},"entry":"../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/main.js","styles":"../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/style.css","nodeTypes":["html-block","html-inline"]}],"contentStyles":[{"href":"../styles/55302789dd1e4d975d3bd635c7fdc6b6808b860b7e13096887d41a75d45bc654.css","integrity":"55302789dd1e4d975d3bd635c7fdc6b6808b860b7e13096887d41a75d45bc654"}]}