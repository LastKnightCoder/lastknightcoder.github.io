{"version":1,"key":"card:268","content":{"id":268,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"除了通过下标访问数组中的元素，还可以通过解构语法"}]},{"type":"code-block","code":"const arr = ['Alice', 18];\n\nconst [name, age] = arr;\nconsole.log(name, age); // Alice 18","language":"js","uuid":"bb056174-e090-4c0b-ae66-786f7caed9fb","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如果想忽略某个 "},{"type":"formatted","text":"index","code":true},{"type":"formatted","text":" 的值，写一个 "},{"type":"formatted","text":",","code":true},{"type":"formatted","text":" 就可以了"}]},{"type":"code-block","code":"const [, age] = arr;\nconsole.log(age); //18","language":"js","uuid":"a3c555ae-0dae-4890-ad89-1f0302144f56","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如果解构的值超出了数组的范围，得到的值是 "},{"type":"formatted","text":"undefined","code":true},{"text":"，可以为这种值给一个默认值","type":"formatted"}]},{"type":"code-block","code":"const [, , gender = 'male'] = arr;\nconsole.log(gender); // male","language":"js","uuid":"ab83c40b-a10a-4dfc-91e4-a975c8d0072b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"解构嵌套数组"}]},{"type":"code-block","code":"const arr = [1, [2, 3], 4];\nconst [one, [two, three], four] = arr;\n\nconsole.log(one, two, three, four); // 1 2 3 4","language":"js","uuid":"f3c5b10e-29aa-4be1-b56f-510a0c9a821f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"解构剩余参数"}]},{"type":"code-block","code":"const [one, ...rest] = [1, 2, 3, 4];\nconsole.log(one, rest); // 1 [2, 3 4]","language":"js","uuid":"e1cebb59-6007-404a-9ffe-03e00146d04a","children":[{"type":"formatted","text":""}]}],"tags":["JavaScript"],"createTime":1691988572548,"updateTime":1743303640422,"linkedCards":[{"id":267,"target":{"key":"card:267","type":"card","id":267},"summary":"使用解构语法从对象中提取属性 const user = { name: 'Alice', age: 18, score: { math: 88, chinese: 70 } } const { name, age } = user; con...","tags":["JavaScript"]}]},"meta":{"type":"card","publishTime":1743303640422}}