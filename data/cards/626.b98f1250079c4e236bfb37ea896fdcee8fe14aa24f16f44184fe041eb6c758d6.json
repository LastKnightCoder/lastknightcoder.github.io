ted","code":true,"text":"20px"},{"type":"formatted","text":"，字体大小 "},{"type":"formatted","code":true,"text":"12px"},{"type":"formatted","text":"，那么上下间距的大小就是 "},{"type":"formatted","code":true,"text":"(20 - 12) / 2 = 4px"},{"type":"formatted","text":"，利用上下间距等分，如果只有"},{"type":"formatted","color":"#6425d0","darkColor":"#a472fc","text":"单行文字"},{"type":"formatted","text":"，将行高设置为容器高度，就可以实现文字在容器中的垂直居中，如果是多行的话就不行了，因为第二行已经在容器外面了"}]},{"type":"code-block","language":"HTML","uuid":"6c761fc3-045d-49d8-ae39-8ca924a9687d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"0def8cee-7da8-44be-a6d3-589a5640e174","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div style=\"height: 60px; line-height: 60px;\">\n  这是一行文字\n</div>","collabId":"007692f2-75d2-427f-87b5-5e5b294d5c94","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<div style=\"height: 60px; border-radius: 20px; line-height: 60px; background: gray; color: white; padding: 0 20px;\"> 这是一行文字</div>","collabId":"4e042358-ae1e-41ca-8b23-eb2137af181b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6453ecc5-7161-4c39-a41f-dcf94e018996","children":[{"type":"formatted","code":true,"text":"line-height"},{"type":"formatted","text":" 属性是可以继承的，对于纯数字和带单位的数字继承的值含义不同。比如对于上述，纯数字 1.5 和带单位的值 150%，1.5em 得到的行高都是相同的，但是继承的值却不同："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"9580abcf-5fee-49d3-95e1-3d7f6b64671d","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6d4cf25b-4723-4e6f-9e48-b8e79f1a82f3","children":[{"type":"paragraph","disableDrag":false,"tauCo