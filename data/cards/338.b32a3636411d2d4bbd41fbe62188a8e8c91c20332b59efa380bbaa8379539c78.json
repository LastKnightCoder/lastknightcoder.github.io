{"version":1,"key":"card:338","content":{"id":338,"content":[{"children":[{"text":"在执行多个 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":" 时，我们一般是使用 ","type":"formatted"},{"code":true,"text":"Promise.all","type":"formatted"},{"text":" 来同时并发执行多个 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":"，但是在资源有限的情况下，我们需要控制同时执行的 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":" 的数量，可以通过 ","type":"formatted"},{"code":true,"text":"p-limit","type":"formatted"},{"text":" 这个库来做到这一点。","type":"formatted"}],"collabId":"0dadd6f6-acfe-429a-8f13-4f5607ce9199","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"安装：","type":"formatted"}],"collabId":"9db8eaa4-b4bc-445e-8123-9b6b06b2102e","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"npm install p-limit --save","collabId":"6feb210b-c284-41c6-bc0f-8467bcf09b05","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2c127241-5ebf-4287-86b2-cef426e6914c","language":"shell","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"f469887f-2a00-4a6b-8eed-6bd15390f318"},{"children":[{"text":"使用：","type":"formatted"}],"collabId":"5dd2b6df-91d0-4544-a9ac-6f28f185b97a","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"import pLimit from 'p-limit';\n\n// 最多同时执行 5 个 Promise\nconst generator = pLimit(5);","collabId":"f48170da-4a4a-440a-aa5a-1e0827012f27","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"d7be12ff-9102-41b4-8555-d605e0c194d7","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"d6874fe6-b18f-473b-9725-d2968700e2f4"},{"children":[{"text":"将需要执行的任务和所需的参数传递给 ","type":"formatted"},{"code":true,"text":"generator","type":"formatted"},{"text":"，该 ","type":"formatted"},{"code":true,"text":"generator","type":"formatted"},{"text":" 返回一个 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":"，当任务被调度执行完成时，这个 ","type":"formatted"},{"code":true,"text":"Promise","type":"formatted"},{"text":" 的状态将会变成 ","type":"formatted"},{"code":true,"text":"resolved","type":"formatted"}],"collabId":"2d046440-bc13-40d0-a6f9-0586e8a0835c","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"import delay from 'delay';\n\nconst tasks = Array.from({ length: 100 }, () => generator(() => delay(100)));\nawait Promise.all(tasks);","collabId":"181aac86-2537-4ce7-82a8-f87acfa75802","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2121388c-11eb-4016-9244-4d7808de77b3","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"99bee674-d9fc-4f8d-85a8-a687e654153f"},{"children":[{"text":"下面分别设置不同的 ","type":"formatted"},{"code":true,"text":"limit","type":"formatted"},{"text":" 来运行 ","type":"formatted"},{"code":true,"text":"100","type":"formatted"},{"text":" 个任务，每个任务运行 ","type":"formatted"},{"code":true,"text":"100ms","type":"formatted"},{"text":"，观察总体的运行时间","type":"formatted"}],"collabId":"137bcd9e-03b1-4a66-8066-814b7701bfc1","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"import pLimit from 'p-limit';\nimport delay from 'delay';\n\nconst runTask = async (limit) => {\n  const generator = pLimit(limit);\n  const start = Date.now();\n  const tasks = Array.from({ length: 100 }, () => generator(() => delay(100)));\n  await Promise.all(tasks);\n  const end = Date.now();\n  return end - start;\n}\n\nconst limits = [5, 10, 20, 50, 100];\nconst results = await Promise.all(limits.map(limit => runTask(limit)));\nconst times = limits.map((limit, index) => ({ limit, time: results[index] }));\n\nconsole.table(times);","collabId":"61373894-b344-4f2a-b85c-850054a7563d","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"4e22c13f-e0f6-48c4-876e-d90c0479c8a8","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"968eb6e7-9d71-45fc-a287-2014f4b1d86c"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"┌─────────┬───────┬──────┐\n│ (index) │ limit │ time │\n├─────────┼───────┼──────┤\n│    0    │   5   │ 2017 │\n│    1    │  10   │ 1012 │\n│    2    │  20   │ 509  │\n│    3    │  50   │ 205  │\n│    4    │  100  │ 105  │\n└─────────┴───────┴──────┘","collabId":"98696cde-1553-4b1e-a4e2-6095238b3aae","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"6680a861-112d-4d0c-ae54-15881f886ac3","language":"console","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"0906b977-0591-4195-a8f6-f9ebff8532c8"},{"children":[{"text":"因为每个任务基本不占用 CPU 的时间，所需时间基本符合","type":"formatted"}],"collabId":"4c7f81a2-63ca-40b7-83b5-1b62bd8cf5ef","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"eb3f75ce-ab5f-4610-902f-7522ebd5da16","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{total time} = \\frac{\\text{number of tasks}}{\\text{limit}} \\times \\text{signle task time}","type":"block-math"}],"tags":["JavaScript/三方库