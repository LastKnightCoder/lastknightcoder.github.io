{"version":1,"key":"card:318","content":{"id":318,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"如何在 esbuild 项目中使用 CSS Module。"}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"下载插件 esbuild-css-modules-plugin"}]},{"type":"code-block","code":"npm i -D esbuild-css-modules-plugin","language":"shell","uuid":"f9ad1dc8-6212-4e0d-9719-3bf944264498","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"配置插件"}]},{"type":"code-block","code":"import esbuild from 'esbuild';\nimport CssModulesPlugin from 'esbuild-css-modules-plugin';\n\nesbuild.build({\n  plugins: [\n    CssModulesPlugin({\n      // @see https://github.com/indooorsman/esbuild-css-modules-plugin/blob/main/index.d.ts for more details\n      force: true,\n      emitDeclarationFile: true,\n      localsConvention: 'camelCaseOnly',\n      namedExports: true,\n      inject: false\n    })\n  ]\n});","language":"js","uuid":"323c25ae-0ace-446d-81d0-9714d81c791f","children":[{"type":"formatted","text":""}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://www.npmjs.com/package/esbuild-css-modules-plugin","openEdit":false,"children":[{"type":"formatted","text":"esbuild-css-modules-plugin"}]},{"text":"","type":"formatted"}]}]}]}],"tags":["CSS/CSS Module","JavaScript/esbuild"],"createTime":1695458598158,"updateTime":1743303640425,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640425}}