ype":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8333ef5e-4699-47d1-8b47-29b02787c0a2","children":[{"type":"formatted","code":true,"text":"link"}]}]}]},{"type":"code-block","language":"JSX","uuid":"3628eba0-5473-4188-85e4-8d4b07b07318","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6efa768a-fd80-4285-859f-187b15bf02ba","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function BlogPost({post}) {\n  return (\n    <article>\n      <h1>{post.title}</h1>\n      <title>{post.title}</title>\n      <meta name=\"author\" content=\"Josh\" />\n      <link rel=\"author\" href=\"https://twitter.com/joshcstory/\" />\n      <meta name=\"keywords\" content={post.keywords} />\n      <p>\n        Eee equals em-see-squared...\n      </p>\n    </article>\n  );\n}","collabId":"96f394b2-ecb1-48ee-a77f-bd9492e40e28","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b0bfc51b-9394-4200-a0f8-e66d89210c9b","children":[{"type":"formatted","text":"会被自动放到 "},{"type":"formatted","code":true,"text":"head"},{"type":"formatted","text":" 中。"}]},{"type":"callout","calloutType":"warning","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"3dd9a48c-0e48-4ee0-b8d6-52bda42d1d1f","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"89ef6964-f830-469c-a317-13b5863af58b","children":[{"type":"formatted","text":"对于简单的用例，渲染文档元数据为标签可能是合适的，但库可以提供更强大的功能，这些功能使得像 "},{"type":"formatted","code":true,"text":"react-helmet"},{"type":"formatted","text":" 这样的框架和库更容易支持元数据标签，而不是替换它们。"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"d930a6ac-9348-489f-bb83-e0a39ceea177","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b1e6e6e2-c818-46fc-abac-0ac0e2087627","children":[{"type":"formatted","text":"支持样式表，如果设置了样式表的 "},{"type":"formatted","code":true,"text":"precedence"},{"type":"formatted","text":"，它将管理样式表在 DOM 中的插入顺序，并确保在显示依赖于这些样式规则的内容之前加载样式表"}]},{"type":"code-block","language":"JSX","uuid":"907085e3-cd10-43d5-a4ec-7df7329933a4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8f154ac1-b9b5-4407-a710-8cbef0eb72f7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function ComponentOne() {\n  return (\n    <Suspense fallback=\"loading...\">\n      <link rel=\"stylesheet\" href=\"foo\" precedence=\"default\" />\n      <link rel=\"stylesheet\" href=\"bar\" precedence=\"high\" />\n      <article class=\"foo-class bar-class\">\n        {...}\n      </article>\n    </Suspense>\n  )\n}\n\nfunction ComponentTwo() {\n  return (\n    <div>\n      <p>{...}</p>\n      <link rel=\"stylesheet\" href=\"baz\" precedence=\"default\" /> <-- will be inserted between foo & bar\n    </div>\n  )\n}","collabId":"21be0265-46ba-4c58-83b6-e6ddd27eef28","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9a20b0a6-89e8-459f-8e15-6dbc838d21a3","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d7947e34-74bc-41b1-a3c3-1f9a8174795e","children":[{"type":"formatted","text":"支持异步脚本"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b33977c1-db14-472d-9384-a13f30098e01","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"14213598-3cd3-4db1-a534-5473d2269306","children":[{"type":"formatted","text":"支持预加载资源"}]},{"type":"code-block","language":"JSX","uuid":"4a97ecd3-e030-4b65-aa9e-14af36b6972e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"eed838ba-d458-458f-aeec-efb9e79e7f91","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"import { prefetchDNS, preconnect, preload, preinit } from 'react-dom'\n\nfunction MyComponent() {\n  preinit('https://.../path/to/some/script.js', {as: 'script' }) // loads and executes this script eagerly\n  preload('https://.../path/to/font.woff', { as: 'font' }) // preloads this font\n  preload('https://.../path/to/stylesheet.css', { as: 'style' }) // preloads this stylesheet\n  prefetchDNS('https://...') // when you may not actually request anything from this host\n  preconnect('https://...') // when you will request something but aren't sure what\n}","collabId":"e4cfc50a-b224-4b04-b325-9e067240b083","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JSX","uuid":"5a803379-a53d-4919-ae7f-00f90b0b5ac9","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"5e419de6-46cc-444b-9c7c-75c88ce56946","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- the above would result in the following DOM/HTML -->\n<html>\n  <head>\n    <!-- links/scripts are prioritized by their utility to early loading, not call order -->\n    <link rel=\"prefetch-dns\" href=\"https://...\">\n    <link rel=\"preconnect\" href=\"https://...\">\n    <link rel=\"preload\" as=\"font\" href=\"https://.../path/to/font.woff\">\n    <link rel=\"preload\" as=\"style\" href=\"https://.../path/to/stylesheet.css\">\n    <script async=\"\" src=\"https://.../path/to/some/script.js\"></script>\n  </head>\n  <body>\n    ...\n  </body>\n</html>","collabId":"df59e153-786a-4319-9aa9-4a866fa00c84","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c53a4b30-f033-40f6-9677-1e86cd8cb290","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"10f940b1-cabd-4645-ad33-2b9d89252b68","children":[{"type":"formatted","text":"支持自定义元素"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"366adb4a-7ce8-4ae0-95a5-17fb3888627f","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"9b1f23a6-d1c5-4a95-90d5-cd7a4c1c2812","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"3e935dd8-e131-4010-afe4-6a5b578178e8","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5ee88156-f4a2-415c-93f0-4a28f03e6c4a","children":[{"type":"link","url":"https://zh-hans.react.dev/blog/2024/12/05/react-19#new-hook-optimistic-updates","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"7e66ce45-e872-4baa-9935-4548a5a76c35","children":[{"type":"formatted","text":"React v19"}]}]}]}]}],"tags":["React","面试题"],"createTime":1744945208185,"updateTime":1752924268674,"linkedCards":[]},"meta":{"type":"card","publishTime":1752924268674}}