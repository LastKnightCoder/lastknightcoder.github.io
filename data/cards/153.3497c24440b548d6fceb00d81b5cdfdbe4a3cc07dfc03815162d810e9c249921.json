{"version":1,"key":"card:153","content":{"id":153,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"355e2d74-36c6-49a8-b48c-548f9d809405","children":[{"type":"formatted","text":"同一个 "},{"type":"formatted","code":true,"text":"MutationObserver"},{"type":"formatted","text":" 可以同时监听多个元素，可通过 "},{"type":"formatted","code":true,"text":"disconnect"},{"type":"formatted","text":" 取消所有元素的监听。"}]},{"type":"code-block","language":"html","uuid":"4ea40b3d-5942-4227-a9be-996191a1d221","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"71935252-4f0e-46d5-8cff-2f096a933c62","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"text1\" contenteditable=\"true\">Hello World!</div>\n<div id=\"text2\" contenteditable=\"true\">你好，世界！</div>\n<button id=\"btn1\">监听text1</button>\n<button id=\"btn2\">监听text2</button>\n<button id=\"stopBtn\">取消监听</button>","collabId":"971539aa-62eb-4217-9378-81447bca5252","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"f04ad21d-715d-412a-9a16-a283d66a5887","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"931a062b-6e47-408a-bf05-eef3363c3b8a","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const observer = new MutationObserver(mutations => {\n  console.log(mutations);\n});\n\nbtn1.addEventListener('click', () => {\n  observer.observe(text1, {\n    characterData: true,\n    subtree: true\n  });\n});\nbtn2.addEventListener('click', () => {\n  observer.observe(text2, {\n    characterData: true,\n    subtree: true\n  });\n});\nstopBtn.addEventListener('click', () => {\n  observer.disconnect();\n});","collabId":"a933ef2e-335b-4b63-a3b9-d7f79bf7fb91","children":[{"type":"formatted","text":""}]