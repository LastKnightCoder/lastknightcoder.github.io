{"version":1,"key":"card:557","content":{"id":557,"content":[{"type":"callout","title":"","calloutType":"note","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块只通过 HTTP(s) 工作，而非本地。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"如果你尝试通过 "},{"type":"formatted","text":"file://","code":true},{"type":"formatted","text":" 协议在本地打开一个网页，你会发现 "},{"type":"formatted","text":"import/export","code":true},{"type":"formatted","text":" 指令不起作用。"}],"disableDrag":false}]},{"type":"header","level":2,"children":[{"type":"formatted","text":"模块核心功能："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"始终使用 "},{"type":"formatted","text":"use strict","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"模块始终在严格模式下运行。例如，对一个未声明的变量赋值将产生错误。"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<script type=\"module\"> \n  a = 5; // error \n</script>","uuid":"df692f26-dbda-44ab-8ce2-c785463319d5","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块级作用域"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"在浏览器中，对于 HTML 页面，每个 "},{"type":"formatted","text":"<script type=\"module\">","code":true},{"type":"formatted","text":" 都存在独立的顶级作用域。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块代码仅在第一次导入时被解析"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"顶层模块代码应该用于初始化，创建模块特定的内部数据结构"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果我们需要多次调用某些东西 —— 我们应该将其以函数的形式导出"}],"disableDrag":false}]}]},{"type":"code-block","language":"js","code":"// 📁 1.js \nimport { admin } from './admin.js'; \nadmin.name = \"Pete\"; \n// 📁 2.js \nimport { admin } from './admin.js'; \nalert(admin.name); // Pete\n// 1.js 和 2.js 引用的是同一个 admin 对象 \n// 在 1.js 中对对象做的更改，在 2.js 中也是可见的_","uuid":"dd2cc7e7-4549-4e01-aa0d-247a4df93148","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"因为该模块只执行了一次。生成导出，然后这些导出在导入之间共享"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"import.meta","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"import.meta","code":true},{"type":"formatted","text":" 对象包含关于当前模块的信息"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"在浏览器环境中，它包含当前脚本的 URL"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果它是在 HTML 中的话，则包含当前页面的 URL"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"在模块中，"},{"type":"formatted","text":"this","code":true},{"type":"formatted","text":" 是 "},{"type":"formatted","text":"undefined","code":true}],"disableDrag":false},{"type":"code-block","language":"html","code":"<script> \n  alert(this); // window \n</script> \n<script type=\"module\"> \n  alert(this); // undefined \n</script>","uuid":"575c900e-57ba-43c1-bec9-7215b1b864ce","children":[{"type":"formatted","text":""}]}]}]},{"type":"header","level":2,"children":[{"type":"formatted","text":"浏览器特定功能"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"延迟加载，与 "},{"type":"formatted","text":"defer","code":true},{"type":"formatted","text":" 的影响相同"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"不会阻塞 HTML 的处理，它们会与其他资源并行加载"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块脚本会等到 HTML 文档完全准备就绪，然后才会运行。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"保持脚本的相对顺序：在文档中排在前面的脚本先执行"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"async","code":true},{"type":"formatted","text":" 适用于内联脚本（inline script）"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<!-- 所有依赖都获取完成（analytics.js）然后脚本开始运行 --> \n<!-- 不会等待 HTML 文档或者其他 <script> 标签 --> \n<script async type=\"module\"> \n  import { counter } from './analytics.js';\n  counter.count();\n </script>","uuid":"8339024e-4a4b-4904-9ab8-14ad397a6e8a","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"外部脚本"}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"具有相同 "},{"type":"formatted","text":"src","code":true},{"type":"formatted","text":" 的外部脚本仅运行一次"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<!-- 脚本 my.js 被加载完成（fetched）并只被运行一次 -->\n<script type=\"module\" src=\"my.js\"></script>\n<script type=\"module\" src=\"my.js\"></script>","uuid":"df346325-ced0-4565-9efe-cfa2ef582b81","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"list-item","children":[{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"如果一个模块脚本是从另一个源获取的，则远程服务器必须提供表示允许获取的响应头 "},{"type":"formatted","text":"Access-Control-Allow-Origin","code":true}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"不允许裸模块"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"在浏览器中，"},{"type":"formatted","text":"import","code":true},{"type":"formatted","text":" 必须给出相对或绝对的 URL 路径。没有任何路径的模块被称为“裸（bare）”模块。"}],"disableDrag":false},{"type":"code-block","language":"js","code":"import {sayHi} from 'sayHi'; // Error，“裸”模块\n// 模块必须有一个路径，例如 './sayHi.js' 或者其他任何路径","uuid":"20dd2d08-6552-4948-b533-7d7f3658de4f","children":[{"type":"formatted","text":""}]},{"type":"callout","title":"","calloutType":"note","children":[{"type":"paragraph","children":[{"type":"formatted","text":"某些环境，像 Node.js 或者打包工具（bundle tool）允许没有任何路径的裸模块，因为它们有自己的查找模块的方法和钩子（hook）来对它们进行微调。但是浏览器尚不支持裸模块。"}],"disableDrag":false}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"nomodule","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"旧版本会忽略 "},{"type":"formatted","text":"type=\"module\"","code":true},{"type":"formatted","text":"，使用 "},{"type":"formatted","text":"nomodule","code":true},{"type":"formatted","text":" 做为后备"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<script nomodule>\n  alert(\"Modern browsers know both type=module and nomodule, so skip this\")\n  alert(\"Old browsers ignore script with unknown type=module, but execute this.\");\n</script>","uuid":"4cfaa76f-c74a-488b-8ce3-cab72926525d","children":[{"type":"formatted","text":""}]}]}]},{"type":"header","level":2,"children":[{"type":"formatted","text":"总结"}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"一个模块就是一个文件。浏览器需要使用 "},{"type":"formatted","text":"<script type=\"module\">","code":true},{"type":"formatted","text":" 以使 "},{"type":"formatted","text":"import/export","code":true},{"type":"formatted","text":" 可以工作。与一般脚本有以下几点不同"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"默认是延迟解析的（deferred）。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"async","code":true},{"type":"formatted","text":" 可用于内联脚本。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"要从另一个源（域/协议/端口）加载外部脚本，需要 CORS header。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"重复的外部脚本会被忽略"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块具有自己的本地顶级作用域"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块始终使用 "},{"type":"formatted","text":"use strict","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"模块代码只执行一次。导出仅创建一次，然后会在导入之间共享"}],"disableDrag":false}]}]}],"tags":["JavaScript/模块","ES6"],"createTime":1744171051894,"updateTime":1752403545159,"linkedCards":[]},"meta":{"type":"card","publishTime":1752403545159}}