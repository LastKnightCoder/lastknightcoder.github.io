{"version":1,"key":"card:663","content":{"id":663,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"pnpm -C","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"pnpm --dir","code":true},{"type":"formatted","text":" 的作用是指定命令执行时的工作目录"}],"disableDrag":false},{"type":"code-block","code":"pnpm -C <path> <command>","language":"Bash","uuid":"0edc64d4-7a63-4b76-8494-31671346030e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"等价于"}],"disableDrag":false},{"type":"code-block","code":"cd <path> && pnpm <command>","language":"Bash","uuid":"200d9ff5-c998-4469-b8c4-b87473d4762f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"比如说对于一个 monorepo 项目，需要在某个包（如 apps/web）下安装依赖"}],"disableDrag":false},{"type":"code-block","code":"pnpm -C apps/web install","language":"Bash","uuid":"f173c488-f841-4296-ab69-e374adf89bdf","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"或者在 CI 脚本中进行构建"}],"disableDrag":false},{"type":"code-block","code":"pnpm -C apps/web build","language":"Bash","uuid":"56082fbb-eed8-46d7-808e-451d953b7bbb","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"既减少了频繁输入 "},{"type":"formatted","text":"cd","code":true},{"type":"formatted","text":" 带来的麻烦，也减少了频繁切换工作目录带来的问题（比如不知道当前的工作目录是什么了）。"}],"disableDrag":false}],"tags":["包管理器/pnpm","使用技巧/pnpm"],"createTime":1767537137932,"updateTime":1767537169217,"linkedCards":[]},"meta":{"type":"card","publishTime":1767537169217}}