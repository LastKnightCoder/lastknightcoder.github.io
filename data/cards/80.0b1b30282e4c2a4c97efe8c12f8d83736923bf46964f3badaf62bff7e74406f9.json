{"version":1,"key":"card:80","content":{"id":80,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"选区和元素是否可编辑并没有直接关系，唯一的区别就是，在可编辑元素上可以看到光标。"}],"disableDrag":false},{"type":"code-block","code":"<input type=\"text\">\n<textarea></textarea>\n<div contenteditable=\"true\"></div>","language":"html","uuid":"84501ffd-d936-4f80-b5b0-411c4de34d2d","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"div{\n    -webkit-user-modify: read-write;\n}","language":"css","uuid":"80607308-a381-4963-b97b-16d5c99504e8","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"这两种有什么区别呢？简单来说，表单元素更容易控制，浏览器提供了更直观的 API 来操控选区。"}],"disableDrag":false},{"type":"code-block","code":"inputElement.setSelectionRange(selectionStart, selectionEnd [, selectionDirection]);","language":"JavaScript","uuid":"7aeaa1b5-1230-4684-a1b6-bb26721180fc","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"选择全部 "}],"disableDrag":false},{"type":"code-block","code":"txt.select();\ntxt.focus();","language":"JavaScript","uuid":"9f12018d-c2e3-4420-915c-19215f2eebd6","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"替换内容"}],"disableDrag":false},{"type":"code-block","code":"inputElement.setRangeText(replacement);\ninputElement.setRangeText(replacement, start, end [, selectMode])","language":"JavaScript","uuid":"0e7a9cbf-3c28-406c-b705-5160a4ff8086","children":[{"type":"formatted","text":""}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"replacement","code":true},{"type":"formatted","text":"：替换的文本"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"start","code":true},{"type":"formatted","text":"：起始位置"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","child