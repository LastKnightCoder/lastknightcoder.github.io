"},{"type":"formatted","text":"Access-Control-Allow-Credentials","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"Access-Control-Allow-Origin","code":true},{"text":" 响应头，否则浏览器会直接返回网络错误","type":"formatted"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"对于非简单请求，会先发送一个"},{"type":"formatted","text":"不携带","bold":true},{"type":"formatted","text":" "},{"type":"formatted","text":"credentials","code":true},{"type":"formatted","text":" 的预检请求，如果服务端没有正确设置 "},{"type":"formatted","text":"Access-Control-Allow-Credentials","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"Access-Control-Allow-Origin","code":true},{"text":" 响应头，那么浏览器直接返回网络错误，如果正确设置了，才会发送携带 ","type":"formatted"},{"type":"formatted","text":"credentials","code":true},{"text":" 的真实请求","type":"formatted"}]}]}]}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"是否可以携带 Cookie，还受到 Cookie 的 "},{"type":"content-link","contentId":1397,"contentType":"card","contentTitle":"","refId":567,"children":[{"type":"formatted","text":"SameSite"}]},{"type":"formatted","text":" 属性的影响。"}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"","type":"formatted"},{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API/Using_Fetch#including_credentials","openEdit":false,"children":[{"type":"formatted","text":"Including credentials"}]},{"text":"","type":"formatted"}]}]}]}],"tags":["JavaScript/fetch","JavaScript/Cookie"],"createTime":1745385238925,"updateTime":1752402057670,"linkedCards":[]},"meta":{"type":"card","publishTime":1752402057670},"links":{"card:567":{"key":"card:567","type":"card","id":567}}}