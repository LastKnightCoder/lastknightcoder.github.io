670d05fb3f","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"模块代码仅在第一次导入时被解析","type":"formatted"}],"collabId":"9be31d52-6f32-4302-9910-4bb1669152a6","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"顶层模块代码应该用于初始化，创建模块特定的内部数据结构","type":"formatted"}],"collabId":"8db0e819-b8ef-4c48-8ec8-8ecdea5027a4","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"f3f08fa9-d1aa-4a51-b2d0-00ef11915fb5","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"如果我们需要多次调用某些东西 —— 我们应该将其以函数的形式导出","type":"formatted"}],"collabId":"b9f08544-fe23-44a0-8b43-22f4a11ac908","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"5e4ee944-0f00-4f44-b6cf-0f6a8948c8b1","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"cbce14c7-51f8-4e1e-bc92-2551652be3f0","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// 📁 1.js \nimport { admin } from './admin.js'; \nadmin.name = \"Pete\"; \n// 📁 2.js \nimport { admin } from './admin.js'; \nalert(admin.name); // Pete\n// 1.js 和 2.js 引用的是同一个 admin 对象 \n// 在 1.js 中对对象做的更改，在 2.js 中也是可见的_","collabId":"d08fea8c-6270-45a6-8a9e-9e043f8e9d58","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"0d0e525a-90d1-4074-af64-5de58d36a486","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"99670be1-9ba8-49c7-b8cf-8ca9d3df0d79"},{"children":[{"text":"因为该模块只执行了一次。生成导出，然后这些导出在导入之间共享","type":"formatted"}],"collabId":"95f5d3be-705d-4487-b2d0-e7cc4ee5dcd6","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"178bc76b-fe0c-4371-863d-b5eaa9cd4b2b","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"import.meta","type":"formatted"},{"text":"：","type":"formatted"},{"code":true,"text":"import.meta","type":"formatted"},{"text":" 对象包含关于当前模块的信息","type":"formatted"}],"collabId":"ab9cafe2-4556-49ec-8a96-0909449f7734","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"在浏览器环境中，它包含当前脚本的 URL","type":"formatted"}],"collabId":"6c44097d-9a23-4a98-8ac3-481a0dc181ea","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"a7aa3956-cc4d-4794-a4a7-2e0af4dcd387","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"如果它是在 HTML 中的话，则包含当前页面的 URL","type":"formatted"}],"collabId":"8b8471f0-9663-41cd-845d-1660cfcecbf1","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"f07cec97-ec09-4aec-8f46-8b453c066f65","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"9faf58d8-caef-4ef7-b520-dbda4d97fa00","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"collabId":"e597facc-ad60-41f6-91e9-aa9c374c7fef","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"在模块中，","type":"formatted"},{"code":true,"text":"this","type":"formatted"},{"text":" 是 ","type":"formatted"},{"code":true,"text":"undefined","type":"formatted"}],"collabId":"2c05ea0f-cc24-41d0-8429-5a931c61a183","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<script> \n  alert(this); // window \n</script> \n<script type=\"module\"> \n  alert(this); // undefined \n</script>","collabId":"9351d31f-edd5-42e2-b3cf-5b7a6192229d","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"883c96f6-b8bc-4120-ad04-6428a4ea92d8","language":"html","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b0a59f98-98e0-4f6c-91d0-3d5b5b8088a0"}],"collabId":"28837cd8-265c-4047-b9f5-54f560c75df0","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"e008b8b7-5fd6-46e8-af2f-d0f924f3b488","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"tags":["JavaScript"],"createTime":1689174285646,"updateTime":1793532516781,"linkedCards":[]},"meta":{"type":"card","publishTime":1793532516781}}