{"version":1,"key":"card:672","content":{"id":672,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"当表单数据构造完成后，如正常提交表单发送网络请求前或者调用 "},{"type":"formatted","text":"new FormData(form)","code":true},{"type":"formatted","text":" 的时候，会触发 "},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":" 事件，常利用该事件在表单提交前将拦截并修改数据。在此之前，我们会添加一个隐藏的 "},{"type":"formatted","text":"<input hidden />","code":true},{"type":"formatted","text":" 元素来同步数据，在提交时可作为表单数据一并提交，现在我们有一种更加优雅的方式来修改表单数据。"}],"disableDrag":false},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"只要能正常触发表单提交，就可以触发此事件："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"点击提交按钮，触发表单提交"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"form.requestSubmit()","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"form.submit()","type":"formatted","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"new FormData(form)","code":true}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"必须传入 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 元素作为参数，否则不会触发 "},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":" 事件"}]}]}]},{"type":"callout","calloutType":"info","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果监听 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件并在其中调用了 "},{"type":"formatted","text":"event.preventDefault()","code":true},{"text":"来阻止表单提交，那么就不会构建表单数据，自然也不会触发 ","type":"formatted"},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":" 事件，这在 SPA 应用很常见，因为不希望页面进行跳转，而是通过手动发送网络请求来提交数据，这个时候可以通过 "},{"type":"formatted","text":"new FormData(form)","code":true},{"type":"formatted","text":" 来触发 "},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":" 事件。"}],"disableDrag":false}]},{"type":"paragraph","children":[{"type":"formatted","text":"事件触发时，可在事件对象上的 "},{"type":"formatted","text":"formData","code":true},{"type":"formatted","text":" 中获取到提交的表单数据或修改表单"}],"disableDrag":false},{"type":"code-block","code":"form.addEventListener('formdata', (event) => {\n  // event.formData 包含表单的所有数据\n  const formData = event.formData;\n\n  // 遍历 FormData 内容\n  for (const [key, value] of formData.entries()) {\n    console.log(`${key}: ${value}`);\n  }\n});","language":"JavaScript","uuid":"5bdd7306-c242-400a-8f12-066b4c05e482","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"修改表单数据"}],"disableDrag":false},{"type":"code-block","code":"form.addEventListener('formdata', (event) => {\n  const formData = event.formData;\n\n  // 1. 修改字段值 - 用户名转小写\n  const username = formData.get('username');\n  formData.set('username', username.toLowerCase());\n\n  // 2. 格式化邮箱\n  const email = formData.get('email');\n  formData.set('email', email.trim().toLowerCase());\n\n  // 3. 清理手机号\n  const phone = formData.get('phone');\n  formData.set('phone', phone.replace(/[\\s-]/g, ''));\n\n  // 4. 删除敏感字段\n  formData.delete('password');\n  formData.delete('confirmPassword');\n\n  // 5. 合并多选值\n  const hobbies = formData.getAll('hobbies');\n  formData.delete('hobbies');\n  formData.set('hobbies', hobbies.join(','));\n});","language":"JavaScript","uuid":"86e046ab-9650-46f7-8a6f-742a2eb86551","children":[{"type":"formatted","text":""}],"isFold":false},{"type":"paragraph","children":[{"type":"formatted","text":"将自定义组件的数据参与表单提交"}],"disableDrag":false},{"type":"code-block","code":"<form id=\"reviewForm\">\n  <label>\n    产品名称\n    <input type=\"text\" name=\"productName\" value=\"无线蓝牙耳机\" required>\n  </label>\n  <label>\n    评分\n    <div class=\"star-rating\" id=\"starRating\" data-name=\"rating\" data-value=\"0\">\n      <span class=\"star\" data-value=\"1\">★</span>\n      <span class=\"star\" data-value=\"2\">★</span>\n      <span class=\"star\" data-value=\"3\">★</span>\n      <span class=\"star\" data-value=\"4\">★</span>\n      <span class=\"star\" data-value=\"5\">★</span>\n    </div>\n  </label>\n  <label>\n    标签（输入后按 Enter 添加）\n    <div class=\"tag-input-container\" id=\"tagInput\" data-name=\"tags\">\n      <span class=\"tag\">音质好 <span class=\"remove\">×</span></span>\n      <span class=\"tag\">续航长 <span class=\"remove\">×</span></span>\n      <input type=\"text\" class=\"tag-input\" placeholder=\"添加标签...\">\n    </div>\n  </label>\n  <label>\n    评价内容\n    <textarea name=\"content\" rows=\"3\">这款耳机音质非常棒，降噪效果也很好，值得推荐！</textarea>\n  </label>\n  <button type=\"submit\">提交评价</button>\n</form>","language":"HTML","uuid":"8d6eab48-c9b8-4654-8799-ae0346a12c45","children":[{"type":"formatted","text":""}],"isFold":false},{"type":"code-block","code":"reviewForm.addEventListener('formdata', (e) => {\n  const formData = e.formData;\n\n  // 添加星级评分\n  formData.append('rating', starRating.dataset.value || '0');\n\n  // 添加标签\n  const tags = getTags();\n  formData.append('tags', JSON.stringify(tags));\n});","language":"JavaScript","uuid":"bf700175-a6ca-4b4b-a589-0baeb0442ae9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"在 "},{"type":"formatted","text":"submit","code":true},{"type":"formatted","text":" 事件中阻止默认行为，通过 "},{"type":"formatted","text":"new FormData(form)","code":true},{"type":"formatted","text":" 触发 "},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":" 事件，并通过 "},{"type":"formatted","text":"fetch","code":true},{"type":"formatted","text":" 发送网络请求提交数据"}],"disableDrag":false},{"type":"code-block","code":"form.addEventListener('submit', async (e) => {\n  e.preventDefault();\n\n  // 创建 FormData 会触发 formdata 事件\n  const formData = new FormData(form);\n  \n  fetch(\"/api/data\", {\n    method: \"POST\",\n    body: formData\n  })\n});\n\nform.addEventListener('formdata', (e) => {\n  const formData = e.formData;\n\n  // 添加客户端信息\n  formData.append('clientTime', new Date().toISOString());\n  formData.append('pageUrl', window.location.href);\n\n  // 添加防重复提交的 token（实际应用中应该是服务器生成的）\n  formData.append('submitToken', 'token_' + Math.random().toString(36).substr(2, 9));\n});","language":"JavaScript","uuid":"f9e72d89-1e9f-4a64-9507-1140564454d0","children":[{"type":"formatted","text":""}],"isFold":false}],"tags":["HTML/form","JavaScript/表单"],"createTime":1769086001268,"updateTime":1774969875113,"linkedCards":[]},"meta":{"type":"card","publishTime":1774969875113}}