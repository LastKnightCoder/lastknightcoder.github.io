{"version":1,"key":"card:512","content":{"id":512,"content":[{"type":"header","children":[{"type":"formatted","text":"从视频中提取音频"}],"level":2},{"type":"code-block","code":"ffmpeg -i <input video> -vn -c:a mp3 <output audio>","language":"shell","uuid":"5ab980f7-fc05-4c57-b956-69f9c51cf54f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"示例："}],"disableDrag":false},{"type":"code-block","code":"ffmpeg -i input.mpt -vn -c:a mp3 output.mp3","language":"shell","uuid":"e8e1d459-db3c-4edd-a9b2-c313349cb6ed","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"参数解释："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-vn","code":true},{"type":"formatted","text":" 表示 no video"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-c:a","code":true},{"type":"formatted","text":" 表示 "},{"type":"formatted","text":"codec of audio","code":true},{"type":"formatted","text":"，后面跟的是音频的编码格式，可以指明为 "},{"type":"formatted","text":"copy","code":true},{"type":"formatted","text":"，表示和视频中音频的编码相同，这样就不会设计音频的编解码，速度会很快，当然可以指定输出音频格式，这里就指明了输出格式为 mp3"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"b:a","code":true},{"type":"formatted","text":" 可以指定音频的码率 "},{"type":"formatted","text":"-b:a 128k","code":true},{"type":"formatted","text":"，表示音频的码率是 "},{"type":"formatted","text":"128kb/s","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-ar","code":true},{"type":"formatted","text":" 可指定音频的采样频率，"},{"type":"formatted","text":"-ar 44k","code":true},{"type":"formatted","text":" 指定音频的采样频率为 "},{"type":"formatted","text":"44kHz","code":true}],"disableDrag":false}]}]}]}]},{"type":"header","children":[{"type":"formatted","text":"从视频中仅提取视频"}],"level":2},{"type":"code-block","code":"ffmpeg -i input.mp4 -an -c:v copy output.mp4","language":"shell","uuid":"9a2cad4c-d9c2-4a29-8a42-b78034a15377","children":[{"type":"formatted","text":""}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-an","code":true},{"type":"formatted","text":" 表示 no audio"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-c:v","code":true},{"type":"formatted","text":" 表示 codec for video"}],"disableDrag":false}]}]},{"type":"header","children":[{"type":"formatted","text":"合并视频和音频"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"合并视频和音频，以合并 B 站的视频和音频为例："}],"disableDrag":false},{"type":"code-block","code":"ffmpeg -i video.mp4 -i audio.m4a -c:a copy -c:v copy o.mp4","language":"sh","uuid":"a5f925d0-85d9-4b6b-835e-037745a79bd5","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"参数见上。"}],"disableDrag":false},{"type":"header","children":[{"type":"formatted","text":"截取音频"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"截取音频的某一段，示例："}],"disableDrag":false},{"type":"code-block","code":"ffmpeg -i input.mp3 -ss 00:01:00 -t 00:00:10 output.mp3","language":"shell","uuid":"2afbb02d-7b10-409b-9dbf-9db23dcbe2dd","children":[{"type":"formatted","text":""}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-ss 00:01:00","code":true},{"type":"formatted","text":": 开始时间（这里是从 1 分钟开始）。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"-t 00:00:30","code":true},{"type":"formatted","text":": 持续时间（这里是 30 秒）。"}],"disableDrag":false}]}]}],"tags":["技巧/ffmpeg","ffmpeg"],"createTime":1731821501064,"updateTime":1752405561887,"linkedCards":[]},"meta":{"type":"card","publishTime":1752405561887}}