{"version":1,"key":"card:570","content":{"id":570,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"new","code":true},{"type":"formatted","text":" 一个对象具体做了什么："}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"基于构造器原型创建一个对象"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"调用构建器方法，并将创建的对象作为内部 "},{"type":"formatted","text":"this","code":true},{"type":"formatted","text":" 值"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"根据返回结果返回对象"}]}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"手写实现"}]},{"type":"code-block","code":"const newObj = (constructor, ...rest) => {\n  const obj = Object.create(constructor.prototype);\n  const res = constructor.apply(obj, rest);\n  if (res !== null && (typeof res === 'object' || typeof res === 'function')) {\n    return res;\n  }\n  return obj;\n}","language":"JavaScript","uuid":"ec14a688-fdde-4e83-823a-d6b127dacbb4","children":[{"type":"formatted","text":""}]}],"tags":["JavaScript","面试题"],"createTime":1744727330768,"updateTime":1744727355991,"linkedCards":[]},"meta":{"type":"card","publishTime":1744727355991}}