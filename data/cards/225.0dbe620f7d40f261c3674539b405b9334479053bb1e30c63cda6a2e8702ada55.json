ldren":[{"type":"formatted","code":true,"text":"values"},{"type":"formatted","text":" 是所有值的集合，"},{"type":"formatted","code":true,"text":"keys"},{"type":"formatted","text":" 是所有键的集合，数组和 "},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 没有键，对于数组来说，键就是下标，对于 "},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 来说，键与值相同；"},{"type":"formatted","code":true,"text":"entries"},{"type":"formatted","text":" 是键值对的集合。三个函数的返回值均是带有 "},{"type":"formatted","code":true,"text":"Symbol.iterator"},{"type":"formatted","text":" 字段的对象，因此可以使用 "},{"type":"formatted","code":true,"text":"for ... of"},{"type":"formatted","text":" 进行遍历。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ce9a3594-dcf4-4696-a2eb-8bcde9197b3a","children":[{"type":"formatted","text":"定义如下集合"}]},{"type":"code-block","language":"JavaScript","uuid":"21d4d7ca-9efa-4a39-bee6-5f36368e11a5","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"5d4578da-180d-4466-a5ef-f4c96fcc81bf","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let arr = [\"red\", \"green\", \"blue\"];\n\nlet set = new Set([\"Alice\", \"Bob\"]);\n\nlet map = new Map();\nmap.set(\"Chinese\", 88);\nmap.set(\"Math\", 98);\nmap.set(\"English\", 59);","collabId":"34d80545-89fd-41b5-9a6b-e6d9fea675a3","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9344f807-db38-477d-a1d4-69a642fe9b46","children":[{"type":"formatted","code":true,"text":"values"}]},{"type":"code-block","language":"JavaScript","uuid":"31164f10-c344-4a50-8bf3-19443cca0fba","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"3898433e-8323-479a-a785-81c9036e1991","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"for(let value of arr.values()) {\n    console.log(value); // red\n                        // green\n                        // blue\n}\n\nfor(let value of set.values()) {\n    console.log(value); // Alice\n                        // Bob\n}\n\nfor(let value of map.values()) {\n    console.log(value); // 88\n                        // 98\n                        // 59","collabId":"91ef288e-e80f-4956-a8ad-7b9fe95082eb","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"01366331-b9cf-4673-a3c5-39250ab1e315","children":[{"type":"formatted","code":true,"text":"keys"}]},{"type":"code-block","language":"JavaScript","uuid":"0ade6d0c-0897-4fb4-b50a-7ee4eed0769e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"491027d4-6630-4a7b-8aea-30e0170ab5f2","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"for (let key of arr.keys()) {\n  console.log(key); // 0\n                    // 1\n                    // 2\n}\n\nfor (let key of set.keys()) {\n  console.log(key); // Alice\n                    // Bob\n}\n\nfor (let key of map.keys()) {\n  console.log(key); // Chinese\n                    // Math\n                    // English\n}","collabId":"0a377a84-e775-4b30-a565-77ea578ddce6","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"679d2d51-7f2d-43b9-a3b2-326c864a848a","children":[{"type":"formatted","code":true,"text":"entries"}]},{"type":"code-block","language":"JavaScript","uuid":"f1a76185-49b3-4da5-858b-5ffedcbfc643","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a37bbdba-96b8-415b-a111-d6e28a8ad329","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"for (let entry of arr.entries()) {\n  console.log(entry); // [ 0, 'red' ]\n                      // [ 1, 'green' ]\n                      // [ 2, 'blue' ]\n}\n\nfor (let entry of set.entries()) {\n  console.log(entry); // [ 'Alice', 'Alice' ]\n                      // [ 'Bob', 'Bob' ]\n}\n\nfor (let entry of map.entries()) {\n  console.log(entry); // [ 'Chinese', 88 ]\n                      // [ 'Math', 98 ]\n                      // [ 'English', 59 ]\n}","collabId":"d33b66ca-111d-4cb2-8bbd-084b07cadd6f","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"591e16cd-93eb-4bcb-8068-41fd25f18f4e","children":[{"type":"formatted","text":"数组、"},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 与 "},{"type":"formatted","code":true,"text":"Map"},{"type":"formatted","text":" 它们本身也是可以使用 "},{"type":"formatted","code":true,"text":"for ... of"},{"type":"formatted","text":" 迭代的，说明它们都是有 "},{"type":"formatted","code":true,"text":"Symbol.iterator"},{"type":"formatted","text":" 字段的，对于数组和 "},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 来说，它们的 "},{"type":"formatted","code":true,"text":"Symbol.iterator"},{"type":"formatted","text":" 与 "},{"type":"formatted","code":true,"text":"values"},{"type":"formatted","text":" 相同，对于 "},{"type":"formatted","code":true,"text":"Map"},{"type":"formatted","text":" 来讲，它们的 "},{"type":"formatted","code":true,"text":"Symbol.iterator"},{"type":"formatted","text":" 与 "},{"type":"formatted","code":true,"text":"entries"},{"type":"formatted","text":" 相同"}]},{"type":"code-block","language":"JavaScript","uuid":"1f0692e0-0ced-4357-95f5-915765944ac1","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId"