{"version":1,"key":"card:364","content":{"id":364,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"git revert 的用法。"}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"它是什么"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"恢复到指定的 commit"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"工作原理"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"通过反向应用新建一个 commit，使得这个 commit 的内容与指定的 commit 相同，这样做可以保留历史记录，特别是在多人协作的项目。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如何使用"}],"disableDrag":false},{"type":"code-block","code":"git revert <commit>","language":"Bash","uuid":"954670b3-acae-4939-9f59-7ce42cbf808b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"仅对暂存区和工作区应用反向操作，但是不会创建一个新的 commit"}],"disableDrag":false},{"type":"code-block","code":"git revert --no-commit <commit>","language":"Bash","uuid":"1b614f46-5c2c-4c5c-8c4c-ea90e4930769","children":[{"type":"formatted","text":""}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"参考："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://www.atlassian.com/git/tutorials/undoing-changes/git-revert","openEdit":false,"children":[{"type":"formatted","text":"Git Revert"}]},{"text":"","type":"formatted"}],"disableDrag":false}]}]}],"tags":["Git"],"createTime":1697639726090,"updateTime":1744953947854,"linkedCards":[]},"meta":{"type":"card","publishTime":1744953947854}}