80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"use std::io;\n\nfn main() {\n    let mut a = String::new();\n    let mut b = String::new();\n\n    io::stdin().read_line(&mut a).expect(\"Failed to read a\");\n    let a = a.trim().parse::<u8>().expect(\"Failed to parse a\");\n    io::stdin().read_line(&mut b).expect(\"Failed to read b\");\n    let b = b.trim().parse::<u8>().expect(\"Failed to parse b\");\n\n    let c = a + b;\n\n    println!(\"{}\", c);\n}","collabId":"82fef046-1773-4c75-ac98-ae44ef73939f","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"cc3d0994-dfc4-4fab-827b-a3efcaccbb16","language":"rs","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"164988ef-7aa9-4f9f-af60-ec53ca383076"},{"children":[{"text":"在调试模式下，会报如下错误","type":"formatted"}],"collabId":"fb4baa4e-a821-4554-af18-1e16e37b3458","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"> .\\target\\debug\\overflow.exe  \n255\n1\nthread 'main' panicked at src\\bin\\overflow.rs:12:13:\nattempt to add with overflow\nnote: run with `RUST_BACKTRACE=1` environment variable to display a backtrace","collabId":"2c201d74-281f-4d85-a8c7-8e3bb541a2c9","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e13f0988-772c-45a2-ac05-5f703eeb13e7","language":"rs","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"c28459c1-e7ce-4a03-9342-46084270db1a"},{"children":[{"text":"在发布模式下，会发生环绕","type":"formatted"}],"collabId":"f10599ce-3e4a-4ef4-b3ab-46e703c3f80c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"> .\\target\\release\\overflow.exe\n255\n1\n0","collabId":"d76a3aa7-42a1-4821-9221-8ff7039bfaf9","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"519b7a84-9fa6-4bd2-8ca4-81258deb43f5","language":"rs","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"eac94e0d-2b48-4a50-bf04-37e893e67ec0"},{"children":[{"text":"虽然在发布模式下没有报错，但是这种行为大概率是我们不希望的，如果希望显式的进行环绕，可以使用标准库中的 ","type":"formatted"},{"code":true,"text":"Wrapping","type":"formatted"},{"text":" 类型。","type":"formatted"}],"collabId":"1e1fe3a0-40a1-4357-ab87-c781914a2e47","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"01932049-5327-442f-8c10-56667ca987be","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","title":"注意","type":"callout"},{"children":[{"text":"Rust 是一个强类型的语言，不同类型的值不能赋值，你不能把其它类型的整数赋给其它类型的整数。","type":"formatted"}],"collabId":"11413963-e9e4-4b7b-bbe9-3c6987013ead","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"在声明变量时可以指定类型，通过 ","type":"formatted"},{"code":true,"text":"let 变量名: 类型","type":"formatted"},{"text":" 语法来指定变量类型，如","type":"formatted"}],"collabId":"5e56bf41-4b38-49ed-bef7-b5ac013e6f28","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"let a: i8 = 2;","collabId":"2c9db774-07c4-406b-b387-51322c4ea15c","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"045e0662-0f60-46ae-ac88-c04ac3ea39fd","language":"rust","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"0df95d24-1684-4c02-86c6-5c0d50a74efe"},{"children":[{"text":"如果不声明类型，则会根据后续的使用来推断类型，如果无法推断类型，整数会被默认推断为 ","type":"formatted"},{"code":true,"text":"i32","type":"formatted"},{"text":"。","type":"formatted"}],"collabId":"ce71dd06-b896-4e02-89ed-24a351f2e64d","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"浮点数","type":"formatted"}],"collabId":"0f950c7b-0f56-4e5f-8052-06cb95eee7da","contentId":340,"contentTitle":"","contentType":"card","refId":402,"tauContract":"720a42c66441f65bfc897253311b73deb687a68a60da46dffe8c7b8537a65760","type":"content-link"},{"text":"只有两种类型，分别为 ","type":"formatted"},{"code":true,"text":"f32","type":"formatted"},{"text":" 与 ","type":"formatted"},{"code":true,"text":"f64","type":"formatted"},{"text":"，顾名思义，分别表示以 ","type":"formatted"},{"code":true,"text":"32","type":"formatted"},{"text":" 位比特和 ","type":"formatted"},{"code":true,"text":"64","type":"formatted"},{"text":" 位比特，","type":"formatted"},{"code":true,"text":"64","type":"formatted"},{"text":" 位的浮点数在范围和精度上都比 ","type":"formatted"},{"code":true,"text":"32","type":"formatted"},{"text":" 位的高，但是在现代计算机中，二者的计算效率几乎一致，因此我们通常使用 ","type":"formatted"},{"code":true,"text":"f64","type":"formatted"},{"text":" 来表示浮点数。","type":"formatted"}],"collabId":"085c23b3-97c5-4dad-9ea6-387036758493","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"如果创建浮点数变量时没有声明类型，若无法通过使用推断类型，则默认为 ","type":"formatted"},{"code":true,"text":"f64","type":"formatted"},{"text":"。","type":"formatted"}],"collabId":"f5ebe0a1-df7c-47ae-98a3-4b3cc8066433","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"字符","type":"formatted"}],"collabId":"2284ffb7-7529-4185-8fe3-c21fddac6668","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"code":true,"text":"char","type":"formatted"},{"text":" 表示单个的字符，它使用四个字节来表示一个字符，","type":"formatted"},{"children":[{"text":"是一个 Unicode 标量值，","type":"formatted"}],"collabId":"84128513-9883-484d-b87b-88c2c08bfe57","color":"red","colorSelectOpen":false,"lineType":"solid","tauContract":"88d9b3835432080ad1c02f70cd42c22df8b46febe5e2b08b10394f654a84380a","type":"underline"},{"text":"因此所有的字符都可以通过它表示，它的字面值使用单引号包裹","type":"formatted"}],"collabId":"c0542c7a-aa71-4310-ae8d-3252d82f6f87","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"let c = '🌰';","collabId":"5761ec6c-7710-4441-83fd-10b72ea3e60a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2e008e89-10ae-44b4-b184-6ffe6d32083b","language":"rust","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"653d74fc-0006-4e2d-a59a-30e6cd8e0725"},{"calloutType":"info","children":[{"children":[{"code":true,"text":"char","type":"formatted"},{"text":" 使用四个字节表示，但是字符串中的字符使用的是 UTF-8 编码，并不一定使用四个字节表示，需要注意二者的区别。","type":"formatted"}],"collabId":"8b1a5545-04be-4e4e-8470-30d271d88291","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"07ee639e-a1f3-4c7c-a6da-8c47fd4ae993","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","title":"","type":"callout"},{"children":[{"text":"布尔","type":"formatted"}],"collabId":"81249ead-6f4f-425e-9a70-f78209efe49c","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"布尔类型的值表示真假，它只有两种取值，","type":"formatted"},{"code":true,"text":"true","type":"formatted"},{"text":" 或者 ","type":"formatted"},{"code":true,"text":"false","type":"formatted"},{"tex