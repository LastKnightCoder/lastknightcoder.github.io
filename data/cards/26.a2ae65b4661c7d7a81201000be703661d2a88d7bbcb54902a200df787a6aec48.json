pe":"formatted"},{"code":true,"text":"i8","type":"formatted"},{"text":" 就表示有符号整数，使用 ","type":"formatted"},{"code":true,"text":"8","type":"formatted"},{"text":" 个比特表示这个整数。","type":"formatted"}],"collabId":"5c636cb7-f4d1-4cb2-b2ea-00e5dfb001e5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"以 ","type":"formatted"},{"children":[{"text":"n","type":"formatted"}],"collabId":"d38d244e-76f8-4d4b-9ee8-a7432759336d","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n","type":"inline-math"},{"text":"表示位数，来看能表示的整数范围，","type":"formatted"},{"code":true,"text":"in","type":"formatted"},{"text":" 能表示的范围在 ","type":"formatted"},{"children":[{"text":"[-2^{(n-1)}, 2^{n - 1} - 1]","type":"formatted"}],"collabId":"3bd146e2-6548-4b4c-9275-85cf90a1ed10","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[-2^{(n-1)}, 2^{n - 1} - 1]","type":"inline-math"},{"text":"，","type":"formatted"},{"code":true,"text":"un","type":"formatted"},{"text":" 表示的范围在 ","type":"formatted"},{"children":[{"text":"[0, 2^{n} - 1]","type":"formatted"}],"collabId":"e52b42a8-f694-4953-9a12-522ce6dfd070","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[0, 2^{n} - 1]","type":"inline-math"},{"text":"，比如 ","type":"formatted"},{"code":true,"text":"i8","type":"formatted"},{"text":" 表示的范围在 ","type":"formatted"},{"children":[{"text":"[-128, 127]","type":"formatted"}],"collabId":"f4a3b178-fbb0-4795-8d74-281d9e014199","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[-128, 127]","type":"inline-math"},{"text":"，","type":"formatted"},{"code":true,"text":"u8","type":"formatted"},{"text":" 表示的范围在 ","type":"formatted"},{"children":[{"text":"[0, 255]","type":"formatted"}],"collabId":"ca968a46-5819-4fb2-91e7-0c9b74e4dabf","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce90