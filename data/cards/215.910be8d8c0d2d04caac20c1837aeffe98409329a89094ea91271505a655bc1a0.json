{"version":1,"key":"card:215","content":{"id":215,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3995d902-74c3-40d6-b37a-4bb95e7c0d13","children":[{"type":"formatted","code":true,"text":"Array.from"},{"type":"formatted","text":" 方法的作用是将一个类数组转化为真正的数组，例如将 "},{"type":"formatted","code":true,"text":"arguments"},{"type":"formatted","text":" 转化为真正的数组"}]},{"type":"code-block","language":"JavaScript","uuid":"76ec8a44-d30c-4943-a2d0-7ca19217ed0e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f5854cde-31d1-405b-81cc-cf43acffae98","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function translateArray() {\n  const arr = Array.from(arguments);\n  console.log(arr);\n}\n\ntranslateArray(1, 2); // [ 1, 2 ]","collabId":"76c7e806-f27f-4eac-a258-48f55b049bb6","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"28f992e1-e60e-4156-9fbd-5014863c1846","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"24c78984-86bc-4591-9418-a95d490d8f44","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const arrayLike = {\n  length: 2,\n  0: \"Hello\",\n  1: \"World\"\n}\n\nconsole.log(Array.from(arrayLike)); // [ 'Hello', 'World' ]","collabId":"216f9023-6631-4893-ab80-0270cd08f4b7","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"131b5391-7cf2-4f1a-b2c4-9c1f751898d8","children":[{"type":"formatted","text":"也可以将一个可迭代的对象转化为真正的数组"}]},{"type":"code-block","language":"JavaScript","uuid":"aaf260b4-4349-497c-b877-fb20020fcf0b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"86b63c1c-d377-490c-a6d1-4bdef69eea60","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const obj = {\n  *[Symbol.iterator]() {\n    yield 1;\n    yield 2;\n    yield 3;\n  },\n};\n\nconst arr = Array.from(obj);\n\nconsole.log(arr);                  // [ 1, 2, 3 ]\nconsole.log(arr instanceof Array); // true","collabId":"e2d4364e-9d64-4830-aef7-2dc6bba02809","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"fda14c25-8d69-49c5-9e77-468830c0e83d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6a9571ee-ae28-4782-9335-4846cf5a1b43","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const set = new Set([1, 2, 3, 4, 5]);\nconst arr = Array.from(set);\n\nconsole.log(arr); // [ 1, 2, 3, 4, 5 ]","collabId":"923ab6fd-507b-4799-bb37-7996a71ff080","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"f1779da3-8c12-46e0-ab73-92f0c5c2cdc2","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c2b89352-15f4-4e65-a47d-39700bc6e862","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const map = new Map([\n  [\"a\", 100],\n  [\"b\", 50]\n]);\n\nconst arr = Array.from(map);\n\nconsole.log(arr); // [ [ 'a', 100 ], [ 'b', 50 ] ]","collabId":"31746757-740a-4474-99b1-8bc7a8fd0bf3","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1f662105-bd16-4aab-9c0f-38a2b07f1924","children":[{"type":"formatted","code":true,"text":"Array.from"},{"type":"formatted","text":" 的第二个参数还可以接收一个回调函数，类似于 "},{"type":"formatted","code":true,"text":"map"},{"type":"formatted","text":" 函数"}]},{"type":"code-block","language":"JavaScript","uuid":"919f9374-f840-45d8-9f0d-8eb4e4b15a95","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"85bbb40c-1119-43e3-882e-2693436afdd8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function translateArray() {\n  return Array.from(arguments, (item) => item + 1);\n}\n\nlet numbers = translateArray(1, 2);\nconsole.log(numbers); // [ 2, 3 ]","collabId":"d4dd54e1-aceb-4ce2-86f6-b51dad943abd","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1b42769f-16ba-4c90-a95b-d84b3edba17a","children":[{"type":"formatted","text":"如果在回调函数中需要用到 "},{"type":"formatted","code":true,"text":"this"},{"type":"formatted","text":" 的话，也可以通过第三个参数传入 "},{"type":"formatted","code":true,"text":"this"},{"type":"formatted","text":"。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"75f7f731-1dd9-4e5f-803c-29b8ea224873","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"38e2ffb5-3d0a-4f29-aa6f-27225f89c5b2","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c0e2ae05-c05b-4c83-bb1f-72881d5fe764","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"41ed614a-8762-4481-9ac7-aa9c4b9acab8","children":[{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/from","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"fda8c8da-8e62-4c5c-b162-95db9d395014","children":[{"type":"formatted","text":"MDN Array.from()"}]}]}]}]}],"tags":["JavaScript"],"createTime":1690707662562,"updateTi