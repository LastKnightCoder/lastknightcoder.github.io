bf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"当不设置 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 或者设置 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 为空字符串时，等效于设置了 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 为 ","type":"formatted"},{"code":true,"text":"text","type":"formatted"},{"text":"。","type":"formatted"}],"collabId":"58a1a0b4-8192-4ccd-aae6-7193122c2adf","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"86118e3e-b0de-4ff3-b6af-2138101890a3","color":"blue","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","type":"highlight-block"},{"children":[{"text":"起一个简单的后端服务，准备三个接口：","type":"formatted"}],"collabId":"980dee81-c12e-46b3-9195-7e38153f2a88","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"code":true,"text":"/text","type":"formatted"},{"text":"：返回普通的文本字符串","type":"formatted"}],"collabId":"9d2f705f-4692-4d18-aea2-8ec3c24104f7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"3f556fa1-c415-43ef-84fd-bf9982ee1262","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"/json","type":"formatted"},{"text":"：返回 JSON 字符串","type":"formatted"}],"collabId":"5b92e3f7-5bb0-4b8b-bb00-71af2969afce","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"02ea9236-bc97-4992-b616-2e91904f0515","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"/xml","type":"formatted"},{"text":"：返回 XML 字符串","type":"formatted"}],"collabId":"1fd36add-f124-4d52-a6ec-3ead077f2cbb","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"9663430a-91ef-465e-b859-3360914f49d9","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"a16c39a7-4c75-4bd3-905b-b14277007f20","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"import Koa from 'koa';\nimport cors from '@koa/cors';\nimport Router from '@koa/router';\n\nconst app = new Koa();\n\nconst router = new Router();\n\nrouter.get('/text', async (ctx) => {\n  ctx.body = \"Hello World!😥🐟\";\n});\n\nrouter.get('/json', async (ctx) => {\n  ctx.body = {\n    name: \"Alice\"\n  }\n});\n\nrouter.get('/xml', async (ctx) => {\n  ctx.body = `<div>Hello World!</div>`\n});\n\napp\n  .use(cors())\n  .use(router.routes())\n  .use(router.allowedMethods())\n  .listen(3000);","collabId":"072308d9-9d0d-48f4-b0b3-6c32807e76b1","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"90860d4c-ac99-47c0-a1c5-4d7258062bc0","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b23e3cae-d99c-41dd-aaa1-319f7353e113"},{"children":[{"text":"通过指定不同的 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 来同时访问这三个接口，查看结果","type":"formatted"}],"collabId":"e4e8f45d-45ae-4cc3-8e9f-10762c28657f","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const api = '/text';\n\n['text', 'json', 'document', 'arraybuffer', 'blob'].forEach(responseType => {\n  const xhr = new XMLHttpRequest();\n  \n  xhr.responseType = responseType;\n  \n  xhr.open('GET', `http://localhost:3000${api}`);\n  \n  xhr.addEventListener('load', () => {\n    console.log('responseType: ', responseType, ', response: ', xhr.response);\n  });\n  \n  xhr.send();\n})","collabId":"112ebd18-53a5-46bf-a4c6-36e0cdc81ddf","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"7c1a10f0-abef-4360-a2a0-8797afd044e7","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"9d09839a-684e-426c-b152-140c9725e424"},{"children":[{"children":[{"children":[{"text":"访问 ","type":"formatted"},{"code":true,"text":"/text","type":"formatted"},{"text":" 接口","type":"formatted"}],"collabId":"9bf80d4e-a9fc-415c-9c13-ca88b5c33796","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"85f561a2-9148-4fac-a823-303633498bae","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a81f4f90-6ae0-40c4-ab1e-c9312c8203c3.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a81f4f90-6ae0-40c4-ab1e-c9312c8203c3.png","width":619.5},{"children":[{"text":"对于 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 为 ","type":"formatted"},{"code":true,"text":"text","type":"formatted"},{"text":" 的请求，其结果被解析为了字符串，对于 ","type":"formatted"},{"code":true,"text":"json","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":" 类型的请求，由于返回结果无法解析，所以统统解析为了 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":"，对于 ","type":"formatted"},{"code":true,"text":"arraybuffer","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"blob","type":"formatted"},{"text":" 则解析为了对于的二进制数据。","type":"formatted"}],"collabId":"17847ba3-c7e6-46fe-a2bc-83b8f7206e0c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"2531ef84-195d-48ff-9086-f8aa5d40d6fb","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"访问 ","type":"formatted"},{"code":true,"text":"/json","type":"formatted"},{"text":" 接口","type":"formatted"}],"collabId":"46f357ec-629a-4fee-9089-2c36969599d5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"6154f539-6516-4f0c-b8ca-60c28fdc0076","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_863aa82c-dad0-4860-ba48-9f07650daa4d.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_863aa82c-dad0-4860-ba48-9f07650daa4d.png","width":620},{"children":[{"text":"对于 ","type":"formatted"},{"code":true,"text":"text","type":"formatted"},{"text":"，不做任何解析，只是将数据转化为了字符串；对于 ","type":"formatted"},{"code":true,"text":"json","type":"formatted"},{"text":"，将数据转化为了 JavaScript 对象，对于 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":"，无法解析，因此结果是 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":"，对于 ","type":"formatted"},{"code":true,"text":"arraybuffer","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"blob","type":"formatted"},{"text":"，则转化为了相应的二进制数据。","type":"formatted"}],"collabId":"149f1bb3-f890-4a3c-b4e0-cba7ff998f2f","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"4e471c99-379d-4f6d-925a-99c3433621f7","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"访问 ","type":"formatted"},{"code":true,"text":"/xml","type":"formatted"},{"text":" 接口","type":"formatted"}],"collabId":"420c16d0-dbe2-4101-8e62-3d0c0d14956f","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"fd414928-b8fa-4bb3-b64a-1760fdeac99c","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_f9957c97-0dc2-4c4a-850b-f6046162813f.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_f9957c97-0dc2-4c4a-850b-f6046162813f.png","width":620},{"children":[{"text":"对于 ","type":"formatted"},{"code":true,"text":"text","type":"formatted"},{"text":"，将结果转化为了字符串，对于 ","type":"formatted"},{"code":true,"text":"json","type":"formatted"},{"text":"，无法解析，结果为 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":"，对于 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":"，可以解析，于是将结果转化为了一个 DOM 对象，对于 ","type":"formatted"},{"code":true,"text":"arraybuffer","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"blob","type":"formatted"},{"text":" 则是转化为了相应的二进制对象。","type":"formatted"}],"collabId":"7859eb92-5f50-423f-a329-7eaea79323c0","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"e4a84633-8ad5-4041-ad3c-d13fadcd4f63","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"9dd22e84-9c6d-40ef-9e49-921c17681db5","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"},{"children":[{"text":"除了可以通过 ","type":"formatted"},{"code":true,"text":"xhr.response","type":"formatted"},{"text":" 访问到请求结果，还可以通过 ","type":"formatted"},{"code":true,"text":"xhr.responseText","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"xhr.responseXML","type":"formatted"},{"text":" 来访问到返回结果，它们两个的值和 ","type":"formatted"},{"code":true,"text":"xhr.response","type":"formatted"},{"text":" 的值是一样的，不同的是仅当 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 为 ","type":"formatted"},{"code":true,"text":"text","type":"formatted"},{"text":" 时，才可以访问 ","type":"formatted"},{"code":true,"text":"xhr.responseText","type":"formatted"},{"text":"，否则会抛出异常；同理，只有当 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 为 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":" 时，才可以访问 ","type":"formatted"},{"code":true,"text":"xhr.responseXML","type":"formatted"},{"text":"，否则也会抛出异常；而 ","type":"formatted"},{"code":true,"text":"xhr.response","type":"formatted"},{"text":" 无论 ","type":"formatted"},{"code":true,"text":"responseType","type":"formatted"},{"text":" 的取值是什么都可以访问，不会抛出异常。","type":"formatted"}],"collabId":"13ff2012-58e3-4da8-8d05-70961904ed21","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"tags":["JavaScript"],"createTime":1704197961211,"updateTime":1793532523861,"linkedCards":[]},"meta":{"type":"card","publishTime":1793532523861}}