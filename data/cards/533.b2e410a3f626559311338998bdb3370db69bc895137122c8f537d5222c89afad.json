e":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ddfc0f6d-6d53-400d-9bf1-b5d24192e1e4","children":[{"type":"formatted","text":"能面对面了解我们的人最多只有两位数，其他人对我们的了解都来自于口碑。打造好口碑很重要，但是靠的是真诚和专业，而不是伪装和表演"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b95e0f3c-d068-4cb1-af14-169fb74f3635","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e03314c1-c0b0-44a1-a62b-b3b9dd08d667","children":[{"type":"formatted","text":"不可能让所有人满意，但对事不对人，同时避免背后议论他人"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e53e713e-debd-4103-80d5-2c2c59f39899","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e44ecedd-6f80-498e-83d0-9e50b9c6c84d","children":[{"type":"formatted","text":"避免零和博弈，追求双赢，并且最多只占 49%。扩大蛋糕，而不是争夺已有资源，长期来看，不要成为总占便宜的人，否则最终会影响团队的信任和合作意愿"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7c45fe08-3d6f-4d64-874e-9b70de6a6724","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"42edb692-720a-4249-99fe-8c1cba0dbc18","children":[{"type":"formatted","text":"来自没有利益关系的合作伙伴的肯定更有说服力"}]}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6a64233a-2550-47e0-aba4-9e1b879e4edc","children":[{"type":"formatted","text":"参考："},{"type":"link","url":"https://juejin.cn/post/7425497083753529378","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"cfb0c333-5bbc-449d-91f9-4ef97580fde2","children":[{"type":"formatted","text":"90后程序员的职业成长漫谈"}]}]}],"tags":["职场"],"createTime":1743323780536,"updateTime":1761990861310,"linkedCards":[]},"meta":{"type":"card","publishTime":1761990861310}}