{"version":1,"key":"card:525","content":{"id":525,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f78181cf-68ec-49f2-a5e7-b2918870776b","children":[{"type":"formatted","text":"思维导图布局实现，如下"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_53be9308-8054-404b-aec5-e998ed49d14a.png","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_53be9308-8054-404b-aec5-e998ed49d14a.png","width":530.3779899578421,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"dd86ad20-0434-4b71-a357-d2e816c9c97d","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6b428c60-711b-471e-b001-32cf3b8130d5","children":[{"type":"formatted","text":"简单考虑，只考虑向右展开的布局。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0546ebed-10d4-4739-9e6b-ffd3b31d4b04","children":[{"type":"formatted","text":"已经条件，知道根节点的位置 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"(\\text{rootX}, \\text{rootY})","collabId":"5cdbfe48-87bb-42bc-bf97-cc60651dad56","children":[{"type":"formatted","text":"(rootX, rootY)"}]},{"type":"formatted","text":"，以及所有节点的大小（宽高），求其他节点的位置 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"(x, y)","collabId":"71a71a7d-ee34-4b79-b075-14fcedbebfa8","children":[{"type":"formatted","text":"(x, y)"}]},{"type":"formatted","text":"。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a5a9b5c0-5c11-4c34-9471-885bc6249ae8","children":[{"type":"formatted","text":"首先看子节点的 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x","collabId":"890109d3-704a-4c11-8df9-0302dc1123c4","children":[{"type":"formatted","text":"x"}]},{"type":"formatted","text":" 和父节点 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{parentX}","collabId":"17c65092-1c67-4ba0-91f3-efd4a6919644","children":[{"type":"formatted","text":"parentX"}]},{"type":"formatted","text":" 的关系，非常简单，子节点在父节点右侧的 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{marginX}","collabId":"d59a4d24-c27c-457c-887a-f00644cd86c3","children":[{"type":"formatted","text":"MARGIN_X"}]},{"type":"formatted","text":" 处，即"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{childX} = \\text{parentX} + \\text{parentWidth} + \\text{marginX}","collabId":"986787c4-6ea2-494b-b231-656661f11457","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c91185d6-8395-47c6-9f0d-d7e5a89affab","children":[{"type":"formatted","text":"对于子节点的 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y","collabId":"ebed92fe-9c47-49a0-be0c-47c7baaa6e74","children":[{"type":"formatted","text":"y"}]},{"type":"formatted","text":" 的计算就比较复杂了，考虑下图"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/%E6%80%9D%E7%BB%B4%E5%AF%BC%E5%9B%BE_7e5d1ca0-d7fa-4440-8f59-632e6de9f689.png","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/%E6%80%9D%E7%BB%B4%E5%AF%BC%E5%9B%BE_7e5d1ca0-d7fa-4440-8f59-632e6de9f689.png","width":618,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"471db7c4-c74f-4dcc-97c7-c38ce4eac93c","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2bfb94d5-8e25-440a-8d83-943b042ad1ce","children":[{"type":"formatted","text":"在知道父元素的位置和宽高的情况下以及所有子节点总体高度的情况下，计算所有子节点整体的 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y","collabId":"de5fa175-b156-48a1-b709-1f5f2abc80f7","children":[{"type":"formatted","text":"y"}]},{"type":"formatted","text":"，在 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y","collabId":"aec05732-1361-49b3-b1cc-b2c06d4543d3","children":[{"type":"formatted","text":"y"}]},{"type":"formatted","text":" 方向上要满足一个关系，就是"},{"type":"formatted","color":"#245bdb","darkColor":"#70a0ff","bold":true,"text":"父节点和子节点整体是居中对齐的"},{"type":"formatted","text":"，即满足"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{parentY} + \\dfrac{\\text{parentHeight}}{2} = \\text{childrenY} + \\frac{\\text{childrenHeight}}{2}","collabId":"1c17d18a-b10e-4d3a-80d0-92fc18863b0f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5aa178ae-d1c5-4722-a133-9cd9fa62bbfe","children":[{"type":"formatted","text":"可以得到"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{childrenY} = \\text{parentY} + \\dfrac{\\text{parentHeight}}{2} - \\frac{\\text{childrenHeight}}{2}","collabId":"58c11497-c3fa-4902-a319-42ecaff8588e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"94fbf83a-3c65-4a63-9899-3ca479cbc646","children":[{"type":"formatted","text":"在知道总体的一个位置之后，计算单个子节点的位置就很简单了，比如对于第 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i","collabId":"7d3a1b90-4075-406e-810b-68d51ae363a3","children":[{"type":"formatted","text":"i"}]},{"type":"formatted","text":" 个子节点，它离顶部的距离就是之前所有节点的实际高度加上所有间距"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{child[i].childrenTop} = \\sum_{\\text{index} = 0}^{i - 1}\\text{child[index].actualHeight} + (i - 1) \\times \\text{marginY} ","collabId":"12cbb408-c272-4093-bc95-e6b92d742034","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"97057be1-50c7-47aa-b5a7-081e90b61808","children":[{"type":"formatted","text":"但是这里还需要做一个调整，这里计算的是这个节点占据区域的整体位置，有可能这个节点的高度小于占据的高度，我们还需要将这个节点居中"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{child.top = child.childrenTop} + \\frac{\\text{child.actualHeight - child.height}}{2}","collabId":"2ea38397-539a-470c-ba70-6d5595a06e3e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"692c5fe1-ce3f-4dde-aada-4711c09f5d1e","children":[{"type":"formatted","text":"上面我们假设 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{childrenHeight}","collabId":"745c11c4-3935-4b6d-8a7a-ff951e089747","children":[{"type":"formatted","text":"childrenHeight"}]},{"type":"formatted","text":" 是已知的，但实际上是需要计算的，当然很好算，就是所有子节点的占据的高度之和加上所有的间距，注意，这里占据的高度和节点的 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{height}","collabId":"f833e169-e29f-4cdb-b0f1-982db32baebe","children":[{"type":"formatted","text":"height"}]},{"type":"formatted","text":" 值并不相等，一个节点占据的高度("},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{actualHeight}","collabId":"56a549fa-3fea-443b-a2b1-847b265e7c3a","children":[{"type":"formatted","text":"actualHeight"}]},{"type":"formatted","text":")的计算方法是"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{node.actualHeight} = \\max(\\text{node.height}, \\text{node.childrenHeight}))","collabId":"b5d3c09a-9b2e-44c1-ac89-bd25811e5940","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8c2978ba-d021-43d6-b260-ed9fab5b01c3","children":[{"type":"formatted","text":"所有 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{childrenHeight}","collabId":"37ca1b74-16d0-4f6c-9750-c714f71716bd","children":[{"type":"formatted","text":"childrenHeight "}]},{"type":"formatted","text":" 的计算为"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{node.childrenHeight} = \\sum_{i}^{n}\\text{children[i].actualHeight} + (n - 1) \\times \\text{marginY}","collabId":"71043a91-670b-4a23-abbb-c2ba422f80f9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"da6d3bcd-1496-4007-a065-f513ebb5b848","children":[{"type":"formatted","text":"需要两次遍历，第一次遍历计算 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x","collabId":"d15b195c-8b49-4bbc-8f39-3ba6e11f84d2","children":[{"type":"formatted","text":"x"}]},{"type":"formatted","text":"、"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{childrenHeight}","collabId":"b2f6684b-294e-421d-9acb-c2d09204e981","children":[{"type":"formatted","text":"childrenHeight"}]},{"type":"formatted","text":" 和 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\text{actualHeight}","collabId":"6386786c-932a-4032-819f-60a6f688bc3c","children":[{"type":"formatted","text":"actualHeight"}]},{"type":"formatted","text":"，第二次遍历计算 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"y","collabId":"fb8f768b-96fb-4755-9abc-304e7f233e03","children":[{"type":"formatted","text":"y"}]},{"type":"formatted","text":"，可以参考以下代码"}]},{"type":"code-block","language":"TypeScript","uuid":"b3e2046e-0823-48f9-ac23-59ca9eab4573","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"ece4cf74-2dfc-4017-b2e8-6101a5322584","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const MARGIN_X = 36;\nconst MARGIN_Y = 16;\n\nconst dfs = (node: MindNodeElement, {\n    before,\n    after,\n  }, parent: MindNodeElement | null = null, index = 0) => {\n    before?.(node, parent, index);\n    node.children.forEach((child, index) => {\n      this.dfs(child, {\n        before,\n        after,\n      }, node, index);\n    });\n    after?.(node, parent, index);\n  }\n\nconst layout = (node: MindNodeElement): MindNodeElement => {\n  this.dfs(draft, {\n    before: (node, parent) => {\n      if (parent) {\n        node.x = parent.x + parent.width + MARGIN_X;\n      }\n    },\n    after: (node) => {\n      if (node.children.length > 0) {\n        node.childrenHeight = node.children.reduce((pre, cur) => {\n          return pre + cur.actualHeight;\n        }, 0) + (node.children.length - 1) * MARGIN_Y;\n        node.actualHeight = Math.max(node.childrenHeight, node.height);\n      } else {\n        node.actualHeight = node.height;\n        node.childrenHeight = 0;\n      }\n    }\n  })\n\n  this.dfs(draft, {\n    before: (node, parent, index) => {\n      if (!parent) return;\n\n      const baseY = parent.y + parent.height / 2 - parent.childrenHeight / 2;\n      const beforeSiblings = index > 0 ? parent.children.slice(0, index) : [];\n      const siblingsHeight = beforeSiblings.reduce((pre, cur) => {\n        return pre + cur.actualHeight;\n      }, 0) + beforeSiblings.length * MARGIN_Y;\n\n      const childrenTop = baseY + siblingsHeight;\n      node.y = childrenTop + (node.actualHeight - node.height) / 2;\n    }\n  })\n}","collabId":"16ab461d-cbff-469f-a23d-73939ea16d2a","children":[{"type":"formatted","text":""}]}]},{"type":"file-attachment","uuid":"6cedfb53-ded0-444e-b06a-378403dd247c","filePath":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/%E6%80%9D%E7%BB%B4%E5%AF%BC%E5%9B%BE_462b476f-f3e7-4ca8-af8e-975e8640882d.drawio","fileName":"思维导图.drawio","isLocal":false,"tauContract":"89aa894266f6e253ffbdedd0cc0a4a78aebef19ced0ac860aad598ee9423cca7","collabId":"23f5ea62-6d48-4d42-b8c4-089d403c36e0","children":[{"type":"formatted","text":""}]}],"tags":["算法"],"createTime":1740350218720,"updateTime":1764293036040,"linkedCards":[]},"meta":{"type":"card","publishTime":1764293036040}}