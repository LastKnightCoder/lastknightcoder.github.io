de":true,"text":"nodeValue"},{"type":"formatted","text":"："},{"type":"formatted","code":true,"text":"null"}]}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c5b0e2df-8f43-4b32-b601-fbc9a3c73f6b","children":[{"type":"formatted","text":"一般将 "},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 当做一个仓库来使用，将要添加到文档树中的节点先添加到 "},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 中，因为如果大批量的向文档树种添加节点时，如果一个个像浏览器添加节点，就会导致浏览器反复渲染，如果我们将节点先添加到 "},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 中，然后在将 "},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 添加到文档树中，"},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 会将它包含的节点一次性添加到文档树("},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 并不会被添加到文档树中)，这样可以提高浏览器的性能。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a65e7125-624e-46af-aaff-480390092cfb","children":[{"type":"formatted","text":"有下面的一个 "},{"type":"formatted","code":true,"text":"ul"},{"type":"formatted","text":" 节点"}]},{"type":"code-block","language":"html","uuid":"8cee9648-6040-4873-8326-2c32eb60a44f","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e9d33af9-95e8-49ee-a61b-cc3807d675bf","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<ul id=\"list\"></ul>","collabId":"6cf2632c-38dc-4a6a-ba32-2c9ddc1ed1d0","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7b47964a-1ad2-48f9-be96-5a748a5209ab","children":[{"type":"formatted","text":"我们需要将下面的节点添加到 "},{"type":"formatted","code":true,"text":"ul"},{"type":"formatted","text":" 中"}]},{"type":"code-block","language":"html","uuid":"d17379eb-5c9c-4a20-b730-d62df37ba611","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8fdc6ac3-63ba-406d-82db-bc1f7661709e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<li>item1</li>\n<li>item2</li>\n<li>item3</li>","collabId":"49ddf79c-bf74-4da5-af49-fe8b31355a23","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8c9e8a30-c4a0-481e-a2fa-772ad229931b","children":[{"type":"formatted","text":"我们可以先将 "},{"type":"formatted","code":true,"text":"li"},{"type":"formatted","text":" 元素添加到一个 "},{"type":"formatted","code":true,"text":"DocumentFragment"},{"type":"formatted","text":" 中，然后在添加到文档数中，如下"}]},{"type":"code-block","language":"JavaScript","uuid":"43c12f10-abae-45a2-8d48-5be94580d11e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e9314aae-5f02-4812-8adc-8e6684f080de","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let ul = document.getElementById(\"list\");\n// 创建一个 DocumentFragment\nlet fragment = document.createDocumentFragment();\n\nfor (let i = 0; i < 3; i++) {\n  let li = document.createElement(\"li\");\n  li.appendChild(document.createTextNode(\"item\" + (i + 1)));\n  fragment.appendChild(li);\n}\n\nul.appendChild(fragment);","collabId":"065e7b46-73d6-4971-9936-79f1ea55fedb","children":[{"type":"formatted","text":""}]}]}],"tags":["DOM"],"createTime":1690699489187,"updateTime":1743303640410,"linkedCards":[{"id":198,"target":{"key":"card:198","type":"card","id":198},"summary":"DOM 定义了一个 Node 类型的接口，DOM 树上的节点都实现了该类型，因此所有的节点都有着 Node 接口中规定的属性和方法。 虽然 HTML 元素以及文本内容都会被转化为节点，但是明显 document 节点，HTML 元素节点，以...","tags":["DOM"]}]},"meta":{"type":"card","publi