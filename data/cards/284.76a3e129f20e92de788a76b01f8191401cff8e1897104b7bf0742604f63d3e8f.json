{"version":1,"key":"card:284","content":{"id":284,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d5c4d4f3-bd6b-4229-bf10-e4f37c4ab236","children":[{"type":"formatted","text":"可以在类的 "},{"type":"formatted","code":true,"text":"contructor"},{"type":"formatted","text":" 方法中访问 "},{"type":"formatted","code":true,"text":"new.target"},{"type":"formatted","text":"，通过 "},{"type":"formatted","code":true,"text":"new.target"},{"type":"formatted","text":" 可以构造一个抽象类，所谓的抽象类，指的就是不能被 "},{"type":"formatted","code":true,"text":"new"},{"type":"formatted","text":" 出实例的类，它只能被继承"}]},{"type":"code-block","language":"js","uuid":"f6b72dfa-88da-43c7-bcd3-6c608dd95649","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"756b7be7-7cb5-4fac-a392-8f70192924bb","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"class Shape {\n  constructor(name) {\n    if (new.target === Shape) {\n      throw new Error(\"Can't be called by new!\");\n    }\n  }\n}\n\nclass Rectangle extends Shape {\n  constructor(name, width, height) {\n    super(name);\n    this.width = width;\n    this.height = height;\n  }\n}\n\n// Error: Can't be called by new!\nconst rec = new Shape(\"长方形\");","collabId":"500e60d6-ee4f-4c0d-b8ff-b162d0b40058","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"19ede7a6-7b99-488e-ad04-60994461b5d7","children":[{"type":"formatted","code":true,"text":"Shape"},{"type":"formatted","text":" 类是一个抽象类，它不能通过 "},{"type":"formatted","code":true,"text":"new"},{"type":"formatted","text":" 来实例化，上面当我们 "},{"type":"formatted","code":true,"text":"new Shape"},{"type":"formatted","text":" 时，会抛出一个错误。"}]}],"tags":["JavaScript/类"],"createTime":1692113048474,"updateTime":1744036230694,"link