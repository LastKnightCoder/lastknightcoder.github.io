{"version":1,"key":"card:520","content":{"id":520,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"人体的免疫系统是抵抗病原体的防御机制，由两部分组成："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"先天性免疫系统"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"适应性免疫系统"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"先天性免疫系统指的是与生俱来的防御机制，可以快速的识别多种病原体，防御机制包括："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"物理和化学屏障"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"皮肤、黏膜"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"胃酸、溶菌酶、抗菌肽"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"细胞防御"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"中性粒细胞"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"巨噬细胞"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"NK 细胞"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"可溶性分子"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"补体系统"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"细胞因子"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"炎症反应和发热"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"炎症"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"发热"}],"disableDrag":false}]}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"适应性免疫系统是后天习得的、高度特异性的防御机制，能够对特定病原体进行精准打击，主要防御机制包括："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"体液免疫，B 细胞分泌抗体"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"细胞免疫，T 细胞激活吞噬细胞，杀死被细菌感染的细胞"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"初次感染后，部分 T 细胞和 B 细胞分化为记忆细胞，下次遇到相同的病原体时，会迅速激活。适应性免疫系统初次响应需要数天，再次响应只需数小时。"}],"disableDrag":false}],"tags":["生物/免疫学"],"createTime":1740096444240,"updateTime":1755938760329,"linkedCards":[]},"meta":{"type":"card","publishTime":1755938760329}}