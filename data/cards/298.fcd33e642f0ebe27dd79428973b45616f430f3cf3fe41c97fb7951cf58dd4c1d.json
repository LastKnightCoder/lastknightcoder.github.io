{"version":1,"key":"card:298","content":{"id":298,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"339482b3-1c7a-4b7f-98cb-2d92f718f235","children":[{"type":"formatted","code":true,"text":"Promise.race"},{"type":"formatted","text":" 方法接收一个 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 组成的数组，返回一个 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":"，当数组中有任一 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 的状态变为 "},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 或者 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":"，返回的 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 就会相应的变为 "},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 或 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":"。正如 "},{"type":"formatted","code":true,"text":"race"},{"type":"formatted","text":" 所暗示的，是多个 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 在竞争，最终选择最快的那个"}]},{"type":"code-block","language":"js","uuid":"7ac0a221-46ec-41d6-ac03-e897ea0d505d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"765aa10a-ad7d-4d29-8ee2-46474a23e46e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const promise1 = new Promise((resolve, reject) => {\n  setTimeout(() => {\n    resolve(1);\n  }, 1000);\n});\n\nconst promise2 = Promise.resolve({\n  then(resolve, reject) {\n    setTimeout(() => {\n      resolve(2);\n    }, 2000);\n  },\n});\n\n// promise1 会率先执行 resolve，所以得到的结果是promise1 传递的结果\nPromise.race([promise1, promise2]).then((data) => {\n  console.log(data); // 1\n});","collabId":"d2772a0d-99db-42ba-b067-b2297ccee462","children":[{"type":"forma