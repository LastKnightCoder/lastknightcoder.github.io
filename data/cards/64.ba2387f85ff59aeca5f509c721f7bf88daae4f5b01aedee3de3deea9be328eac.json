{"version":1,"key":"card:64","content":{"id":64,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fe950a2e-b86e-4e9c-90a0-b3634ae52788","children":[{"type":"formatted","text":"Linux 使用文件描述符标识文件，非负整数。前三个文件描述符保留（0，1，2）"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"1b241b2f-dd9c-4470-a563-c7dd27c2602f","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"87886998-6d04-43ec-89db-ddb44c11ff34","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dc26ecc1-6d70-4811-8adb-00f6faca393a","children":[{"type":"formatted","text":"0：标准输入，STDIN"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f0803c23-b3e1-4671-95c2-408fb5246194","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f985f783-ab9a-4f6e-96d6-3b84db9bb358","children":[{"type":"formatted","text":"1：标准输出，STDOUT"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b3c278e4-a4c1-4599-8e97-aad746b41a2a","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ff964fa8-b489-4e3b-b0c0-d43614e68120","children":[{"type":"formatted","text":"2：标准错误，STDERR"}]}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"df9163ad-6ecd-4ac6-809c-beb42daa6595","children":[{"type":"formatted","text":"标准输入：键盘输入。"},{"type":"formatted","code":true,"text":"<"},{"type":"formatted","text":" 会重定向指定文件来替换标准输入，读取文件获得输入，就像是从键盘上输入的。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e1e09931-4542-4264-99df-ec7c28491d0f","children":[{"type":"formatted","text":"标准输出：显示器。大多数命令将输出导向标准输出。错误输出和普通输出是分开的，"},{"type":"formatted","code":true,"text":">"},{"type":"formatted","text":" 只能重定向普通输出。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b26fa29c-579e-44c1-83a4-dc027afabc36","children":[{"type":"formatted","text":"标准错误：默认 STDOUT 和 STDERR 会输出到同一位置，虽然文件描述符不同。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"46be9b24-484d-4eb6-aa8b-4e2a48f8d147","children":[{"type":"formatted","text":"重定向错误 "},{"type":"formatted","code":true,"text":"2>"},{"type":"formatted","text":"，"},{"type":"formatted","bold":true,"text":"紧紧挨着"},{"type":"formatted","text":"。"}]},{"type":"code-block","language":"bash","uuid":"f553cf9f-e17d-49fc-9e39-91c4229a8bc8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c97bc0f8-1e31-416a-8a7e-c0ad9cded15e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"xt in ~ λ ls -l dasda\nls: cannot access 'dasda': No such file or directory\nxt in ~ λ ls -l dasda 2> err.txt\nxt in ~ λ cat err.txt\nls: cannot access 'dasda': No such file or directory","collabId":"ba083a7a-f507-4a60-bb79-c01e15768c25","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"181e7927-f95d-4af8-8e73-2ee97a705cf1","children":[{"type":"formatted","text":"同时重定向标准输出和标准错误："}]},{"type":"code-block","language":"bash","uuid":"cd2f9053-f98f-4613-8263-0335688e3407","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7dd316ff-3458-4cd0-8a53-3f966dfe7ee1","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"xt in ~/tmp λ ls\nhello.md  qq\n\n\n# 默认都输出在屏幕\nxt in ~/tmp λ ls -l hello.md bb\nls: cannot access 'bb': No such file or directory\n-rw-r--r-- 1 xt xt 0 Dec 21 21:24 hello.md\n\n\n# 标准输出重定向到 stdout，标准错误重定向到 stderr\nxt in ~/tmp λ ls -l hello.md bb 1> stdout 2> stderr\n\n\nxt in ~/tmp λ cat stdout\n-rw-r--r-- 1 xt xt 0 Dec 21 21:24 hello.md\nxt in ~/tmp λ cat stderr\nls: cannot access 'bb': No such file or directory","collabId":"cf298fa3-47ff-4d0f-90bc-3b99c69bbcca","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5445a52a-527f-482d-8f71-521df1e2b039","children":[{"type":"formatted","text":"标准输出和错误都输出在一个文件中，通过 "},{"type":"formatted","code":true,"text":"&>"}]},{"type":"code-block","language":"bash","uuid":"94e33393-a650-431a-b572-8c9df9935846","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"741e8a04-56f1-4d10-ac17-0e07594abab9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 都输出到 common 文件\nxt in ~/tmp λ ls -l hello.md bb &> common\n# 查看文件内容\nxt in ~/tmp λ cat common\nls: cannot access 'bb': No such file or directory\n-rw-r--r-- 1 xt xt 0 Dec 21 21:24 hello.md","collabId":"5add46c8-ad2e-443f-ac9d-bc522dec1f1b","children":[{"type":"formatted","text":""}]}]}],"tags":["Shell编程/重定向"],"createTime":1689084796225,"updateTime":1743303640388,"linkedCards":[{"id":65,"target":{"key":"card:65","type":"card","id":65},"summary":"临时重定向 # 输出临时重定向到标准错误 echo \"This is a error\" >&2 在文件描述符前面添加 & 就是临时重定向 #!/bin/zsh echo \"This is a error.\" >&2 echo \"This n...","tags":["Shell编程/重定向"]},{"id":68,"target":{"key":"card:68","type":"card","id":68},"summary":"Linux Shell 最多可以有 9 个文件描述符，其他 6 个 3~9 可用于重定向，可将其任一个分配给文件。 # 创建输出重定向 exec 3> out echo \"Hello World.\" >&3 echo \"Hi.\" >&3 #...","tags":["Shell编程/重定向"]}]},"meta":{"type":"card","publishTime":1743303640388}}