ract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<input id=\"fileInput\" type=\"file\" />","collabId":"ee1bbb80-98ac-4db2-9647-93390636b282","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"js","uuid":"0456a6d1-2d42-436b-ad54-eeee1be8a781","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e95004b2-93c7-4132-b281-2ff48875ac06","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const input = document.getElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n  // file.name 文件名称\n  // file.size 文件大小\n  // file.path 文件路径\n  // file.type 文件 MIME TYPE（如果存在的话）\n  // file.lastModified 文件最后更改时间（时间戳）\n  // file.lastModifiedDate 文件最后更改时间（对象）\n});","collabId":"a6afe918-b992-4661-bfaa-42de653e8938","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"46664a75-c609-42a4-9c65-4bf91946c573","children":[{"type":"formatted","text":"有时候浏览器默认的样式较丑，我们会将 "},{"type":"formatted","code":true,"text":"input"},{"type":"formatted","text":" 隐藏"}]},{"type":"code-block","language":"html","uuid":"b156e810-04c8-4d45-b664-2c5451af46fd","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"80517abd-bfa6-44d7-9b29-10209542b954","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<input id=\"inputFile\" type=\"file\" style=\"display: none;\" />\n<button id=\"btn\">上传文件</button>","collabId":"6b25a9ed-a20a-4fbf-81e5-4565fa1ba94a","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"js","uuid":"b8b05f8f-1bde-4a34-ab1e-1938e93fcc51","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5d