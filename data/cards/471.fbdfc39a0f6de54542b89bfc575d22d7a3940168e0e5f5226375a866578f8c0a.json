unt += 1\n        return super().__getattribute__(name)\n\ns = Stats()\ns.name = \"Alice\"\nprint(s.name)    # 访问属性时记录访问次数\nprint(s._count)  # 输出: 1","collabId":"5935f326-1135-46e3-bbf5-3b9d40e5bebc","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"88204d31-443e-447c-bd5c-ed955172c0f5","children":[{"type":"formatted","text":"相比 "},{"type":"formatted","code":true,"text":"property"},{"type":"formatted","text":"，这些魔法方法使用起来要棘手些，在可能的情况下，还是使用 "},{"type":"formatted","code":true,"text":"property"},{"type":"formatted","text":" 吧。"}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"d091c760-0bc5-49ce-903b-a1f3bd244a69","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1a3b632e-8cb4-461d-9ec3-13d98929e44b","children":[{"type":"formatted","text":"编写 "},{"type":"formatted","code":true,"text":"__getattribute__"},{"type":"formatted","text":" 需要避开无限循环陷阱。由于它拦截对所有属性的访问（在新式类中），因此将拦截对 "},{"type":"formatted","code":true,"text":"__dict__"},{"type":"formatted","text":" 的访问！"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b976f19e-7101-488c-9639-c010eaead1a5","children":[{"type":"formatted","text":"在 "},{"type":"formatted","code":true,"text":"__getattribute__"},{"type":"formatted","text":" 中访问当前实例的属性时，唯一安全的方式是使用超类的方法 "},{"type":"formatted","code":true,"text":"__getattribute__"},{"type":"formatted","text":"（使用 "},{"type":"formatted","code":true,"text":"super"},{"type":"formatted","text":"）。"}]}]}],"tags":["Python/魔法方法"],"createTime":1719276760702,"updateTime":1791474923040,"linkedCards":[]},"meta":{"type":"card","publishTime":1791474923040}}