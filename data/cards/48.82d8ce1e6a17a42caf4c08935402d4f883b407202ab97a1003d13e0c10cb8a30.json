{"version":1,"key":"card:48","content":{"id":48,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1d6e80f3-ae1d-4c18-a84f-8b4607d8443a","children":[{"type":"formatted","text":"使用 FileReader 读取二进制文件内容，提供了不同的方法来解析提交的二进制内容"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"1741da82-2ac7-4fe0-8d62-c5ab9a82ea3c","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"efd4fd9f-d36f-43da-b62a-58dcfd908d53","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"bfd6df0d-6d52-43e3-8d15-a951494e4c83","children":[{"type":"formatted","code":true,"text":"readAsText"},{"type":"formatted","text":"：将二进制内容解析为字符串，用以读取文本文件"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"8834e8f4-0412-475f-b7b7-df4f3be8e797","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"af412f93-b591-4017-8b7e-30c2121c933f","children":[{"type":"formatted","code":true,"text":"readAsArrayBuffer"},{"type":"formatted","text":"：将文件解析为 ArrayBuffer，一般用以处理二进制文件，比如 Word、PPT 等文件"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"2c1bd8b8-14f8-402f-9397-b0c0ff93c35a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"401b414b-e71b-4b7f-8d43-3f95d93d7c1b","children":[{"type":"formatted","code":true,"text":"readAsDataURL"},{"type":"formatted","text":"：返回一个 Data URL，一般读取图片、音视频为此格式，然后作为 "},{"type":"formatted","code":true,"text":"src"},{"type":"formatted","text":" 属性的值进行展示"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"80eb18be-d798-4887-9852-86a0830e151f","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"82a071dd-fea9-4505-b43a-84e337166b53","children":[{"type":"formatted","code":true,"text":"readAsBinaryString"},{"type":"formatted","text":"：用的很少，目前还不知道有什么用"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3b74dbe1-d2d6-4a72-816f-fecb0c6c91c0","children":[{"type":"formatted","text":"读取文本："}]},{"type":"code-block","language":"JavaScript","uuid":"a4bb2f45-06e1-438c-b4e3-e0d0621aafda","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"52977fc9-4450-41a1-9fd8-2eba432c1392","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const reader = new FileReader();\nreader.addEventListener('load', () => {\n  const text = reader.result;\n  console.log(result);\n});\nreader.readAsText(file);","collabId":"ec90fce4-5fa2-433b-99cc-42a3ff4761f5","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a8047eb1-69a1-4f79-8f3c-33228c883868","children":[{"type":"formatted","text":"读取图片并显示："}]},{"type":"code-block","language":"JavaScript","uuid":"364c6397-51b9-49c4-a740-07e7963875a3","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"ce2167b8-91ca-4572-9de5-323a9344aac6","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const reader = new FileReader();\nreader.addEventListener('load', () => {\n  const imgUrl = reader.result;\n  img.src = imgUrl;\n});\nreader.readAsDataURL(file);","collabId":"5324332c-6bc9-460b-829f-6a866b14cea2","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5d86a3f4-394b-4086-b977-0fc18e5ea037","children":[{"type":"formatted","text":"读取图片并对其进行置灰，然后显示："}]},{"type":"code-block","language":"JavaScript","uuid":"dd3d6fa6-5b59-4f00-811a-86b85ccdfa53","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"fa55f01a-3d2e-4e79-89bb-36895879d27e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const inout = document.getElementById('fileInput')\ninout.addEventListener('change', (e) => {\n  const file = e.target.files[0];\n  const reader = new FileReader();\n  reader.addEventListener('load', () => {\n    const image = new Image();\n    image.src = reader.result;\n    // 使用 canvas 操作图片数据\n    image.onload = () => {\n      const canvas = document.createElement('canvas');\n      const ctx = canvas.getContext('2d');\n      canvas.width = image.width;\n      canvas.height = image.height;\n      // 将图片放在画布上\n      ctx.drawImage(image, 0, 0, image.width, image.height);\n      const imageData = ctx.getImageData(0, 0, image.width, image.height);\n      const data = imageData.data;\n      // 将图片置灰\n      for (let i = 0; i < data.length; i += 4) {\n        // data[i] -> red data[i + 1] -> green data[i + 2] -> blue data[i + 4] -> alpha\n        const gray = 0.3 * data[i] + 0.59 * data[i + 1] + 0.11 * data[i + 2];\n        data[i] = gray;\n        data[i + 1] = gray;\n        data[i + 2] = gray;\n      }\n      // 将处理后的图片数据放置在画布上\n      ctx.putImageData(imageData, 0, 0);\n      document.getElementById('img').src = canvas.toDataURL();\n    }\n  });\n  \n  reader.readAsDataURL(file);\n}","collabId":"b7373940-47ea-473c-a8f7-7bddd1fe7ccd","children":[{"type":"formatted","text":""}]}]}],"tags":["JavaScript"],"createTime":1689000150840,"updateTime":1744171244922,"linkedCards":[]},"meta":{"type":"card","publishTime":1744171244922}}