ElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n});\n\n\nbtn.addEventListener('click', () => {\n  // 调起上传文件页面\n  input.click();\n})","collabId":"7cf08876-8967-43f7-9125-9d4574a48bc7","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"c76327e0-cb5d-4681-8c8b-19a8798456a3","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"a3fe35de-f215-4d4d-a6af-0eefcb092fd9"},{"children":[{"text":"拖拽也可上传文件，监听 ","type":"formatted"},{"code":true,"text":"drop","type":"formatted"},{"text":" 事件，并通过 ","type":"formatted"},{"code":true,"text":"e.dataTransfer","type":"formatted"},{"text":" 获得拖拽的文件","type":"formatted"}],"collabId":"25cc5e83-099a-4560-ba57-5bcb5d18a3ab","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<div id=\"drop\">拖拽文件至此</div>","collabId":"cc9ecd9f-6b88-4108-ad53-8fe9dd7c13de","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2f382375-5e89-4e2c-a550-3df40f924ed4","language":"html","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"022af81c-987e-4809-a0f6-c05757a1da00"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const drop = document.getEelementById(\"drop\");\ndrop.addEventListener('drop', (e) => {\n  const files = e.dataTransfer.files;\n  const file = files[0];\n})","collabId":"97f0d84b-f481-409a-b1db-872ce62b21c3","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"3b351123-9b12-409f-a7d7-f429f04eb947","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e4007