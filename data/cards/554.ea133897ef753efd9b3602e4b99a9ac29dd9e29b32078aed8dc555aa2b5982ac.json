{"version":1,"key":"card:554","content":{"id":554,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"浏览器上传文件的两种方式："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 标签"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"拖拽"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"将 "},{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 标签的 "},{"type":"formatted","text":"type","code":true},{"type":"formatted","text":" 设置为 "},{"type":"formatted","text":"file","code":true},{"type":"formatted","text":" 即可上传文件"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<input id=\"fileInput\" type=\"file\" />","uuid":"0357b26f-facf-45d7-9d36-ba84041dee22","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"js","code":"const input = document.getElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n  // file.name 文件名称\n  // file.size 文件大小\n  // file.path 文件路径\n  // file.type 文件 MIME TYPE（如果存在的话）\n  // file.lastModified 文件最后更改时间（时间戳）\n  // file.lastModifiedDate 文件最后更改时间（对象）\n});","uuid":"0456a6d1-2d42-436b-ad54-eeee1be8a781","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"有时候浏览器默认的样式较丑，我们会将 "},{"type":"formatted","text":"input","code":true},{"type":"formatted","text":" 隐藏"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<input id=\"inputFile\" type=\"file\" style=\"display: none;\" />\n<button id=\"btn\">上传文件</button>","uuid":"b156e810-04c8-4d45-b664-2c5451af46fd","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"js","code":"const btn = document.getElementById(\"btn\");\nconst input = document.getElementById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n});\n\nbtn.addEventListener('click', () => {\n  // 调起上传文件页面\n  input.click();\n})","uuid":"b8b05f8f-1bde-4a34-ab1e-1938e93fcc51","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"拖拽也可上传文件，监听 "},{"type":"formatted","text":"drop","code":true},{"type":"formatted","text":" 事件，并通过 "},{"type":"formatted","text":"e.dataTransfer","code":true},{"type":"formatted","text":" 获得拖拽的文件"}],"disableDrag":false},{"type":"code-block","language":"html","code":"<div id=\"drop\">拖拽文件至此</div>","uuid":"c01a0528-e5a5-4e68-adda-b17b4d59c7d0","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"js","code":"const drop = document.getEelementById(\"drop\");\ndrop.addEventListener('drop', (e) => {\n  const files = e.dataTransfer.files;\n  const file = files[0];\n})","uuid":"e26a2054-825b-4a84-8a23-7673fac6c9d6","children":[{"type":"formatted","text":""}]}],"tags":["技巧/文件上传","JavaScript/技巧"],"createTime":1744169739241,"updateTime":1744169821148,"linkedCards":[]},"meta":{"type":"card","publishTime":1744169821148}}