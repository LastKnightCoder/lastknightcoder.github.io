{"version":1,"key":"card:689","content":{"id":689,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"moveBefore(nodeToMove, referenceNode)","code":true},{"type":"formatted","text":" 函数的作用是把 "},{"type":"formatted","text":"nodeToMove","code":true},{"type":"formatted","text":" 插入到 "},{"type":"formatted","text":"referenceNode","code":true},{"type":"formatted","text":" 之前，"},{"type":"formatted","text":"同时保留该节点及其子节点的所有内部状态。","textGradient":"ocean"}],"disableDrag":false},{"type":"highlight-block","disableDrag":false,"children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"referenceNode","code":true},{"text":" 可以设置为 ","type":"formatted"},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":"，当设置为 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":" 时，则表示插入到目标父元素的最后。"}]}],"color":"red"},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"在此之前我们想移动节点，通常会通过 "},{"type":"formatted","text":"appendChild","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 等 DOM API 实现，但是这种插入并不是「原子」的，而是分为了两个过程，第一步先把节点从 DOM 树中移除，第二步把节点插入到相应位置，这就会导致如下问题："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"iframe","code":true},{"type":"formatted","text":" 会重新加载"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"正在进行的动画会中断"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"焦点会丢失，用户选中的文本也会丢失"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"Web Components 会触发 "},{"type":"formatted","text":"disconnectedCallback","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"connectedCallback","code":true},{"type":"formatted","text":"，这可能会导致组件内部执行不必要的清理和重新初始化逻辑"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"popover","code":true},{"type":"formatted","text":"、"},{"type":"formatted","text":"dialog","code":true},{"type":"formatted","text":" 会被关闭，其内部的焦点也会丢失，需要通过代码重新显示出来"}]}]}]},{"type":"highlight-block","color":"red","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"媒体资源（音视频）无论使用何种方式移动，它的状态都会被保留，这是浏览器内部做的优化。"}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"而 "},{"type":"formatted","text":"moveBefore","code":true},{"type":"formatted","text":" 它是一种"},{"type":"formatted","text":"「原子移动」","textGradient":"ocean"},{"type":"formatted","text":"，在移动的过程中可以保留所有的状态，这意味着以上情况都不会发生："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"iframe","code":true},{"type":"formatted","text":" 不会重新加载"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"动画会继续执行"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"焦点会继续保持在移动的元素中，选中的文字样式也会保留"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"Web Components 会触发一个 "},{"type":"formatted","text":"connectedMoveCallback","code":true},{"type":"formatted","text":" 的生命周期函数，不会触发 "},{"type":"formatted","text":"disconnectedCallback","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"connectedCallback","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"popover","type":"formatted","code":true},{"type":"formatted","text":"、"},{"type":"formatted","text":"dialog","code":true},{"type":"formatted","text":" 等元素的状态保持，不会因为移动而导致被意外关闭"}]}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"比较典型的使用场景是 React/Vue 框架中的 "},{"type":"formatted","text":"createPortal","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"Teleport","code":true},{"type":"formatted","text":"，为了防止被 CSS 的 "},{"type":"formatted","text":"overflow: hidden","code":true},{"type":"formatted","text":" 裁剪，通常会把元素插入到 "},{"type":"formatted","text":"body","code":true},{"type":"formatted","text":" 下，通过 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 或者 "},{"type":"formatted","text":"appendChild","code":true},{"type":"formatted","text":" 等 API 就会导致之前状态丢失，有了 "},{"type":"formatted","text":"moveBefore","code":true},{"type":"formatted","text":" 状态就可以得以保存。"}]},{"type":"paragraph","children":[{"type":"formatted","text":"还有拖拽排序、动态调整布局、模态框/抽屉组件的位置调整等场景，只要涉及到需要保持元素状态的 DOM 移动，都可以用 "},{"type":"formatted","text":"moveBefore","code":true},{"type":"formatted","text":"。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"下面是一些具体的代码示例："}],"disableDrag":false},{"type":"code-block","language":"JAVASCRIPT","code":"// 基本用法示例\nconst container = document.querySelector('#container');\nconst item = document.querySelector('#item');\nconst reference = document.querySelector('#reference');\n\n// 移动到 reference 之前\ncontainer.moveBefore(item, reference);\n\n// 移动到容器最后（reference 为 null）\ncontainer.moveBefore(item, null);","uuid":"3c7e3204-9445-41a1-8cb6-4ec40272ff89","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"JAVASCRIPT","code":"// 拖拽排序场景\nfunction handleDragDrop(draggedElement, dropTarget) {\n  const parent = dropTarget.parentElement;\n  // 使用 moveBefore 保持拖拽元素的所有状态\n  // 比如正在播放的视频、输入框的焦点等\n  parent.moveBefore(draggedElement, dropTarget);\n}","uuid":"33ae7b23-4b5e-4c49-bf7c-fa4c15d2eacc","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"JAVASCRIPT","code":"// 对比传统方式的问题\nconst iframe = document.querySelector('iframe');\nconst newParent = document.querySelector('#new-parent');\n\n// ❌ 传统方式：iframe 会重新加载，用户填写的表单数据丢失\nnewParent.appendChild(iframe);\n\n// ✅ 使用 moveBefore：iframe 不会重新加载，状态完整保留\nnewParent.moveBefore(iframe, null);","uuid":"7747bcd7-ca17-4fef-af2f-9bc7cc72bc8d","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"JAVASCRIPT","code":"// Web Components 中的 connectedMoveCallback\nclass MyElement extends HTMLElement {\n  connectedMoveCallback() {\n    // 元素被 moveBefore 移动时触发\n    // 可以在这里做一些轻量级的更新，而不需要重新初始化\n    console.log('元素被移动了，但状态保留');\n  }\n  \n  connectedCallback() {\n    // 使用 insertBefore/appendChild 时会触发\n    console.log('元素被插入，需要重新初始化');\n  }\n  \n  disconnectedCallback() {\n    // 使用 insertBefore/appendChild 时会先触发\n    console.log('元素被移除，需要清理资源');\n  }\n}","uuid":"dbaf9bd7-5c57-481d-b0d4-5a3c0fa116e6","children":[{"type":"formatted","text":""}]},{"type":"highlight-block","color":"yellow","children":[{"type":"paragraph","children":[{"type":"formatted","text":"moveBefore","code":true},{"type":"formatted","text":" 的使用限制和注意事项："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"移动的元素必须在页面中，即必须是 "},{"type":"formatted","text":"isConnected","code":true},{"type":"formatted","text":" 的，否则会报错，而 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 不要求必须在页面中，在内存中就可以，比如通过 "},{"type":"formatted","text":"createElement","code":true},{"type":"formatted","text":" 创建的元素"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"referenceNode","code":true},{"type":"formatted","text":" 必须是目标父节点的直接子节点，否则会抛出 "},{"type":"formatted","text":"NotFoundError","code":true}],"disableDrag":false},{"type":"code-block","language":"JAVASCRIPT","code":"slotB.moveBefore(node, referenceNode)\n//  ↑ 目标父节点         ↑ 必须是 slotB 的直接子节点","uuid":"d67543fb-76a3-479c-983c-fa645bcf49d2","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"不能跨文档移动，"},{"type":"formatted","text":"nodeToMove","code":true},{"type":"formatted","text":" 和目标父节点必须在同一个 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":" 中，否则会抛出 "},{"type":"formatted","text":"HierarchyRequestError","code":true},{"type":"formatted","text":"。如果需要跨文档移动，还是得用 "},{"type":"formatted","text":"adoptNode","code":true},{"type":"formatted","text":" + "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 的组合"}],"disableDrag":false},{"type":"code-block","language":"JAVASCRIPT","code":"// 跨文档移动的场景（比如从 iframe 中移动元素到主文档）\nconst iframe = document.querySelector('iframe');\nconst iframeDoc = iframe.contentDocument;\nconst nodeFromIframe = iframeDoc.querySelector('#some-element');\nconst mainDocContainer = document.querySelector('#container');\n\n// ❌ 错误：不能直接跨文档使用 moveBefore\n// mainDocContainer.moveBefore(nodeFromIframe, null); // 抛出 HierarchyRequestError\n\n// ✅ 正确：先用 adoptNode 把节点\"过继\"到目标文档，再插入\nconst adoptedNode = document.adoptNode(nodeFromIframe);\nmainDocContainer.insertBefore(adoptedNode, null);\n// 注意：这种方式会丢失状态，因为 adoptNode 本身就会断开连接","uuid":"927bfc7f-c156-4769-9587-1f04fc0bb5ac","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"不能移动到自己的子孙节点下，否则会抛出 "},{"type":"formatted","text":"HierarchyRequestError","code":true},{"type":"formatted","text":"，这和 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 的行为一致"}],"disableDrag":false},{"type":"code-block","language":"JAVASCRIPT","code":"// ❌ 错误：不能把父元素移动到自己的子元素下\nconst parent = document.querySelector('#parent');\nconst child = document.querySelector('#child'); // child 是 parent 的子元素\nchild.moveBefore(parent, null); // 抛出 HierarchyRequestError","uuid":"c5239dae-81fc-40e7-8e6f-794671b13d07","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果 "},{"type":"formatted","text":"nodeToMove","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"referenceNode","code":true},{"type":"formatted","text":" 是同一个节点，什么都不会发生，不会报错"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"虽然 "},{"type":"formatted","text":"moveBefore","code":true},{"type":"formatted","text":" 保留了大部分状态，但某些 CSS 相关的状态可能会受影响："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"CSS 过渡（"},{"type":"formatted","text":"transition","code":true},{"type":"formatted","text":"）可能会被打断或重新触发，取决于移动前后的样式变化"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"某些依赖于 DOM 位置的 CSS 选择器（如 "},{"type":"formatted","text":":first-child","code":true},{"type":"formatted","text":"、"},{"type":"formatted","text":":nth-child","code":true},{"type":"formatted","text":"）会重新计算"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position: sticky","code":true},{"type":"formatted","text":" 的元素可能需要重新计算粘性定位"}],"disableDrag":false}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"MutationObserver","code":true},{"type":"formatted","text":" 仍然会观察到这次移动，会触发一个 "},{"type":"formatted","text":"childList","code":true},{"type":"formatted","text":" 类型的 "},{"type":"formatted","text":"mutation","code":true},{"type":"formatted","text":" 记录，"},{"type":"formatted","text":"addedNodes","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"removedNodes","code":true},{"type":"formatted","text":" 都会包含被移动的节点，这意味着从 DOM 结构的角度看，节点确实经历了\"移除-添加\"的过程，只是状态被保留了"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"事件监听器会完整保留，包括通过 "},{"type":"formatted","text":"addEventListener","code":true},{"type":"formatted","text":" 添加的和内联的事件处理器"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"Shadow DOM 的限制：不能把 Shadow DOM 内的元素移动到 Shadow DOM 外，也不能把外部元素移动到 Shadow DOM 内（除非通过 slot），这和 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 的限制一样"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"浏览器兼容性：这是一个比较新的 API，Safari 还不支持，但是可使用 "},{"type":"formatted","text":"insertBefore","code":true},{"type":"formatted","text":" 优雅降级"}],"disableDrag":false},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_21092f12-cd79-4490-ab66-9fcbcdd7c2d1.webp","uuid":"c99c1aff-5f3f-4306-b477-6b001eb47350","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_21092f12-cd79-4490-ab66-9fcbcdd7c2d1.webp","width":650,"alt":""}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"参考："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/API/Element/moveBefore","children":[{"type":"formatted","text":"moveBefore"}]},{"text":"","type":"formatted"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://developer.chrome.com/blog/movebefore-api","children":[{"type":"formatted","text":"Chrome for Developers: Preserve state during DOM mutations with moveBefore()"}]},{"text":"","type":"formatted"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://www.zhangxinxu.com/wordpress/2026/01/insertbefore-movebefore-dom/","children":[{"type":"formatted","text":"告别 insertBefore，使用 moveBefore 移动 DOM 元素"}]},{"text":"","type":"formatted"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"text":"","type":"formatted"},{"type":"link","url":"https://caniuse.com/wf-move-before","children":[{"type":"formatted","text":"Can I Use"}]},{"text":"","type":"formatted"}]}]}]}],"tags":["DOM/moveBefore"],"createTime":1774405100763,"updateTime":1775053398448,"linkedCards":[]},"meta":{"type":"card","publishTime":1775053398448}}