{"version":1,"key":"card:119","content":{"id":119,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"如何在多个脚本中使用函数？"}]},{"type":"code-block","code":"xt in ~/shell/func λ cat math.sh\n#!/bin/zsh\n\nadd() {\n    echo $[ $1 + $2 ]\n}\n\nsub() {\n    echo $[ $1 - $2 ]\n}\n\nmul() {\n    echo $[ $1 * $2 ]\n}\n\ndiv() {\necho $[ $1 / $2 ]\n}","language":"bash","uuid":"65d65011-087f-47ff-a152-1002561ebdb2","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如何在其他脚本中使用这些函数，"},{"type":"formatted","text":"source ./math.sh","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":"source","code":true},{"type":"formatted","text":" 不会在子 shell 执行 math.sh，而是在当前 shell"}]},{"type":"code-block","code":"xt in ~/shell/func λ cat 09.sh\n#!/bin/zsh\n\nsource ./math.sh\n\nres=$(add 1 2)\necho \"1 + 2 = $res\"\n\nres=$(mul 3 4)\necho \"3 * 4 = $res\"\n\nxt in ~/shell/func λ ./09.sh\n1 + 2 = 3\n3 * 4 = 12","language":"bash","uuid":"19ba7c1d-306d-442b-be22-c8b136ddc510","children":[{"type":"formatted","text":""}]},{"type":"callout","calloutType":"tip","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"source","code":true},{"type":"formatted","text":" 可以简写为 "},{"type":"formatted","text":".","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":". ./math.sh","code":true},{"type":"formatted","text":"。"}]}]}],"tags":["Shell编程/函数"],"createTime":1689257003036,"updateTime":1743303640393,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640393}}