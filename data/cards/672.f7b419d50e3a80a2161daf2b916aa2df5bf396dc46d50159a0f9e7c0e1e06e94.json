{"version":1,"key":"card:672","content":{"id":672,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4412b07d-a8cc-4735-893e-1689b277e6a0","children":[{"type":"formatted","text":"当表单数据构造完成后，如正常提交表单发送网络请求前或者调用 "},{"type":"formatted","code":true,"text":"new FormData(form)"},{"type":"formatted","text":" 的时候，会触发 "},{"type":"formatted","code":true,"text":"formdata"},{"type":"formatted","text":" 事件，常利用该事件在表单提交前将拦截并修改数据。在此之前，我们会添加一个隐藏的 "},{"type":"formatted","code":true,"text":"<input hidden />"},{"type":"formatted","text":" 元素来同步数据，在提交时可作为表单数据一并提交，现在我们有一种更加优雅的方式来修改表单数据。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a70a8155-edc2-42e1-88dc-ae4ad1cc58ae","children":[{"type":"formatted","text":"只要能正常触发表单提交，就可以触发此事件："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"6b3ea793-23ae-47cb-ade0-52025c584657","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6119cbc7-f421-47e0-99a0-b49d617d82b8","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c018c456-353a-48b6-bce7-7e24449b1272","children":[{"type":"formatted","text":"点击提交按钮，触发表单提交"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e3836536-9007-44d9-8fe7-278207981e69","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"525fdabb-1df6-40c1-9bc0-660d8c2350f2","children":[{"type":"formatted","code":true,"text":"form.requestSubmit()"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b74f02fe-8fe6-442b-8bff-f4e1fa8e1a14","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"354403d6-2059-4c31-9ffe-551ad1aff6e9","children":[{"type":"formatted","code":true,"text":"form.submit()"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f3422416-09d9-4d15-895a-f1cc36ee83ab","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b0c16695-0982-4391-9b7b-2ead53e459e1","children":[{"type":"formatted","code":true,"text":"new FormData(form)"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"158ead0b-f2cc-47db-a4e1-7003d75d0069","children":[{"type":"formatted","text":"必须传入 "},{"type":"formatted","code":true,"text":"form"},{"type":"formatted","text":" 元素作为参数，否则不会触发 "},{"type":"formatted","code":true,"text":"formdata"},{"type":"formatted","text":" 事件"}]}]}]},{"type":"callout","calloutType":"info","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"1a5acbaf-b721-49c2-8392-74591609050d","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b56dfe24-d216-4e36-9372-3278087eade3","children":[{"type":"formatted","text":"如果监听 "},{"type":"formatted","code":true,"text":"submit"},{"type":"formatted","text":" 事件并在其中调用了 "},{"type":"formatted","code":true,"text":"event.preventDefault()"},{"type":"formatted","text":"来阻止表单提交，那么就不会构建表单数据，自然也不会触发 "},{"type":"formatted","code":true,"text":"formdata"},{"type":"formatted","text":" 事件，这在 SPA 应用很常见，因为不希望页面进行跳转，而是通过手动发送网络请求来提交数据，这个时候可以通过 "},{"type":"formatted","code":true,"text":"new FormData(form)"},{"type":"formatted","text":" 来触发 "},{"type":"formatted","code":true,"text":"formdata"},{"type":"formatted","text":" 事件。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f8216c2b-0746-4628-9f6b-48145311e813","children":[{"type":"formatted","text":"事件触发时，可在事件对象上的 "},{"type":"formatted","code":true,"text":"formData"},{"type":"formatted","text":" 中获取到提交的表单数据或修改表单"}]},{"type":"code-block","language":"JavaScript","uuid":"5bdd7306-c242-400a-8f12-066b4c05e482","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"d9cde1b4-a281-46e4-b558-90e7511bd375","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"form.addEventListener('formdata', (event) => {\n  // event.formData 包含表单的所有数据\n  const formData = event.formData;\n\n  // 遍历 FormData 内容\n  for (const [key, value] of formData.entries()) {\n    console.log(`${key}: ${value}`);\n  }\n});","collabId":"ac9baaef-ca46-47a2-b0d0-c44739a68adf","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3e4a4054-da18-40cc-a336-f59b52f01585","children":[{"type":"formatted","text":"修改表单数据"}]},{"type":"code-block","language":"JavaScript","uuid":"86e046ab-9650-46f7-8a6f-742a2eb86551","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"dcd74827-399e-444d-9f4b-5629e64ff0b7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"form.addEventListener('formdata', (event) => {\n  const formData = event.formData;\n\n  // 1. 修改字段值 - 用户名转小写\n  const username = formData.get('username');\n  formData.set('username', username.toLowerCase());\n\n  // 2. 格式化邮箱\n  const email = formData.get('email');\n  formData.set('email', email.trim().toLowerCase());\n\n  // 3. 清理手机号\n  const phone = formData.get('phone');\n  formData.set('phone', phone.replace(/[\\s-]/g, ''));\n\n  // 4. 删除敏感字段\n  formData.delete('password');\n  formData.delete('confirmPassword');\n\n  // 5. 合并多选值\n  const hobbies = formData.getAll('hobbies');\n  formData.delete('hobbies');\n  formData.set('hobbies', hobbies.join(','));\n});","collabId":"edf2181b-7227-45cd-8706-33462aa696c1","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"18487558-5791-4486-a1f0-ce801c5c7ac9","children":[{"type":"formatted","text":"将自定义组件的数据参与表单提交"}]},{"type":"code-block","language":"HTML","uuid":"8d6eab48-c9b8-4654-8799-ae0346a12c45","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cd22a5e4-2cd1-4c1e-8b19-39a472fffa90","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<form id=\"reviewForm\">\n  <label>\n    产品名称\n    <input type=\"text\" name=\"productName\" value=\"无线蓝牙耳机\" required>\n  </label>\n  <label>\n    评分\n    <div class=\"star-rating\" id=\"starRating\" data-name=\"rating\" data-value=\"0\">\n      <span class=\"star\" data-value=\"1\">★</span>\n      <span class=\"star\" data-value=\"2\">★</span>\n      <span class=\"star\" data-value=\"3\">★</span>\n      <span class=\"star\" data-value=\"4\">★</span>\n      <span class=\"star\" data-value=\"5\">★</span>\n    </div>\n  </label>\n  <label>\n    标签（输入后按 Enter 添加）\n    <div class=\"tag-input-container\" id=\"tagInput\" data-name=\"tags\">\n      <span class=\"tag\">音质好 <span class=\"remove\">×</span></span>\n      <span class=\"tag\">续航长 <span class=\"remove\">×</span></span>\n      <input type=\"text\" class=\"tag-input\" placeholder=\"添加标签...\">\n    </div>\n  </label>\n  <label>\n    评价内容\n    <textarea name=\"content\" rows=\"3\">这款耳机音质非常棒，降噪效果也很好，值得推荐！</textarea>\n  </label>\n  <button type=\"submit\">提交评价</button>\n</form>","collabId":"16fc8c87-cc26-49cd-a081-f0b542b6b7f1","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"bf700175-a6ca-4b4b-a589-0baeb0442ae9","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b58ad625-9039-4b39-942d-60ea9a64314e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"reviewForm.addEventListener('formdata', (e) => {\n  const formData = e.formData;\n\n  // 添加星级评分\n  formData.append('rating', starRating.dataset.value || '0');\n\n  // 添加标签\n  const tags = getTags();\n  formData.append('tags', JSON.stringify(tags));\n});","collabId":"c39b79d8-46b0-4e9a-952a-74f104dfc67d","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c62d7f03-c7c4-4889-9125-16f6e89757b2","children":[{"type":"formatted","text":"在 "},{"type":"formatted","code":true,"text":"submit"},{"type":"formatted","text":" 事件中阻止默认行为，通过 "},{"type":"formatted","code":true,"text":"new FormData(form)"},{"type":"formatted","text":" 触发 "},{"type":"formatted","code":true,"text":"formdata"},{"type":"formatted","text":" 事件，并通过 "},{"type":"formatted","code":true,"text":"fetch"},{"type":"formatted","text":" 发送网络请求提交数据"}]},{"type":"code-block","language":"JavaScript","uuid":"f9e72d89-1e9f-4a64-9507-1140564454d0","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2480b93d-ce9c-4f4c-b229-ec9ea237d0d5","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"form.addEventListener('submit', async (e) => {\n  e.preventDefault();\n\n  // 创建 FormData 会触发 formdata 事件\n  const formData = new FormData(form);\n  \n  fetch(\"/api/data\", {\n    method: \"POST\",\n    body: formData\n  })\n});\n\nform.addEventListener('formdata', (e) => {\n  const formData = e.formData;\n\n  // 添加客户端信息\n  formData.append('clientTime', new Date().toISOString());\n  formData.append('pageUrl', window.location.href);\n\n  // 添加防重复提交的 token（实际应用中应该是服务器生成的）\n  formData.append('submitToken', 'token_' + Math.random().toString(36).substr(2, 9));\n});","collabId":"62791294-d3e7-464c-892d-1f337f6da3a7","children":[{"type":"formatted","text":""}]}]}],"tags":["HTML/form","JavaScript/表单"],"createTime":1769086001268,"updateTime":1774969875113,"linkedCards":[]},"meta":{"type":"card","publishTime":1774969875113}}