{"version":1,"key":"card:242","content":{"id":242,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"Set 集合是一个有序的、没有重复元素的集合。通过 "},{"type":"formatted","text":"new Set()","code":true},{"type":"formatted","text":" 得到一个 "},{"type":"formatted","text":"Set","code":true},{"type":"formatted","text":" 对象，"},{"type":"formatted","text":"Set","code":true},{"type":"formatted","text":" 集合提供如下 API"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"add(item)","code":true},{"type":"formatted","text":"：向集合中添加元素 "},{"type":"formatted","text":"item","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"has(item)","code":true},{"type":"formatted","text":"：判断集合中是否有 "},{"type":"formatted","text":"item","code":true},{"type":"formatted","text":" 元素"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"delete(item)","code":true},{"type":"formatted","text":"：删除集合中的 "},{"type":"formatted","text":"item","code":true},{"type":"formatted","text":" 元素"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"clear()","code":true},{"type":"formatted","text":"：清空集合中的所有元素"}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"Set","code":true},{"type":"formatted","text":" 集合是通过 "},{"type":"content-link","children":[{"type":"formatted","text":"Object.is","code":true}],"refId":319,"contentType":"card","contentTitle":"","contentId":302},{"type":"formatted","text":" 方法来判断两个元素是否相同的，所以 "},{"type":"formatted","text":"5","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"\"5\"","code":true},{"type":"formatted","text":" 是两个不同的元素"}]},{"type":"code-block","code":"const set = new Set();\n\nset.add(5);\nset.add(\"5\");\n\nconsole.log(set.size); // 2","language":"JavaScript","uuid":"ed59ac41-d2b5-4d83-8d53-9f194d4fa584","children":[{"type":"fo