:"formatted","text":"两个盒子的上下 "},{"type":"formatted","text":"margin","code":true},{"type":"formatted","text":" 都是 "},{"type":"formatted","text":"10px","code":true},{"type":"formatted","text":"，二者会进行合并，因此两个盒子的间距是 "},{"type":"formatted","text":"10px","code":true},{"type":"formatted","text":" 而不是 "},{"type":"formatted","text":"20px","code":true},{"type":"formatted","text":"。"}],"disableDrag":false},{"type":"html-block","html":"<iframe src=\"https://lastknightcoder.github.io/frontend-demo/margin%E5%A1%8C%E9%99%B7/01.html\" width=\"100%\" height=\"250\"></iframe>","children":[{"type":"formatted","text":""}]},{"type":"divide-line","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"父子间 "},{"type":"formatted","text":"margin","code":true},{"type":"formatted","text":" 的合并是指父元素的 "},{"type":"formatted","text":"margin-top","code":true},{"type":"formatted","text":" 会与第一个孩子的 "},{"type":"formatted","text":"margin-top","code":true},{"type":"formatted","text":" 合并，父元素的 "},{"type":"formatted","text":"margin-bottom","code":true},{"type":"formatted","text":" 会与最后一个孩子的 "},{"type":"formatted","text":"margin-bottom","code":true},{"type":"formatted","text":" 进行合并"}],"disableDrag":false},{"type":"code-block","code":"<div>\n  <div class=\"box red\">BOX1</div>\n</div>\n<div style=\"outline: 2px solid #1ba78455;\">\n  <div class=\"box blue\" style=\"margin: 100px 0;\">\n    BOX2\n  </div>\n</div>\n<div>\n  <div class=\"box red\">BOX3</div>\n</div>","language":"html","uuid":"84cd762c-ce32-467a-ae97-c65c52b69a1b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"第二盒子给子孩子设置了上下 "},{"type":"formatted","text":"100px","code":true},{"type":"formatted","text":" 的外边距，然后给父元素一个 "},{"type":"formatted","text":"outline","code":true},{"type":"formatted","text":"，从 "},{"type":"formatted","text":"outline","code":true},{"type":"formatted","text":" 紧紧的包裹了子元素可以发现 "},{"type":"formatted","text":"margin","code":