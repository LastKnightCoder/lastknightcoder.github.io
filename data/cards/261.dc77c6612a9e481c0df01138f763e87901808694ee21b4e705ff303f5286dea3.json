{"version":1,"key":"card:261","content":{"id":261,"content":[{"children":[{"code":true,"text":"startsWith","type":"formatted"},{"text":" 是用来判断某个个字符串是否是该字符串的开头","type":"formatted"}],"collabId":"ce10c23a-436d-46ea-b0d7-bff40b2695d0","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const str = \"Hello World!\";\n\nconsole.log(str.startsWith(\"Hello\")); // true\nconsole.log(str.startsWith(\"World\")); // false","collabId":"c69ffee0-6d51-4663-a675-3224dd07f4ea","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"d8e1dda4-84c9-44d1-8250-35d53377be9f","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"a608adb7-699b-49e0-a46d-cc1dbbbde0af"},{"children":[{"code":true,"text":"startsWith","type":"formatted"},{"text":" 还可以接收第二个参数，用来指定开头的位置，默认是 ","type":"formatted"},{"code":true,"text":"0","type":"formatted"}],"collabId":"d7d495e1-71d3-49b7-bc1c-55207de1bc6a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const str = \"01234567\";\n\nconsole.log(str.startsWith(\"123\")); // false\nconsole.log(str.startsWith(\"123\", 1)); // true","collabId":"af035cf4-4705-458f-bbc5-957a8cd60b89","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"4f720892-b65d-4bcf-8d85-e1e96007a93f","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"2c3ffce8-90dd-4017-9bfe-3760dc0c30d3"},{"children":[{"code":true,"text":"endsWith","type":"formatted"},{"text":" 的作用是用来判断某个字符串是否是该字符串的结尾","type":"formatted"}],"collabId":"5d572feb-47e5-4d07-bfbf-d67d683519cf","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const str = \"Hello World!\";\n\nconsole.log(str.endsWith(\"World!\")); // true\nconsole.log(str.endsWith(\"Hello\")); // false","collabId":"a7b10eea-516b-43b2-b2c6-c82c8359474a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"72cc0226-74db-4c76-8403-e7ba00ed3d5e","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"de421213-067b-4671-b090-478d187d5792"},{"children":[{"text":"同样，","type":"formatted"},{"code":true,"text":"endsWith","type":"formatted"},{"text":" 接受第二个参数用来指定末尾的位置，默认是字符串的长度","type":"formatted"}],"collabId":"4964fcc2-a613-4a44-bada-f556839be2b6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const str = \"Hello World!\";\n\nconsole.log(str.endsWith(\"World\")); // false\nconsole.log(str.endsWith(\"World\", str.length - 1)); // true","collabId":"d97d7c13-d511-40a5-89f3-caa4b04af394","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"07302f45-637e-470b-ba72-b56940e64f49","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"fdb9f1a0-0507-4ef9-a992-d536b0536e5d"}],"tags":["JavaScript"],"createTime":1691250572969,"updateTime":1793532521630,"linkedCards":[]},"meta":{"type":"card","publishTime":1793532521630}}