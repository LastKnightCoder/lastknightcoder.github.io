atted","text":" 的 "},{"type":"formatted","code":true,"text":"replacer"},{"type":"formatted","text":" 参数和 "},{"type":"formatted","code":true,"text":"JSON.parse"},{"type":"formatted","text":" 的 "},{"type":"formatted","code":true,"text":"receiver"},{"type":"formatted","text":" 来自定义序列化，可以参考 "},{"type":"link","url":"https://stackoverflow.com/questions/29085197/how-do-you-json-stringify-an-es6-map","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"14cb8bff-6cc8-4fac-8411-6f97b75df5bc","children":[{"type":"formatted","text":"StackOverflow 上的一个回答"}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a652afd8-0f41-415e-876a-90b7db93cf1d","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"680397e7-d183-4f25-a8f5-6226e93c8cc5","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f9b37750-8c55-4946-b91d-5426d887f275","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c962ecba-f8ba-4c41-a37f-03dd9af6d793","children":[{"type":"link","url":"https://developer.mozilla.org/zh-CN/docs/Web/JavaScript/Reference/Global_Objects/Map","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"a51d10a6-0c2b-42a5-b2d4-39e288c31fcf","children":[{"type":"formatted","text":"Map"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"a228276d-e7d5-485e-a64f-ec4b73d6f30f","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fb98afb7-8ff2-4254-9690-3bf954f3dc7a","children":