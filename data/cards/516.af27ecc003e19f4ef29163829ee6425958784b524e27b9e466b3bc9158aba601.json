{"version":1,"key":"card:516","content":{"id":516,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"纳瓦尔的七个阅读习惯："}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"不关注阅读数量"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"不追求读多少书，也不追求读完一本书"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"果然舍弃"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"阅读过程中，如果十分枯燥且未引起你的兴趣，果断跳过"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"好书要精读重读"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"每个人都有几本反复精读的书，让这些书构成你的基础"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"激发思考和创意"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"读书不是为了获取知识，而是为了激起你的思考，获取知识靠 Google 和 ChatGPT 就行了"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"保持输出"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"讲解你学到的东西，更容易消化书中的内容"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"阅读效率"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"阅读的效率高，但不是唯一的方式，Youtube、播客，博客等都是有用的渠道"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"保持阅读习惯"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"坚持每天阅读一两个小时"}],"disableDrag":false}]}]}],"tags":["读书"],"createTime":1736079540901,"updateTime":1752924464592,"linkedCards":[]},"meta":{"type":"card","publishTime":1752924464592}}