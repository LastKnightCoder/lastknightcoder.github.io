{"version":1,"key":"card:266","content":{"id":266,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ff04080e-8198-4319-999e-943291055563","children":[{"type":"formatted","text":"在 ES6 引入了模板字符串，除了通过 "},{"type":"formatted","code":true,"text":"''"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"\"\""},{"type":"formatted","text":" 来声明字符串字面值，还可以通过 "},{"type":"formatted","code":true,"text":"``"},{"type":"formatted","text":" 来声明字符串字面值："}]},{"type":"code-block","language":"js","uuid":"d2a0b4dc-820f-476d-baa2-22cdbf039104","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"815c4168-c14c-4cb3-ad35-809238695bec","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const str = `Hello World!`;\nconsole.log(str); // Hello World!","collabId":"3b31f604-7f45-484c-956a-8b456af5f11f","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e0aa57b9-a1c5-44e3-9563-12ab883a04b6","children":[{"type":"formatted","text":"在模板字符串中可以直接添加空行，而在 "},{"type":"formatted","code":true,"text":"''"},{"type":"formatted","text":" 或 "},{"type":"formatted","code":true,"text":"\"\""},{"type":"formatted","text":" 中，只能通过 "},{"type":"formatted","code":true,"text":"\\n"},{"type":"formatted","text":" 的方式来换行，但是不直观，在 "},{"type":"formatted","code":true,"text":"``"},{"type":"formatted","text":" 可以直接换行而不会有语法错误："}]},{"type":"code-block","language":"js","uuid":"d79b7e9a-26ec-4428-a301-5bdfca7fdbbb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"15ab1026-000a-485f-a2bb-b5eabd8f2d6c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const dom = `\n<div>\n\tHello World!\n</div>\n`","collabId":"ab93f6e8-4ea5-4a0b-bd10-62b0dd2013b3","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1168dc9a-0edf-4a4a-bf07-d267583ac8d7","children":[{"type":"formatted","text":"模板字符串让拼接字符串更加容易："}]},{"type":"code-block","language":"js","uuid":"9fd82ea8-429e-416c-8fa1-869997b9774a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9181b812-51a7-472f-aded-d76145a827a7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const price = 10;\n// + 号拼接\nconst str = \"这个东西价值\" + price + \"元！\";\n// 模板字符串\nconst str = `这个东西价值${price}元!`;","collabId":"d2308583-52ae-43e4-9cf2-49065dac73f3","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"75ce85df-78bc-4579-8add-dd575ccd2c01","children":[{"type":"formatted","text":"可以通过标签函数自定义对模板字符串进行处理，其结果作为最终的字符串返回"}]},{"type":"code-block","language":"js","uuid":"2be62d99-a287-492c-85d8-232cd3fd7ae5","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"98ff9120-305a-45a7-a374-9f765439f9e9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const tag = (literals, ...substitutions) => {\n  return 'hello';\n}\n\nconst name = \"牛牛\";\n// tag 函数的返回值是模板字符串的最终结果\nconst str = tag`我的名字是：${name}`; // hello","collabId":"1c1fe61c-4367-4bc0-b7e4-73d212d43dfa","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"be2aac56-6a3d-4ed9-81c7-4fec20816a8f","children":[{"type":"formatted","text":"标签函数接收两个参数："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"46a2974f-982d-40ef-b03a-8bde33b34086","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"988366a4-d066-45fe-86d3-b19e08647eae","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5ae1c496-3aa2-4aa3-8bc3-7a337140e85e","children":[{"type":"formatted","text":"由 "},{"type":"formatted","code":true,"text":"${}"},{"type":"formatted","text":" 分割的模板字符串数组"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"1473542a-b87a-4055-9d99-1e0f4859629b","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"935bb68d-a8b5-435f-b5e3-83e0ec82ddbb","children":[{"type":"formatted","code":true,"text":"${}"},{"type":"formatted","text":" 中表达式计算后的结果形成的数组"}]}]}]},{"type":"code-block","language":"js","uuid":"ca58239c-a915-4348-9db7-4c6750eeb1ab","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8f458b2b-85c7-4b8f-87d9-ca869ca6f45b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const price = 2.5,\n      count = 3;\nconst message = tag`${count} items cost $${(price * count).toFixed(2)}.`;\nfunction tag(literals, ...substitutions) {\n  console.log(literals); // [ '', ' items cost $', '.' ]\n  console.log(substitutions); // [ 3, '7.50' ]\n}","collabId":"94bf3673-b08e-42d3-b0c5-624717212221","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3b4553f3-260d-4a4f-9cee-827ddb8d5764","children":[{"type":"formatted","text":"定义一个标签函数模拟模板字符串的默认行为"}]},{"type":"code-block","language":"js","uuid":"f17b641b-1187-4e41-a562-796d53ce9d00","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"ee913472-1fc5-4c43-a637-2a4e05811e71","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function defaultTemplate(literals, ...substitutions) {\n  let result = \"\";\n  for (let i = 0; i < substitutions.length; i++) {\n    result += literals[i];\n    result += substitutions[i];\n  }\n\n  result += literals[literals.length - 1];\n\n  return result;\n}\n\nconst price = 2.5,\n      count = 3;\nconst message = defaultTemplate`${count} items cost $${(price * count).toFixed(2)}.`;\n\nconsole.log(message); // 3 items cost $7.50.","collabId":"60c016b3-1e89-4519-8139-48b818eb653f","children":[{"type":"formatted","text":""}]}]}],"tags":["JavaScript/模板字符串"],"createTime":1691731196215,"updateTime":1743303640422,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640422}}