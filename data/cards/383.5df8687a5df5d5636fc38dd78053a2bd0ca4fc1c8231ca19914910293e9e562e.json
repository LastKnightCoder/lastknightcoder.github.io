{"version":1,"key":"card:383","content":{"id":383,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"众所周知， "},{"type":"formatted","text":"position: fixed","code":true},{"type":"formatted","text":" 是相对于视口定位，但是有的时候会出现例外："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"祖先元素设置了 "},{"type":"formatted","text":"container","code":true},{"type":"formatted","text":" 属性"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"祖先元素设置了 "},{"type":"formatted","text":"transform","code":true},{"type":"formatted","text":" 属性"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"此时都是相对于该祖先元素进行定位的。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"在 React 组件中，如果需要用到固定定位，可以考虑使用 "},{"type":"formatted","text":"createPortal","code":true},{"type":"formatted","text":" 将元素插入到 "},{"type":"formatted","text":"body","code":true},{"type":"formatted","text":" 下，这样该定位元素不论什么情况下都是相对于视口进行定位的了"}],"disableDrag":false},{"type":"code-block","code":"import { createPortal } from 'react-dom';\n\nconst Portal = ({ children }: { children: ReactNode }) => {\n  return createPortal(children, document.body)\n}\n\nconst Component = () => {\n  return (\n  \t<div>\n      <!-- 其它 -->\n    \t<Portal>\n      \t<!-- 需要固定定位的元素 -->\n      </Portal>\n    </div>\n  )\n}","language":"tsx","uuid":"a58d0fb4-319e-458f-aefd-acc1b0850180","children":[{"type":"formatted","text":""}]}],"tags":["CSS/定位/fixed"],"createTime":1701266862996,"updateTime":1755938416033,"linkedCards":[]},"meta":{"type":"card","publishTime":1755938416033}}