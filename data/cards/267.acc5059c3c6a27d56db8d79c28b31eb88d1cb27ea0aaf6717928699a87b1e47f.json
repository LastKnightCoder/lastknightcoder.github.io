{"version":1,"key":"card:267","content":{"id":267,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"使用解构语法从对象中提取属性"}]},{"type":"code-block","code":"const user = {\n  name: 'Alice',\n  age: 18,\n  score: {\n    math: 88,\n\t\tchinese: 70\n  }\n}\n\nconst { name, age } = user;\nconsole.log(name, age); // Alice 18","language":"js","uuid":"ff37a10c-995d-43f6-b244-3ab6d4e65696","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"当对象中不存在该属性或该属性值为 "},{"type":"formatted","text":"undefined","code":true},{"type":"formatted","text":" 时，我们可以在解构时赋予默认值"}]},{"type":"code-block","code":"const { gender = 'male' } = user;\nconsole.log(gender); // male","language":"js","uuid":"19b7d4c2-412c-4756-9a4a-11238cab503d","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"在解构时可以同时赋予别名"}]},{"type":"code-block","code":"const { name: anotherName } = user;\nconsole.log(anotherName); // Alice","language":"js","uuid":"cd6876c1-2314-4723-85c9-2e3807fa95e4","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"嵌套解构对象"}]},{"type":"code-block","code":"const { score: { math } } = user;\nconsole.log(math); // 88","language":"js","uuid":"62c1b17a-0206-405a-82fd-b33d042ec847","children":[{"type":"formatted","text":""}]}],"tags":["JavaScript"],"createTime":1691820172318,"updateTime":1743303640422,"linkedCards":[{"id":268,"target":{"key":"card:268","type":"card","id":268},"summary":"除了通过下标访问数组中的元素，还可以通过解构语法 const arr = ['Alice', 18]; const [name, age] = arr; console.log(name, age); // Alice 18 如果想忽略某个...","tags":["JavaScript"]}]},"meta":{"type":"card","publishTime":1743303640422}}