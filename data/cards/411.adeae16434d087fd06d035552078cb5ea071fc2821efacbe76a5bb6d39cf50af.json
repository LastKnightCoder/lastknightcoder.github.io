"tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6fa7236f-2c6e-4900-baa8-6bb816dd1b69","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let a: i32 = 1;\nlet b = a;\n\n// 因为 i32 实现了 Copy Trait，所以仅仅是将 a 的数据复制了，\n// a 仍然保留对元数据的所有权，仍然可以使用\nprintln!(\"{}, {}\", a, b);","collabId":"9b6223f9-fd95-499a-a964-a1d3ba5f86ce","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"rs","uuid":"4a94a862-3670-44f7-b630-60e75768de3a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2eb89d17-2a53-49ae-a022-62290ff640fb","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let a = [10; 3];\nlet b = a;\n\nprintln!(\"a: {:?}\\nb: {:?}\", a, b);","collabId":"0870c85c-461b-4923-ac1c-c25cc5e0ba50","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"acbbd0cf-6679-460e-8265-1b7f77a130ab","children":[{"type":"formatted","text":"对于引用而言没有所有权的概念，它只是对值的借用，因此对引用进行赋值不牵涉到所有权的转移"}]},{"type":"code-block","language":"rs","uuid":"4d174a56-7453-4fe7-94e9-5b0d7ddb4e68","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"477d133d-a153-4f7e-9ba5-6ff3702e42fa","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"fn main() {\n    let s = String::from(\"hello\");\n    let s1 = &s;\n    let s2 = s1; // s1 是引用，不存在所有权的概念，复制后 s1 仍然可访问\n\n    println!(\"{}\", s1); // hello\n    println!(\"{}\", s2); // hello\n}","collabId":"0273f94b-941e-4449-b4fe-56d27c8e9dc7","children":[{"type":"formatted","text":""}]}]}],"tags":["Rust/所有权"],"createTime":1709220126028,"updateTime":1755514059027,"linkedCards":[]},"meta":{"type":"card","publishTime":1755514059027}}