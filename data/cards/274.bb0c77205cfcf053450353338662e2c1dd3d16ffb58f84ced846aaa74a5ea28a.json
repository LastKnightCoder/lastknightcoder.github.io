{"version":1,"key":"card:274","content":{"id":274,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"几个与原型相关的方法。"}]},{"type":"paragraph","children":[{"type":"formatted","text":"在创建对象时，可以通过 "},{"type":"formatted","text":"Object.create","code":true},{"type":"formatted","text":" 为对象指定一个原型"}]},{"type":"code-block","code":"const person = {\n  sayHello() {\n    console.log(\"Hello\");\n  },\n};\n\nconst friend = Object.create(person);\nfriend.sayHello(); // Hello","language":"js","uuid":"b2b88ccf-f737-47f5-bfe6-1982d53a8695","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"可以通过 "},{"type":"formatted","text":"Object.getPrototypeOf","code":true},{"type":"formatted","text":" 获得对象的原型"}]},{"type":"code-block","code":"console.log(Object.getPrototypeOf(friend) === person); // true","language":"js","uuid":"bf0bbcdc-f404-4fb1-9b45-34661c93363d","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"在 ES6 中新增了 "},{"type":"formatted","text":"Object.setPrototypeOf","code":true},{"type":"formatted","text":" 方法，可以改变一个对象的原型"}]},{"type":"code-block","code":"const dog = {\n  sayHello() {\n    console.log(\"Woff\");\n  },\n};\n\nObject.setPrototypeOf(friend, dog);\nfriend.sayHello(); // Woff\nconsole.log(Object.getPrototypeOf(friend) === dog); // true","language":"js","uuid":"9647154a-371c-41d9-a936-b6472e80bbe3","children":[{"type":"formatted","text":""}]}],"tags":["JavaScript"],"createTime":1692110805587,"updateTime":1743303640422,"linkedCards":[{"id":275,"target":{"key":"card:275","type":"card","id":275},"summary":"如果重写了原型中的方法，如何访问原型中的方法。 在 ES5 中，通过 Object.getPrototypeOf(this).[method].call(this) 来访问原型 const person = { sayHello() { r...","tags":["JavaScript/类"]}]},"meta":{"type":"card","publishTime":1743303640422}}