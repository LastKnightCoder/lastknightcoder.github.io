matted","text":"，那么我们可以通过下面的方式来获得该节点"}]},{"type":"code-block","language":"JavaScript","uuid":"dcc8babd-b92a-4cc9-98b1-276285448e9c","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9fe5790e-2f0d-440d-bcc5-aa613f7f1409","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"images.namedItem(\"img1\");`","collabId":"4f35e8b5-41fd-495d-8c79-28fdd08140cd","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"7c8add80-c461-48f4-b43a-3832ea4a550c","children":[{"type":"formatted","text":"getElementsByClassName"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6e53824a-4397-489a-8cb2-b9869ff3df25","children":[{"type":"formatted","code":true,"text":"getElementsByClassName"},{"type":"formatted","text":" 可以通过类型来查找元素，由于可以多个元素存在相同的类型，因此返回的也是一个 "},{"type":"formatted","code":true,"text":"HTMLCollection"}]},{"type":"code-block","language":"JavaScript","uuid":"eeac1554-adcc-4ce6-86f4-839ce3032484","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"3bc1f53f-e9c9-44d8-8a13-fb6bafb84f42","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const disabled = document.getElementsByClassName('disabled');\nArray.from(disabled).forEach(disabledEle => {\n\tdisabledEle.style.color = 'rgba(0, 0, 0, .2)';\n});","collabId":"6831de58-6457-48fd-95e1-f7a42f9dde1d","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"ad612213-9dec-4896-a4d8-df776f198044","children":[{"type":"formatted","text":"getElementsByName"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fe106f38-3432-4a3b-a7ea-147c44877735","children":[{"type":"formatted","text":"该方法是根据 "},{"type":"formatted","code":true,"text":"name"},{"type":"formatted","text":" 属性来获得节点的，该方法返回的是一个 "},{"type":"formatted","code":true,"text":"NodeList"},{"type":"formatted","text":"，一般这个方法是用来取得单选按钮，因为单选按钮必须拥有相同的 "},{"type":"formatted","code":true,"text":"name"},{"type":"formatted","text":" 属性。假设有如下单选按钮"}]},{"type":"code-block","language":"HTML","uuid":"885c1cc7-4f4f-4cb6-aa21-90b1282345a6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"59440174-4db2-433c-b448-5045a4944cdc","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<input type=\"ratio\" value=\"green\" name=\"color\" />\n<input type=\"ratio\" value=\"red\" name=\"color\" />\n<input type=\"ratio\" value=\"blue\" name=\"color\" />","collabId":"175dba0d-681a-4feb-9b0c-e4b0a8143a7f","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ad00a377-a88f-41d7-b52d-7354faba1671","children":[{"type":"formatted","text":"我们可以通过下面的方法获得所以的单选按钮"}]},{"type":"code-block","language":"JavaScript","uuid":"6dd21a76-cb31-4e6e-8c66-ec6b2f2c0ebb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"0ca4be22-65ce-4291-88e1-9d47fd6520ab","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"document.getElementsByName(\"color\");","collabId":"e6ac46f1-4fc8-433e-884d-deee874f094b","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"a30f8e11-e006-4bda-a188-ad4a78cafc1c","children":[{"type":"formatted","text":"querySelector"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91d