uContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"da0f16ac-d81b-4b07-a260-0e7314747ca4","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"20fc94b9-80be-4554-81bc-57411b4ee93f","children":[{"type":"formatted","text":"Import Map 必须在使用其定义的标识符的模块之前"}]},{"type":"code-block","language":"HTML","uuid":"2042e72f-03c9-477d-bce5-40dea6896b79","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"1a8ec2e3-1116-4438-9cb5-99f5280e57bd","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- ✅ 合法：Map 1 在使用它的 Module 1 之前 -->\n<script type=\"importmap\">{ \"imports\": { \"a\": \"a.js\" } }</script>\n<script type=\"module\">import 'a';</script>\n\n<!-- ✅ 合法：Map 2 在使用它的 Module 2 之前 -->\n<script type=\"importmap\">{ \"imports\": { \"b\": \"b.js\" } }</script>\n<script type=\"module\">import 'b';</script>\n\n<!-- ❌ 非法：Module 使用了尚未定义的标识符 -->\n<script type=\"module\">import 'a';</script>  <!-- 错误！'a' 还没定义 -->\n<script type=\"importmap\">{ \"imports\": { \"a\": \"a.js\" } }</script>","collabId":"2beeb435-d065-40d4-8aa9-8b8e4295478b","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"aa40719d-f10d-4d99-9e95-5c7c8a66eb01","children":[{"type":"formatted","code":true,"text":"importmap"},{"type":"formatted","text":" 定义和 "},{"type":"formatted","code":true,"text":"module"},{"type":"formatted","text":" 脚本可进行穿插，只需保证在 "},{"type":"formatted","code":true,"text":"module"},{"type":"formatted","text":" 中引用的标识符已被定义"}]},{"type":"code-block","language":"HTML","uuid":"57d70a18-4d75-4570-a2e3-d2e580f91fcd","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"50238011-a265-497f-b8a9-d42737d798ee","childre