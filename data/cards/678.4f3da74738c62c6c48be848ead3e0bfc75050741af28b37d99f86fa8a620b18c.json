ing\": \"data:text/javascript,export default 'Hello from Import Map 3!'\"\n    }\n}\n</script>","collabId":"de0700a1-192a-4aa2-9354-6989444c5b30","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"731584fc-e399-4b14-bf10-fe521b0c5418","children":[{"type":"formatted","text":"相当于"}]},{"type":"code-block","language":"HTML","uuid":"52b73a46-08e6-4a05-b576-9f958107a5c4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"5cda6425-cf88-4fa7-a344-36595b151393","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<script type=\"importmap\">\n{\n    \"imports\": {\n        \"lodash\": \"https://esm.sh/lodash-es@4.17\",\n        \"dayjs\": \"https://esm.sh/dayjs@1.11.10\",\n        \"uuid\": \"https://esm.sh/uuid@9\",\n        \"nanoid\": \"https://esm.sh/nanoid@5\",\n        \"my-greeting\": \"data:text/javascript,export default 'Hello from Import Map 3!'\"\n    }\n}\n</script>","collabId":"35f4ea5b-d9a3-4d14-a513-706e52f456c4","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"dc6fdedd-72cb-4b90-aa67-b3e4af5e2c63","children":[{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"174ec074-e091-4591-b4b5-d661f2f3cc65","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"1a68f2ab-e68a-48df-8ef3-26b22e9c1b25","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b64a3a16-b0bb-4d15-b92a-842c432e9dab","children":[{"type":"formatted","text":"如果一个模块标识符（如 "},{"type":"formatted","code":true,"text":"lodash"},{"type":"formatted","text":"）已经被解析（即模块已被导入/加载），后续 Import Map 中对同一标识符的定义会被忽略"}]},{"type":"code-block","language":"HTML","uuid":"eadbc83f-52de-467c-b33a-fef049dc3bcd","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"d60b442a-9f06-44fa-82e9-be371803e1b0","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- 1. Import Map 1 -->\n<script type=\"importmap\">\n{\n    \"imports\": {\n        \"lib-a\": \"data:...'Library A'\",\n        \"shared\": \"data:...'Shared from Map 1'\"\n    }\n}\n</script>\n\n<!-- 2. Module Script 1 - 使用 Map 1 的定义 -->\n<script type=\"module\">\n    import libA from 'lib-a';      // ✅ 正常工作\n    import shared from 'shared';   // ✅ 解析为 Map 1 的定义\n    // 此时 \"shared\" 已被解析\n</script>\n\n<!-- 3. Import Map 2 -->\n<script type=\"importmap\">\n{\n    \"imports\": {\n        \"lib-b\": \"data:...'Library B'\",\n        \"shared\": \"data:...'Shared from Map 2'\"  // ⚠️ 被忽略！\n    }\n}\n</script>\n\n<!-- 4. Module Script 2 -->\n<script type=\"module\">\n    import libB from 'lib-b';      // ✅ 正常工作\n    import shared from 'shared';   // ⚠️ 仍然是 Map 1 的定义！\n</script>","collabId":"d1179438-d6a6-4d40-939c-3210ef0249eb","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b14d31d0-ce06-411b-a2d0-9cbf7589832c","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8c88a112-15cd-4954-9f3d-bd6eefb0edda","children":[{"type":"formatted","text":"即使模块还没被加载，只要标识符已经在全局 Import Map 中有映射，后续 Import Map 中对同一标识符的重新定义也会被忽略"}]},{"type":"code-block","language":"HTML","uuid":"82b0b33f-98f3-4b0f-89f8-eca217a93645","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"512d8847-1102-4678-8ef3-bcdb1e014f2c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- Import Map 1: 首先注册 -->\n<script type=\"importmap\">\n{\n    \"imports\": {\n        \"lodash\": \"https://cdn.jsdelivr.net/npm/lodash-es@4.17.21/lodash.js\",   /* ✅ 生效 */\n        \"dayjs\": \"https://esm.sh/dayjs@1.11.10\"                                 /* ✅ 生效 */\n    }\n}\n</script>\n\n<!-- Import Map 2: 随后注册 -->\n<script type=\"importmap\">\n{\n    \"imports\": {\n        \"lodash\": \"https://unpkg.com/lodash-es@4.17.21/lodash.js\",   /* ❌ 忽略：lodash 已在 Map 1 中映射 */\n        \"uuid\": \"https://esm.sh/uuid@9\"                              /* ✅ 生效：uuid 是新标识符 */\n    }\n}\n</script>\n\n<!-- 此时还没有任何模块被加载，但全局 Import Map 已经是： -->\n<!--\n{\n    \"imports\": {\n        \"lodash\": \"https://cdn.jsdelivr.net/npm/lodash-es@4.17.21/lodash.js\",   (来自 Map 1)\n        \"dayjs\": \"https://esm.sh/dayjs@1.11.10\",                                (来自 Map 1)\n        \"uuid\": \"https://esm.sh/uuid@9\"                                         (来自 Map 2)\n    }\n}\n-->\n\n<!-- 模块脚本 -->\n<script type=\"module\">\n    import _ from 'lodash';   // → cdn.jsdelivr.net (Map 1)，不是 unpkg.com (Map 2)\n    import dayjs from 'dayjs'; // → esm.sh (Map 1)\n    import { v4 } from 'uuid'; // → esm.sh (Map 2)\n</script>","collabId":"f3309e35-14c1-42a9-9520-db876f16ff37","children":[{"type":"formatted","text":""}]}]}]}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b0205714-77dd-4ef0-82a4-5b2422f45f9c","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"067da0e3-5072-426f-9fe2-d1f4d52a0c76","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c448f7e1-2671-4676-b165-3d18e3626378","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"490e3412-0b43-404f-9368-56056e9f9935","children":[{"type":"link","url":"https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/script/type/importmap","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"cf910a97-31ec-43e9-a3d6-ac1b86e6d480","children":[{"type":"formatted","text":"<script type=\"importmap\">"}]}]}]}]}],"tags":["HTML/Import Map"],"createTime":1769179175797,"updateTime":1774969824922,"linkedCards":[]},"meta":{"type":"card","publishTime":1774969824922},"links":{"card:675":{"key":"card:675","type":"card","id":675}}}