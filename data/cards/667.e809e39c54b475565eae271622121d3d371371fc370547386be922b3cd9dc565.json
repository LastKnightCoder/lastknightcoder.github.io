e-step"}],"collabId":"711659ee-31e0-4687-bbce-19315a18154e","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"f9c4ae5a-03da-445c-ba59-6002e62620e6"},{"children":[{"text":"而 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":" 表示设置的是空值，一般用来表示对象的空值","type":"formatted"}],"collabId":"91635d43-c55b-49bd-9529-2962c4465ee3","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"let obj = null\nif (condition) {\n  obj = {}\n}","collabId":"837e0f89-e966-49d2-9f6f-589dacef8531","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e2fd4e00-84cb-441f-b881-e3eba403c1fd","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"8d312b9f-86a1-4d9f-9f6a-5f949920285e"}],"collabId":"8bdbb563-69c4-4fa9-b42e-a7d6c3e1c4ca","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"typeof","type":"formatted"},{"text":" 操作符的返回值不同","type":"formatted"}],"collabId":"29796581-6634-4851-b39e-7398a1775972","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"typeof undefined === \"undefined\" // -> true\ntypeof null === \"object\"         // -> true","collabId":"d3d1ef04-0aba-44f7-bbe8-a32e06a341bb","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"0a0ec26e-9afc-4ed0-bbe1-816b20deed65","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"96fcd428-4681-4721-b74e-a2b