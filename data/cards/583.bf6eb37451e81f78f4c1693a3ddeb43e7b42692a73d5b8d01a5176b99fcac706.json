{"version":1,"key":"card:583","content":{"id":583,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7784140c-03d2-455d-9dc0-e1216eb86896","children":[{"type":"formatted","text":"模块化的发展历史："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"60f420b3-14eb-454f-bf79-40b6ec6abf99","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c59a5116-1f59-4dcd-b9e7-ffb33f30bd47","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a4a10e10-1aef-426d-90b7-4dd258710cf0","children":[{"type":"formatted","text":"无模块（1995-2009）"}]},{"type":"code-block","language":"JavaScript","uuid":"38b2e22a-75fd-45a8-86af-a38862e808ea","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2d1fd3f7-6aaf-4d9c-b790-75c71ef20a50","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"var module1 = {\n  foo: function() { /*...*/ }\n};\n\nvar module2 = {\n  bar: function() { /*...*/ }\n};","collabId":"015d389a-4705-4541-8851-4835f4f1d1d0","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"bf95a08d-1b77-4a49-b90d-27e86dc8c620","children":[{"type":"formatted","text":"全局变量污染，依赖关系无法确定。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"04dc0799-8ead-4804-978f-89af392ab71c","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"277f041e-8a0e-47f8-a312-f39eaf813a9f","children":[{"type":"formatted","text":"立即执行函数（2009）"}]},{"type":"code-block","language":"JavaScript","uuid":"87e27967-b71b-4597-8d2d-08df57ce0ff7","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a8119145-157a-4baf-81aa-8eac689456be","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"var module = (function() {\n  var privateVar = 'private';\n  return {\n    publicMethod: function() {\n      console.log(privateVar);\n    }\n  };\n})();","collabId":"1db18c48-a215-4bab-99e8-389ba01a3b8d","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9e696778-331b-4f3f-b506-4a9ca2c1a80c","children":[{"type":"formatted","text":"直接在立即函数中执行，通过闭包返回立即执行函数中的定义的模块。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"03fc0e92-f0dc-4930-8291-9aeeb89f48e1","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b008322b-5bd1-4d83-8523-4ad8f5d1dd1a","children":[{"type":"formatted","text":"CommonJS（2009）"}]},{"type":"code-block","language":"JavaScript","uuid":"d7a514e7-967a-47d2-9de8-332a4fc79b25","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"becabb3c-73f6-4a50-8109-0e663983d4ee","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"// math.js\nexports.add = function(a, b) { return a + b; };\n\n// 或\nmodule.exports = {\n  add: function(a, b) { return a + b; }\n};\n\n// app.js\nconst math = require('./math');\nmath.add(1, 2);","collabId":"69175921-2c1c-4fac-9186-1546d951f6c3","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fc6450b2-c63e-4d5b-9d47-4771388f41c9","children":[{"type":"formatted","text":"Node.js 的模块化规范，通过 "},{"type":"formatted","code":true,"text":"require"},{"type":"formatted","text":" 同步加载模块，通过 "},{"type":"formatted","code":true,"text":"module.exports"},{"type":"formatted","text":" 导出模块，仅适用于服务器端。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"379f411c-a958-489e-9377-af2619cea569","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5f84eb60-9b3d-4506-94a6-5ab2c0aa7d67","children":[{"type":"formatted","text":"AMD（2011）"}]},{"type":"code-block","language":"JavaScript","uuid":"cdefa3ce-1b88-4bde-96a6-a65dc2750e22","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"da57ecc0-840a-40a7-99f7-5f9053e8d501","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"// 定义模块\ndefine(['dep1', 'dep2'], function(dep1, dep2) {\n  return {\n    method: function() {\n      dep1.doSomething();\n    }\n  };\n});\n\n// 加载模块\nrequire(['module'], function(module) {\n  module.method();\n});","collabId":"ae583b11-f89a-4e7a-8804-a82ba92c7449","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"293023b5-d6eb-4c80-b0f2-f82c7c45e5e8","children":[{"type":"formatted","text":"RequireJS 推动的适合浏览器端的模块系统，通过 "},{"type":"formatted","code":true,"text":"define"},{"type":"formatted","text":" 定义模块，通过 "},{"type":"formatted","code":true,"text":"require"},{"type":"formatted","text":" 加载模块，模块的加载是异步的。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"683b36d5-fe2a-43d3-9121-137d938d3226","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dd394c04-6ae1-487f-9046-9c67539cf8c4","children":[{"type":"formatted","text":"CMD（2011）"}]},{"type":"code-block","language":"JavaScript","uuid":"d5c8e92e-c552-413a-81f7-c2ba23892123","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e00a4a81-4f60-4f48-adc5-773794a2318c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"define(function(require, exports, module) {\n  var dep1 = require('dep1');\n  exports.method = function() {\n    dep1.doSomething();\n  };\n});","collabId":"0ca5afbf-3aef-4eb7-8b83-ebeedcc90077","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5093918d-b7d4-4efc-973d-0f81a7ae3d4f","children":[{"type":"formatted","text":"类似于 AMD，但更接近 CommonJS，相比于 AMD，它延迟执行，仅当模块被其他模块使用的时候才会执行，不用预先定义好依赖。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"78362700-718e-4e24-8d40-f53f65812268","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"338e8e6b-a901-4855-b3a1-e4d62e98354e","children":[{"type":"formatted","text":"UMD（2014）"}]},{"type":"code-block","language":"JavaScript","uuid":"eacc2c2b-6c59-4ee4-802e-698c7e21b348","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"37bdc5c0-25ea-43b9-a21b-0a1b411e853b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"(function(root, factory) {\n  if (typeof define === 'function' && define.amd) {\n    // AMD\n    define(['jquery'], factory);\n  } else if (typeof exports === 'object') {\n    // CommonJS\n    module.exports = factory(require('jquery'));\n  } else {\n    // 全局变量\n    root.myModule = factory(root.jQuery);\n  }\n}(this, function($) {\n  // 模块代码\n  return {};\n}));","collabId":"bdac7454-b615-46b9-ae3f-3a1a3f21b662","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"166bea8e-f781-4d17-afe5-c03855ba5b5a","children":[{"type":"formatted","text":"兼容 AMD 和 CommonJS，可以在浏览器和 Node.js 中同时使用。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"035ce91b-5cd2-41d8-950c-6700bd14a852","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e867df6e-ac43-479f-9424-1bfade880e85","children":[{"type":"formatted","text":"ES Module（2015）"}]},{"type":"code-block","language":"JavaScript","uuid":"baf0a573-238c-4bd3-9064-97bc17365ad0","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"134710cf-cda3-4928-b2cf-898f472e3d25","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"// math.js\nexport const add = (a, b) => a + b;\nexport const PI = 3.14;\n\n// 或\nconst add = (a, b) => a + b;\nconst PI = 3.14;\nexport { add, PI };\n\n// app.js\nimport { add, PI } from './math.js';\nconsole.log(add(1, 2));","collabId":"2f6c024b-3253-4730-9995-4d0ac1955334","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1d6b94ff-37b1-424d-a534-09bb28d015c8","children":[{"type":"formatted","text":"ES 2015 标准引入的官方模块系统，通过 "},{"type":"formatted","code":true,"text":"import"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"export"},{"type":"formatted","text":" 导入和导出模型，在浏览器和 Node.js 中均原生支持，特点是静态分析，编译时加载，支持通过 import() 动态导入"}]}]}]},{"type":"mermaid","tauContract":"1c918d7603a3e3ecd29f011e4bab52bce848fe941bcb9a9dcf18f1024e918a5d","chart":"graph TD\n    A[无模块化] --> B[IIFE]\n    B --> C[CommonJS]\n    B --> D[AMD]\n    D --> E[CMD]\n    C --> F[UMD]\n    D --> F\n    E --> F\n    F --> G[ES Modules]","collabId":"b4bf290b-f812-4aed-8d06-dfc375cd6c35","children":[{"type":"formatted","text":""}]}],"tags":[],"createTime":1745387396088,"updateTime":1745387396088,"linkedCards":[]},"meta":{"type":"card","publishTime":1745387396088}}