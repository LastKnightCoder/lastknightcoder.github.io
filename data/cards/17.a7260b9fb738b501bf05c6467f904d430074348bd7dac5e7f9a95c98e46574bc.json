{"version":1,"key":"card:17","content":{"id":17,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"784af671-c52e-4ce0-9bb8-191087c38506","children":[{"type":"formatted","text":"函数类型的声明，例如声明一个 "},{"type":"formatted","code":true,"text":"add"},{"type":"formatted","text":" 函数"}]},{"type":"code-block","language":"TypeScript","uuid":"2f495ad5-76d5-4263-8752-e9276711ffd8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"0a23a6af-2c9f-4fe1-811f-701fa970f635","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function add(x: number, y: number): number {\n  return x + y;\n}\n\nconst add = function (x:number, y:number): number {\n  return x + y;\n}","collabId":"5134f9b3-5628-4c86-af88-478ed5dc82ae","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"375bb4f6-e0d1-410f-bec3-ce0a65e10965","children":[{"type":"formatted","text":"除此之外可以单独为函数标注类型"}]},{"type":"code-block","language":"TypeScript","uuid":"2a200c7c-d8c5-46ca-8a9e-ad1b9d6c8779","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"08f801f2-f3ee-4727-b76a-8bdc4fa25022","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const add: (number, number) => number = function(x, y){\n  return x + y;\n}","collabId":"5e97eb78-1b7b-4e89-aeae-5e23a689aa46","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6c301182-c317-44d8-9eb8-a5664732425c","children":[{"type":"formatted","text":"箭头函数的标注"}]},{"type":"code-block","language":"TypeScript","uuid":"507ba39f-69d6-44a5-912a-a