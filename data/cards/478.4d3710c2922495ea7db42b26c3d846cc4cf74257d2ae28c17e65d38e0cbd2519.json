formatted","code":true,"text":":"},{"type":"formatted","text":"，而在 Windows 中为 "},{"type":"formatted","code":true,"text":";"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"33c2d39f-2b4d-461f-84a4-99b60103c9b3","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2d1cb9c0-4304-46a0-90d4-8eef394b002c","children":[{"type":"formatted","text":"变量 "},{"type":"formatted","code":true,"text":"os.linesep"},{"type":"formatted","text":" 是用于文本文件中的行分隔符：在 UNIX/OS X 中为单个换行符"},{"type":"formatted","code":true,"text":"\\n"},{"type":"formatted","text":"，在 Windows 中为回车和换行符"},{"type":"formatted","code":true,"text":"\\r\\n"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"fa1a303a-97b8-47a4-8adc-5216fbe18e44","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"810d5830-d8f5-4ca4-90e2-144c51b17a8a","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"urandom"},{"type":"formatted","text":" 使用随系统而异的“真正”（至少是强加密）随机源。如果平台没有提供这样的随机源，将引发 "},{"type":"formatted","code":true,"text":"NotImplementedError"},{"type":"formatted","text":" 异常"}]}]}]}],"tags":["Python/标准库/os"],"createTime":1719398461547,"updateTime":1743303640443,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640443}}