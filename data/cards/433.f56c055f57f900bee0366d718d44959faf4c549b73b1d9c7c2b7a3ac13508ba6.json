{"version":1,"key":"card:433","content":{"id":433,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"序列可以直接通过 "},{"type":"formatted","text":"+","code":true},{"type":"formatted","text":" 运算符进行拼接"}]},{"type":"code-block","code":">>> [1, 2, 3] + [4, 5, 6]\n[1, 2, 3, 4, 5, 6]\n>>> (1, 3, 4) + (2, 7, 8)\n(1, 3, 4, 2, 7, 8)\n>>> \"Hello \" + \"World!\"\n'Hello World!'","language":"py","uuid":"33b96fb3-be00-43a1-b645-91dee4863750","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"一般而言只能对同类型的序列使用 "},{"type":"formatted","text":"+","code":true},{"type":"formatted","text":" 拼接"}]},{"type":"code-block","code":">>> [1, 2, 3] + \"Hello\"\nTraceback (most recent call last):\n  File \"<stdin>\", line 1, in <module>\nTypeError: can only concatenate list (not \"str\") to list","language":"py","uuid":"13861ea7-91e4-424d-b677-a873303c55d5","children":[{"type":"formatted","text":""}]}],"tags":["Python/序列/运算"],"createTime":1719024237703,"updateTime":1743303640439,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640439}}