{"version":1,"key":"card:406","content":{"id":406,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"一条指令的执行流程可以分解为如下六个部分："}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"取指"}]},{"type":"paragraph","children":[{"type":"formatted","text":"根据 PC 寄存器，从内存中取出指令"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"译码"}]},{"type":"paragraph","children":[{"type":"formatted","text":"根据读取到的寄存器编号，从寄存器文件中读取相应寄存器的内容"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"执行"}]},{"type":"paragraph","children":[{"type":"formatted","text":"根据指定功能码，进行计算"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"访存"}]},{"type":"paragraph","children":[{"type":"formatted","text":"从内存中读取数据或者将数据写入到内存中"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"写回"}]},{"type":"paragraph","children":[{"type":"formatted","text":"更新寄存器"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"更新"}]},{"type":"paragraph","children":[{"type":"formatted","text":"将 PC 寄存器设置为下一条指令的地址"}]}]}]},{"type":"divide-line","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"例子1："},{"type":"formatted","text":"mrmovq D(rB) rA","code":true},{"text":"，该指令的作用是根据地址 ","type":"formatted"},{"type":"formatted","text":"D + R[rB]","code":true},{"type":"formatted","text":" ，从内存中读取数据，并写入到寄存器 "},{"type":"formatted","text":"rA","code":true},{"type":"formatted","text":" 中"}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"取指","type":"formatted"}]},{"type":"code-block","code":"icode: ifun <- M[PC]  // 第一个字节表示指令\nrA: rB <- M[PC+1]     // 第二个字节表示要操作的寄存器编号\nvalC <- M[PC + 2]     // 8 字节，表示立即数\nvalP <- PC + 10       // 下一个指令的地址，1 + 1 + 8 => 10","language":"","uuid":"5b971aee-b039-4e2c-999f-5160dd85618d","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"译码"}]},{"type":"code-block","code":"valB <- R[rB]","language":"","uuid":"c6903ee7-7d62-4204-aeef-41797a4349f6","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"执行"}]},{"type":"code-block","code":"valE <- valB + valC // 计算 D + R[rB]","language":"","uuid":"4b4de8a3-6d8d-4284-b329-7dd4fc59f2c0","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"访存"}]},{"type":"code-block","code":"valM <- M[valE] // 读取地址为 D + R[rB] 的内存数据","language":"","uuid":"d9e037d8-eab9-4e84-a134-cc81fe9a3b8e","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"写回"}]},{"type":"code-block","code":"R[rA] <- valM","language":"","uuid":"fe5ea026-e412-415b-a0ba-1e255c44a41f","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"更新"}]},{"type":"code-block","code":"PC <- valP","language":"","uuid":"ddfdafef-2ab8-4811-85ad-53e2feedd6a0","children":[{"type":"formatted","text":""}]}]}]},{"type":"divide-line","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"例子2："},{"type":"formatted","text":"pushq rA","code":true},{"text":"，该指令的作用是将寄存器 ","type":"formatted"},{"type":"formatted","text":"rA","code":true},{"type":"formatted","text":" 中的内容压入到栈中"}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"取指","type":"formatted"}]},{"type":"code-block","code":"icode: ifun <- M[PC]\nrA: rB <- M[PC + 1]\nvalP <- PC + 2","language":"","uuid":"c