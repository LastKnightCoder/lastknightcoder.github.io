{"version":1,"key":"card:391","content":{"id":391,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"XMLHttpRequest","code":true},{"type":"formatted","text":" 实例上存在一个 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 属性，通过设置该属性可以对返回结果产生影响。有如下取值："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"text","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"将结果转化为字符串"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"json","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"将结果转化为 JavaScript 对象，如果无法转换，则结果为 "},{"type":"formatted","text":"null","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"document","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"将结果转化为 DOM 对象，如果无法转换，则结果为 "},{"type":"formatted","text":"null","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"arraybuffer","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"将结果转化为 "},{"type":"formatted","text":"ArrayBuffer","code":true},{"type":"formatted","text":" 对象，其中保存了结果对应的二进制数据"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"blob","code":true}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"将结果转化为 "},{"type":"formatted","text":"Blob","code":true},{"type":"formatted","text":" 对象，其中保存了结果对应的二进制数据"}],"disableDrag":false}]}]},{"type":"highlight-block","color":"blue","children":[{"type":"paragraph","children":[{"type":"formatted","text":"当不设置 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 或者设置 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 为空字符串时，等效于设置了 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"text","code":true},{"type":"formatted","text":"。"}],"disableDrag":false}]},{"type":"paragraph","children":[{"type":"formatted","text":"起一个简单的后端服务，准备三个接口："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"/text","code":true},{"type":"formatted","text":"：返回普通的文本字符串"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"/json","code":true},{"type":"formatted","text":"：返回 JSON 字符串"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"/xml","code":true},{"type":"formatted","text":"：返回 XML 字符串"}],"disableDrag":false}]}]},{"type":"code-block","code":"import Koa from 'koa';\nimport cors from '@koa/cors';\nimport Router from '@koa/router';\n\nconst app = new Koa();\n\nconst router = new Router();\n\nrouter.get('/text', async (ctx) => {\n  ctx.body = \"Hello World!😥🐟\";\n});\n\nrouter.get('/json', async (ctx) => {\n  ctx.body = {\n    name: \"Alice\"\n  }\n});\n\nrouter.get('/xml', async (ctx) => {\n  ctx.body = `<div>Hello World!</div>`\n});\n\napp\n  .use(cors())\n  .use(router.routes())\n  .use(router.allowedMethods())\n  .listen(3000);","language":"js","uuid":"b23e3cae-d99c-41dd-aaa1-319f7353e113","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"通过指定不同的 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 来同时访问这三个接口，查看结果"}],"disableDrag":false},{"type":"code-block","code":"const api = '/text';\n\n['text', 'json', 'document', 'arraybuffer', 'blob'].forEach(responseType => {\n  const xhr = new XMLHttpRequest();\n  \n  xhr.responseType = responseType;\n  \n  xhr.open('GET', `http://localhost:3000${api}`);\n  \n  xhr.addEventListener('load', () => {\n    console.log('responseType: ', responseType, ', response: ', xhr.response);\n  });\n  \n  xhr.send();\n})","language":"js","uuid":"9d09839a-684e-426c-b152-140c9725e424","children":[{"type":"formatted","text":""}]},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"访问 "},{"type":"formatted","text":"/text","code":true},{"type":"formatted","text":" 接口"}],"disableDrag":false},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a81f4f90-6ae0-40c4-ab1e-c9312c8203c3.png","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a81f4f90-6ae0-40c4-ab1e-c9312c8203c3.png","width":619.5},{"type":"paragraph","children":[{"type":"formatted","text":"对于 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"text","code":true},{"type":"formatted","text":" 的请求，其结果被解析为了字符串，对于 "},{"type":"formatted","text":"json","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":" 类型的请求，由于返回结果无法解析，所以统统解析为了 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":"，对于 "},{"type":"formatted","text":"arraybuffer","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"blob","code":true},{"type":"formatted","text":" 则解析为了对于的二进制数据。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"访问 "},{"type":"formatted","text":"/json","code":true},{"type":"formatted","text":" 接口"}],"disableDrag":false},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_863aa82c-dad0-4860-ba48-9f07650daa4d.png","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_863aa82c-dad0-4860-ba48-9f07650daa4d.png","width":620},{"type":"paragraph","children":[{"type":"formatted","text":"对于 "},{"type":"formatted","text":"text","code":true},{"type":"formatted","text":"，不做任何解析，只是将数据转化为了字符串；对于 "},{"type":"formatted","text":"json","code":true},{"type":"formatted","text":"，将数据转化为了 JavaScript 对象，对于 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":"，无法解析，因此结果是 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":"，对于 "},{"type":"formatted","text":"arraybuffer","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"blob","code":true},{"type":"formatted","text":"，则转化为了相应的二进制数据。"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"访问 "},{"type":"formatted","text":"/xml","code":true},{"type":"formatted","text":" 接口"}],"disableDrag":false},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_f9957c97-0dc2-4c4a-850b-f6046162813f.png","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_f9957c97-0dc2-4c4a-850b-f6046162813f.png","width":620},{"type":"paragraph","children":[{"type":"formatted","text":"对于 "},{"type":"formatted","text":"text","code":true},{"type":"formatted","text":"，将结果转化为了字符串，对于 "},{"type":"formatted","text":"json","code":true},{"type":"formatted","text":"，无法解析，结果为 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":"，对于 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":"，可以解析，于是将结果转化为了一个 DOM 对象，对于 "},{"type":"formatted","text":"arraybuffer","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"blob","code":true},{"type":"formatted","text":" 则是转化为了相应的二进制对象。"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"除了可以通过 "},{"type":"formatted","text":"xhr.response","code":true},{"type":"formatted","text":" 访问到请求结果，还可以通过 "},{"type":"formatted","text":"xhr.responseText","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"xhr.responseXML","code":true},{"type":"formatted","text":" 来访问到返回结果，它们两个的值和 "},{"type":"formatted","text":"xhr.response","code":true},{"type":"formatted","text":" 的值是一样的，不同的是仅当 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"text","code":true},{"type":"formatted","text":" 时，才可以访问 "},{"type":"formatted","text":"xhr.responseText","code":true},{"type":"formatted","text":"，否则会抛出异常；同理，只有当 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"document","code":true},{"type":"formatted","text":" 时，才可以访问 "},{"type":"formatted","text":"xhr.responseXML","code":true},{"type":"formatted","text":"，否则也会抛出异常；而 "},{"type":"formatted","text":"xhr.response","code":true},{"type":"formatted","text":" 无论 "},{"type":"formatted","text":"responseType","code":true},{"type":"formatted","text":" 的取值是什么都可以访问，不会抛出异常。"}],"disableDrag":false}],"tags":["JavaScript"],"createTime":1704197961211,"updateTime":1759825477353,"linkedCards":[]},"meta":{"type":"card","publishTime":1759825477353}}