"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"aa21709f-4983-4b7f-952f-2c20b79495ee","children":[{"type":"formatted","text":"同样可以在函数里面使用 "},{"type":"formatted","code":true,"text":"$#"},{"type":"formatted","text":"，表示参数个数，"},{"type":"formatted","code":true,"text":"$*"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"$@"},{"type":"formatted","text":"，表示参数列表。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"86ab0b61-4aea-4fe2-954f-d4bd1506d835","children":[{"type":"formatted","text":"函数内部变量可声明为局部变量，使用 "},{"type":"formatted","code":true,"text":"local"}]},{"type":"code-block","language":"bash","uuid":"8504f22b-9cb9-49ed-9e05-06fbccc0d795","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"90cf4366-3743-48b9-8c67-f086b3e05722","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#!/bin/zsh\n\nval=10\n\nadd() {\n    local val=$[ $1 + $2 ]\n    echo \"$val\"\n}\nres=$(add 1 2)\necho \"1 + 2 = $res\"\n\n# 外部 val 还是 10，不会受到影响\necho \"outer val: $val.\"","collabId":"3b46b2ac-3549-4220-9c65-a8f0207faca0","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"bash","uuid":"9e653e58-6277-4e15-b51e-8e8c24987bc4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"67d6235f-3d95-4403-bd12-07231fb5b6ef","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"xt in ~/shell/func λ ./05.sh\n1 + 2 = 3\nouter val: 10.","collabId":"27af1fd9-39ca-4ccc-98d5-f3675a4ccf83","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a231dac9-bdf9-44bf-950a-1e022e525bed","children":[{"type":"formatted","text":"传递数组参数"}]},{"type":"code-block","language":"bash","uuid":"7ff1a5d8-3a4e-44d4-94a7-4ad73658ec12","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cd80496d-3b78-4352-833a-60c5d57a1764","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#!/bin/zsh\n\narray=(1 2 3 4)\n\nprocess_data() {\n    len=$#\n    for (( i = 1; i <= $len; i++ ))\n        do\n            echo \"param$i: $1\"\n            shift\n        done\n}\n\nprocess_data ${array[*]}","collabId":"99d74bf6-60f0-48a0-a9af-c39a2dee49a8","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"68b6af74-203b-439b-802a-50dcb82eece4","children":[{"type":"formatted","text":"返回数组"}]},{"type":"code-block","language":"bash","uuid":"1aba5cc7-ae0e-4563-8aec-6234f7bc826f","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"63706a0b-cbb8-4cde-8e9e-6878a1b18b90","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"#!/bin/zsh\n\nfunction times2 {\n    local origin_arr=($(echo \"$@\"))\n    local new_arr=($(echo \"$@\"))\n    local i\n    for (( i = 1; i <= $#; i++ ))\n    {\n        # 数组元素翻倍\n        new_arr[$i]=$[ ${origin_arr[$i]} * 2 ]\n    }\n    # 输出新数组，即返回数组\n    echo ${new_arr[*]}\n}\n\narr=(1 2 3 4 5)\n# 拿到返回数组\nnew_arr=$(times2 ${arr[*]})\necho ${new_arr[*]}","collabId":"c04c7fdc-aad6-4640-87fc-205fdf6f2476","children":[{"type":"formatted","text":""}]}]}],"tags":["Shell编程/函数"],"createTime":1689258139413,"updateTime":1743303640393,"linkedCards":[{"id":110,"target":{"key":"card:110","type":"card","id":110},"summary":"读取用户输入的参数 ./add.sh 10 20 如何拿到 10 和 20 这两个参数。 $0 ：调用脚本的命令 $n ：输入参数 $1 ：10 $2 ：20 xt in ~/shell/read λ cat greet.sh #!/bin...","tags":["Shell编程"]},{"id":118,"target":{"key":"card:118","type":"card","id":118},"summary":"Shell 与输入相关的特殊变量。 $# ：参数个数 获得最后一个参数 # 错误写法 ${$#} 不能在 {} 里面使用美元符 $ ，得改为 ! # 非常奇怪，但是很有用 ${!#} 获得所有参数 $* ：所有参数视作整体 $@ ：分开保存...","tags":["Linux","Shell编程/输入"]},{"id":125,"target":{"key":"card:125","type":"card","id":125},"summary":"Shell 脚本中函数的创建与使用。格式： function name { commands } function name { commands } 使用： name 举个🌰： #!/bin/zsh function echo_hell...","tags":["Shell编程/函数"]}]},"meta":{"type":"card","publishTime":1743303640393}}