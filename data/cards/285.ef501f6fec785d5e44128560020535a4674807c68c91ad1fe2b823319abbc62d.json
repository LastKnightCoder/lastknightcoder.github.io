k);","collabId":"e0ead1f2-e171-4ff1-91ef-89c6a27053a0","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3b6199cd-7e2f-4da6-8063-6d0deb3dfad5","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"new Promise()"},{"type":"formatted","text":"来创建一个 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 实例，"},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 实例存在三种状态，"},{"type":"formatted","code":true,"text":"pendding"},{"type":"formatted","text":" 态，"},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 态和 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":" 态。实例上存在一个 "},{"type":"formatted","code":true,"text":"then"},{"type":"formatted","text":" 的方法，该方法接受两个函数作为参数传入，当 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 实例变为 "},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 态时，传入 "},{"type":"formatted","code":true,"text":"then"},{"type":"formatted","text":" 的第一个函数将会被执行，当 "},{"type":"formatted","code":true,"text":"Promise"},{"type":"formatted","text":" 实例变为 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":" 态时，传入 "},{"type":"formatted","code":true,"text":"then"},{"type":"formatted","text":" 的第二个函数会被执行。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d460f993-4abd-4893-8a78-1f4d8cbf6bca","children":[{"type":"formatted","code":true,"text":"new Promise()"},{"type":"formatted","text":" 接受一个函数作为参数，该函数接收两个参数 "},{"type":"formatted","code":true,"text":"resolve"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"reject"},{"type":"formatted","text":"，这两个参数也是函数。当 "},{"type":"formatted","code":true,"text":"new Promise()"},{"type":"formatted","text":" 创建实例时，初始实例为 "},{"type":"formatted","code":true,"text":"pendding"},{"type":"formatted","text":" 态，然后立即执行传入的函数，如果在函数中调用了 "},{"type":"formatted","code":true,"text":"resolve"},{"type":"formatted","text":" 方法，那么实例的状态就变成 "},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 态，如果调用了 "},{"type":"formatted","code":true,"text":"reject"},{"type":"formatted","text":" 方法，实例的状态就变成了 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":" 态。"}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"ca64297f-ed0e-4b85-9ce2-58647bb7ea89","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"db2c3b8a-20cd-41bc-8837-19f9215f4255","children":[{"type":"formatted","text":"注意："},{"type":"formatted","code":true,"text":"resolved"},{"type":"formatted","text":" 态和 "},{"type":"formatted","code":true,"text":"rejected"},{"type":"formatted","text":" 态只能由 "},{"type":"formatted","code":true,"text":"pendding"},{"type":"formatted","text":" 态转化而来，因此如果 "},{"type":"formatted","code":true,"text":"resolve"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"reject"},{"type":"formatted","text":" 都调用了，先调用的能有效地改变状态。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e5c8cf30-8a79-45ee-9b22-7f8529296187","children":[{"type":"formatted","text":"传入 "},{"type":"formatted","code":true,"text":"resolve"},{"type":"formatted","text":" 的值将作为参数传递给传入 "},{"type":"formatted","code":true,"text":"then"},{"type":"formatted","text":" 的第一个函数，传入 "},{"type":"formatted","code":true,"text":"reject"},{"type":"formatted","text":" 的值将作为参数传递给传入 "},{"type":"formatted","code":true,"text":"then"},{"type":"formatted","text":" 的第二个函数"}]},{"type":"code-block