{"version":1,"key":"card:692","content":{"id":692,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"application/x-www-form-unlencoded 和 multipart/formdata","code":true},{"type":"formatted","text":" 是通过 POST 提交表单时的两种数据编码方式。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"application/x-www-form-unlencoded","code":true},{"type":"formatted","text":" 是默认的提交方式，数据被编码为键值对，类似于查询字符串的格式提交数据 "},{"type":"formatted","text":"key1=value1&key2=value2","code":true},{"type":"formatted","text":"，如果 "},{"type":"formatted","text":"key","code":true},{"type":"formatted","text":" 或 "},{"type":"formatted","text":"value","code":true},{"type":"formatted","text":" 中存在特殊字符，比如"},{"type":"formatted","text":"「中文、空格、","bold":true},{"type":"formatted","bold":true,"text":"&","code":true},{"type":"formatted","bold":true,"text":"、"},{"type":"formatted","bold":true,"text":"=","code":true},{"type":"formatted","bold":true,"text":"、"},{"type":"formatted","bold":true,"text":"#","code":true},{"type":"formatted","bold":true,"text":"」"},{"type":"formatted","text":" 等会进行 "},{"type":"formatted","text":"percent-encoding","code":true},{"text":"。","type":"formatted"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"原始数据："}],"disableDrag":false},{"type":"code-block","language":"","code":"username = 张三\nmessage  = hello world & bye","uuid":"66adcf70-6a73-48b5-a5bc-7b2ef2d9e131","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"编码后："}],"disableDrag":false},{"type":"code-block","language":"","code":"username=%E5%BC%A0%E4%B8%89&message=hello+world+%26+bye","uuid":"e22a09cb-2c07-462b-a139-3f87c8cf76bf","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如果包含文件的话，需要将提交方式设置为 "},{"type":"formatted","text":"multipart/formdata","code":true},{"type":"formatted","text":"，否则文件会被序列化为字符串 "},{"type":"formatted","text":"[object File]","code":true},{"type":"formatted","text":" 进行提交。"}],"disableDrag":false},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"multipart/formdata","code":true},{"type":"formatted","text":" 以多个 part 来分割数据提交，分割数据使用随机的 boundary 边界字符串分割（在进行提交时，boundary 会由浏览器自动生成），在最后的 boundary 末尾有 "},{"type":"formatted","text":"--","code":true},{"type":"formatted","text":"，表示结束。"}]},{"type":"paragraph","children":[{"type":"formatted","text":"每个 part 包含："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"Content-Disposition","code":true},{"type":"formatted","text":" 头，固定值 "},{"type":"formatted","text":"formdata","code":true},{"type":"formatted","text":"，后跟参数，参数说明如下"}],"disableDrag":false},{"type":"table","children":[{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"参数"}]},{"type":"table-cell","children":[{"type":"formatted","text":"必填"}]},{"type":"table-cell","children":[{"type":"formatted","text":"说明"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"name","code":true}]},{"type":"table-cell","children":[{"type":"formatted","text":"✅"}]},{"type":"table-cell","children":[{"type":"formatted","text":"对应 HTML "},{"type":"formatted","text":"<input name=\"...\">","code":true},{"type":"formatted","text":" 的字段名"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"filename","code":true}]},{"type":"table-cell","children":[{"type":"formatted","text":"文件时必填"}]},{"type":"table-cell","children":[{"type":"formatted","text":"上传文件的原始文件名"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"filename*","code":true}]},{"type":"table-cell","children":[{"type":"formatted","text":"可选"}]},{"type":"table-cell","children":[{"type":"formatted","text":"RFC 5987 编码的文件名，用于非 ASCII 文件名"}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"filename*","code":true},{"type":"formatted","text":" 的语法结构为 "},{"type":"formatted","text":"filename*=charset'language'encoded-value","code":true}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"charset","code":true},{"type":"formatted","text":"，编码，基本上固定为 UTF-8"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"language","code":true},{"type":"formatted","text":"，语言，如 zh，可为空"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"encoded-value","code":true},{"type":"formatted","text":"，使用 "},{"type":"formatted","text":"encodeURIComponent","code":true},{"type":"formatted","text":" 编码"}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"可选的 "},{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":" 头（文件类型）"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"字段值或文件二进制内容"}],"disableDrag":false}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"一个完整的 HTTP 请求示例："}]},{"type":"code-block","code":"POST /upload HTTP/1.1\nContent-Type: multipart/form-data; boundary=----Boundary7MA4YWxkTrZu0gW\n\n------Boundary7MA4YWxkTrZu0gW\nContent-Disposition: form-data; name=\"username\"\n                     ↑ 固定值   ↑ 字段名，对应 <input name=\"username\">\n\nalice\n↑ 字段值，纯文本，无需编码\n------Boundary7MA4YWxkTrZu0gW\nContent-Disposition: form-data; name=\"avatar\"; filename=\"photo.jpg\"\nContent-Type: image/jpeg\n              ↑ 文件 part 需要额外的 Content-Type 说明 MIME 类型\n\n<JPEG 二进制数据...>\n------Boundary7MA4YWxkTrZu0gW\nContent-Disposition: form-data; name=\"doc\"; filename*=UTF-8''%E6%8A%A5%E5%91%8A.pdf\nContent-Type: application/pdf\n              ↑ 中文文件名用 filename* 避免乱码\n\n<PDF 二进制数据...>\n------Boundary7MA4YWxkTrZu0gW--\n↑ boundary 末尾加 -- 表示整个 multipart 结束","language":"HTTP","uuid":"14eabe48-aa81-4d55-b6ba-a9221777a129","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"有的时候同一个字段的值包含多个文件 ("},{"type":"formatted","text":"<input name=\"photos\" type=\"file\" multiple />","code":true},{"type":"formatted","text":")，每一个文件也是使用边界字符串分割为多个 part，不过这些 part 的 "},{"type":"formatted","text":"name","code":true},{"type":"formatted","text":" 是同一个，在服务端会被解析为一个数组"}],"disableDrag":false},{"type":"code-block","code":"------Boundary\nContent-Disposition: form-data; name=\"photos\"; filename=\"a.jpg\"\nContent-Type: image/jpeg\n\n<binary>\n\n------Boundary\nContent-Disposition: form-data; name=\"photos\"; filename=\"b.jpg\"\nContent-Type: image/jpeg\n\n<binary>\n------Boundary--","language":"HTTP","uuid":"8f17b0d5-6361-41f3-89d8-f1ff818e1715","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"那么下一个问题是如何指定提交方式呢？如果是通过 "},{"type":"formatted","text":"form","code":true},{"type":"formatted","text":" 表单直接提交，可以通过 "},{"type":"formatted","text":"enctype","code":true},{"type":"formatted","text":" 属性指定提交方式，有三种合法值："}]},{"type":"code-block","code":"<!-- 默认，不写就是这个 -->\n<form method=\"POST\" enctype=\"application/x-www-form-urlencoded\">\n\n<!-- 有文件上传时必须用这个 -->\n<form method=\"POST\" enctype=\"multipart/form-data\">\n\n<!-- 几乎不用，仅调试用途，值之间用换行分隔，不做任何编码 -->\n<form method=\"POST\" enctype=\"text/plain\">","language":"HTML","uuid":"55e9f27f-0b1f-4042-b092-01b23c9eee87","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"两个注意事项："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"如果表单包含文件，但是通过 "},{"type":"formatted","text":"application/x-www-form-urlencoded","code":true},{"type":"formatted","text":" 编码提交会怎么样，会导致文件会被序列化为 "},{"type":"formatted","text":"[object File]","code":true},{"type":"formatted","text":" 字符串"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"如果包含文件，但是通过 GET 提交会怎么样，首先通过 "},{"type":"formatted","text":"enctype","code":true},{"type":"formatted","text":" 指定的值无效，会被直接忽略，然后会通过查询字符串传递参数，如果包含文件，文件内容也会被序列化为 "},{"type":"formatted","text":"[object File]","code":true}]}]}]},{"type":"callout","calloutType":"warning","title":"误区","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"一开始我以为浏览器如果在不指定 "},{"type":"formatted","text":"enctype","code":true},{"type":"formatted","text":" 属性的情况下，会根据表单中是否存在文件自行选择编码方式，比如如果不存在文件，那么就使用 "},{"type":"formatted","text":"urlencoded","code":true},{"type":"formatted","text":" 编码，如果存在则使用 "},{"type":"formatted","text":"multipart","code":true},{"type":"formatted","text":" 编码，但是浏览器是不会这么做的，默认值就是 "},{"type":"formatted","text":"urlencoded","code":true},{"type":"formatted","text":"，所以如果存在文件并且没有手动指定 "},{"type":"formatted","text":"enctype","code":true},{"type":"formatted","text":" 的话，文件的值都会被序列化为 "},{"type":"formatted","text":"[object File]","code":true},{"type":"formatted","text":"。"}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"相比之下 fetch 手动提交要智能一些，浏览器会根据 "},{"type":"formatted","text":"body","code":true},{"type":"formatted","text":" 的类型来确定 "},{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":"："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"URLSearchParams -> application/x-www-form-urlencoded","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"FormData -> multipart/form-data","code":true}]}]}]},{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"也可以手动指定 "},{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":"，但是有两个注意事项："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":" 要和 "},{"type":"formatted","text":"body","code":true},{"type":"formatted","text":" 匹配，如果不匹配，浏览器是"},{"type":"formatted","text":"不会\"自动匹配修复\"","bold":true},{"type":"formatted","text":"的，而是按照你说的发出去，而服务端会根据你指定的 "},{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":" 解析，这种情况就没法解析成功，会遇到 400/415（Bad Request / Unsupported Media Type）错误"}]},{"type":"code-block","code":"fetch('/api', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: new URLSearchParams({ a: 1 }).toString() // 实际传递的是查询字符串，但是服务端会尝试解析为 JSON 对象，导致解析报错\n})","language":"JavaScript","uuid":"9d7943eb-cc85-4829-8d1f-5c62ad129283","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"如果手动指定为 "},{"type":"formatted","text":"multipart/form-data","code":true},{"type":"formatted","text":"，但是忘记了 boundary 边界字符串，会导致服务端无法解析，通常会报错 \"miss boundary\""}]},{"type":"code-block","code":"const fd = new FormData();\nfd.append('a', '1');\n\nfetch('/upload', {\n  method: 'POST',\n  headers: { 'Content-Type': 'multipart/form-data' }, // ❌ 不要这么写\n  body: fd\n});","language":"JavaScript","uuid":"fb5a01ca-d982-4dda-bac0-7747603372f9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"所以在这种情况下，不需要手动指定 "},{"type":"formatted","text":"Content-Type","code":true},{"type":"formatted","text":"，浏览器会自动推断并且自动生成随机的 boundary 边界字符串"}],"disableDrag":false},{"type":"code-block","code":"fetch('/upload', { method: 'POST', body: fd }); // ✅ 不要手动设置 Content-Type","language":"JavaScript","uuid":"175e1f04-2b33-466e-a416-046c23d75b78","children":[{"type":"formatted","text":""}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"在最后使用一个表格进行总结："}],"disableDrag":false},{"type":"table","children":[{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"对比维度"}]},{"type":"table-cell","children":[{"type":"formatted","text":"application/x-www-form-urlencoded"}]},{"type":"table-cell","children":[{"type":"formatted","text":"multipart/form-data"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"默认行为"}]},{"type":"table-cell","children":[{"type":"formatted","text":"HTML "},{"type":"formatted","text":"<form>","code":true},{"type":"formatted","text":" 默认"}]},{"type":"table-cell","children":[{"type":"formatted","text":"需显式指定 "},{"type":"formatted","text":"enctype","code":true}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"文件上传"}]},{"type":"table-cell","children":[{"type":"formatted","text":"不支持"}]},{"type":"table-cell","children":[{"type":"formatted","text":"支持"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"二进制数据"}]},{"type":"table-cell","children":[{"type":"formatted","text":"不支持"}]},{"type":"table-cell","children":[{"type":"formatted","text":"支持"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"中文/特殊字符"}]},{"type":"table-cell","children":[{"type":"formatted","text":"percent-encoding，体积膨胀"}]},{"type":"table-cell","children":[{"type":"formatted","text":"原样传输，无膨胀"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"请求体格式"}]},{"type":"table-cell","children":[{"type":"formatted","text":"单一字符串 "},{"type":"formatted","text":"k=v&k=v","code":true}]},{"type":"table-cell","children":[{"type":"formatted","text":"多段结构，有 boundary"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"请求体大小"}]},{"type":"table-cell","children":[{"type":"formatted","text":"小（纯文本场景）"}]},{"type":"table-cell","children":[{"type":"formatted","text":"稍大（有 boundary 开销）"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"服务端解析"}]},{"type":"table-cell","children":[{"type":"formatted","text":"简单"}]},{"type":"table-cell","children":[{"type":"formatted","text":"需要专门的 multipart 解析库"}]}]},{"type":"table-row","children":[{"type":"table-cell","children":[{"type":"formatted","text":"适用场景"}]},{"type":"table-cell","children":[{"type":"formatted","text":"登录、搜索、简单表单"}]},{"type":"table-cell","children":[{"type":"formatted","text":"文件上传、富表单"}]}]}]}],"tags":["HTML/form","概念对比","JavaScript/fetch"],"createTime":1775047759885,"updateTime":1775053026553,"linkedCards":[]},"meta":{"type":"card","publishTime":1775053026553}}