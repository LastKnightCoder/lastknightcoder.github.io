3ead1dec2","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1f5fbeed-cedb-449c-b7fe-d150e5f7e034","children":[{"type":"formatted","text":"基金 A：年收益率为 10%，波动率为 4%"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6a8537d9-131e-478e-b155-c2faad052a36","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0fe9f9f5-59b1-4849-8dea-1574e54084c1","children":[{"type":"formatted","text":"基金 B：年收益率为 14%，波动率为 12%"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"124e6bba-8610-4c23-964c-80e14c92275f","children":[{"type":"formatted","text":"它们夏普比率分别为"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\text{Sharpe}_A = \\frac{10\\% - 2\\%}{4\\%} = 2 \\\\\n\\text{Sharpe}_B = \\frac{14\\% - 2\\%}{12\\%} = 1","collabId":"6e1ba143-097a-49ed-8996-2a674638a518","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3cd5b0b2-ca55-43b1-8408-0e120510321d","children":[{"type":"formatted","text":"虽然 B 的收益率更高，但 A 的夏普比率远高于 B，说明 A 的性价比更好。B 的高收益是靠承担巨大风险换来的，而 A 能让你在承担更小风险的情况下依旧获得不错的收益。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c02b78d3-e1ca-44c6-a926-1a3277f507f3","children":[{"type":"formatted","text":"当然夏普比率也有其局限性："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"4e7b0a32-d6f4-458a-8e42-e5fe6f3da1d2","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c