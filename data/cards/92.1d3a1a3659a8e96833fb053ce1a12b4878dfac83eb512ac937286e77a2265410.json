{"version":1,"key":"card:92","content":{"id":92,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"添加与删除远程分支"}]},{"type":"code-block","code":"# 添加远程分支\ngit remote add origin https://github.com/user/repo.git\n# 删除远程分支\ngit remote rm origin","language":"bash","uuid":"44ac4283-92de-4f3e-aa7e-ea1d95edde82","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"强制推送"}]},{"type":"code-block","code":"git push --force","language":"bash","uuid":"aabfedc5-0204-41bb-a3c7-7f526def813b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"放弃本地内容，使用远程仓库的内容"}]},{"type":"code-block","code":"git fetch --all\ngit reset --hard origin/master","language":"bash","uuid":"f335493f-4686-49bf-834e-4061c292bd26","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"删除本地分支"}]},{"type":"code-block","code":"git branch -d branchName\ngit branch -D branchName # 强制删除","language":"bash","uuid":"f9dfc471-32cf-4ae6-a58d-74f811b949d1","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"拉取远程创建的分支"}]},{"type":"code-block","code":"git fetch origin branchName\ngit checkout -b branchName origin/branchName","language":"bash","uuid":"0f4ccfcf-0454-4ab9-8954-01d8d1fd9a40","children":[{"type":"formatted","text":""}]}],"tags":["Git"],"createTime":1689175075554,"updateTime":1743303640390,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640390}}