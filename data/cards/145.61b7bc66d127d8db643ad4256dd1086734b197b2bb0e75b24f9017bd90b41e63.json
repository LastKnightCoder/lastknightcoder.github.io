ldren":[{"children":[{"code":true,"text":"target","type":"formatted"},{"text":"：被监听的元素","type":"formatted"}],"collabId":"53b9eef5-0ee3-4724-8782-5123a44c5689","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"ac4ceaf9-e47b-408e-b981-830d9b9e58d3","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"time","type":"formatted"},{"text":"：自页面加载后，该事件发生的时间点，单位为毫秒","type":"formatted"}],"collabId":"bbf63d15-c6a7-4678-be38-ab254d36d825","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"2b5e2959-0a34-402c-a88b-bac5a8d7292e","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"isIntersecting","type":"formatted"},{"text":"：是进入视口还是离开视口","type":"formatted"}],"collabId":"5baddd8d-02ef-4065-b0ab-9956ae617f68","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"当被监听的元素进入或消失于视口中时，均会触发回调函数的执行，","type":"formatted"},{"code":true,"text":"isIntersecting","type":"formatted"},{"text":" 的值可以表示是出现在视口中还是消失在视口中，当值为 ","type":"formatted"},{"code":true,"text":"true","type":"formatted"},{"text":" 时，表示出现在视口中，为 ","type":"formatted"},{"code":true,"text":"false","type":"formatted"},{"text":" 表示消失在视口中。","type":"formatted"}],"collabId":"e6fdf77a-7ba5-44d5-95bf-01bd3317616f","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"0c811894-0c9a-4ac7-955e-102b2790043c","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"58023e3f-c1c6-4b0d-a328-1026bbde57ef","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"code":true,"text":"options","type"