{"version":1,"key":"card:137","content":{"id":137,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"浏览器打印日志，除了拼接字符串，还可以使用占位符。"}]},{"type":"code-block","code":"// %s 字符串\nconst name = \"Alice\";\nconsole.log(\"My name is %s\", name);","language":"javascript","uuid":"55bdeab3-4d01-4f80-a5cb-aae910141b44","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"// %d 数字\nconst price = 18;\nconsole.log(\"价格是 %d 元\", price);","language":"JavaScript","uuid":"8eb61237-4614-4cf2-bb4d-5846c427084c","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"// %o 对象\nconst obj = {\n  name: \"Bob\",\n  age: 19\n}\n\nconsole.log('%o', obj);","language":"JavaScript","uuid":"c153fea7-3b31-41e3-8d9f-359449cb1e5e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"最神奇的是 "},{"type":"formatted","text":"%c","code":true},{"text":"，可以自定义样式","type":"formatted"}]},{"type":"code-block","code":"const errorStyle = 'color: white; background: red; border-radius: 2px;padding: 0 4px';\nconst successStyle = 'color: white; background: green; border-radius: 2px;padding: 0 4px';\nconsole.log('%cSomething Error, %cSomething Good!', errorStyle, successStyle, \"No Style\\n\\n\");","language":"JavaScript","uuid":"d0f03226-d878-43a3-8f4a-8fda69ce598b","children":[{"type":"formatted","text":""}]},{"type":"image","url":"https://github.com/LastKnightCoder/image-for-2022/raw/master/image.1kqukqdo9ukg.png","pasteUploading":false,"children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"可以自定义的属性包含："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"background and its longhand equivalents"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"border and its longhand equivalents"}]}]},{"type":"list-item","children":[{"type":"paragraph","ch