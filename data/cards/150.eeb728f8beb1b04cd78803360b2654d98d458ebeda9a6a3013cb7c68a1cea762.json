{"version":1,"key":"card:150","content":{"id":150,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"34eff92a-6b36-42bd-b781-0ca83856f9f9","children":[{"type":"formatted","text":"当设置 "},{"type":"formatted","code":true,"text":"attributes"},{"type":"formatted","text":" 属性为 "},{"type":"formatted","code":true,"text":"true"},{"type":"formatted","text":" 时，就可以监听到属性的变化，包括自定义属性。"}]},{"type":"code-block","language":"html","uuid":"f6075ff3-95a9-4a5b-867b-aac19c3c2e6c","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b52c6d8d-85cd-4584-b3e4-ee34dd1264eb","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<div id=\"container\" class=\"red\">\n  <p>世界这么大，我想去看看</p>\n</div>\n<button id=\"btn\">改变颜色</button>","collabId":"19310e22-0b7f-494c-89e6-3cd8f596de13","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"JavaScript","uuid":"08783e9b-596a-47f2-baee-326c7f80171f","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"bc18a546-1e7b-4c4f-a2ae-23bd4cdc06c1","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const container = document.querySelector('#container');\nconst observer = new MutationObserver(mutations => {\n  console.log(mutations);\n});\nobserver.observe(container, {\n  attributes: true\n});\n\nconst btn = document.querySelector('#btn');\nbtn.addEventListener('click', () => {\n  container.classList.toggle('red');\n  container.classList.toggle('green');\n});","collabId":"d6c39ec2-d3c7-441d-9529-fa57edba1306","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"be1ca141-b213-4611-9582-9c706f077c75","children":[{"type":"formatted","text":"属性变动对应的 "},{"t