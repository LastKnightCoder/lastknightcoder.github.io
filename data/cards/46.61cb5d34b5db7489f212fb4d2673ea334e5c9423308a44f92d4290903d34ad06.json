{"version":1,"key":"card:46","content":{"id":46,"content":[{"type":"callout","calloutType":"info","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"该笔记是来源于公众号文章"},{"type":"link","url":"https://mp.weixin.qq.com/s/N25KcGneKPgvBa8zBownlw","openEdit":false,"children":[{"type":"formatted","text":"还在用定时器吗？借助 CSS 来监听事件"}]},{"type":"formatted","text":"。"}]}]},{"type":"header","children":[{"type":"formatted","text":"hover延时触发"}],"level":2},{"type":"header","children":[{"type":"formatted","text":"一般方法"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"鼠标进入时开始定时器"}]},{"type":"code-block","code":"var timer = null\nel.addEventListener('mouseover', () => {\n  timer && clearTimeout(timer)\n  timer = setTimeout(() => {\n    // 具体逻辑\n  }, 1000)\n})","language":"JavaScript","uuid":"df14edde-150d-4c24-baed-6c64c1b32fe3","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"鼠标离开时取消定时器"}]},{"type":"code-block","code":"el.addEventListener('mouseout', () => {\n  timer && clearTimeout(timer)\n})","language":"JavaScript","uuid":"b148fa2d-222d-45b5-a4e2-310b41ad7568","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"利用动画结束事件"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"为元素添加延时动画"}]},{"type":"code-block","code":"button:hover{\n  opacity: 0.999; /*无关紧要的样式*/\n  transition: 0s 1s opacity; /*延时 1s */\n}","language":"css","uuid":"cdabe1ed-58e6-4d23-ba51-4f6e43d7e680","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"监听动画结束事件"}]},{"type":"code-block","code":"el.addEventListener('transitionend', () => {\n  // 具体逻辑\n})","language":"JavaScript","uuid":"91b8bb05-fdd8-4af7-bfa6-a3334409727f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"无需定时器，也无需取消，更无需考虑 dom 结构，完美实现。"}]},{"type":"header","children":[{"type":"formatted","text":"长按触发"}],"level":2},{"type":"header","children":[{"type":"formatted","text":"一般方法"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"借助定时器，按下时开启定时器，离开时取消定时器"}]},{"type":"code-block","code":"el.onmousedown = function(){\n    this.timer && clearTimeout(this.timer);\n    this.timer = settimeout(function(){\n        //业务代码\n    },1000)\n}\nel.onmouseup = function(){\n    this.timer && clearTimeout(this.timer);\n}","language":"TypeScript","uuid":"fc9d4f16-378e-49c0-a496-642f31b29a1e","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"利用动画结束事件"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"为 "},{"type":"formatted","text":":active","code":true},{"type":"formatted","text":" 伪类添加延时动画"}]},{"type":"code-block","code":"button:hover:active{\n  opacity: .999; /*无关紧要的样式*/\n  transition: opacity 1s; /*延时 1s */\n}","language":"css","uuid":"38cd5c2d-9a8f-4e4b-b4b5-d2663a67b368","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"然后再监听 "},{"type":"formatted","text":"transitionend","code":true},{"type":"formatted","text":" 事件"}]},{"type":"code-block","code":"el.addEventListener('transitionend', () => {\n  // 具体逻辑\n})","language":"JavaScript","uuid":"88f07136-b1c9-4cac-8126-67ccbb5b961b","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"轮播和暂停"}],"level":2},{"type":"header","children":[{"type":"formatted","text":"一般方法"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"鼠标放上去时暂停，鼠标离开时自动滚动，借助定时器 "},{"type":"formatted","text":"setInterveal","code":true},{"type":"formatted","text":" 进行轮播，鼠标放上去时清除定时器，鼠标离开时新建定时器"}]},{"type":"code-block","code":"function autoPlay(){\n  timer && clearInterval(timer)\n  timer = setInterval(function(){\n    // 轮播逻辑\n  }, 1000)\n}\nautoPlay()\nview.onmouseover = function(){\n    timer && clearInterval(timer)\n}\nel.onmouseout = function(){\n    autoPlay()\n}","language":"JavaScript","uuid":"1dea44a1-8e78-460e-bc90-57ad7e72035c","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"animationiteration 事件"}],"level":2},{"type":"paragraph","children":[{"type":"formatted","text":"设置动画为无限次数，每次动画开始时都会触发 "},{"type":"formatted","text":"animationiteration","code":true},{"type":"formatted","text":" 事件，鼠标放上去时动画暂停"}]},{"type":"code-block","code":".view {\n  animation: scroll 1s infinite; /*每1s动画，无限循环*/\n}\n.view:hover{\n  animation-play-state: paused; /*hover暂停*/\n}\n@keyframes scroll {\n  to {\n    transform: translateZ(.1px); /*无关紧要的样式*/\n  }\n}","language":"css","uuid":"291d7d10-693f-4018-b17e-6a9c194a5443","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"view.addEventListener(\"animationiteration\", () => {\n  // 轮播逻辑\n})","language":"JavaScript","uuid":"0f203b58-09f9-4019-826e-c69a24c4f8d5","children":[{"type":"formatted","text":""}]}],"tags":["CSS/技巧","技巧/CSS"],"createTime":1688999551522,"updateTime":1743303640387,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640387}}