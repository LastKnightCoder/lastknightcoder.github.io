{"version":1,"key":"card:265","content":{"id":265,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"在 ES5 中想获得正则对象包含哪些修饰符，一般通过解析 "},{"type":"formatted","text":"toString","code":true},{"type":"formatted","text":" 得到的字符串"}]},{"type":"code-block","code":"const getFlags = function (re) {\n  const str = re.toString();\n  return str.substring(str.lastIndexOf(\"/\") + 1, str.length);\n};\n\nconst re = /abc/giu;\nconsole.log(getFlags(re)); // \"giu\"","language":"js","uuid":"019e511d-00e0-419b-b1b1-0cb08a255efd","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"在 ES6 中为正则对象添加了一个 "},{"type":"formatted","text":"flags","code":true},{"type":"formatted","text":" 属性，可以通过 "},{"type":"formatted","text":"flags","code":true},{"type":"formatted","text":" 属性来获得正则对象包含的修饰符"}]},{"type":"code-block","code":"const re = /abc/giu;\nconsole.log(re.source); // \"abc\"\nconsole.log(re.flags);  // \"giu\"","language":"js","uuid":"74af6671-27a9-48d2-85d9-a15d16952aca","children":[{"type":"formatted","text":""}]}],"tags":["JavaScript"],"createTime":1691717720400,"updateTime":1743303640422,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640422}}