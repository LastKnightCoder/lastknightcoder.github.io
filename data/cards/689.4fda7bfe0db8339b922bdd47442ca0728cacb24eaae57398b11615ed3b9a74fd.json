{"version":1,"key":"card:689","content":{"id":689,"content":[{"children":[{"code":true,"text":"moveBefore(nodeToMove, referenceNode)","type":"formatted"},{"text":" 函数的作用是把 ","type":"formatted"},{"code":true,"text":"nodeToMove","type":"formatted"},{"text":" 插入到 ","type":"formatted"},{"code":true,"text":"referenceNode","type":"formatted"},{"text":" 之前，","type":"formatted"},{"text":"同时保留该节点及其子节点的所有内部状态。","textGradient":"ocean","type":"formatted"}],"collabId":"efa9f7ad-2fcd-4a47-b1df-64ddbca216f6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"code":true,"text":"referenceNode","type":"formatted"},{"text":" 可以设置为 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":"，当设置为 ","type":"formatted"},{"code":true,"text":"null","type":"formatted"},{"text":" 时，则表示插入到目标父元素的最后。","type":"formatted"}],"collabId":"122fe6a9-b5a6-4208-9b0b-a8edc2a50c77","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"96ce138b-4271-472e-a70c-3ede7ee8f9e5","color":"red","disableDrag":false,"tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","type":"highlight-block"},{"children":[{"text":"在此之前我们想移动节点，通常会通过 ","type":"formatted"},{"code":true,"text":"appendChild","type":"formatted"},{"text":" 或者 ","type":"formatted"},{"code":true,"text":"insertBefore","type":"formatted"},{"text":" 等 DOM API 实现，但是这种插入并不是「原子」的，而是分为了两个过程，第一步先把节点从 DOM 树中移除，第二步把节点插入到相应位置，这就会导致如下问题：","type":"formatted"}],"collabId":"724e982a-9b8d-4060-825e-1899ef07c826","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"code":true,"text":"iframe","type":"formatted"},{"text":" 会重新加载","type":"formatted"}],"collabId":"579b95ff-d050-45cb-af37-82b5b1e9014d","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"8cba058e-2236-425d-8f46-de1beabeea0e","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"正在进行的动画会中断","type":"formatted"}],"collabId":"053d61a8-31c1-48de-9133-43a501b74168","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"554a933e-c673-4a80-9af0-efca25bdff68","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"焦点会丢失，用户选中的文本也会丢失","type":"formatted"}],"collabId":"754e11da-a0b2-4f2b-9b63-01f3be314e0a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"126f97c0-dd94-4cc8-a496-ecd8cc0e836a","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"Web Components 会触发 ","type":"formatted"},{"code":true,"text":"disconnectedCallback","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"connectedCallback","type":"formatted"},{"text":"，这可能会导致组件内部执行不必要的清理和重新初始化逻辑","type":"formatted"}],"collabId":"094ed488-bf39-4194-8e6c-351bcbb5168a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"0b58ca84-6d7c-4c31-8ace-84dd30faf010","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"popover","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"dialog","type":"formatted"},{"text":" 会被关闭，其内部的焦点也会丢失，需要通过代码重新显示出来","type":"formatted"}],"collabId":"4ddea84c-e04c-4583-b560-7f4af7c9ebc7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"b8d080f5-540d-4d3c-b2a0-0d4549735457","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"55f7160e-8c4a-468b-92fd-1bc9c80bd953","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"媒体资源（音视频）无论使用何种方式移动，它的状态都会被保留，这是浏览器内部做的优化。","type":"formatted"}],"collabId":"bf9eb261-eff8-405e-89b0-386edec41bf1","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"440300a5-bd04-4d80-9af9-1b81a83e250b","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","type":"highlight-block"},{"children":[{"text":"而 ","type":"formatted"},{"code":true,"text":"moveBefore","type":"formatted"},{"text":" 它是一种","type":"formatted"},{"text":"「原子移动」","textGradient":"ocean","type":"formatted"},{"text":"，在移动的过程中可以保留所有的状态，这意味着以上情况都不会发生：","type":"formatted"}],"collabId":"9755d5ec-c382-4593-943e-e944aba3f8fa","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"code":true,"text":"iframe","type":"formatted"},{"text":" 不会重新加载","type":"formatted"}],"collabId":"7105fbca-04a9-4d38-8a74-47f0b7f181fc","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"ba9efd7c-a8f7-44b7-8692-3d044c6c400f","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"动画会继续执行","type":"formatted"}],"collabId":"bd0c5652-c84a-4d8b-997b-9b483f832be5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"9de7eaba-b586-4c08-b3aa-759e4753711a","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"焦点会继续保持在移动的元素中，选中的文字样式也会保留","type":"formatted"}],"collabId":"09b839d6-23fb-422a-9f42-5c262cb4dd25","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"65b827d0-a631-4c47-a681-074bbdcab859","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"Web Components 会触发一个 ","type":"formatted"},{"code":true,"text":"connectedMoveCallback","type":"formatted"},{"text":" 的生命周期函数，不会触发 ","type":"formatted"},{"code":true,"text":"disconnectedCallback","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"connectedCallback","type":"formatted"}],"collabId":"1777e650-dada-4f7c-98d4-0a2d4ec8ba93","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"a51f8d7f-b66e-4feb-8dfa-e687199444c2","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"popover","type":"formatted"},{"text":"、","type":"formatted"},{"code":true,"text":"dialog","type":"formatted"},{"text":" 等元素的状态保持，不会因为移动而导致被意外关闭","type":"formatted"}],"collabId":"e2a1ce8e-482b-4f76-abb7-dd9640731de6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"28b8cbe1-9f69-473d-b520-1aa92508f092","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"77238b57-d99d-4994-9fba-526ca20f4cb2","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"比较典型的使用场景是 React/Vue 框架中的 ","type":"formatted"},{"code":true,"text":"createPortal","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"Teleport","type":"formatted"},{"text":"，为了防止被 CSS 的 ","type":"formatted"},{"code":true,"text":"overflow: hidden","type":"formatted"},{"text":" 裁剪，通常会把元素插入到 ","type":"formatted"},{"code":true,"text":"body","type":"formatted"},{"text":" 下，通过 ","type":"formatted"},{"code":true,"text":"insertBefore","type":"formatted"},{"text":" 或者 ","type":"formatted"},{"code":true,"text":"appendChild","type":"formatted"},{"text":" 等 API 就会导致之前状态丢失，有了 ","type":"formatted"},{"code":true,"text":"moveBefore","type":"formatted"},{"text":" 状态就可以得以保存。","type":"formatted"}],"collabId":"6aca6e14-5474-4cfc-b916-474232bc085a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"还有拖拽排序、动态调整布局、模态框/抽屉组件的位置调整等场景，只要涉及到需要保持元素状态的 DOM 移动，都可以用 ","type":"formatted"},{"code":true,"text":"moveBefore","type":"formatted"},{"text":"。","type":"formatted"}],"collabId":"5125d478-723a-4e5e-8f8f-177c5369e6e5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"下面是一些具体的代码示例：","type":"formatted"}],"collabId":"34b8be0c-5c26-4bb1-b6ea-f633731e9644","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// 基本用法示例\nconst container = document.querySelector('#container');\nconst item = document.querySelector('#item');\nconst reference = document.querySelector('#reference');\n\n// 移动到 reference 之前\ncontainer.moveBefore(item, reference);\n\n// 移动到容器最后（reference 为 null）\ncontainer.moveBefore(item, null);","collabId":"10023999-e79c-4064-a399-ccf18a8599ae","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1ed00ffb-2597-42e3-a4da-b7ecfc7906ab","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"3c7e3204-9445-41a1-8cb6-4ec40272ff89"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// 拖拽排序场景\nfunction handleDragDrop(draggedElement, dropTarget) {\n  const parent = dropTarget.parentElement;\n  // 使用 moveBefore 保持拖拽元素的所有状态\n  // 比如正在播放的视频、输入框的焦点等\n  parent.moveBefore(draggedElement, dropTarget);\n}","collabId":"bd1cb9fb-8027-47e7-80bf-19610896adc6","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"6dc6dda7-f19d-4269-8d07-3fcb4e59f523","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"33ae7b23-4b5e-4c49-bf7c-fa4c15d2eacc"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// 对比传统方式的问题\nconst iframe = document.querySelector('iframe');\nconst newParent = document.querySelector('#new-parent');\n\n// ❌ 传统方式：iframe 会重新加载，用户填写的表单数据丢失\nnewParent.appendChild(iframe);\n\n// ✅ 使用 moveBefore：iframe 不会重新加载，状态完整保留\nnewParent.moveBefore(iframe, null);","collabId":"25ab2772-c260-4e14-9c5b-956446fe8377","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"36a2ed88-350a-43bc-855e-40e3b8dd4bcb","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"7747bcd7-ca17-4fef-af2f-9bc7cc72bc8d"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// Web Components 中的 connectedMoveCallback\nclass MyElement extends HTMLElement {\n  connectedMoveCallback() {\n    // 元素被 moveBefore 移动时触发\n    // 可以在这里做一些轻量级的更新，而不需要重新初始化\n    console.log('元素被移动了，但状态保留');\n  }\n  \n  connectedCallback() {\n    // 使用 insertBefore/appendChild 时会触发\n    console.log('元素被插入，需要重新初始化');\n  }\n  \n  disconnectedCallback() {\n    // 使用 insertBefore/appendChild 时会先触发\n    console.log('元素被移除，需要清理资源');\n  }\n}","collabId":"6dd28eff-3af8-4fc7-aea6-bbe8a119f772","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"6381db4b-497c-4236-a1db-d3030596fbe4","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"dbaf9bd7-5c57-481d-b0d4-5a3c0fa116e6"},{"children":[{"children":[{"code":true,"text":"moveBefore","type":"formatted"},{"text":" 的使用限制和注意事项：","type":"formatted"}],"collabId":"0c040261-b245-478a-b7f9-1326e134018f","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"移动的元素必须在页面中，即必须是 ","type":"formatted"},{"code":true,"text":"isConnected","type":"formatted"},{"text":" 的，否则会报错，而 ","type":"formatted"},{"code":true,"text":"insertBefore","type":"formatted"},{"text":" 不要求必须在页面中，在内存中就可以，比如通过 ","type":"formatted"},{"code":true,"text":"createElement","type":"formatted"},{"text":" 创建的元素","type":"formatted"}],"collabId":"5112d079-e59d-4878-93c2-af8d58e9ecbe","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"05e83fe5-5097-4347-af3b-4818e5b12862","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"referenceNode","type":"formatted"},{"text":" 必须是目标父节点的直接子节点，否则会抛出 ","type":"formatted"},{"code":true,"text":"NotFoundError","type":"formatted"}],"collabId":"a14e99ac-5c19-4bf4-9d05-10f146087634","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"slotB.moveBefore(node, referenceNode)\n//  ↑ 目标父节点         ↑ 必须是 slotB 的直接子节点","collabId":"f671b15b-a391-46a3-b5bc-eef313d002c7","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1c597e99-7825-42a3-a8a9-9b6f2698140f","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"d67543fb-76a3-479c-983c-fa645bcf49d2"}],"collabId":"79bcd0d9-122f-4747-9fb9-0ceb72f55378","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"不能跨文档移动，","type":"formatted"},{"code":true,"text":"nodeToMove","type":"formatted"},{"text":" 和目标父节点必须在同一个 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":" 中，否则会抛出 ","type":"formatted"},{"code":true,"text":"HierarchyRequestError","type":"formatted"},{"text":"。如果需要跨文档移动，还是得用 ","type":"formatted"},{"code":true,"text":"adoptNode","type":"formatted"},{"text":" + ","type":"formatted"},{"code":true,"text":"insertBefore","type":"formatted"},{"text":" 的组合","type":"formatted"}],"collabId":"a17fdd0f-b6f7-4046-89fa-1912428606ac","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// 跨文档移动的场景（比如从 iframe 中移动元素到主文档）\nconst iframe = document.querySelector('iframe');\nconst iframeDoc = iframe.contentDocument;\nconst nodeFromIframe = iframeDoc.querySelector('#some-element');\nconst mainDocContainer = document.querySelector('#container');\n\n// ❌ 错误：不能直接跨文档使用 moveBefore\n// mainDocContainer.moveBefore(nodeFromIframe, null); // 抛出 HierarchyRequestError\n\n// ✅ 正确：先用 adoptNode 把节点\"过继\"到目标文档，再插入\nconst adoptedNode = document.adoptNode(nodeFromIframe);\nmainDocContainer.insertBefore(adoptedNode, null);\n// 注意：这种方式会丢失状态，因为 adoptNode 本身就会断开连接","collabId":"11e5b368-d799-4e30-9ca2-bbec33a57120","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"6fd56ed2-14a6-4f67-9a89-b1b8fc5d7433","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"927bfc7f-c156-4769-9587-1f04fc0bb5ac"}],"collabId":"62641625-bfc9-4877-bfbd-64ea0165e116","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"不能移动到自己的子孙节点下，否则会抛出 ","type":"formatted"},{"code":true,"text":"HierarchyRequestError","type":"formatted"},{"text":"，这和 ","type":"formatted"},{"code":true,"text":"insertBefore","type":"formatted"},{"text":" 的行为一致","type":"formatted"}],"collabId":"c9c009d3-8959-46ab-93cc-6c440d67171c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"// ❌ 错误：不能把父元素移动到自己的子元素下\nconst parent = document.querySelector('#parent');\nconst child = document.querySelector('#child'); // child 是 parent 的子元素\nchild.moveBefore(parent, null); // 抛出 HierarchyRequestError","collabId":"2b6754bd-cc4b-4e1e-964e-b015aa457790","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"fc4a9a1b-2385-4419-8ee8-24b54289fd56","language":"JAVASCRIPT","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"c5239dae-81fc-40e7-8e6f-794671b13d07"}],"collabId":"5589fa24-c03c-479f-a6e2-3a28dde2825f","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"如果 ","type":"formatted"},{"code":true,"text":"nodeToMove","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"referenceNode","type":"formatted"},{"text":" 是同一个节点，什么都不会发生，不会报错","type":"formatted"}],"collabId":"afc5d8b1-8cf9-4869-99b8-b33272ef07f0","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"0f31f437-fbb2-447c-98ae-c2ccd4118d13","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":