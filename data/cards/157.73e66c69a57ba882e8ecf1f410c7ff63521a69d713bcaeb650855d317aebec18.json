72fb1","collabId":"b716b68c-756e-40b4-9787-96662d8641d8","children":[{"type":"formatted","code":true,"text":"@import"}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"74def3aa-0eb0-43c9-8f1a-44bc19c296b4","children":[{"type":"formatted","text":"style 属性"}]},{"type":"code-block","language":"HTML","uuid":"e99b2b16-c875-4568-8b50-55ecf743fc91","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e1f488b3-da6e-47dd-bac8-bce8621bd5a9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<body>\n  <h1 style=\"color: red;\">Hello World!</h1>\n  <p style=\"text-align: center;\">今天的天气真好</p>\n</body>","collabId":"bb37d1b4-839f-4ca7-9609-fa02b2bf3276","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"40dd4b4d-07c5-4205-91bc-934581734d3b","children":[{"type":"formatted","text":"style 标签"}]},{"type":"code-block","language":"html","uuid":"dc31b042-d133-4912-b67b-010930b65801","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"89630100-9c92-4fcd-8a44-92f5b8f6f0aa","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <title>CSS介绍</title>\n    <style>\n        h1 {\n            color: blue; /* 设置一级标题的字体颜色为蓝色*/\n        }\n        p {\n            text-align: right; /* 设置 p 中文本对齐的方式为右对齐 */\n        }\n    </style>\n</head>\n<body>\n    <h1>Hello World!</h1>\n    <p>今天天气真好</p>\n</body>\n</html>","collabId":"88e17c7e-a396-488f-a58e-308cf4e76252","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"f606a6c2-c586-4c85-96fc-8f4a5e90d36c","children":[{"type":"formatted","text":"link 标签"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b5d015ae-1a6e-4f36-83fd-8d908e6070dd","children":[{"type":"formatted","text":"当网页的规模不大，样式较少时，可以将样式写在 "},{"type":"formatted","code":true,"text":"style"},{"type":"formatted","text":" 标签中，但是当网页变得复杂，将样式写在 "},{"type":"formatted","code":true,"text":"style"},{"type":"formatted","text":" 标签不好调试 ，所以我们一般将样式写在一个单独的文件中，然后通过 "},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 标签引入该样式文件。假设目录结构如下"}]},{"type":"code-block","language":"","uuid":"393dd6d0-0e43-4da9-b874-af8b8275617c","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cee619db-c653-4a67-ab8d-3dffed778b0f","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"index.html\nindex.css","collabId":"f0b281fa-8e90-4fb3-8d92-aa19527116c5","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"da46fbc9-c4e2-4192-99ab-fe8b03682697","children":[{"type":"formatted","text":"index.css 为样式文件，它与 index.html 在同一个文件夹下面，我们现在需要在 index.html 中引入 index.css"}]},{"type":"code-block","language":"html","uuid":"57483ee2-247d-4368-a789-4594ef5b5e09","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a493af7e-ce1b-407c-a029-3fbb52dc6232","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<!-- index.html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <title>link标签</title>\n    <link rel=\"stylesheet\" href=\"./index.css\">\n</head>\n<body>\n    <h1>Hello World!</h1>\n    <p>今天天气真好</p>\n</body>\n</html>","collabId":"d445f37e-a588-4d79-a033-b7507ffc38c3","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"css","uuid":"d5d9d96a-ae8d-40cc-8310-ae5f42b428bd","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"5ad27e0e-1304-4a81-ab8b-3ad927ff4297","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"/* index.css */\nh1 {\n    color: orange;\n}\np {\n    font-size: 2em;\n}","collabId":"3bdc4155-c7c5-4f72-b36b-fc5fedab7e55","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"63be107d-777b-4daa-b9d8-3298b703826d","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 标签的 "},{"type":"formatted","code":true,"text":"href"},{"type":"formatted","text":" 属性来指明 CSS 文件的位置，浏览器会根据指出的位置下载文件，然后解析该文件，为网页添加样式。"},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 所引用的文件不仅仅可以是本地文件，甚至可以是网络文件"}]},{"type":"code-block","language":"html","uuid":"f6374c4e-7655-4b41-8ebd-e9b0f498f0c6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"01e3995f-6b57-4f02-aba6-c2baada5be0e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<link href=\"https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.0.4/base.css\" rel=\"stylesheet\">","collabId":"4e7e226f-0986-49b1-be88-18e67839bba6","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"33dcc922-9c15-4996-bc7d-920bf9839928","children":[{"type":"formatted","code":true,"text":"rel"},{"type":"formatted","text":" 属性设置为 "},{"type":"formatted","code":true,"text":"stylesheet"},{"type":"formatted","text":"，它的目的是为了告诉浏览器我引入的是层叠样式表文件，在 HTML5 中，这一属性可以省略。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"e044b958-f9d6-48ad-bef6-72e3251c3aab","children":[{"type":"formatted","text":"@import"}]},{"type":"code-block","language":"html","uuid":"80540539-6b20-4255-be59-bf6d1f79438c","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2a0ece97-da3a-415e-81b8-984bd56f7a6e","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<style>\n    @import url(\"index.css\");\n</style>","collabId":"b1bb9fb1-d43f-4ccd-92e7-ee5796fa71bd","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"375002cf-7710-4818-a327-aa18a7d63eff","children":[{"type":"formatted","text":"除了可以在 "},{"type":"formatted","code":true,"text":"style"},{"type":"formatted","text":" 标签中通过 "},{"type":"formatted","code":true,"text":"@import"},{"type":"formatted","text":" 导入样式文件，还可以在 CSS 文件中使用 "},{"type":"formatted","code":true,"text":"@import"}]},{"type":"code-block","language":"css","uuid":"ec5bcb6c-e0cc-4a71-ab07-be1cef7044d8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c5eb31dc-3bf3-40d8-b462-818ef103a6e8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"/* main.css */\n@import \"https://cdn.bootcdn.net/ajax/libs/tailwindcss/2.0.4/base.css\"","collabId":"dbcdc137-a494-448f-a75c-9656aa3ff4ab","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"b45f03c5-9b9c-436c-90cd-a4b74e22c088","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d0075157-8ac2-4145-90ac-b02b8e26c3a4","children":[{"type":"formatted","code":true,"text":"@import"},{"type":"formatted","text":" 必须出现在样式规则之前，在样式表之后的 "},{"type":"formatted","code":true,"text":"@import"},{"type":"formatted","text":" 将会被忽略。"}]}]},{"type":"callout","calloutType":"tip","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"c1087a5b-9f47-454f-841f-2f50285cf1ae","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b203656e-3f52-4ea5-9d7b-5860c2e220f4","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 引入 CSS 文件与通过 "},{"type":"formatted","code":true,"text":"@import"},{"type":"formatted","text":" 引入 CSS 文件有何不同?"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d7f920bd-a499-4510-8ca3-240600b0195c","children":[{"type":"formatted","text":"二者差别不是很大，"},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 标签是 HTML 引入样式表的机制，而 "},{"type":"formatted","code":true,"text":"@import"},{"type":"formatted","text":" 是 CSS 引入样式表的机制。但是浏览器处理他们的方式是不同的，就性能而言，"},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 标签具有明显的优势，所以推荐使用 "},{"type":"formatted","code":true,"text":"link"},{"type":"formatted","text":" 引入样式。"}]}]}],"tags":["CSS"],"createTime":1690213996994,"updateTime":1743303640406,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640406}}