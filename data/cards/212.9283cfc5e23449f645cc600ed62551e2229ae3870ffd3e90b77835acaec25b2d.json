count, text)","code":true},{"type":"formatted","text":"：从 "},{"type":"formatted","text":"offset","code":true},{"type":"formatted","text":" 开始，将 "},{"type":"formatted","text":"count","code":true},{"type":"formatted","text":" 个文本替换为 "},{"type":"formatted","text":"text","code":true}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"splitText(offset)","code":true},{"type":"formatted","text":"：以 "},{"type":"formatted","text":"offset","code":true},{"type":"formatted","text":" 为界，将文本分割为两个文本节点，并将第二个文本节点返回"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"substringData(offset, count)","code":true},{"type":"formatted","text":"：取得从 "},{"type":"formatted","text":"offset","code":true},{"type":"formatted","text":" 开始的 "},{"type":"formatted","text":"count","code":true},{"type":"formatted","text":" 个文本"}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"举个🌰："}]},{"type":"code-block","code":"<div>Hello World</div>","language":"html","uuid":"a7096681-0e7c-492f-a713-7ceb6f7d6ab1","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"let text = div.firstChild;       // Text 节点是 div 的第一个子节点\ntext.appendData(\"!\");            // Hello World!\ntext.deleteData(0, 6);           // 从 0 开始，删除 6 个字符 ==> World!\ntext.insertData(0, \"Hello \");    // 在 0 前面插入文本， Hello_(_代表空格) => Hello World!\ntext.replaceData(0, 5, \"Hi\");    // 从 0 开始将后 5 个字符替换为 Hi => Hi World!\nlet newText = text.splitText(3); // 以 3 为界，分为两个文本节点 =>1. Hi_(_代表空格) 2. World!\nnewText.substringData(0, 1);     // W","language":"JavaScript","uuid":"7cad828d-3b8e-4789-9c80-2e15e03974ca","children":[{"type":"formatted","text":""}]}],"tags":["DOM"],"createTime":1690699144254,"updateTime":1743303640410,"linkedCards":[{"id":198,"target":{"key":"card:198","type":"card","id":198},"summary":"DOM 定义了一个 Node 类型的接口，DOM 树上的节点都实现了该类型，因此所有的节点都有着 Node 接口中规定的属性和方法。 虽然 HTML 元素以及文本内容都会被转化为节点，但是明显 document 节点，HTML 元素节点，以...","tags":["DOM"]}]},"meta":{"type":"card","publishTime":1743303640410}}