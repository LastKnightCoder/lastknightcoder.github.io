{"version":1,"key":"card:52","content":{"id":52,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"如何将 Rust 中的结构体变为可 Copy，需要满足两个条件："}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"所有的字段都是可 Copy"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"没有实现 Drop Trait"}],"disableDrag":false}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"然后通过 "},{"type":"formatted","text":"derive","code":true},{"type":"formatted","text":" 来为结构体实现 Copy Trait"}],"disableDrag":false},{"type":"code-block","code":"#[derive(Copy, Clone)]\nstruct Point {\n    x: i32,\n    y: i32,\n}","language":"rs","uuid":"19a39af5-280d-46f3-ae43-9e19e2c5ed99","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"fn main() {\n    #[derive(Copy, Clone)]\n    struct Point {\n        x: i32,\n        y: i32,\n    }\n\n    let p1 = Point { x: 0, y: 0 };\n    let p2 = p1;\n\n    println!(\"p1 = ({}, {})\", p1.x, p1.y); // p1 = (0, 0)\n    println!(\"p2 = ({}, {})\", p2.x, p2.y); // p2 = (0, 0)\n}","language":"rs","uuid":"0f497cc5-7082-46b2-9768-9dd90d62155b","children":[{"type":"formatted","text":""}]},{"type":"callout","calloutType":"note","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"Copy Trait 依赖于 Clone Trait。"}],"disableDrag":false}]},{"type":"paragraph","children":[{"type":"formatted","text":"相关卡片："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"content-link","children":[{"type":"formatted","text":"赋值语义"}],"refId":411,"contentType":"card","contentTitle":"","contentId":347},{"text":"","type":"formatted"}],"disableDrag":false}]}]}],"tags":["Rust/Trait"],"createTime":1689000860866,"updateTime":1755514076756,"linkedCards":[]},"meta":{"type":"card","publishTime":1755514076756},"links":{"card:411":{"key":"card:411","type":"card","id":411}}}