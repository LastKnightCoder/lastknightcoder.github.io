{"version":1,"key":"card:269","content":{"id":269,"content":[{"children":[{"text":"ES6 为对象提供了一些简写的方式。","type":"formatted"}],"collabId":"80a4e34a-4791-45fd-905a-e737f8684078","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"当属性名和值所对应的变量名相同时，可以简写","type":"formatted"}],"collabId":"88cddcf6-799a-4aad-a9cd-ecfbbf283ef5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const name = \"Alice\";\nconst age = 18;\n\nconst person = {\n  name: name,\n  age: age,\n};\n\n// 可以简写为\nconst person = {\n  name,\n  age,\n};","collabId":"5641f758-13ed-4aac-b2d5-602c0ffb2520","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"223dfe78-b2cb-4887-9e00-78d04f7a40f6","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"fd821213-beb5-465d-9b8e-e0570671466d"},{"children":[{"text":"对于函数也存在更加简写的声明方式","type":"formatted"}],"collabId":"fbafabe0-da47-4144-be8f-6ad9abe4255d","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const person = {\n  name: \"Alice\",\n  sayHello: function () {\n    return \"Hello\";\n  },\n};\n\n// sayHello 可以简写为\nconst person = {\n  name: \"Alice\",\n  sayHello() {\n    return \"Hello\";\n  },\n};","collabId":"dab8a658-d5c2-4b6b-ae98-55d26ccb6faa","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"8663ff1d-adec-452d-a22b-079f3174c621","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"178fd7ff-0305-471c-9920-39e0c2053f58"},{"children":[{"text":