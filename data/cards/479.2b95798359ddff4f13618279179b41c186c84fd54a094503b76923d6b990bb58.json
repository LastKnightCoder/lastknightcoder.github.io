3d88c.png","tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"f22a871f-4137-4eb2-a9d3-8a70b7287d7f","children":[{"type":"formatted","text":""}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"6c25d918-4704-4489-9f28-6dd40b806fef","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"606fcb61-cb95-40cc-9eca-cf85c670ea6e","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c08ad5c7-93d0-4007-9a1c-9f0ffbe4cde7","children":[{"type":"formatted","code":true,"text":"fileinput.input"},{"type":"formatted","text":" 是其中最重要的函数，它返回一个可在 "},{"type":"formatted","code":true,"text":"for"},{"type":"formatted","text":" 循环中进行迭代的对象"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"fa2d0dec-c862-4d2c-b37d-1ff795439695","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6e2bd434-0742-47a8-8504-8babe005a454","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e11d5db5-154b-4de1-af5b-ab23c2e236e4","children":[{"type":"formatted","text":"还可将参数 "},{"type":"formatted","code":true,"text":"inplace"},{"type":"formatted","text":" 设置为 "},{"type":"formatted","code":true,"text":"True"},{"type":"formatted","text":"，这样将就地进行处理"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"05469e39-6cf3-4dee-94cd-6bb16835e61b","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fdc480d1-e3ad-4344-a312-2d93f00515f4","children":[{"type":"formatted","text":"就地进行处理时，可选参数 "},{"type":"formatted","code":true,"text":"backup"},{"type":"formatted","text":" 用于给从原始文件创建的备份文件指定扩展名"}]}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"bc69ec6a-66a1-4c37-9b19-a852af696be0","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4f000a1a-d800-4fec-864b-8efb7110099c","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.filename"},{"type":"formatted","text":" 返回当前文件（即当前处理的行所属文件）的文件名"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"708dba70-db3e-4c22-b5c3-43662c67879d","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ca38320c-3705-4164-bce6-0c637641c972","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.lineno"},{"type":"formatted","text":" 返回当前行的编号。这个值是累计的，因此处理完一个文件并接着处理下一个文件时，不会重置行号，而是从前一个文件最后一行的行号加 1 开始"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f3f77c69-5677-4d35-88ce-fbdbfede5849","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"592b4f80-781f-4b2b-829b-7940b7bc04cc","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.filelineno"},{"type":"formatted","text":" 返回当前行在当前文件中的行号。每次处理完一个文件并接着处理下一个文件时，将重置这个行号并从 1 重新开始"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"d03d4ef8-679c-4ce6-b099-6be19e71c710","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d07e1782-ecf0-4f3f-8be1-2686f0000fcd","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.isfirstline"},{"type":"formatted","text":" 在当前行为当前文件中的第一行时返回 "},{"type":"formatted","code":true,"text":"True"},{"type":"formatted","text":"，否则返回 "},{"type":"formatted","code":true,"text":"False"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"4bb588c4-78b0-44f3-aea9-518f81f7dd75","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0a77a9a0-568b-42ec-ab9e-912d4dced6e8","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.nextfile"},{"type":"formatted","text":" 关闭当前文件并跳到下一个文件，且计数时忽略跳过的行"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"ac06dbd0-26ed-4d9c-ba77-3e40e1b1ee2c","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0c4c4a57-c17e-4c04-a471-0e54592084ff","children":[{"type":"formatted","text":"函数 "},{"type":"formatted","code":true,"text":"fileinput.close"},{"type":"formatted","text":" 关闭整个文件链并结束迭代"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c350c335-9e7a-48e4-a955-fd33a1f52d71","children":[{"type":"formatted","text":"假设你编写了一个 Python 脚本，并想给其中的代码行加上行号。鉴于你希望这样处理后程序依然能够正常运行，因此必须在每行末尾以注释的方式添加行号。为让这些行号对齐，可使用字符串格式设置功能。假设只允许每行代码最多包含 40 个字符，并在第 41 个字符处开始添加注释。"}]},{"type":"code-block","language":"py","uuid":"5cb345db-e4dc-43aa-b6bf-086b2262f0fd","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f00c199f-89e7-4813-a25a-78e1025ddeb5","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# numberlines.py\n\n\nimport fileinput\n\n\nfor line in fileinput.input(inplace=True):\n    line = line.rstrip()\n    num = fileinput.lineno()\n    print('{:<50} # {:2d}'.format(line, num))","collabId":"3d635d9e-8121-4780-8fb8-47161dc2f083","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"py","uuid":"f47d9e6a-ec18-42ce-9aa1-57b36dd31a2d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8093ba3f-82a2-4f36-96dd-20c61e963282","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"python numberlines.py numberlines.py","collabId":"c4f7d6b4-32b1-4e8c-9567-6c14ed932d1e","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"warning","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"2c08c65b-a749-4f91-a028-0a34906bf67a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9789cbd4-6b0b-43c5-ba21-5248079c6d14","children":[{"type":"formatted","text":"务必慎用参数 "},{"type":"formatted","code":true,"text":"inplace"},{"type":"formatted","text":"，因为这很容易破坏文件。"}]}]}],"tags":["Python/标准库/fileinput"],"createTime":1719398549221,"updateTime":1791474923044,"linkedCards":[]},"meta":{"type":"card","publishTime":1791474923044}}