{"version":1,"key":"card:395","content":{"id":395,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"在 TypeScript 中使用 "},{"type":"formatted","text":"useRef","code":true},{"type":"formatted","text":" 来获取 DOM 对象，会报类型错误"}],"disableDrag":false},{"type":"code-block","code":"function App() {\n  const ref = useRef<HTMLDivElement>();\n\n  return (\n    <div ref={ref}>\n      Hello World!\n    </div>\n  )\n}","language":"TSX","uuid":"86d2d936-c790-4a5d-abc9-8fd266f24a4b","children":[{"type":"formatted","text":""}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_e4cf4687-ff72-4947-b0fd-ec2b9a9ccdd2.png","uuid":"eee84e6e-aafa-4704-b6c3-9f61b84feee8","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_e4cf4687-ff72-4947-b0fd-ec2b9a9ccdd2.png","width":696},{"type":"paragraph","children":[{"type":"formatted","text":"解决办法是使用 "},{"type":"formatted","text":"useRef","code":true},{"type":"formatted","text":" 给一个初始值 "},{"type":"formatted","text":"null","code":true},{"type":"formatted","text":"，就不会报错了"}],"disableDrag":false},{"type":"code-block","code":"function App() {\n  const ref = useRef<HTMLDivElement>(null);\n\n  return (\n    <div ref={ref}>\n      Hello World!\n    </div>\n  )\n}","language":"tsx","uuid":"11eb034a-d6c2-4839-87a6-a6eac761f511","children":[{"type":"formatted","text":""}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_6534996e-defc-4d4f-a49d-d8000163b236.png","uuid":"7b1bc8f0-6924-428a-a789-4f13d353c413","pasteUploading":false,"children":[{"type":"formatted","text":""}],"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_6534996e-defc-4d4f-a49d-d8000163b236.png","width":696}],"tags":["React/useRef","技巧/React","技巧/TypeScript","React/技巧","TypeScript/技巧"],"createTime":1704808856339,"updateTime":1768722741664,"linkedCards":[]},"meta":{"type":"card","publishTime":1768722741664}