{"version":1,"key":"card:182","content":{"id":182,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f77e40e0-04c6-4b1f-831c-6973b5ed4808","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"toBlob(callback, type, quality)"},{"type":"formatted","text":" 方法可以将 "},{"type":"formatted","code":true,"text":"canvas"},{"type":"formatted","text":" 对象转化为 Blob 对象，该方法接收三个参数，第一个参数为回调函数，Blob 对象会作为参数传递给改函数，"},{"type":"formatted","code":true,"text":"type"},{"type":"formatted","text":" 指定转换的图片类型，可以为 "},{"type":"formatted","code":true,"text":"image/png"},{"type":"formatted","text":" "},{"type":"formatted","code":true,"text":"image/jpeg"},{"type":"formatted","text":" "},{"type":"formatted","code":true,"text":"image/webp"},{"type":"formatted","text":" ，可以通过第三个参数 "},{"type":"formatted","code":true,"text":"quality"},{"type":"formatted","text":" 指定图片的质量，默认值为 "},{"type":"formatted","code":true,"text":"0.92"}]},{"type":"code-block","language":"JavaScript","uuid":"cd83ed29-8912-40b7-82f2-b70d77116845","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"918232b2-79b2-4cd2-beea-e0500ebf9599","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const canvasToBlob = (canvas) => {\n  return new Promise(resolve => {\n    canvas.toBlob(blob => {\n      resolve(blob)\n    }, 'image/png')\n  })\n}\n\n(async () => {\n  const blob = await canvasToBlob(canvas)\n  const url = URL.createObjectURL(blob)\n  const img = new Image()\n  img.src = url\n  document.body.appendChild(img)\n})()","collabId":"bbc10338-6e9d-4133-afe1-24436551f94d","children":[{"type":"formatted","text":""}]}]}],"tags":["Canvas"],"createTime":1690379894974,"updateTime":1743303640408,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640408}}