{"version":1,"key":"card:436","content":{"id":436,"content":[{"children":[{"text":"内置函数 ","type":"formatted"},{"code":true,"text":"len","type":"formatted"},{"text":" 可以返回序列中的元素的个数","type":"formatted"}],"collabId":"01c0c99c-4fc3-4a3f-ba00-f096e2b7eda9","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> l = [1, 2, 3, 4, 5]\n>>> len(l)\n5\n\n>>> t = (4, 5, 6, 7, 8)\n>>> len(t)\n5\n\n>>> s = \"Hello World!\"\n>>> len(s)\n12","collabId":"f1696c02-b7c1-4642-b8ed-ac6b2cb52b54","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"911c6d1d-9b8c-4699-9b4b-0c2020f451d3","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"6e6f7a8b-63d6-49e9-86cc-0c7e96fb16d5"},{"children":[{"code":true,"text":"min","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"max","type":"formatted"},{"text":" 分别返回序列中最小和最大的元素","type":"formatted"}],"collabId":"b6fec5db-df11-4d8c-9bf8-67fb8f4c10ab","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> min(l)\n1\n>>> max(l)\n5\n\n>>> min(t)\n4\n>>> max(t)\n8\n\n>>> min(s)\n' '\n>>> max(s)\n'r'","collabId":"c7c148d5-84b3-470a-96f5-ce15476a668d","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"ec6aa164-a102-481e-bf77-a87d8ef2a557","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"e79d28bb-f4c0-435a-bf98-131bbc17624a"}],"tags":["Python/序列"],"createTime":1719025081458,"updateTime":1793532524992,"linkedCards":[]},"meta":{"type":"card","publishTime":1793532524992}}