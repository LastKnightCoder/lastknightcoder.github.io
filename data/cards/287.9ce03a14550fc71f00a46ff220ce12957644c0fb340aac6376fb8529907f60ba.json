{"version":1,"key":"card:287","content":{"id":287,"content":[{"children":[{"code":true,"text":"document.importNode","type":"formatted"},{"text":" 可以从另一个 ","type":"formatted"},{"code":true,"text":"document","type":"formatted"},{"text":" 中复制一个 ","type":"formatted"},{"code":true,"text":"Node","type":"formatted"},{"text":" 或者 ","type":"formatted"},{"code":true,"text":"DocumentFragment","type":"formatted"},{"text":"，被复制的 ","type":"formatted"},{"code":true,"text":"Node","type":"formatted"},{"text":" 尚未在 ","type":"formatted"},{"code":true,"text":"DOM","type":"formatted"},{"text":" 树中，需要手动插入。","type":"formatted"}],"collabId":"bedf0e20-c9ef-4552-a039-9b1c08904de3","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"语法如下：","type":"formatted"}],"collabId":"3c73c150-1efd-4dd9-9ca1-935f77d94bc0","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"document.importNode(externalNode, deep = false);","collabId":"44ff0a51-be6f-4a4a-99b5-ab3bc55c5778","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"cf025c77-18dd-4c0d-a654-b8fa7f841b72","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b5d88a99-d6a2-44b8-92ff-cf4b86b8cbd3"},{"children":[{"children":[{"children":[{"code":true,"text":"externalNode","type":"formatted"},{"text":"：需要导入到当前文档的 ","type":"formatted"},{"code":true,"text":"Node","type":"formatted"},{"text":" 或 ","type":"formatted"},{"code":true,"text":"DocumentFragment","type":"formatted"}],"collabId":"48599770-4a97-4b28-80d5-60d5cc4df0c1","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"c47d6b35-d68d-4938-8ad4-5c4c6813c04b","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"deep","type":"formatted"},{"text":"：是否复制的子元素，默认是 ","type":"formatted"},{"code":true,"text":"false","type":"formatted"},{"text":"，即不导入子元素","type":"formatted"}],"collabId":"51f657cc-f0dd-4189-bbc4-897d03693849","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"f7ca2b2d-50d3-425a-8d5b-f272fed76b24","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"faf17b3b-30e3-409a-814f-c0fe14db9ad4","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"例子🌰：","type":"formatted"}],"collabId":"4d2b5f89-a565-4808-b75e-358ac52fe3e7","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<!-- 01.html -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Document</title>\n</head>\n<body>\n  <div style=\"color: red;\">\n    <button id=\"btn\">导入</button>\n  </div>\n  <iframe id=\"iframe\" src=\"./2.html\"></iframe>\n  <script>\n    const btn = document.getElementById('btn');\n    const iframe = document.getElementById('iframe');\n    btn.addEventListener('click', () => {\n      const oldNode = iframe.contentDocument.getElementById('imported');\n      const newNode = document.importNode(oldNode, true);\n      btn.insertAdjacentElement('afterend', newNode);\n    });\n  </script>\n</body>\n</html>","collabId":"03ef5bd3-1e2f-4270-b4c2-01b8afedb924","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"c8814274-3519-49df-98ec-1288c19c2698","language":"html","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"co