{"version":1,"key":"card:71","content":{"id":71,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f86e8b0a-9ccd-4814-8fef-99d1a142751c","children":[{"type":"formatted","code":true,"text":"mv"},{"type":"formatted","text":" 用来移动文件或者重命名文件。"}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"f2c870a1-2880-44d8-9dd3-6720ee5d427e","children":[{"type":"formatted","text":"重命名文件"}]},{"type":"code-block","language":"bash","uuid":"e2e2ccf8-3dce-4940-9273-3f47f67d8da2","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"ba724a03-217f-4d0d-9bcf-52ec9edbeac9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# src 是文件夹，其余两个为文件\n~ » tree\n.\n├── hello.c\n├── hello.md\n└── src\n\n1 directory, 2 files\n# 重命名 hello.md 为 hello2.md\n~ » mv hello.md hello2.md\n~ » tree\n.\n├── hello.c\n├── hello2.md\n└── src\n\n1 directory, 2 files","collabId":"5e007d0e-1582-4a3f-b46a-a2734df40742","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"warning","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"ea22650f-986e-4c19-8697-9b006140c0d9","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8c22fb8a-1a3e-4dff-ac99-fbc2c2a8b4c3","children":[{"type":"formatted","text":"当移动文件或重命名时 "},{"type":"formatted","code":true,"text":"mv hello.md hello2.md"},{"type":"formatted","text":"，如果 "},{"type":"formatted","code":true,"text":"hello2.md"},{"type":"formatted","text":" 已经存在，则不会有任何的提示，默认原先的文件会被覆盖，我们同样可以添加 "},{"type":"formatted","code":true,"text":"-i"},{"type":"formatted","text":" 选项，如果文件已存在的情况下会进行询问是否覆盖"}]},{"type":"code-block","language":"bash","uuid":"e8e5d897-51a1-41cf-834a-47f40005f831","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9211ef35-033a-4e75-9718-8e2e1e128422","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"~ » mv -i hello.md hello2.md\nmv: overwrite 'hello2.md'? n","collabId":"3c2d66e8-e3a4-409b-832f-93623a6f6243","children":[{"type":"formatted","text":""}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"e1a29901-bafb-4f71-84f0-7237f34446a3","children":[{"type":"formatted","text":"移动文件"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b7e67035-bfab-4559-901d-d723a6b9c57e","children":[{"type":"formatted","bold":true,"text":"移动单个文件到文件夹："}]},{"type":"code-block","language":"bash","uuid":"364a1aee-acc0-4d15-b83d-495da1c8b367","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"29392665-b814-470a-b4f0-e865df9f9e6b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 移动 hello.c 到 src 文件夹下\n~ » mv hello.c src\n~ » tree\n.\n├── hello2.md\n└── src\n    └── hello.c\n\n1 directory, 2 files","collabId":"b087cf97-5b69-4ec0-9add-afc248a64182","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2b47513b-7ea7-4606-a4cd-de92389e2502","children":[{"type":"formatted","bold":true,"text":"移动多个文件到文件夹："}]},{"type":"code-block","language":"bash","uuid":"48bb8052-3fd8-425e-9a16-600d573a42b4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"12ca9abf-a0d0-4faa-843c-c2a7bc3f5cb7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 创建新文件 hello.md\n~ » touch hello.md\n# 移动多个文件到 src 文件夹下\n~ » mv hello.md hello2.md src\n~ » tree\n.\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n\n1 directory, 3 files","collabId":"67a8e4a4-dc41-4e49-a8eb-630380e161bc","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4b2e6a5a-24a9-468e-a629-8185978fc7c2","children":[{"type":"formatted","bold":true,"text":"移动文件夹下的所有文件到另一文件夹："}]},{"type":"code-block","language":"bash","uuid":"e30d6260-7b0a-4862-ac90-ba7eecc82895","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7a5a67a2-9b2a-4541-bd2c-c801e4b026c6","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# src 中有 3 个文件，dst 为空文件夹\n~ » tree\n.\n├── dst\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n2 directories, 3 files\n# 移动 src 下所有文件到 dst 中\n~ » mv src/* dst\n~ » tree\n.\n├── dst\n│   ├── hello.c\n│   ├── hello.md\n│   └── hello2.md\n└── src\n\n2 directories, 3 files","collabId":"7ac98b32-1e78-483e-aa56-1fb372c5d195","children":[{"type":"formatted","text":""}]}]}],"tags":["Linux/命令/mv"],"createTime":1689089713600,"updateTime":1753198349355,"linkedCards":[]},"meta":{"type":"card","publishTime":1753198349355}}