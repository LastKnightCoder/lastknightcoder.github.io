et trap.'\" SIGINT\nfor (( i = 1; i <= 3; i++ ))\ndo\n\techo \"first loop, number$i\"\n\tsleep 1\ndone\n\ntrap \"echo 'I modified trap.'\" SIGINT\nfor (( i = 1; i <= 3; i++ ))\ndo\n\techo \"second loop, number$i\"\n\tsleep 1\ndone","collabId":"55ad1f75-312c-4c66-9ee6-9943cc8c3168","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2e5aa15a-a2bc-472a-9682-ef9b647cdeb6","language":"Bash","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"90a602fb-e989-4633-9ca1-40a7050aface"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"xt in ~/shell/sig λ ./03.sh\nfirst loop, number1\nfirst loop, number2\n^CI set trap.\nfirst loop, number3\nsecond loop, number1\nsecond loop, number2\n^CI modified trap.\nsecond loop, number3","collabId":"9129eed4-27e3-4237-8137-e694b997622a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"68a09427-1479-481a-aeee-520f09beb015","language":"bash","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"4dc44bf8-5dd7-4d51-a8bd-22f28a7a1b85"},{"children":[{"text":"删除捕获","type":"formatted"}],"collabId":"4948da7c-f87a-4945-9ae8-81e75dc0520e","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"# 删除信号，双（单）破折号\ntrap -- SIGINT\ntrap - SIGINT","collabId":"f8130ead-99ad-4e44-b0d0-73976df69d4f","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"9a91a535-bf96-4950-96f3-cf23a99e5dc6","language":"bash","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"d6d0cf2d-50e6-4589-a47a-be25f727a458"}],"tags":["Shell编程"],"createTime":1689173013741,"updateTime":179353251663