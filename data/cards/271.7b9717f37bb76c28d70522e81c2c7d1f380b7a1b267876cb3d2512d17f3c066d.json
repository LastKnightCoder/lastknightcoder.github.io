{"version":1,"key":"card:271","content":{"id":271,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"在比较两个值时，一般会使用 "},{"type":"formatted","text":"==","code":true},{"type":"formatted","text":" 或者更加严格的 "},{"type":"formatted","text":"===","code":true},{"type":"formatted","text":" ，更多的人乐意使用 "},{"type":"formatted","text":"===","code":true},{"type":"formatted","text":"，但是即使是 "},{"type":"formatted","text":"===","code":true},{"type":"formatted","text":" 也会不准确，例如"}]},{"type":"code-block","code":"console.log(+0 === -0); // true\nconsole.log(NaN === NaN); // false","language":"js","uuid":"a4280c79-e890-4715-97e8-b347a8942fd7","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"Object.is","code":true},{"type":"formatted","text":" 方法正是用来修补这一小的瑕疵的，它的作用与 "},{"type":"formatted","text":"==","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"===","code":true},{"type":"formatted","text":" 一样也是用来比较两个值是否相同的"}]},{"type":"code-block","code":"const print = console.log;\n\nprint(5 == \"5\");            // true\nprint(5 === \"5\");           // false\nprint(Object.is(5, \"5\"));   // false\n\nprint(+0 == -0);            // true\nprint(+0 === -0);           // true\nprint(Object.is(+0, -0));   // false\n\nprint(NaN === NaN);         // false\nprint(Object.is(NaN, NaN)); // true","language":"js","uuid":"63a82578-6248-4231-8bb0-23f3851015ea","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"Object.is","code":true},{"type":"formatted","text":" 与 "},{"type":"formatted","text":"===","code":true},{"type":"formatted","text":" 的不同仅在于 "},{"type":"formatted","text":"+0","code":true},{"type":"formatted","text":"，"},{"type":"formatted","text":"-0","code":true},{"type":"formatted","text":" 以及 "},{"type":"formatted","text":"NaN","code":true},{"type":"formatted","text":" 的比较。"}]}],"tags":["JavaScript"],"createTime":1692109878275,"updateTime":1743303640422,"l