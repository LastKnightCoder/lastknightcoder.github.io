{"version":1,"key":"card:372","content":{"id":372,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9f1624a8-c8be-41ac-947e-1e4167cd86ce","children":[{"type":"formatted","text":"给定一串文本及其字体，如何获取该文字的长度。"}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"8fb99e44-c23a-44b2-b77a-d6322047bf67","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e7217be6-0763-48bf-bcbc-7e8d1cdb37db","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cc7a31cc-2177-4dbc-9a8f-7de29af01a34","children":[{"type":"formatted","text":"DOM"}]},{"type":"code-block","language":"js","uuid":"bfd274d1-cefe-49e0-a8ce-d0baae6b73df","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"4de90fac-1cf5-4cac-acd7-f3a6bafa78e5","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const getTextWidthByDOM = (text, font) => {\n  const div = document.createElement('div');\n  div.style.font = font;\n  div.textContent = text;\n  \n  div.style.position = 'absolute';\n  div.style.left = '-9999px';\n  div.style.top = '-9999px';\n  div.style.whiteSpace = 'nowrap';\n\n  document.body.appendChild(div);\n  const width = div.clientWidth;\n  document.body.removeChild(div);\n  \n  return width;\n}","collabId":"0b46d9cd-85f3-4959-ac7c-e988d35e42a9","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"js","uuid":"3efe0eee-3de1-4c9c-b234-00c83fe150ee","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2cdd816c-7ae3-43d9-95be-de1b2a6641ba","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"getTextWidthByDOM('世界这么大，I Want to see see', 'normal 20px 黑体-简'); //290","collabId":"dfbb031c-2fbc-4ea6-b94d-13df28ba1b51","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"d6557f60-0e0e-447f-a5b2-6a77802e050c","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"32b28573-7e8e-4a93-85e8-dd8e23e48418","children":[{"type":"content-link","refId":175,"contentType":"card","contentTitle":"","contentId":169,"tauContract":"720a42c66441f65bfc897253311b73deb687a68a60da46dffe8c7b8537a65760","collabId":"56d7e552-10ea-4e04-8281-9891e7611195","children":[{"type":"formatted","text":"Canvas"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"96b4f1b1-8638-46c4-ba9b-6a84846cb911","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","code":true,"text":"CanvasRenderingContext2D.measureText()"},{"type":"formatted","text":"可以获取到文本的长度"}]},{"type":"code-block","language":"js","uuid":"a5868144-b3ee-44b0-afe0-47e4fae00ec4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6658f2e0-ab0f-4c8f-9077-58bff5badd66","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const getTextWidthByCanvas = (text, font) => {\n  const canvas = document.createElement('canvas');\n  const ctx = canvas.getContext('2d');\n  ctx.font = font;\n  const { width } = ctx.meatureText(text);\n  \n  return width;\n}","collabId":"05c121bb-2adb-4c1e-8ceb-b09a3a859ef0","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"js","uuid":"0cf9aff9-caea-4376-a715-c236deafffa6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a9f592cc-8125-43ad-b231-8f0e1d1deede","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"getTextWidthByCanvas('世界这么大，I Want to see see!', 'normal 20px 黑体-简'); // 289.6599426269531","collabId":"a1036944-0f1f-4c5b-ad17-4fd585afbb40","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"b8786704-1774-4523-a51a-37a7e2c726ef","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d0fe3efc-a829-484e-abac-77167a9eb19f","children":[{"type":"formatted","text":"通过 DOM 计算得到的宽度是整数，会根据四舍五入进行取整，而通过 Canvas 计算得到的是小数。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0c299943-4210-4d8a-bbb3-7b784fddf9ae","children":[{"type":"formatted","text":"若通过 Canvas 计算得到的是 166.5，如果通过 DOM 计算得到的可能是 166，也可能是 167，根据浏览器计算结果不同。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f7f77e3e-18dd-4543-aed8-275bff1ed370","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"6c00bbe1-a26c-4ea9-bb0c-59acf502985a","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7713a0a0-5e6e-474e-8dac-398c70856993","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"56d6ae2d-9fea-4978-8afe-d682bc67a1ce","children":[{"type":"link","url":"https://stackoverflow.com/questions/118241/calculate-text-width-with-javascript","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac2