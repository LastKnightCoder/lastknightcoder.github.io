{"version":1,"key":"card:357","content":{"id":357,"content":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"content-link","children":[{"type":"formatted","text":"柯里化"}],"refId":356,"contentType":"card","contentTitle":"","contentId":305},{"type":"formatted","text":"有什么用处，假设有一个 ajax 请求的函数如下"}]},{"type":"code-block","code":"function ajax(type, url, data) {\n    let xhr = new XMLHttpRequest();\n    xhr.onReadystateChange = function() {\n        // ...\n    }\n    xhr.open(type, url);\n    xhr.send(data);\n}","language":"js","uuid":"622e0776-67ea-4ad5-81d6-94b759e33047","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"现在我们将这个函数柯里化"}]},{"type":"code-block","code":"let curriedAjax = curry(ajax);\nlet post = curriedAjax('post');","language":"js","uuid":"3ccd6d56-2128-460a-99de-eb001c78b321","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"我们向 "},{"type":"formatted","text":"curriedAjax","code":true},{"type":"formatted","text":" 传入一个参数 "},{"type":"formatted","text":"post","code":true},{"type":"formatted","text":"，得到一个函数，这个函数的作用是用来发 "},{"type":"formatted","text":"post","code":true},{"type":"formatted","text":" 请求的，我们每次发 "},{"type":"formatted","text":"post","code":true},{"type":"formatted","text":" 请求时，只需要使用 "},{"type":"formatted","text":"post","code":true},{"type":"formatted","text":" 方法即可，这样函数的复用性有了极大的增强，我们可以继续传入参数"}]},{"type":"code-block","code":"let postGoogle = post('https://www.google.com');","language":"js","uuid":"44c55fec-c5a6-4b44-aede-2995ffb3ccd5","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"我们又得到了一个函数，该函数的作用是向 https://www.google.com 发送 post 请求，函数的复用性又进一步的提升。"}]}],"tags":["JavaScript"],"createTime":1697157222791,"updateTime":1743303640425,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640425},"links":{"card:356":{"key":"card:356","type":"card","id":356}}}