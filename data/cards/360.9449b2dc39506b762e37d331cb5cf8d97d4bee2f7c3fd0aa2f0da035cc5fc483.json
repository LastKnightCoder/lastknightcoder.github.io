","collabId":"d71370bc-9de1-4d43-b130-d453d857c2d5","children":[{"type":"formatted","text":"jQuery 也存在一个 "},{"type":"formatted","code":true,"text":"outerWidth()"},{"type":"formatted","text":" 方法，它返回的元素的外部宽度，包括 "},{"type":"formatted","code":true,"text":"padding"},{"type":"formatted","text":"、"},{"type":"formatted","code":true,"text":"border"},{"type":"formatted","text":"，它接收一个可选参数，表示是否包含 "},{"type":"formatted","code":true,"text":"margin"},{"type":"formatted","text":"，默认是 "},{"type":"formatted","code":true,"text":"false"},{"type":"formatted","text":"。"}]}]}]}]},{"type":"callout","calloutType":"info","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"befc4936-8e5c-412a-9a74-024d6fc2f8f9","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"42178fb7-09d3-47c1-b881-eb90061580cc","children":[{"type":"formatted","text":"如果设置了宽度，但是有纵向滚动条，实际内容宽度是设置的宽度减去滚动条的宽度，滚动条的宽度在 Chrome 中默认是 17px。"}]}]},{"type":"callout","calloutType":"note","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"13df87c4-d045-4058-bb45-3c52e0386e0a","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a271dfa1-64f4-4693-8d03-03b99b4003a6","children":[{"type":"formatted","text":"如果页面纵向是滚动的，我期望 "},{"type":"formatted","code":true,"text":"document.documentElement.offsetWidth"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"window.innerWidth"},{"type":"formatted","text":" 相同，但是"},{"type":"formatted","highlight":"red","text":"实际上 "},{"type":"formatted","highlight":"red","code":true,"text":"document.documentElement.offsetWidth"},{"type":"formatted","highlight":"red","text":"比 "},{"type":"formatted","highlight":"red","code":true,"text":"window.innerWidth"},{"type":"formatted","highlight":"red","text":"小 "},{"type":"formatted","highlight":"red",