{"version":1,"key":"card:666","content":{"id":666,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0570c2e6-a8f5-459e-a0ec-db60c639b7d3","children":[{"type":"content-link","contentId":1753,"contentType":"card","contentTitle":"","refId":665,"tauContract":"720a42c66441f65bfc897253311b73deb687a68a60da46dffe8c7b8537a65760","collabId":"cd0a1e94-2c21-496c-9e76-8dc8efb8f10b","children":[{"type":"formatted","code":true,"text":"dialog"}]},{"type":"formatted","text":" 元素和表单的联动"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"68382db7-a062-4325-add4-a4b08710c23c","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c5bc7603-1d87-4a04-906d-bd717a42d945","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"82c88aa8-a051-47de-9b1c-07ca936917d7","children":[{"type":"formatted","text":"当通过 "},{"type":"formatted","code":true,"text":"showModal"},{"type":"formatted","text":" 打开 "},{"type":"formatted","code":true,"text":"dialog"},{"type":"formatted","text":" 时，会自动聚焦到 "},{"type":"formatted","code":true,"text":"dialog"},{"type":"formatted","text":" 中第一个可聚焦的元素，关闭时可将焦点恢复，"},{"type":"link","url":"https://lastknightcoder.github.io/demos/dialog/03-form-dialog.html","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"902d758f-0cb0-4a23-a740-7bfba24a61c3","children":[{"type":"formatted","text":"点击此处示例查看"}]}]},{"type":"code-block","language":"TSX","uuid":"2699b547-8cbb-45ef-992d-b3c28d28b49a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"949e8bea-32e6-4793-87b5-2af1bfb519fe","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const handleLoginSubmit = (e) => {\n    e.preventDefault();\n    const formData = new FormData(e.target);\n    const user = {\n      username: formData.get('username'),\n      email: formData.get('email')\n    };\n    setUsers([...users, user]);\n    loginDialogRef.current?.close();\n    e.target.reset();\n};\n\n<dialog\n    ref={loginDialogRef}\n    className=\"backdrop:bg-black/50 bg-white dark:bg-gray-800 rounded-lg shadow-xl p-0 border-0\"\n    >\n    <div className=\"p-6 min-w-[400px]\">\n        <h3 className=\"text-2xl font-bold mb-6 text-gray-900 dark:text-white\">用户登录</h3>\n        <form onSubmit={handleLoginSubmit}>\n        <div className=\"space-y-4 mb-6\">\n            <div>\n            <label className=\"block text-sm font-medium mb-2 text-gray-900 dark:text-white\">\n                用户名\n            </label>\n            <input\n                type=\"text\"\n                name=\"username\"\n                required\n                className=\"w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500\"\n                placeholder=\"请输入用户名\"\n            />\n            </div>\n            <div>\n            <label className=\"block text-sm font-medium mb-2 text-gray-900 dark:text-white\">\n                邮箱\n            </label>\n            <input\n                type=\"email\"\n                name=\"email\"\n                required\n                className=\"w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500\"\n                placeholder=\"请输入邮箱\"\n            />\n            </div>\n        </div>\n        <div className=\"flex gap-3 justify-end\">\n            <button\n            type=\"button\"\n            onClick={() => loginDialogRef.current?.close()}\n            className=\"px-4 py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-900 dark:text-white rounded-lg transition\"\n            >\n            取消\n            </button>\n            <button\n            type=\"submit\"\n            className=\"px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition\"\n            >\n            登录\n            </button>\n        </div>\n        </form>\n    </div>\n</dialog>","collabId":"89a7b6e5-74c8-4b7b-b214-495bdfa3e802","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9a1862ac-8d88-4514-9131-a36cf6bcd752","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ebdf3551-d2eb-41dc-a913-aa063921edc4","children":[{"type":"formatted","code":true,"text":"dialog"},{"type":"formatted","text":" 中的表单如何 "},{"type":"formatted","code":true,"text":"method"},{"type":"formatted","text":" 设置为 "},{"type":"formatted","code":true,"text":"dialog"},{"type":"formatted","text":"，那么点击提交时会关闭弹窗，而不是发送网络请求，而提交按钮的 "},{"type":"formatted","code":true,"text":"value"},{"type":"formatted","text":" 可以通过 "},{"type":"formatted","code":true,"text":"dialog.returnValue"},{"type":"formatted","text":" 获取到，因此可以根据点击的不同按钮执行不同的操作，"},{"type":"link","url":"https://lastknightcoder.github.io/demos/dialog/05-method-dialog.html","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"b2e0bb4e-2738-4953-93c7-92733b4e2b63","children":[{"type":"formatted","text":"点击此处查看示例"}]}]},{"type":"code-block","language":"TSX","uuid":"91d03c87-dbee-40ce-be04-6668d83e417b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"3ef90dc4-61ad-4935-be10-8a3eea3eb471","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const handleDeleteClose = () => {\n    const dialog = deleteDialogRef.current;\n    addLog(`删除确认对话框关闭，返回值: \"${dialog.returnValue}\"`);\n\n    if (dialog.returnValue === 'delete') {\n        addLog('✓ 用户确认删除操作');\n    } else if (dialog.returnValue === 'cancel') {\n        addLog('✗ 用户取消删除操作');\n    }\n};\n\n<dialog\n    ref={deleteDialogRef}\n    onClose={handleDeleteClose}\n    className=\"backdrop:bg-black/50 bg-white dark:bg-gray-800 rounded-lg shadow-xl p-0 border-0\"\n    >\n    <form method=\"dialog\" className=\"p-6 min-w-[400px]\">\n        <div className=\"flex items-center gap-3 mb-4\">\n        <div className=\"w-12 h-12 bg-red-100 dark:bg-red-900 rounded-full flex items-center justify-center\">\n            <span className=\"text-2xl\">⚠️</span>\n        </div>\n        <h3 className=\"text-2xl font-bold text-gray-900 dark:text-white\">确认删除</h3>\n        </div>\n        <p className=\"text-gray-600 dark:text-gray-300 mb-6\">\n        此操作无法撤销。确定要删除这个项目吗？\n        </p>\n        <div className=\"flex gap-3 justify-end\">\n        <button\n            type=\"submit\"\n            value=\"cancel\"\n            className=\"px-4 py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-900 dark:text-white rounded-lg transition\"\n        >\n            取消\n        </button>\n        <button\n            type=\"submit\"\n            value=\"delete\"\n            className=\"px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition\"\n        >\n            删除\n        </button>\n        </div>\n    </form>\n</dialog>","collabId":"ead2f4a0-0cdd-494b-a4fa-a40246698284","children":[{"type":"formatted","text":""}]}]}]}]}],"tags":["HTML/dialog","HTML/form"],"createTime":1768402842868,"updateTime":1774969896276,"linkedCards":[]},"meta":{"type":"card","publishTime":1774969896276},"links":{"card:665":{"key":"card:665","type":"card","id":665}}}