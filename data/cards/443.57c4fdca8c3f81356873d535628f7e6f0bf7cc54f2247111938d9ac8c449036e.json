moo-moo there'.find('moo')\n7\n>>> title = \"Monty Python's Flying Circus\"\n>>> title.find('Monty')\n0\n>>> title.find('Python')\n6\n>>> title.find('Flying')\n15\n>>> title.find('Zirquss')\n-1","collabId":"60e0bb87-2803-4c1d-84f8-c28e68a16482","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"92671229-5c36-4fab-8948-30c2cd7b9a96","children":[{"type":"formatted","text":"可指定搜索的起点和终点"}]},{"type":"code-block","language":"py","uuid":"68dfb83d-04e8-4eeb-90ae-c6617f5656cf","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"87f11751-5b2d-4aa4-8a82-d73f74ba494a","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":">>> subject = '$$$ Get rich now!!! $$$'\n>>> subject.find('$$$')\n0\n>>> subject.find('$$$', 1) # 只指定了起点\n20\n>>> subject.find('!!!')\n16\n>>> subject.find('!!!', 0, 16) # 同时指定了起点和终点\n-1","collabId":"72f796da-e1fe-441a-b03d-f676d37a4983","children":[{"type":"formatted","text":""}]}]},{"type":"highlight-block","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"9e044418-de19-4e61-b470-c661f7e6f647","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e7ca662e-c2a5-441d-b224-1f09067a31f1","children":[{"type":"formatted","text":"起点和终点值（第二个和第三个参数）指定的搜索范围包含起点，但不包含终点。"}]}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"385be6b1-0c67-475f-9bac-b194fb183bb5","children":[{"type":"formatted","text":"join"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fdf7db1f-4284-44db-b64f-074660396ed5","children":[{"type":"formatted","text":"合并序列的元素，所合并序列的元素必须都是字符串。"}]},{"type":"code-block","language":"py",