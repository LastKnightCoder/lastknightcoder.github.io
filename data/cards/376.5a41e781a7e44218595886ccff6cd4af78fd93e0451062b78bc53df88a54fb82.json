{"version":1,"key":"card:376","content":{"id":376,"content":[{"type":"paragraph","children":[{"text":"关于滚动的一些注意点：","type":"formatted"}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","code":true,"text":"html"},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"textarea","code":true},{"type":"formatted","text":" 元素会出现滚动条，是因为其 "},{"type":"formatted","text":"overflow","code":true},{"type":"formatted","text":" 的初始值为 "},{"type":"formatted","text":"auto","code":true},{"type":"formatted","text":"，而不是 "},{"type":"formatted","text":"visible","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"对于 PC 来说，滚动条是出现在 "},{"type":"formatted","text":"html","code":true},{"type":"formatted","text":" 元素上，而对于移动设备来说却不是，在 PC 设备上，我们通过 "},{"type":"formatted","text":"document.documentElement.scrollTop","code":true},{"type":"formatted","text":" 来获取滚动高度，但是在移动设备上就得通过 "},{"type":"formatted","text":"document.body.scrollTop","code":true},{"type":"formatted","text":" 来获取"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"滚动条是会占据可用宽度的，可参考 "},{"type":"content-link","children":[{"type":"formatted","text":"clentWidth、offsetWidth"}],"refId":360,"contentType":"card","contentTitle":"","contentId":308},{"type":"formatted","text":" 等的定义。"}],"disableDrag":false}]}]}],"tags":["CSS/滚动"],"createTime":1699671306191,"updateTime":1745152819152,"linkedCards":[]},"meta":{"type":"card","publishTime":1745152819152},"links":{"card:360":{"key":"card:360","type":"card","id":360}}}