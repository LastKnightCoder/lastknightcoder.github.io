befee37e5daeb6121e40071bbd6","collabId":"e191bbd6-5488-49b1-85b5-473ba1d7fa89","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"Vary: User-Agent","collabId":"c9013296-5846-4ed4-965d-9b1724c8db03","children":[{"type":"formatted","text":""}]}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4655e39d-2093-4ef8-84e5-65686054fb3b","children":[{"type":"formatted","text":"如果需要区分多个首部，可以同时指定多个字段，字段之间使用逗号分隔"}]},{"type":"code-block","language":"HTTP","uuid":"5a5f5d87-d09e-4ebc-aa9b-26b723555db7","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9a5d99f6-d575-4267-a170-f4b771f0fbe3","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"Vary: Accept-Encoding, Accept-Language","collabId":"ce6012cc-8b08-4a69-a814-c7663596dba6","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"72235952-813b-4465-9890-7634a10f9360","children":[{"type":"formatted","text":"如果缓存系统没有根据这些请求头加以区分，就会返回错误的缓存内容给用户。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5d6d9124-0a33-472e-992c-7540bd74ba1e","children":[{"type":"formatted","text":"可见 "},{"type":"formatted","code":true,"text":"Vary"},{"type":"formatted","text":" 响应头对缓存系统有很大的影响，如果不正确的设置 "},{"type":"formatted","code":true,"text":"Vary"},{"type":"formatted","text":" 可能会导致缓存系统的成本上升、缓存命中率急剧下降或者返回错误的缓存响应，比如如果你不依赖于 "},{"type":"formatted","code":true,"text":"User-Agent"},{"type":"formatted","text":" 提供不同的服务，却把 "},{"type":"formatted","code":true,"text":"User-Agent"},{"type":"formatted","text":" 放入了 "},{"type":"formatted","code":true,"text":"Vary"},{"type":"formatted","text":" 中，由于 "},{"type":"formatted","code":true,"text":"User-Agent"},{"type":"formatted","text":" 高度离散，就会导致缓存效率大幅降低。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e9bb3f6b-4358-4a53-9343-ab28055ef607","children":[{"type":"formatted","text":"参考："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"580c071f-ac26-420b-ad7b-c9f7cbd12310","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"960e2679-1802-44b2-bd8f-5de8670bceae","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6303d933-d9c6-4def-b65c-5b46504584d6","children":[{"type":"formatted","text":"《HTTP 权威指南》，第 17 章，内容协商与转码"}]}]}]}],"tags":["HTTP/Vary"],"createTime":1752853058031,"updateTime":1752853182287,"linkedCards":[]},"meta":{"type":"card","publishTime":1752853182287}}