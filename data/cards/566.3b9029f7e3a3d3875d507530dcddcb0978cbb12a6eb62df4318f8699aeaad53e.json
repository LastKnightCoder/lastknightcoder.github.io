{"version":1,"key":"card:566","content":{"id":566,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"Canvas 和 SVG 的区别："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"Canvas"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"像素栅格图，放大时失真"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"使用 JavaScript 绘制"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"绘制时不会引起 DOM 变化，性能好，适合游戏和数据可视化"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"简单事件系统，只能给整个 canvas 标签添加事件，无法为其中的绘制的元素单独添加事件，需要自行处理与元素交互的"}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"SVG"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"矢量图，放大时不失真"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"XML 标签绘制，无需 JavaScript 参与"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"修改时会引起 DOM 变化，会引起浏览器的重排和重绘，频繁绘制时会导致性能问题，适合交互的静态图形"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"可单独为绘制的元素添加事件"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"可嵌入 DOM，实现复杂的排版"}]}]}]}]}]}],"tags":["面试题","Canvas","SVG","概念对比"],"createTime":1744640142179,"updateTime":1752403040114,"linkedCards":[]},"meta":{"type":"card","publishTime":1752403040114}}