ph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e4f1e02e-575d-40d3-a0c7-3f359123b556","children":[{"type":"formatted","text":"改：非文法、语法上的修改或扩写，而是在理解消化后用自己的理解进行修改"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"227e08e8-9f49-4342-9f67-d3210b7c5ebd","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ad7d1e19-ca53-4048-845f-0ce90ae9efb2","children":[{"type":"formatted","text":"删：对于不在关注的领域，归档或者及时清理，减少心智负担，对于单篇笔记，有了更深刻的理解，可以使用更精炼的语句进行表达，删除不必要的部分"}]}]}]}]}]}],"tags":["读书/笔记的方法","学习方法"],"createTime":1743904829242,"updateTime":1743904847872,"linkedCards":[]},"meta":{"type":"card","publishTime":1743904847872}}