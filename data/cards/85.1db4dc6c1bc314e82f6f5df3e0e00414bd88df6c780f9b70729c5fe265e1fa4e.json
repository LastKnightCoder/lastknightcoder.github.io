{"version":1,"key":"card:85","content":{"id":85,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"range.surroundContents","code":true},{"type":"formatted","text":" 给选区包裹一层标签"}],"disableDrag":false},{"type":"code-block","code":"const mark = document.createElement('mark');\nrange.surroundContents(mark);","language":"JavaScript","uuid":"bc2f19df-d8f9-4485-9cf3-d5bd690d9242","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"但是当选区横跨多个标签时，就会发生错误。另一种方案，通过 "},{"type":"formatted","text":"range.extractContents","code":true},{"type":"formatted","text":" 提取选区内容，是一个 "},{"type":"formatted","text":"DocumentFragment","code":true},{"type":"formatted","text":"，然后插入新内容"}],"disableDrag":false},{"type":"code-block","code":"const mark = document.createElement('mark');\nmark.append(range.extractContents());\nrange.insertNode(mark);","language":"JavaScript","uuid":"53e6705c-75e4-463b-a646-770171655718","children":[{"type":"formatted","text":""}]}],"tags":["DOM/选区"],"createTime":1689172831711,"updateTime":1753716407180,"linkedCards":[]},"meta":{"type":"card","publishTime":1753716407180}}