{"version":1,"key":"card:445","content":{"id":445,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"创建字典："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"字面量"}]},{"type":"code-block","code":">>> d = {\"name\": \"Alice\", \"age\": 18}\n>>> d\n{'name': 'Alice', 'age': 18}","language":"py","uuid":"ee62e2a4-6422-410a-8230-30e908bcb42d","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"dict","code":true},{"type":"formatted","text":" 方法，从其他字典进行创建"}]},{"type":"code-block","code":">>> items = [('name', 'Gumby'), ('age', 42)]\n>>> d = dict(items)\n>>> d\n{'age': 42, 'name': 'Gumby'}\n>>> d['name']\n'Gumby'","language":"py","uuid":"7a236801-fc0e-4551-8860-67c645c15559","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"如果调用 "},{"type":"formatted","text":"dict","code":true},{"type":"formatted","text":" 时没有提供任何实参，将返回一个空字典。"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"字典推导，在一行代码中根据一个或多个输入序列中的元素来生成新的字典"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"语法"}]},{"type":"code-block","code":"new_dict = {key_expression: value_expression for item in iterable if condition}","language":"py","uuid":"a5ba6d51-d9b2-4631-ae9f-0eefb9cad201","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"例子"}]},{"type":"code-block","code":">>> squares_dict = {x: x**2 for x in range(5)}\n>>> squares_dict\n{0: 0, 1: 1, 2: 4, 3: 9, 4: 16}","language":"py","uuid":"40c5d746-e957-46e0-9a80-ca4bae6f5fac","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":">>> names = ['Alice', 'Bob', 'Charlie']\n>>> name_dict = {name: len(name) for name in names}\n>>> name_dict\n{'Alice': 5, 'Bob': 3, 'Charlie': 7}","language":"py","uuid":"28a87e37-6a84-4c59-87a7-92247eadfb54","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":">>> filtered_dict = {key: [num for num in data[key] if num % 2 == 0] for key in data}\n>>> filtered_dict\n{'a': [2], 'b': [4, 6], 'c': [8]}","language":"py","uuid":"cace75b9-d887-4fdb-891b-d28f4f231420","children":[{"type":"formatted","text":""}]}]}]}]}]},{"type":"paragraph","children":[{"type":"formatted","text":"基本操作："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"len(d)","code":true},{"type":"formatted","text":" 返回字典 "},{"type":"formatted","text":"d","code":true},{"type":"formatted","text":" 包含的项（键-值对）数。"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"d[k]","code":true},{"type":"formatted","text":"返回与键 "},{"type":"formatted","text":"k","code":true},{"type":"formatted","text":" 相关联的值。"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"d[k] = v","code":true},{"text":" 将值 ","type":"formatted"},{"type":"formatted","text":"v","code":true},{"text":" 关联到键k。","type":"formatted"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"del d[k]","code":true},{"type":"formatted","text":" 删除键为 "},{"type":"formatted","text":"k","code":true},{"type":"formatted","text":" 的项。"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"k in d","code":true},{"type":"formatted","text":" 检查字典 "},{"type":"formatted","text":"d","code":true},{"type":"formatted","text":" 是否包含键为 "},{"type":"formatted","text":"k","code":true},{"type":"formatted","text":" 的项。"}]}]}]},{"type":"code-block","code":">>> d\n{'name': 'Alice', 'age': 18}\n\n>>> len(d)\n2\n\n>>> d[\"name\"]\n'Alice'\n\n>>> d[\"age\"] = 20\n>>> d\n{'name': 'Alice', 'age': 20}\n\n>>> del d[\"name\"]\n>>> d\n{'age': 20}\n\n>>> \"name\" in d\nFalse\n>>> \"age\" in d\nTrue","language":"py","uuid":"7320d57e-f924-43ec-a80e-f0986a6a36fe","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"注意："}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"字典中的键可以是任何不可变的类型，如浮点数（实数）、字符串或元组。"}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"即便是字典中原本没有的键，也可以给它赋值，这将在字典中创建一个新项。"}]}]}]}],"tags":["Python/字典"],"createTime":1719153127353,"updateTime":1743303640440,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640440}}