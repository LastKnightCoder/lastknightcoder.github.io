{"version":1,"key":"card:11","content":{"id":11,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"05e9d0fc-baea-43c1-8293-b30027f9a472","children":[{"type":"formatted","text":"使用 "},{"type":"formatted","code":true,"text":"&"},{"type":"formatted","text":" 连接两个类型形成的新类型表示二者的交集，新类型表示同时满足二者的类型"}]},{"type":"code-block","language":"TypeScript","uuid":"dbf33c3b-7a52-470c-9250-1049e3b64f9d","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e162d473-6faa-45e2-b3cb-132d970012d8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"// 既是 string 又是 number，不存在这种类型\ntype Never = string & number; ","collabId":"effc39b8-4a3a-4d50-907f-7068199ae79e","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"TypeScript","uuid":"424473ee-b6b5-4a89-8fce-702ff4b1f7ba","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"f001f443-35d8-476b-9931-945c7bf985c9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"interface State {\n  name: string;\n  age: number;\n}\ninterface Action {\n  eat: () => void;\n}\n\n\n// 既满足 State，又满足 Action，将两个对象进行合并\ntype Person = State & Action;\n\n\nconst person: Person = {\n  name: 'Alice',\n  age: 18,\n  eat: () => {\n    console.log('ear');\n  }\n}","collabId":"0c8aef55-50a5-4477-85ec-80066b0c2e4a","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"TypeScript","uuid":"592e18f4-f84e-4619-8f80-83caddee99c4","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8f138052-b41c-4dbd-a2a0-5a1ad77c0d14","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"type A = (1 | 2 | 3) & (1 | 2); // 1 | 2","collabId":"7b94e083-a093-498c-9cac-4382a60b0660","children":[{"type":"formatted","text":""}]}]}],"tags":["TypeScript/类型操作"],"createTime":1688912176923,"updateTime":1743303640384,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640384}}