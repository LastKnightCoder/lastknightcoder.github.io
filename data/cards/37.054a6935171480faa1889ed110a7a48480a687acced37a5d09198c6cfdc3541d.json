{"version":1,"key":"card:37","content":{"id":37,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"考虑视口的大小为 "},{"type":"inline-math","tex":"h","children":[{"type":"formatted","text":"h"}]},{"type":"formatted","text":"，页面的总长度为 "},{"type":"inline-math","tex":"y","children":[{"type":"formatted","text":"y"}]},{"type":"formatted","text":"，那么滚动条的长度 "},{"type":"inline-math","tex":"x","children":[{"type":"formatted","text":"x"}]},{"type":"formatted","text":" 是多少"}],"disableDrag":false},{"type":"image","url":"https://github.com/LastKnightCoder/ImgHosting3/raw/master/Pasted-image-20230210111814.192lruuhom3k.webp","children":[{"type":"formatted","text":""}],"previewUrl":"https://github.com/LastKnightCoder/ImgHosting3/raw/master/Pasted-image-20230210111814.192lruuhom3k.webp"},{"type":"paragraph","children":[{"type":"formatted","text":"视口占页面的比例应与滚动条长度占滚动条总长度（视口长度）相同，即"}],"disableDrag":false},{"type":"block-math","tex":"\\frac{h}{y} = \\frac{x}{h}","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"得到"}],"disableDrag":false},{"type":"block-math","tex":"x = \\frac{h^2}{y}","children":[{"type":"formatted","text":""}]}],"tags":["DOM/技巧","技巧/DOM"],"createTime":1688964344714,"updateTime":1752924257899,"linkedCards":[]},"meta":{"type":"card","publishTime":1752924257899}}