{"version":1,"key":"card:191","content":{"id":191,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"当我们调用 "},{"type":"formatted","text":"stroke()","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"fill()","code":true},{"type":"formatted","text":" 方法时，会根据当前的路径信息进行绘制图形，而当我们调用 "},{"type":"formatted","text":"clip()","code":true},{"type":"formatted","text":" 方法时，则会根据路径信息形成一个裁剪区域，接下来绘制的图形只能出现在这个裁剪区域中"}]},{"type":"code-block","code":"ctx.beginPath()\nctx.arc(250, 250, 100, 0, 2 * Math.PI)\nctx.clip()\n\nconst loadImage = (src) => {\n  const img = new Image()\n  img.addEventListener('load', () => {\n    const width = img.width\n    const height = img.height\n    const ratio = width / height\n    ctx.drawImage(img, 0, 0, canvas.width, canvas.width / ratio)\n  })\n  img.src = src\n}\n\nloadImage('./car.jpeg')","language":"JavaScript","uuid":"83d6488b-3d64-40ab-a703-146d5be137c2","children":[{"type":"formatted","text":""}]},{"type":"html-block","html":"<iframe src=\"https://lastknightcoder.github.io/canvas-demos/68.html\" height=\"450\" width=\"800px\" style=\"overflow: hidden; transform: translateX(-100px); border: none;\"></iframe>","children":[{"type":"formatted","text":""}]}],"tags":["Canvas"],"createTime":1690384930343,"updateTime":1743303640408,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640408},"pluginRenderers":[{"runtimeVersion":1,"manifest":{"formatVersion":1,"id":"tau.html","name":"HTML","version":"0.1.4","minAppVersion":"0.59.0","apiVersion":1,"platform":"desktop","format":"cjs","main":"main.js","editor":true,"categories":["editor","ai"],"keywords":["HTML","网页","嵌入"],"integrity":{"main.js":"eafe74429244b57e1dce6a889e1e925f0cf178f5942afe95485f081a8fa048bf","main.css":"468f2feb73a33e5711b1583b609e4ab3818e83d5f19a38dcd9d027b77eb269d8"},"styles":"main.css"},"entry":"../../plugin-assets/tau.html/0.1.4/7b4be5bc83e3b665c52aeaddc0c146d56eb1864201e835bf5ebaba71b8eb1536/main.js","styles":"../../plugin-assets/tau.html/0.1.4/7b4be5bc83e3b665c52aeaddc0c146d56eb1864201e835bf5ebaba71b8eb1536/style.css","nodeTypes":["html-block","html-inline"]}],"contentStyles":[{"href":"../styles/6bf420e577ba514b1b435bb7c38df1c818bcb57e99bca9492a0c106577b9a04f.css","integrity":"6bf420e577ba514b1b435bb7c38df1c818bcb57e99bca9492a0c106577b9a04f"}]}