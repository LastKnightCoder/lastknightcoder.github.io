{"version":1,"key":"card:357","content":{"id":357,"content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"993bc3ec-24ab-44d6-8e9c-8460d54c9f36","children":[{"type":"content-link","refId":356,"contentType":"card","contentTitle":"","contentId":305,"tauContract":"720a42c66441f65bfc897253311b73deb687a68a60da46dffe8c7b8537a65760","collabId":"990e3df9-e66a-425a-810d-b92937d3df77","children":[{"type":"formatted","text":"柯里化"}]},{"type":"formatted","text":"有什么用处，假设有一个 ajax 请求的函数如下"}]},{"type":"code-block","language":"js","uuid":"622e0776-67ea-4ad5-81d6-94b759e33047","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"333f20b1-d003-4d31-8b07-83e3a88bcaad","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function ajax(type, url, data) {\n    let xhr = new XMLHttpRequest();\n    xhr.onReadystateChange = function() {\n        // ...\n    }\n    xhr.open(type, url);\n    xhr.send(data);\n}","collabId":"fdfe1234-a61f-4454-a7d0-872ae7bf2c83","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ee436fc3-1ab0-4489-a1fe-203072fd3196","children":[{"type":"formatted","text":"现在我们将这个函数柯里化"}]},{"type":"code-block","language":"js","uuid":"3ccd6d56-2128-460a-99de-eb001c78b321","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9c0bea0a-831a-43ab-8f1e-ef74ee9b7255","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let curriedAjax = curry(ajax);\nlet post = curriedAjax('post');","collabId":"cb24dc88-d51f-41e4-bd01-500c8d84d063","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"873dbdf0-da39-494b-8aee-b7557db6a33e","children":[{"type":"formatted","text":"我们向 "},{"type":"formatted","code":true,"text":"curriedAjax"},{"type":"formatted","text":" 传入一个参数 "},{"type":"formatted","code":true,"text":"post"},{"type":"formatted","text":"，得到一个函数，这个函数的作用是用来发 "},{"type":"formatted","code":true,"text":"post"},{"type":"formatted","text":" 请求的，我们每次发 "},{"type":"formatted","code":true,"text":"post"},{"type":"formatted","text":" 请求时，只需要使用 "},{"type":"formatted","code":true,"text":"post"},{"type":"formatted","text":" 方法即可，这样函数的复用性有了极大的增强，我们可以继续传入参数"}]},{"type":"code-block","language":"js","uuid":"44c55fec-c5a6-4b44-aede-2995ffb3ccd5","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"fb6a432f-3079-49fe-b0b0-5000763800b9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"let postGoogle = post('https://www.google.com');","collabId":"98eb92b7-88a0-4b0b-aed5-f0c5bb19c27f","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cfcaa1ee-193d-4451-961a-32427f4bf08d","children":[{"type":"formatted","text":"我们又得到了一个函数，该函数的作用是向 https://www.google.com 发送 post 请求，函数的复用性又进一步的提升。"}]}],"tags":["JavaScript"],"createTime":1697157222791,"updateTime":1743303640425,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640425},"links":{"card:356":{"key":"card:356","type":"card","id":356}}}