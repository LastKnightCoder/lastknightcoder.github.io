{"version":1,"key":"card:182","content":{"id":182,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","text":"toBlob(callback, type, quality)","code":true},{"type":"formatted","text":" 方法可以将 "},{"type":"formatted","text":"canvas","code":true},{"type":"formatted","text":" 对象转化为 Blob 对象，该方法接收三个参数，第一个参数为回调函数，Blob 对象会作为参数传递给改函数，"},{"type":"formatted","text":"type","code":true},{"type":"formatted","text":" 指定转换的图片类型，可以为 "},{"type":"formatted","text":"image/png","code":true},{"type":"formatted","text":" "},{"type":"formatted","text":"image/jpeg","code":true},{"type":"formatted","text":" "},{"type":"formatted","text":"image/webp","code":true},{"type":"formatted","text":" ，可以通过第三个参数 "},{"type":"formatted","text":"quality","code":true},{"type":"formatted","text":" 指定图片的质量，默认值为 "},{"type":"formatted","text":"0.92","code":true}]},{"type":"code-block","code":"const canvasToBlob = (canvas) => {\n  return new Promise(resolve => {\n    canvas.toBlob(blob => {\n      resolve(blob)\n    }, 'image/png')\n  })\n}\n\n(async () => {\n  const blob = await canvasToBlob(canvas)\n  const url = URL.createObjectURL(blob)\n  const img = new Image()\n  img.src = url\n  document.body.appendChild(img)\n})()","language":"JavaScript","uuid":"cd83ed29-8912-40b7-82f2-b70d77116845","children":[{"type":"formatted","text":""}]}],"tags":["Canvas"],"createTime":1690379894974,"updateTime":1743303640408,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640408}}