{"version":1,"key":"card:563","content":{"id":563,"content":[{"children":[{"code":true,"text":"Map","type":"formatted"},{"text":" 和 ","type":"formatted"},{"code":true,"text":"Set","type":"formatted"},{"text":" 的迭代顺序：","type":"formatted"},{"bold":true,"text":"和插入顺序相同","type":"formatted"},{"text":"。","type":"formatted"}],"collabId":"93bd9f85-3a73-4ddb-bfaf-17c17737e048","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const map = new Map();\nmap.set(\"b\", 2);\nmap.set(\"a\", 1);\nmap.set(\"d\", 4);\nmap.set(\"c\", 3);\n\nconsole.log(...map.entries()) // [['b', 2], ['a', 1], ['d', 4], ['c', 3]]\nconsole.log(...map.keys())    // b a d c\nconsole.log(...map.values())  // 2 1 4 3","collabId":"ae5ef46f-1995-47b0-bbf0-9655afe14d5a","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"3cb95656-2082-458e-b625-7bd484bae758","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"e6df8f11-6eef-4b4e-9921-bec7c2848544"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const set = new Set();\nset.add(\"a\");\nset.add(\"d\");\nset.add(\"c\");\nset.add(\"b\");\n\nconsole.log(...set.values()); // a d c b","collabId":"7ceccfe2-707a-429b-bff3-2bfa1849c1e6","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"5c4f1286-d17d-4b53-acbd-69330b56c1e4","language":"JavaScript","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"1ef5b7c2-0e89-441c-8a38-485e16c60708"}],"tags":["JavaScript/Map","JavaScript/Set","面试题"],"createTime":1744527817497,"updateTime":1793532557508,"linkedCards":[]},"meta":{"type":"card","publishTime":1793532557508}}