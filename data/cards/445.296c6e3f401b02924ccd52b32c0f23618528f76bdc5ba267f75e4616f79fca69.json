151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"基本操作：","type":"formatted"}],"collabId":"ce9f5e68-b5e1-4314-9c2e-021fefd6dfe7","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"code":true,"text":"len(d)","type":"formatted"},{"text":" 返回字典 ","type":"formatted"},{"code":true,"text":"d","type":"formatted"},{"text":" 包含的项（键-值对）数。","type":"formatted"}],"collabId":"aac88a75-3f31-473d-9e44-87e9d23ca160","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"6b196ac9-5a27-4526-985f-1bd751103aca","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"d[k]","type":"formatted"},{"text":"返回与键 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 相关联的值。","type":"formatted"}],"collabId":"4ff5d942-098f-421f-8bc0-942eda83a7dc","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"3d65f872-099e-44e5-83c5-18aabf475d42","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"d[k] = v","type":"formatted"},{"text":" 将值 ","type":"formatted"},{"code":true,"text":"v","type":"formatted"},{"text":" 关联到键k。","type":"formatted"}],"collabId":"83b3bb1f-86ac-4e1b-9def-1d1fb58b85f9","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"58208fc2-bcdf-4e66-ba88-f89737f43e57","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"del d[k]","type":"formatted"},{"text":" 删除键为 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 的项。","type":"formatted"}],"collabId":"1e76e2c3-2082-4c6d-9bb8-871cbd9b12d9","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"d3266f1e-afef-4c2e-bc7d-2053d57472b4","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"k in d","type":"formatted"},{"text":" 检查字典 ","type":"formatted"},{"code":true,"text":"d","type":"formatted"},{"text":" 是否包含键为 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 的项。","type":"formatted"}],"collabId":"c36d9fb1-95e4-4f2d-9977-d6cfecf68c64","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"6c540109-a6e0-4ff2-a1b4-84696811b82b","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"8aefa988-81fd-4004-b1fa-6b504d9549f2","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> d\n{'name': 'Alice', 'age': 18}\n\n>>> len(d)\n2\n\n>>> d[\"name\"]\n'Alice'\n\n>>> d[\"age\"] = 20\n>>> d\n{'name': 'Alice', 'age': 20}\n\n>>> del d[\"name\"]\n>>> d\n{'age': 20}\n\n>>> \"name\" in d\nFalse\n>>> \"age\" in d\nTrue","collabId":"32ed4544-5fb8-43d2-8b9d-3dab01f4d0a7","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"9f215f9b-12d7-460c-a340-70ed9f6e98ec","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"7320d57e-f924-43ec-a80e-f0986a6a36fe"},{"children":[{"text":"注意：","type":"formatted"}],"collabId":"7cac1dd0-79f8-47a1-a0f2-1494fe247787","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"字典中的键可以是任何不可变的类型，如浮点数（实数）、字符串或元组。","type":"formatted"}],"collabId":"e