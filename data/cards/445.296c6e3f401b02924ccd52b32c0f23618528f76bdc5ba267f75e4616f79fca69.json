{"version":1,"key":"card:445","content":{"id":445,"content":[{"children":[{"text":"创建字典：","type":"formatted"}],"collabId":"e870d15b-0cbb-4218-91f8-0094ae26209f","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"字面量","type":"formatted"}],"collabId":"114a182a-67ad-40d4-818e-543c368b0714","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> d = {\"name\": \"Alice\", \"age\": 18}\n>>> d\n{'name': 'Alice', 'age': 18}","collabId":"28976306-6e1a-4bd8-a903-66af293b5749","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"51f14666-da9c-4357-970a-01ff8b9a511f","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"ee62e2a4-6422-410a-8230-30e908bcb42d"}],"collabId":"9a318952-6bfc-4cdf-beb4-4219ae50b3c4","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"dict","type":"formatted"},{"text":" 方法，从其他字典进行创建","type":"formatted"}],"collabId":"d19a420a-b0aa-4fa2-9e64-4997684e3016","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> items = [('name', 'Gumby'), ('age', 42)]\n>>> d = dict(items)\n>>> d\n{'age': 42, 'name': 'Gumby'}\n>>> d['name']\n'Gumby'","collabId":"5032fb30-8616-4412-a36c-80d8163df340","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"997db9f4-9079-48b2-b582-6444e9952fe0","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"7a236801-fc0e-4551-8860-67c645c15559"},{"children":[{"text":"如果调用 ","type":"formatted"},{"code":true,"text":"dict","type":"formatted"},{"text":" 时没有提供任何实参，将返回一个空字典。","type":"formatted"}],"collabId":"a4d5830e-223b-4d3a-bec8-1ffb4c371864","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"903ad8f3-236b-498f-b30c-a5970cc24b8d","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"字典推导，在一行代码中根据一个或多个输入序列中的元素来生成新的字典","type":"formatted"}],"collabId":"4b1e50dd-f241-4e8a-a6cd-033f18901237","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"语法","type":"formatted"}],"collabId":"ba93853a-324a-4e22-9295-d3a550ca48bb","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"new_dict = {key_expression: value_expression for item in iterable if condition}","collabId":"4ff9fa76-eb35-49cb-afde-e3278431fc60","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"60b02b77-b5f7-4ce2-b80a-486e3921a8c0","language":"py","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"a5ba6d51-d9b2-4631-ae9f-0eefb9cad201"}],"collabId":"024e1109-c61d-488e-9e06-540afb3a6701","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"例子","type":"formatted"}],"collabId":"c0cc0cc8-163f-4653-a83a-bdb0b81cf26e","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":">>> squares_dict = {x: x**2 for x in range(5)}\n>>> squares_dict\n{0: 0, 1: 1, 2: 4, 3: 9, 4: 16}","collabId":"bab07090-1bfe-44de-9ba0-ce854a28d7cb","tauContrac