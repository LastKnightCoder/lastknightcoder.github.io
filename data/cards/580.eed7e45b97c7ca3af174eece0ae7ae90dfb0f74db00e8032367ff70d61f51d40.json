{"version":1,"key":"card:580","content":{"id":580,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"GET 和 POST 的比较："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"作用"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"GET：一般用以请求资源"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"POST：一般用以提交数据或更新资源"}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"幂等"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"GET：多次请求对服务器状态无影响，具有幂等性"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"POST：请求会对服务器状态产生影响，无幂等性"}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"安全"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"GET：安全性较好，无法作为 CSRF 的攻击手段修改用户数据"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"POST：安全性较差，可作为 CSRF 攻击手段修改用户数据"}]}]}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"参数"}]},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"GET：通过 URL 携带请求参数，URL 具有长度限制，所以对请求参数存在限制"}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"POST：通过 HTTP Body 携带参数，无长度限制"}]}]}]}]},{"type":"l