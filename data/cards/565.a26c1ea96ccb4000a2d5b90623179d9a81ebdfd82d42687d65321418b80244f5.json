{"version":1,"key":"card:565","content":{"id":565,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"push","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"concat","code":true},{"type":"formatted","text":" 的区别："}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"push","code":true},{"type":"formatted","text":" 会原地修改数组，"},{"type":"formatted","text":"concat","code":true},{"type":"formatted","text":" 不会修改原数组，而是返回新的数组"}]},{"type":"code-block","code":"const arr = [1, 2, 3];\narr.push(4);\n\nconsole.log(arr); // [1, 2, 3, 4]","language":"JavaScript","uuid":"a9029747-8827-492a-8549-2a019ece0604","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"const arr = [1, 2, 3];\nconst newArr = arr.concat(4);\n\nconsole.log(arr);    // [1, 2, 3]\nconsole.log(newArr); // [1, 2, 3, 4]","language":"JavaScript","uuid":"311648e5-2442-44c8-b104-fd74e6f7e72f","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","disableDrag":false,"children":[{"type":"formatted","text":"push","code":true},{"type":"formatted","text":" 不会自动展开参数，原样添加到数组中，"},{"type":"formatted","text":"concat","code":true},{"type":"formatted","text":" 会自动展开一层数组"}]},{"type":"code-block","code":"const arr = [1, 2, 3];\narr.push([4]);\n\nconsole.log(arr); // [1, 2, 3, [4]]","language":"JavaScript","uuid":"208727fa-69c7-4a0d-8d15-5e42cd56fec9","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"const arr = [1, 2, 3];\nconst newArr = arr.concat([4]); // [4] 会被自动展开\n\nconsole.log(newArr); // [1, 2, 3, 4]","language":"JavaScript","uuid":"6a1df727-d02e-4506-99ef-3f47a62b7468","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"可以利用这一特性，通过 "},{"type":"formatted","text":"concat","code":true},{"type":"formatted","text":" 来拍平数组"}],"disableDrag":false},{"type":"code-block","code":"const flat = (arr) => {\n  return arr.reduce((prev, cur) => {\n    return prev.concat(Array.isArray(cur) ? flat(cur) : cur);\n  }, [])\n}","language":"JavaScript","uuid":"4109a3cf-9e80-40e3-ac8b-4a782083bf66","children":[{"type":"formatted","text":""}]}]}]}],"tags":["面试题"],"createTime":1744619871445,"updateTime":1746078575735,"linkedCards":[]},"meta":{"type":"card","publishTime":1746078575735}}