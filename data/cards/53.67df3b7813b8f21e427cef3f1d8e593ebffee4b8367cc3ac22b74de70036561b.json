{"version":1,"key":"card:53","content":{"id":53,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"gzip","code":true},{"type":"formatted","text":" 是用于压缩和解压缩的命令行工具。"}],"disableDrag":false},{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"压缩文件"}],"disableDrag":false},{"type":"code-block","code":"# 压缩文件，原文件会被删除，会自动生成以 .gz 为后缀名的压缩文件\ngzip 文件","language":"Bash","uuid":"48ab168c-c594-4351-8f4e-5527a1bf926f","children":[{"type":"formatted","text":""}]},{"type":"code-block","code":"# 压缩多个文件\ngzip 文件1 文件2","language":"Bash","uuid":"89442e1c-a18a-45ce-8fb4-ce80f5bfd467","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"通过 "},{"type":"formatted","text":"-c","code":true},{"type":"formatted","text":" 选项可以将压缩后的内容写入到标准输出而不是文件中，配合重定向我们可以对文件进行压缩的同时且不删除原文件"}],"disableDrag":false},{"type":"code-block","code":"gzip -c hello.c > hello.c.gz","language":"Bash","uuid":"4cbf9605-48bb-40aa-ac08-20f1527b9ef4","children":[{"type":"formatted","text":""}]}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"解压文件"}],"disableDrag":false},{"type":"code-block","code":"# 解压缩，file 会被删除\ngzip -d 压缩文件\n# 或\ngunzip 压缩文件","language":"Bash","uuid":"5f5794c0-575f-46aa-a4be-8982f13d668c","children":[{"type":"formatted","text":""}]}]}]},{"type":"callout","calloutType":"note","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"gzip","code":true},{"type":"formatted","text":" 只能压缩文件。"}],"disableDrag":false}]}],"tags":["压缩/gzip","Linux/命令/gzip"],"createTime":1689000973042,"updateTime":1755938597218,"linkedCards":[]},"meta":{"type":"card","publishTime":1755938597218}}