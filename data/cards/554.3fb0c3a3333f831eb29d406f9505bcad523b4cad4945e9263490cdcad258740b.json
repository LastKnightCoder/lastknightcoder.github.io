tById(\"fileInput\");\ninput.addEventListener(\"change\", (event) => {\n  const files = event.target.files;\n  const file = files[0];\n});\n\nbtn.addEventListener('click', () => {\n  // 调起上传文件页面\n  input.click();\n})","collabId":"13efc565-bf63-410f-bc95-4b7566fd3257","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"3677c3dd-5ae5-4d2d-b4bf-e32c524eb43a","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b8b05f8f-1bde-4a34-ab1e-1938e93fcc51"},{"children":[{"text":"拖拽也可上传文件，监听 ","type":"formatted"},{"code":true,"text":"drop","type":"formatted"},{"text":" 事件，并通过 ","type":"formatted"},{"code":true,"text":"e.dataTransfer","type":"formatted"},{"text":" 获得拖拽的文件","type":"formatted"}],"collabId":"e9114ea4-ffc5-4f3b-9720-9d709ee0760a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"<div id=\"drop\">拖拽文件至此</div>","collabId":"fdcc2386-2a9c-4d33-aa3a-2eb61119157b","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"43613713-c2dc-402f-96fc-008b16308767","language":"html","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"c01a0528-e5a5-4e68-adda-b17b4d59c7d0"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"const drop = document.getEelementById(\"drop\");\ndrop.addEventListener('drop', (e) => {\n  const files = e.dataTransfer.files;\n  const file = files[0];\n})","collabId":"32be154b-64b1-4ab6-a0fa-76a7ab1653d4","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"fd0def43-fe79-4bdd-b6d2-8c3da236b323","language":"js","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-bloc