{"version":1,"key":"card:8","content":{"id":8,"content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"76e8a5f1-4625-490e-a535-c7b68f9535f2","children":[{"type":"formatted","text":"具有父子关系的两个类型，如果经过一定变换后，还具有父子关系，就说明这种变换是协变的，如果父子关系颠倒，就说明是逆变的。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"071a29b1-b213-447b-9b45-c25a4ad85537","children":[{"type":"formatted","text":"如下两个类型，"},{"type":"formatted","code":true,"text":"Dog"},{"type":"formatted","text":" 是 "},{"type":"formatted","code":true,"text":"Animal"},{"type":"formatted","text":" 的子类型"}]},{"type":"code-block","language":"TypeScript","uuid":"25c5c298-8465-4da6-bdf2-2e5ba08e8f90","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b9804cd1-8765-46a3-8e81-341d571fcdb4","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"interface Animal {\n  name: string;\n}\ninterface Dog extends Animal {\n  eat: () => void;\n}","collabId":"67c5fc33-da2a-45ae-934d-deaf2826fd94","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7aaa6f00-7993-4456-be77-ac55230c6d06","children":[{"type":"formatted","text":"协变的例子"}]},{"type":"code-block","language":"TypeScript","uuid":"cde2533e-7c48-4379-80df-cdd4a84b2ddc","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"400d30b1-7f56-4f59-8c69-8ccb6992f25c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"type AnimalArray = Array<Animal>;\ntype DogArray = Array<Dog>;\n\n\n// DogArray 仍然是 AnimalArray 的子类型，因此 Array<T> 是协变操作\ntype isChild = DogArray extends AnimalArray ? true : false; // true","collabId":"0c51e5cd-d499-47b3-8ca7-4537b092d82d","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"22225474-9738-4e3a-bdf3-ff566fb4070a","children":[{"type":"formatted","text":"逆变的例子"}]},{"type":"code-block","language":"TypeScript","uuid":"af02c006-a6a8-4a76-9f2e-90d2e4ae430b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c7e3d717-7ea2-41d5-822d-993661b52a9d","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"type AnimalFn = (param: Animal) => void;\ntype DogFn = (param: Dog) => void;\n\n\n// 此时 DogFn 是 AnimalFn 的父类型，父子关系颠倒，因此该变换为逆变\ntype isChild = DogFn extends AnimalFn ? true : false;  // false\ntype isParent = AnimalFn extends DogFn ? true : false; // true","collabId":"44d13b89-ed58-4b4d-b1fd-23029ef6bbad","children":[{"type":"formatted","text":""}]}]}],"tags":["TypeScript/逆变","TypeScript/协变","TypeScript/数据类型/函数"],"createTime":1688911806928,"updateTime":1752924158821,"linkedCards":[]},"meta":{"type":"card","publishTime":1752924158821}}