{"version":1,"key":"card:382","content":{"id":382,"content":[{"type":"numbered-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"position: sticky","code":true},{"type":"formatted","text":" 是相对于其最近的可滚动元素定位的，即 "},{"type":"formatted","text":"overflow","code":true},{"type":"formatted","text":" 非 "},{"type":"formatted","text":"visible","code":true},{"type":"formatted","text":" 的值（即使未发生滚动）"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 元素无法超出其"},{"type":"content-link","children":[{"type":"formatted","text":"包含块"}],"refId":377,"contentType":"card","contentTitle":"","contentId":319},{"type":"formatted","text":"的范围（一般来说是其父级块元素），因此会出现一些意料以外的情况"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"当 "},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 元素和包含块等高时，滚动时 "},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 居然随着包含块一同滚走了，因为二者高度相同，包含块没有多余的空间供 "},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 元素移动"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"当包含块即将退出滚动元素视口时，"},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 元素也跟走退出了。可以利用此特性实现后面的 "},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 将前面的 "},{"type":"formatted","text":"sticky","code":true},{"type":"formatted","text":" 元素顶出去的效果"}],"disableDrag":false}]}]}]}]}],"tags":["CSS/定位/sticky"],"createTime":1701069652852,"updateTime":1744036272547,"linkedCards":[]},"meta":{"type":"card","publishTime":1744036272547},"links":{"card:377":{"key":"card:377","type":"card","id":377}}}