{"version":1,"key":"card:436","content":{"id":436,"content":[{"type":"paragraph","children":[{"type":"formatted","text":"内置函数 "},{"type":"formatted","text":"len","code":true},{"type":"formatted","text":" 可以返回序列中的元素的个数"}]},{"type":"code-block","code":">>> l = [1, 2, 3, 4, 5]\n>>> len(l)\n5\n\n>>> t = (4, 5, 6, 7, 8)\n>>> len(t)\n5\n\n>>> s = \"Hello World!\"\n>>> len(s)\n12","language":"py","uuid":"6e6f7a8b-63d6-49e9-86cc-0c7e96fb16d5","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"min","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"max","code":true},{"type":"formatted","text":" 分别返回序列中最小和最大的元素"}]},{"type":"code-block","code":">>> min(l)\n1\n>>> max(l)\n5\n\n>>> min(t)\n4\n>>> max(t)\n8\n\n>>> min(s)\n' '\n>>> max(s)\n'r'","language":"py","uuid":"e79d28bb-f4c0-435a-bf98-131bbc17624a","children":[{"type":"formatted","text":""}]}],"tags":["Python/序列"],"createTime":1719025081458,"updateTime":1743303640439,"linkedCards":[]},"meta":{"type":"card","publishTime":1743303640439}}