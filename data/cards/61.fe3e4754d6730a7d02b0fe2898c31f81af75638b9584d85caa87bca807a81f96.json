{"version":1,"key":"card:61","content":{"id":61,"content":[{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"55d42c08-35a5-47d2-8390-f681d48e7544","children":[{"type":"formatted","text":"基本用法"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9590f0db-9aab-4325-9ea7-8664ccf28922","children":[{"type":"formatted","code":true,"text":"cp"},{"type":"formatted","text":" 命令用来复制文件，基本用法"}]},{"type":"code-block","language":"bash","uuid":"5311fe13-6293-4b4c-9997-cc1b9dbfccfb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"506c9173-6040-4b3b-986d-aca936b07ee8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"cp source destination","collabId":"01a14b92-b83c-4739-802b-f1395d483782","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"bf6a007b-470a-4e74-881f-cc0cef812376","children":[{"type":"formatted","text":"复制文件并命名"}]},{"type":"code-block","language":"bash","uuid":"eeb5f5e2-66bc-4289-b9e4-0559f17cbff2","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"90bb8e03-f03f-4f18-80a9-9f4c29276f47","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 当前文件夹下内容\n~ » ls -l\ntotal 0\n-rw-r--r-- 1 xt xt   75 Nov 20 18:34 hello.c\n-rw-r--r-- 1 xt xt    0 Nov 20 18:35 hello.md\ndrwxr-xr-x 1 xt xt 4096 Nov 20 18:51 test","collabId":"93ae0592-775f-4316-8fdd-24e280157a2f","children":[{"type":"formatted","text":""}]}]},{"type":"code-block","language":"bash","uuid":"62bea7c0-4c19-4f16-a644-56dddd2d9796","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"619fa6fb-c81b-4050-8a73-3c3a9e7b54e8","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 复制 hello.md 到当前文件夹下，并命名为 hello2.md\n~ » cp hello.md hello2.md\n~ » ls\nhello.c  hello.md  hello2.md  test","collabId":"2450855e-524d-4f60-8d82-0f92966e8621","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"warning","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"06e88c91-e52c-4c2b-a0f7-328c9653c0b5","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a3f9a6cd-ef84-4ead-888f-20b705584aec","children":[{"type":"formatted","text":"如果当前文件夹下已经存在 "},{"type":"formatted","code":true,"text":"hello2.md"},{"type":"formatted","text":"，则会覆盖该文件，"},{"type":"formatted","bold":true,"text":"且不会给出任何提示"},{"type":"formatted","text":"，我们可以为 "},{"type":"formatted","code":true,"text":"cp"},{"type":"formatted","text":" 命令添加 "},{"type":"formatted","code":true,"text":"-i"},{"type":"formatted","text":" 选项，如果已经存在同名的文件，它会询问你是否覆盖"}]},{"type":"code-block","language":"Bash","uuid":"bb814461-a0d0-4672-aa5e-ef21464b3e4a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"efa7e386-366a-4518-8ecd-4686fdb7fbe0","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 输入 y 表示覆盖，输入 n 表示不覆盖\n~ » cp -i hello.md hello2.md\ncp: overwrite 'hello2.md'? y","collabId":"3ebcb09b-1a74-4f3f-b682-a8df475d27c2","children":[{"type":"formatted","text":""}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"05d0733d-80ec-4a9d-8de8-36d4442a55c6","children":[{"type":"formatted","text":"复制文件到指定目录"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a1903812-bc33-49f7-afc7-273d3ed36aa3","children":[{"type":"formatted","bold":true,"text":"复制单个文件"}]},{"type":"code-block","language":"bash","uuid":"51b77bce-47c4-4225-8a2d-37d756290320","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"e8a2f8fd-5e38-4c37-a825-f82719ddcca9","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 复制 /etc 文件夹下的 passwd 文件到当前目录\n~ » cp /etc/passwd .\n~ » ls\nhello.c  hello.md  hello2.md  passwd  test\n# 复制 hello.md 到当前目录下的 test 文件夹\n~ » cp hello.md test\n~ » tree\n.\n├── hello.c\n├── hello.md\n├── hello2.md\n├── passwd\n└── test\n    └── hello.md\n\n1 directory, 5 files","collabId":"b758257a-0490-445e-9308-ae6ae899357a","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f26a9ba0-0522-4e70-8243-e5d657026377","children":[{"type":"formatted","bold":true,"text":"复制多个文件"},{"type":"formatted","text":"："}]},{"type":"code-block","language":"bash","uuid":"e7a66b82-b748-4fac-82f5-2f9d4b8ae452","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"afff28c9-1172-4393-be4e-73d4ae462bc3","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 复制多个文件 hello.md, hello2.md 到 test 文件夹\n~ » cp hello.c hello2.md test\n~ » tree\n.\n├── hello.c\n├── hello.md\n├── hello2.md\n├── passwd\n└── test\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n1 directory, 7 files","collabId":"bd2b90b4-414d-4bf5-be58-77588a84fad4","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"17b3b234-19c1-417a-97c2-c2e139778020","children":[{"type":"formatted","bold":true,"text":"使用通配符复制多个文件："}]},{"type":"code-block","language":"bash","uuid":"26ce4691-841d-47b2-a518-dec74c7c2ede","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7e913d5d-f9b8-4943-baa0-de69ae32a718","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 复制 hello.md hello2.md ... 到 test 文件夹\ncp hello* test","collabId":"8dd25cb7-aa18-46ab-8742-d9010a8b878b","children":[{"type":"formatted","text":""}]}]},{"type":"callout","calloutType":"tip","title":"","tauContract":"82a3e58fc7df817d12ed2ff5fb675ef0d468689701d99d9471018c2dbd8a3221","collabId":"03aab5de-8495-4fea-91cd-794fd735a585","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"89131e97-0dff-468e-8d2d-b4967f950c1e","children":[{"type":"formatted","text":"同样你可以添加 "},{"type":"formatted","code":true,"text":"-i"},{"type":"formatted","text":" 选项，在覆盖文件之前进行询问。"}]},{"type":"code-block","language":"javascript","uuid":"0b9ea197-f2a4-4f28-be7d-66450e0577b3","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c2ad0240-663d-4d21-91f2-db8106f8592b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"~ » cp -i /etc/passwd .\ncp: overwrite './passwd'? n","collabId":"c51436e3-6ae5-47c5-8c24-4a3720d2e2bb","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"526e8dec-8dd6-439c-b971-237a41634afe","children":[{"type":"formatted","text":"将文件移动到某个目录时，也可以为文件重命名"}]},{"type":"code-block","language":"Bash","uuid":"57343884-3696-45ae-9dcc-43451a3b7624","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"d153a0c5-872c-4941-9f49-4745fddbe032","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 将 /etc/passwd 移动到当前文件夹，并重命名为 password\n~ » cp /etc/passwd ./password\n~ » ls\nhello.c  hello.md  hello2.md  passwd  password  test","collabId":"3a509c97-7e70-40d1-ad5c-ae57d8477fbd","children":[{"type":"formatted","text":""}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"9cee5afb-1e83-4a61-a9cd-99c10d681f5b","children":[{"type":"formatted","text":"复制目录"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e9263eca-a720-4471-8716-150dfe33b31e","children":[{"type":"formatted","text":"复制目录时需要添加 "},{"type":"formatted","code":true,"text":"-r"},{"type":"formatted","text":" 选项"}]},{"type":"code-block","language":"shell","uuid":"d1b4f5e0-52fc-462b-bdca-2824eb9d6fbb","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"03fe00b8-0dc4-4f5b-ba58-67fe505a7f87","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"cp -r dir1 dir2","collabId":"c254c9c9-5938-4230-8d7b-d0d854557f88","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"668478c3-d38b-4c41-8d9b-c93404938bf9","children":[{"type":"formatted","text":"上述命令有两种情况："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"330d186c-dda0-4926-995e-7728a81223f0","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"3c489beb-daca-40ec-884e-e4525ba4e2db","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c3c7d610-b6b9-482d-89b6-e731334b5cd7","children":[{"type":"formatted","code":true,"text":"dir2"},{"type":"formatted","text":" 不存在，则新建 "},{"type":"formatted","code":true,"text":"dir2"},{"type":"formatted","text":" 文件夹，并将 "},{"type":"formatted","code":true,"bold":true,"text":"dir1"},{"type":"formatted","bold":true,"text":" 文件夹下的所有文件复制到 "},{"type":"formatted","bold":true,"code":true,"text":"dir2"},{"type":"formatted","bold":true,"text":" 下"},{"type":"formatted","text":"，注意这里不是复制文件夹，而是复制文件夹下的所有文件"}]},{"type":"code-block","language":"bash","uuid":"229c2896-563b-4e7a-ac4a-91649b3b83e2","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"08b82ff1-dee9-4f46-80f6-a7fec93d0c84","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# 当前目录下只有 src 文件夹，src 文件夹下有三个文件\n~ » tree\n.\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n1 directory, 3 files\n# 因为 dst 文件夹不存在，所以会新建 dst 文件夹\n# 并把 src 下的所有文件复制到 dst 文件夹下\n~ » cp -r src dst\n~ » tree\n.\n├── dst\n│   ├── hello.c\n│   ├── hello.md\n│   └── hello2.md\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n2 directories, 6 files","collabId":"644109f0-c924-4af9-a720-0e63332d8d67","children":[{"type":"formatted","text":""}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"59aa75de-8054-425e-b87e-0a0800a86e6b","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"56146a3d-4ddc-4fcc-a5ca-43c6c40694c9","children":[{"type":"formatted","code":true,"text":"dir2"},{"type":"formatted","text":" 已存在，且为文件夹，则将 "},{"type":"formatted","code":true,"bold":true,"text":"dir1"},{"type":"formatted","bold":true,"text":" 文件夹"},{"type":"formatted","text":"复制到 "},{"type":"formatted","code":true,"text":"dir2"},{"type":"formatted","text":" 下"}]},{"type":"code-block","language":"bash","uuid":"d283e0ff-f9fe-4145-b99c-7cec33601ea8","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"daf4e64a-1690-4647-b74f-b80981379500","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"# dst 文件夹已存在，其中没有任何内容\n~ » tree\n.\n├── dst\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n2 directories, 3 files\n# dst 文件夹已存在，所以会将 src 这个文件夹复制到 dst 文件夹中\n~ » cp -r src dst\n~ » tree\n.\n├── dst\n│   └── src\n│       ├── hello.c\n│       ├── hello.md\n│       └── hello2.md\n└── src\n    ├── hello.c\n    ├── hello.md\n    └── hello2.md\n\n3 directories, 6 files","collabId":"6e87bbcf-7c8e-413b-8e1a-79e0fbf9acd9","children":[{"type":"formatted","text":""}]}]}]}]}],"tags":["Linux/命令/cp"],"createTime":1689051191303,"updateTime":1745155377086,"linkedCards":[]},"meta":{"type":"card","publishTime":1745155377086}}