{"version":1,"key":"quest:165","content":{"id":165,"title":"什么是马尔萨斯陷阱？","summary":"暂未记录答案","target":{"key":"quest:165","type":"quest","id":165},"groupId":9,"groupTitle":"经济&金融","groupColor":"sky-blue","status":"resolved","answers":[],"materials":[{"index":1,"kind":"card","group":"note","title":"马尔萨斯陷阱及其在现代的打破与警示","meta":"","excerpt":"人类经过了几千年的发展，为什么始终维持在刚好吃饱的水平？技术带来的生产效率提升和粮食增加，似乎总是被人口增长给消耗掉。英国经济学家、人口学家托马斯·马尔萨斯在 1798 年的《人口论》中提出了这个政治经济学概念，他将人类生活水平长期停滞的现象称为马尔萨斯陷阱。 马尔萨斯陷阱建立在两个假设之上： 人口增长：人口的增长速率","target":{"key":"card:720","type":"card","id":720},"citeKey":"card:720"}],"trail":[{"time":1777790317275,"tone":"start","text":"提出问题","refs":[]},{"time":1778988782824,"tone":"milestone","text":"写下卡片","refs":[1]},{"time":1778990057537,"tone":"done","text":"标为已解决","refs":[]}],"description":[{"type":"paragraph","children":[{"type":"formatted","text":""}]}],"createTime":1777790317275,"updateTime":1777790317275,"resolvedTime":1778990057537},"meta":{"type":"quest","publishTime":1777790317275}}