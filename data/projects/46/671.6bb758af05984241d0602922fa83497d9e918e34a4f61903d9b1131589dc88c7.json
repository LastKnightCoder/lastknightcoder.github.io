pe":"formatted","text":"y_{i\\w - 1} = 1"}]},{"type":"formatted","text":"，设 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"z = -x > 0","collabId":"92f3b015-c5ff-4d89-92de-1bab89f245ef","children":[{"type":"formatted","text":"z = -x > 0"}]},{"type":"formatted","text":"﻿，则"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\sum_{i = 0}^{w - 2}z_i2^{i} + \\sum_{i = 0}^{w - 2} x_i 2^{i} = 2^{w - 1}","collabId":"0a7fff2b-7757-4f14-8b48-f2ff6fdf6f8f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e675efd9-4548-41f9-8a7f-bc88a8535377","children":[{"type":"formatted","text":"则"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\begin{aligned}\nx = -z &= -\\sum_{i = 0}^{w - 2}z_i2^{i} \\\\\n&= -2^{w - 1} + \\sum_{i = 0}^{w - 2} x_i 2^{i} \\\\\n&= -x_{w - 1} 2^{w - 1} + \\sum_{i = 0}^{w - 2} x_i 2^{i}\n\\end{aligned}","collabId":"72f73671-fe74-4fc9-b05f-0f6a77cea33a","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"82ace667-2ca7-4c63-a1bc-acee93aaed2e","children":[{"type":"formatted","text":"综上，对任意 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"{-2^{w - 1} \\leq x \\leq 2^{w - 1} - 1}","collabId":"86277a90-1e2b-433a-8714-a3caa6a4c336","children":[{"type":"formatted","text":"${-2^{w - 1} \\leq x \\leq 2^{w - 1} - 1}"}]},{"type":"formatted","text":"﻿，其二进制表示为 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\vec{x} = [x_{w - 1}, x_{w - 2}, \\dots, x_0]","collabId":"62c1e8a6-d9ab-40fe-bebc-7d6996a1149c","chi