-hostimaging.oss-cn-beijing.aliyuncs.com/image_a38b374f-1563-45fc-b955-ca5500f13a18.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"f065bbdd-41a3-4024-9a22-32c6ec0663bf","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"67d29977-a014-4452-8d6d-ac842cc19473","children":[{"type":"formatted","text":"光线追踪是一个准确的算法，质量高，符合物理规律，但是非常慢，用来做一些离线的应用，一帧就需要 10k CPU 小时"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_876b576e-c8aa-441f-b3a0-92780abeaf7d.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"5b435f5f-6437-43d9-8d5d-9f32a97b76fd","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8aa45c87-b2e2-4626-9c77-866bd67c6571","children":[{"type":"formatted","text":"光线是什么？"}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"9f24c320-0348-40c1-9610-b03bd1623c52","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"09d1a46b-c9da-4f4b-8fc7-5bf92eb4329d","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"537744f3-b2d4-498f-86b1-d43b990abac5","children":[{"type":"formatted","text":"光沿直线传播"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"ccb6bcc7-793a-4550-8019-654438a65e29","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8b6280fb-bad7-4926-84fc-3f7072e9e8fd","children":[{"type":"formatted","text":"光线与光线之间不会发生碰撞"}]}]},{"type":"list-item","tauCon