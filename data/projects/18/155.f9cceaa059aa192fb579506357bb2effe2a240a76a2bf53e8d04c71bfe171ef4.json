1dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5025d744-aebc-4e84-a554-0b8f02b15428","children":[{"type":"formatted","text":"深度图示例"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a10defe4-82dc-472c-bda0-ac529e608917.png","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a10defe4-82dc-472c-bda0-ac529e608917.png","width":720,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"fb5dc78d-4df5-441e-8d00-67543e19df26","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"62862502-af34-4995-a217-3ea72a2c0b7a","children":[{"type":"formatted","text":"首先认为所有的像素记录的深度都是无限远，遍历所有三角形，光栅化为不同的像素，对于每个像素比较当前深度与记录的深度，取最小"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a082117b-bc7b-4b8e-bd1b-9228433622c6.png","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a082117b-bc7b-4b8e-bd1b-9228433622c6.png","width":720,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"d82b5a11-a9b3-44b9-ad45-8a22c00fc590","children":[{"type":"formatted","text":""}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_e59ea64a-74fe-4a6e-b7fc-eaf13af2dbf3.png","pasteUploading":false,"previewUrl":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_e59ea64a-74fe-4a6e-b7fc-eaf13af2dbf3.png","width":720,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"42e55c4d-3182-4d31-ad1b-6f765975e8d1","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"14c1efe1-0a13-4848-a48e-57712ba2207e","children":[{"type":"formatted","text":"Z-Buffer 算法的复杂度，认为三角形不是特别大，覆盖常数个像素，复杂度多少："},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(n)","collabId":"56125bc1-e6da-48ac-8dfa-c0be7b5fbaf6","children":[{"type":"formatted","text":"O(n)"}]},{"type":"formatted","text":"。"}]},{"type":"highlight-block","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"e951f70b-5166-49c8-ba83-8f81954093ca","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f2a12ce8-1fa3-4811-a33c-ef04502808f7","children":[{"type":"formatted","text":"假设每个三角形只覆盖 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"100","collabId":"6c44547e-1df8-46a3-a62a-13320a376eb6","children":[{"type":"formatted","text":"100"}]},{"type":"formatted","text":" 个像素，那么算法复杂度为 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(100n)","collabId":"be0e27c1-5c61-4bfa-805e-b5bdedd2e7da","children":[{"type":"formatted","text":"O(100n)"}]},{"type":"formatted","text":"，排序的算法复杂度为 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(n\\log n)","collabId":"c852e621-6e79-47c8-93f5-c6c5279d6dbf","children":[{"type":"formatted","text":"O(n\\logn)"}]},{"type":"formatted","text":"﻿，一般常数项会忽略掉，所以认为是 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(100n) = O(n)","collabId":"667a44b8-2041-4482-9c3d-1b718637a8e0","children":[{"type":"formatted","text":"O(100n) = O(n)"}]},{"type":"formatted","text":"，但是忽略的前提是 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n \\rightarrow \\infin","collabId":"55d871a8-bf91-423a-a901-213e3d78c071","children":[{"type":"formatted","text":"n -> \\inf"}]},{"type":"formatted","text":"﻿，实际情况 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n","collabId":"e8f534a5-f664-4da7-8395-0b3d80515649","children":[{"type":"formatted","text":"n"}]},{"type":"formatted","text":" 肯定不会为无穷大，什么时候 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"\\log n > 100","collabId":"19074b69-39a2-4afc-94b2-f6435471d00d","children":[{"type":"formatted","text":"\\log n > 100"}]},{"type":"formatted","text":" 呢，"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n > 2^{100}","collabId":"7bdfb93f-904f-4744-b3d6-9341ae90f220","children":[{"type":"formatted","text":"n > 2^{100}"}]},{"type":"formatted","text":"，这是个天文数字，也就是说，其实在这种情况下，"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(n\\log n)","collabId":"dc2c0124-aa41-420a-8260-c9888b0ad126","children":[{"type":"formatted","text":"O(n\\log n)"}]},{"type":"formatted","text":" 是由于 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(100n)","collabId":"78b118f7-7486-4e0b-a802-df3954bef463","children":[{"type":"formatted","text":"O(100n)"}]},{"type":"formatted","text":"，不能武断的忽略这个常数。"}]}]},{"type":"highlight-block","color":"blue","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"858b7863-e902-4e44-ae44-e3f5947ca258","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3719e819-1152-48cf-bee2-40bc4a895e26","children":[{"type":"formatted","text":"会存在两个三角形像素深度完全一样的情况吗？概率很低，但是存在，怎么处理呢？"}]}]},{"type":"divide-line","tauContract":"e43f9dce629c905e0bcd68c62f974061860b4a4428d1bf3ee0965ca60e23efd0","collabId":"63398390-fef2-4ad2-9e1e-e4031fc834f0","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"93dc58ef-bec6-43a8-98e9-d1315bf99e20","children":[{"type":"formatted","text":"着色：对不同的物体应用不同的材质。"}]},{"type":"highlight-block","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"ac2f0ff0-27b0-4b21-84cd-a3d4632e9d1b","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f8668baa-164c-4e13-bd2d-6569c09cf2f9","children":[{"type":"formatted","text":"我认为的着色就是考虑光照与物体本身颜色的作用，形成人眼看到的颜色。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3c1c4b90-434b-4de7-8b61-9e1f97c6a832","children":[{"type":"formatted","text":"光的观察："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"b66e9391-7fc4-4654-a030-d386bf0b80f6","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"dda36074-37db-4beb-b886-dd499ac3693e","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6cdf98f0-ddd6-43e8-821f-3d52b8333493","children":[{"type":"formatted","text":"高光"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"503bb9d8-a013-47d4-988f-e674655e436a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"65d72bde-ca3f-46e7-af14-001e90645a01","children":[{"type":"formatted","text":"漫反射"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"1157c5d9-bb94-40aa-964f-215252cd9815","childr