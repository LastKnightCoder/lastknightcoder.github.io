af-bec3-3b112afa339d","children":[{"type":"formatted","text":"从频率的角度看，什么是采样，采样就是在重复频域上的内容"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_cd595ffa-b721-4364-b5d5-120608e7a1d9.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"00df4e9e-e28e-4bd0-921e-87ec7dedec57","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6b5c5079-48e7-449c-949c-466ed6312b76","children":[{"type":"formatted","text":"产生锯齿就是重复的频率内容重合了"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_29b74dcd-21fe-4f89-8e7f-62976d1df9de.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"ff5f80af-f604-4946-9c8c-109d55d5fdad","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f35d8ed4-e2c5-4ff5-b898-c6afa7091d18","children":[{"type":"formatted","text":"所以反走样的方法："}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"88856db7-dc4b-48a6-81e7-0baab76aad45","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7aaf079c-32c3-4c35-9cc1-64786b93e696","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fa55de08-a834-4e52-ad52-61643e6414b2","children":[{"type":"formatted","text":"提高采样率，让频率不重合，但是成本高，并且需要非常高的分辨率"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"97e13806-e1a0-4fb5-8d0a-ca22cbccabe9","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7eb6135c-15fd-4b04-8c7d-ae2ac839956e","children":[{"type":"formatted","text":"在采样前让图像的的频率变低，滤除高频率（模糊）✅"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_79047d90-c20c-4553-a57e-7173a1227bf8.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"7a8f9fb7-c488-4b43-91b4-9667090983f1","children":[{"type":"formatted","text":""}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ec589941-7db7-4bae-8c60-6735939ae0f7","children":[{"type":"formatted","text":"实际上是怎么把三角形变模糊，使用一个低通滤波"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_29cd026d-fa64-4ae0-ae18-c7ace5fb1896.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"26ce36e6-d659-4815-a391-049a8e8c8dfc","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fe41d222-42fd-4d8d-8520-e56b712782e0","children":[{"type":"formatted","text":"对覆盖面积做一个平均"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_7775d41a-a1b1-42a3-920d-722d2241ae3e.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"78e32e00-ffad-4f08-83f8-062c2768e2c0","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d3a6ba68-2817-45d0-8b90-865c355205d7","children":[{"type":"formatted","text":"怎么做覆盖面积的平均，近似方法，用更多采样点做反走样，把一个像素划分为多个（MSAA），注意 MSAA 是为了提高近似的覆盖率计算模糊来实现反走样，而不是提高采样率完成的"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_61c99c0a-453a-4f79-a0af-6ab371aaea97.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"a44aa2fb-9d3c-4f68-875f-ecdbf1623174","children":[{"type":"formatted","text":""}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_7f0ce3b8-101c-4876-923e-55c8c16b4384.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"515eaa23-bda0-4be0-9b16-1767a0d9ef62","children":[{"type":"formatted","text":""}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_11ef04b3-de8b-4939-bbc2-cf4274ca2271.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c43f7899-0089-4d21-a4a1-ee7a74d7b6e2","children":[{"type":"formatted","text":""}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_6334d0fb-f5b3-455b-b520-94603466c82d.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"b77cc133-a6a6-403a-87c5-de57b13a15e9","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ef9e4a3f-c3b9-45be-8500-5ddaf18be59a","children":[{"type":"formatted","text":"MSAA 的效果，效果还不错"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_59b01dbf-f035-4939-ab8d-f8d35b83a410.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"d6c4f7f8-5ca5-4b47-86fc-383abda09bb5","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7658e921-2bff-491f-8776-d4fb6fa03a05","children":[{"type":"formatted","text":"牺牲了什么？用更多的点测试，增大了计算量。有没有更好的办法，减少采样的点测试，使用不规则的分布减少点，有很多的样本得到复用，光线追踪会提及使用什么样的分布。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"619e5370-cac2-4f6c-8bc4-b3968e3cc95f","children":[{"type":"formatted","text":"其他抗锯齿方法（工业界很常用）："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"b0135018-8cad-4d6c-9a21-ee7e7e460bbd","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"0a1d2384-4aa5-440b-af3b-851ed3e510d6","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e893cb03-9af0-4e3e-9251-472d4149d346","children":[{"type":"formatted","text":"FXAA（Fast Approximate AA），后期处理，对有锯齿的图片进行处理"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9d1858ba-36f1-44cc-8594-8ddc08103e4a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e93b343c-28b1-4498-a23b-a271126af488","children":[{"type":"formatted","text":"TAA（Temporal AA），利用上一帧的信息"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"68cb548e-231e-4d8e-86f7-7a2a4131c866","children":[{"type":"formatted","text":"超分辨率，是指把小图拉大，但是存在失真（走样），怎么解决这个问题："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"6c3c87c4-df0b-4f51-bae8-f96780dad42d","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"4cb41abe-248e-4d65-88ea-8cd62fa82094","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"55fe42e0-fb0b-45e8-977a-07f20f8d1b5b","children":[{"type":"formatted","text":"DLSS（Deep Learning Super Sampling）"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"a907485c-be41-494b-b4bd-a67a5fba98c4","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b1f9423a-cb81-43f5-bea2-7939762c19c9","children":[{"type":"formatted","text":"和抗锯齿不是一会儿事，但是本质相同"}]}]}]}],"breadcrumb":[{"label":"3D 学习","target":{"key":"doc:project:18:147","type":"doc","id":147}},{"label":"GAMES 101","target":{"key":"doc:project:18:147","type":"doc","id":147}},{"label":"第六课：光栅化II","target":{"key":"doc:project:18:154","type":"doc","id":154}}],"prevPage":{"title":"第五课：光栅化I","target":{"key":"doc:project:18:152","type":"doc","id":152}},"nextPage":{"title":"第七课：着色I","target":{"key":"doc:project:18:155","type":"doc","id":155}},"createTime":1736691731434,"updateTime":1744963208436,"projectId":18},"meta":{"type":"doc","publishTime":1744963208436}}