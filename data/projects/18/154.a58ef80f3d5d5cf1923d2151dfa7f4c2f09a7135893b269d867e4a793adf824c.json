030a03aa1.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"a50018c7-1bff-41a2-8824-19446065f857","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"22a41696-d736-4ed3-ad67-6d82edc6162d","children":[{"type":"formatted","text":"滤波，其实就是在频域上进行处理，一般是去除某些频率，因此称为滤波，常见的滤波器有低通滤波器，高通滤波器，带通滤波器，带阻滤波器。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"da85dac3-e163-4f71-8702-8ea37be4c52c","children":[{"type":"formatted","text":"图像及其频率分布"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_1b1595ef-f67d-47fd-9968-3b82c440289c.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c41768cc-552f-4744-b788-7e97fe65ee57","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2dc36dbd-d616-4649-b45f-288a4da7b885","children":[{"type":"formatted","text":"高通（边缘）"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_ec04bb3c-dd05-4e76-ac56-091a79421ed4.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"3b24f7dc-395c-4dff-8b9e-227ea4448c79","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8c5a44ce-12e0-4495-8dc6-d9af140cd357","children":[{"type":"formatted","text":"低通（模糊）"}]},{"type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_72fc29ec-e4f5-4a2b-b945-83bd13c50a08.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642dec