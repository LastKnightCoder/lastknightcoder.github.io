c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"2643bf87-d185-4382-b650-8e77c536aff4","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c25c9a22-878d-43e3-950d-6c557c592ca0","children":[{"type":"formatted","text":"快门时间短，可以看的清楚，时间长，变模糊"}]}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b75a0416-baab-4b52-b76c-331f44998685","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"700ecdd5-8789-4fa1-850d-468e231e069a","children":[{"type":"formatted","text":"ISO，可以理解简单的线性往上乘"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"60692640-377c-4bad-b18a-94b5fcdf6249","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9b1b226f-3562-4cea-99ff-c90d9d80e1e3","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"28372119-00cf-4473-b67b-a540a2ddb64d","children":[{"type":"formatted","text":"任何信号都有噪声，对信号乘一个数，会放大信号，但同样会放大噪声，如果在很暗的房间，用来很小的光圈和很快的快门时间，用了一个很大的 ISO 把亮度拉大，但是结果会很 noise，正常情况大家不愿意调节他得到一个更亮的图，在一定的小范围条行，大了一定有噪声"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7906efdb-751f-41cb-a970-94c4d9f3d987","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0acaa321-a331-4df1-9d85-2cc64ce0a50b","children":[{"type":"formatted","text":"为什么有噪声，简单看，把光认为是光子，如果快门时间不够，进入感光元件光子不够，结果就是 noisy"}]}]}]}]}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_3369e8c9-aaaf-4b3c-9262-694cd2ddf327.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"1acfbf5c-4357-4996-bf7a-ce462f261a65","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1d210440-14f6-4024-a115-ef1904d153a4","children":[{"type":"formatted","text":"ISO 就是简单的线性的乘一下"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_db1a3bf5-e8b1-4edd-bc2e-765e62e948e9.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c5ad76a1-f685-4d24-afd8-50fe8bcf25bc","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f05ca975-74c9-47cf-a259-823ac44eaa6a","children":[{"type":"formatted","text":"控制其他变量，越来越暗，通过 ISO 调回来亮度，可以看到 ISO 越大噪声越明显"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_123b109b-cb58-4428-bde4-48adb9d5a27c.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"05cb1620-36bf-49ea-a957-5f7a9eab0313","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3b8deb92-8f45-47ea-b6d2-ec366e38a85e","children":[{"type":"formatted","text":"F-Number（F-Stop），F 数的两种写法"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"98db0008-00a1-4ae2-bf20-4d93f683c882","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f96ac437-6fa8-461f-a403-5ad2cb704822","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9b6ffd51-a717-46c8-bf55-9a747019e338","children":[{"type":"formatted","text":"F"},{"type":"formatted","color":"#e33a32","darkColor":"#fa7873","text":"N"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"bbb7abab-ed7b-42db-893e-3edb0afc9346","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"143e78c9-a7ac-4c84-a5b1-728cf1964fc7","children":[{"type":"formatted","text":"F/"},{"type":"formatted","color":"#e33a32","darkColor":"#fa7873","text":"N"}]}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"03490bac-320d-4892-b62f-4b3ae339339f","children":[{"type":"formatted","text":"简单理解，F 数是什么，非正式理解，F 数就是光圈的直径分之一，N 越大光圈越小"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"367137aa-fa4e-47e5-b8fd-705009292417","children":[{"type":"formatted","text":"调光圈可以得到固定时间内进入的能量"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_1c377feb-6e92-429f-88e8-bd48e95c0512.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"88236f60-d31e-4398-8919-7618aa07e050","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"be6c5887-15c6-47fa-a334-af3939708176","children":[{"type":"formatted","text":"快门是怎么控制的呢？一开始关闭的，然后升上去，快门突然打开，然后关上。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"9b7bb2d8-77b0-49ad-97ec-8aeb824d2f77","children":[{"type":"formatted","text":"但我们关心的完全关闭到突然打开，虽说是突然，但是有一个过程的，这个过程会造成什么影响？"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a33a4473-f629-4952-8b07-80616379a352","children":[{"type":"formatted","text":"如果快门时间长，为什么小人就模糊了，这个就叫做运动模糊，运动模糊是怎么回事，在快门打开的这段时间内，物体发生了移动，中间的过程都会被记下来，传感器平均了一下，就模糊了。"}]},{"type":"highlight-block","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"a2a72226-aeb5-434d-a9b1-f4fc666f80c4","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7d80c88d-524a-45b1-b5bf-cfa441f8b5a0","children":[{"type":"formatted","text":"目前说的是机械式快门。"}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e4c57bb6-a195-41b1-ad59-e95782e36318","children":[{"type":"formatted","text":"反过来讲，快门时间不变，物体运动越快，越容易出现运动模糊，手抖会出现运动模糊，所以为什么拍照要保持稳定。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_c850513b-4f24-4871-9a8a-c625dfc3e89e.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"3c3852dd-6af5-4f64-b621-dcfd836eec87","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"980a03b1-2c2b-4c3c-b94a-091e7c2c5287","children":[{"type":"formatted","text":"用更短的快门时间，运动模糊会减轻"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a3ffff7e-bc64-4a1d-8c64-8d170ea1e682","children":[{"type":"formatted","text":"运动模糊一定是坏事吗，比如赛车，如果没有运动模糊，就会觉得赛车很慢，作图就很快，右边感觉是摆拍。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2c09a7b2-f21f-4bd6-89b1-38931fe11069","children":[{"type":"formatted","text":"运动模糊是怎么来的，在不同的时间对物体进行了一个采样，反走样，引入了一定的模糊，在时间上采样，如果有运动模糊的话，有一个反走样的效果。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a29091fc-3da7-4a3e-8c02-bffde89dddf4.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"1e0e1ef2-35f4-4987-b07e-8788e0746e97","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4e30d622-70a4-4b81-b6d1-019b8367b218","children":[{"type":"formatted","text":"快门打开需要时间，如果物体运动速度快，就会出现问题，Rolling shutter，对于高速运动的东西会造成扭曲（螺旋桨），记录的是不同时间进入的光。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_fb09bee6-7d0d-4f8f-89cf-ca1d34afb4cb.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"1e4872f4-0c22-4b60-ad18-1d7a5d37273e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8af0a309-416a-4e55-ba95-4654daeee6ee","children":[{"type":"formatted","text":"和光圈在一块考虑，快门时间短，就会暗，怎么办，提高光圈大小，用更小的 f 数"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ac62b56c-d867-444f-9f99-4ed944fbe5a0","children":[{"type":"formatted","text":"下面表格可以打到基本相同的亮度。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4485529a-21aa-40d6-b79d-22ba98c98666","children":[{"type":"formatted","text":"是不是说排出的照片是一模一样呢，大光圈会引起浅景深的问题，正常情况下是需要权衡的。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_0301657b-4377-47b1-b099-6b122ff4223c.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"3c843bac-833c-47ae-8e57-0d9bb06174e8","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7e633190-1baa-4bc0-9f96-5cf2ea13bd6c","children":[{"type":"formatted","text":"高速摄影，每秒钟拍更多帧数，然后按正常帧数放，那么留给快门的时间就非常短，要保证每一帧看的见，用更大的光圈和 ISO，ISO 大家不习惯，所以就用更大的光圈。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_6bab4cc5-cb78-4d9d-a989-d1f8dfb7a7de.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c1bd0339-a00a-4096-80b2-b97d2011f52d","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3668723d-4b71-40a7-bc97-1ca2896e2469","children":[{"type":"formatted","text":"超低速摄影，延迟摄影，给特别长的曝光时间，给小光圈，拉丝"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a4a6ce28-749d-4760-bb8b-4c9a11e4ace8.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"31860387-4f1c-4815-b216-2b87171dfea4","children":[{"type":"formatted","text":""}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_8b0ee349-1f3e-44ad-af74-3916b2b45e8f.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"40c93df2-bb2f-4132-b912-6d80a0b073aa","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dd860d74-ed3d-4e6e-b88c-0b2bfeebf557","children":[{"type":"formatted","text":"对于真正的镜头，非常非常的复杂，现在相机都不会用单个棱镜做，用棱镜组，真正的棱镜很复杂，用一个简单的棱镜来描述"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_42cb13e8-1c40-4a97-a993-8d4df77dd2e8.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"dc91bda4-66d4-4c6c-98a8-7db055db4c6b","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1851dd40-d55b-41f3-b92e-20a519724a29","children":[{"type":"formatted","text":"真实棱镜，没法把光线聚集到一起"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_f6cff474-2d2f-4823-8add-7cd45bcee517.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"c46b7f7a-b6a8-472b-9b19-45f1b8714b9a","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7478f976-5d25-4bc3-887c-842040e6ea58","children":[{"type":"formatted","text":"我们研究的是理想化的薄棱镜"}]},{"type":"numbered-list","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","collabId":"6c75f4dc-e476-4c61-8292-36003c4ce721","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"90adcfee-fce5-4dbf-8a29-8fc7730c8b4f","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"433f087e-bfa7-40e9-a253-332ce10aac3c","children":[{"type":"formatted","text":"所有的平行光经过棱镜会经过焦点"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"29e7a775-66b4-41c5-95ce-7df199b1664f","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e533287c-94d7-4e5a-ac03-4106b34e52a8","children":[{"type":"formatted","text":"所有经过焦点的光线经过棱镜后会变为平行"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"dcca7be7-0ba7-4eb1-b2ad-d4b30ff1c526","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7dbdb6ba-7bd2-454d-a1c1-f6ab60190e2e","children":[{"type":"formatted","text":"焦距大小可以被任意改变（在现实，用棱镜组的组合就好像随意改变等价的一个薄棱镜的焦距）"}]}]}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_aaf942d5-5a73-4cf0-bc64-bccb3eae76ee.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"dc65a8b7-5419-4c37-97fe-df6408315cfb","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8e664b94-62b9-4b8d-baf9-0fbcd265b2bb","children":[{"type":"formatted","text":"棱镜满足的基本的物理规律，高斯薄棱镜公式。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fa77a8b9-60d2-4421-9eca-84d5e4111b17","children":[{"type":"formatted","text":"任何一个方向光线穿过棱镜中心，方向不会发生改变。定义两个距离，物距 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"z_o","collabId":"6df48729-1c88-48f2-a896-3901aaf8b8f1","children":[{"type":"formatted","text":"z_o"}]},{"type":"formatted","text":"，像距 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"z_i","collabId":"94ed537c-b745-476f-87a7-341fc842cd0b","children":[{"type":"formatted","text":"z_i"}]},{"type":"formatted","text":"，焦距 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"f","collabId":"a7d14135-7d40-4c1e-adef-4a1fa30cead0","children":[{"type":"formatted","text":"f"}]},{"type":"formatted","text":"，满足的性质"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"\\frac{1}{f} = \\frac{1}{z_i} + \\frac{1}{z_o}","collabId":"1ba0d0a9-0adb-4dba-a965-42bd41f4d358","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"731977c7-c521-43e3-99b8-bf0566b84990","children":[{"type":"formatted","text":"对棱镜来说，如果改变物距，像距一定跟着改。"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_5b395b21-9d07-4f96-8629-ee2f931988a8.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"333cf037-d53c-41d4-b84e-746f7d247b3e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"61850b5a-ce8c-46ad-b8e0-ce38ad8c8573","children":[{"type":"formatted","text":"推导物距、像距、焦距的关系，满足的几何关系，两个相似三角形"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9e4851b3-d1ec-4176-b142-488b33b7d541.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"1a09d450-57fb-4f41-a2e8-d6dcdc20f4a3","children":[{"type":"formatted","text":""}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_b050ce9a-19ff-41d6-abb6-99c7ea4d2af1.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"ddefb882-0ea7-411a-bb5f-f4a93f552e60","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3df8ae74-d01d-43d7-b268-8f8613c656aa","children":[{"type":"formatted","text":"景深问题，引入一个概念，Circle of Confusion(CoC)，指成像系统中，一个理想点光源因未完全聚焦而扩散成的圆形模糊光斑，CoC 和棱镜大小成正比"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_af17c984-72cc-4cea-99f3-0e60ec7e67ae.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"87f6a080-79b6-4819-9b98-36b2dcb3b887","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"83e3120b-e07f-4730-bf0b-d64ebfaf4dd1","children":[{"type":"formatted","text":"这就告诉我们，看到的东西模糊不模糊，取决于光圈的大小"}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a9879a5e-b91d-4575-bff9-3b66cc7912a1.png","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"745fcb3a-1ee3-4b89-8a57-a4ee59d87b39","children":[{"type":"formatted","text":""}]},{"