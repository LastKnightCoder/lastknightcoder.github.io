{"version":1,"key":"doc:project:45:654","content":{"id":654,"title":"折线","content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"30f7c7d0-c946-40ee-904f-e541addbe13f","children":[{"type":"formatted","text":"绘制折线我们可以使用多个 "},{"type":"formatted","code":true,"text":"<line>"},{"type":"formatted","text":" 标签，但是这样会有点麻烦，我们可以使用 "},{"type":"formatted","code":true,"text":"<polyline>"},{"type":"formatted","text":" 标签，通过 "},{"type":"formatted","code":true,"text":"points"},{"type":"formatted","text":" 指定点的坐标即可"}]},{"type":"code-block","language":"html","uuid":"2a6c3de7-65fb-4013-88cf-061f08d7b195","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"2ad9dd88-7b71-4a12-aa77-13441bcfc19c","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"400\" height=\"200\" viewBox=\"0 0 400 200\">\n  <polyline\n    points=\"20 160, 80 100, 140 70, 200 80, 260 10, 320 40, 380 50\"\n    fill=\"none\"\n    stroke=\"gray\"\n    stroke-width=\"5\"\n  />\n</svg>","collabId":"3ff14943-1339-4a25-835e-a17f0a1c6e35","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"400\" height=\"200\" viewBox=\"0 0 400 200\">\n  <polyline\n    points=\"20 160, 80 100, 140 70, 200 80, 260 10, 320 40, 380 50\"\n    fill=\"none\"\n    stroke=\"gray\"\n    stroke-width=\"5\"\n  />\n</svg>","collabId":"98ce6bc2-1f36-4848-97ee-633a31549873","children":[{"type":"formatted","text":""}]},{"type":"highlight-block","color":"green","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"0123313b-d42a-4343-9565-33b605490242","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"89b707d1-e0c1-4549-8c1b-c3a7b93713ee","childr