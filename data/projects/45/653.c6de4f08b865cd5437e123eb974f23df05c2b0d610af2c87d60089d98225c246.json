/>\n</svg>","collabId":"ae785765-b89a-43d0-9c50-8af816ed1169","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c15ad30b-5f22-4fd6-9792-736fe682e1ba","children":[{"type":"formatted","text":"还可以通过 "},{"type":"formatted","code":true,"text":"stroke-dasharray"},{"type":"formatted","text":" 来定义虚线，虚线就是由实线和空隙组成的，所以我们只要定义实线和空隙的长度即可，然后会不断重复"}]},{"type":"code-block","language":"html","uuid":"be98c177-6a49-4453-a379-47ee5ca5b534","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"82194042-90d5-4658-81f2-206123e18446","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<line\n  x1=\"20\"\n  y1=\"20\"\n  x2=\"80\"\n  y2=\"80\"\n  stroke=\"gray\"\n  stroke-width=\"3\"\n  stroke-dasharray=\"10 5\"\n/>","collabId":"276d98a5-9622-495c-943c-dee2bd64ec40","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n\t<line x1=\"20\" y1=\"20\" x2=\"80\" y2=\"80\" stroke=\"gray\" stroke-width=\"3\" stroke-dasharray=\"10 5\" />\n</svg>","collabId":"5286cd5c-67b3-4741-b7b9-76ec40203282","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"61bc1785-b740-4d17-92cc-8c4360e5604e","children":[{"type":"formatted","text":"上面我们定义实线长 "},{"type":"formatted","code":true,"text":"10"},{"type":"formatted","text":" 个单位，空隙长 "},{"type":"formatted","code":true,"text":"5"},{"type":"formatted","text":" 个单位，然后不断重复。我们也可以只指定一个值，当指定一个值时，就表示实线和空隙的长度是一样的。还可以同时指定多个值，例如我们希望实线一段长，一段短，那我们可以指定 "},{"type":"formatted","code":true,"text":"stroke-dasharray=\"10 5 3 5\""}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n\t<line x1=\"20\" y1=\"20\" x2=\"80\" y2=\"80\" stroke=\"gray\" stroke-width=\"3\" stroke-dasharray=\"10 5 3 5\" />\n</svg>","collabId":"58bc5dbb-4460-4ac2-861a-786e53fffc28","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b5574fb7-fe13-4a61-a9d5-c201727a95bb","children":[{"type":"formatted","code":true,"text":"stroke-dasharray"},{"type":"formatted","text":" 指定的值的个数必须为偶数，依次表示实线的长度和空隙的长度，如果指定的是奇数的话，就会重复一次，使其变为偶数个数。例如指定 "},{"type":"formatted","code":true,"text":"stroke-dasharray=\"12 5 3\""},{"type":"formatted","text":" 就相当于 "},{"type":"formatted","code":true,"text":"stroke-dasharray=\"12 5 3 12 5 3\""}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n<line x1=\"20\" y1=\"20\" x2=\"80\" y2=\"80\" stroke=\"gray\" stroke-width=\"3\" stroke-dasharray=\"12 5 3\" />\n</svg>","collabId":"9f035057-0d3e-44e6-b575-c443a6a736ce","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1836b876-3bfa-47a9-bebb-2d622415be51","children":[{"type":"formatted","text":"另一个与虚线有关的是 "},{"type":"formatted","code":true,"text":"stroke-dashoffset"},{"type":"formatted","text":"，用来指定偏移量。例如我们指定 "},{"type":"formatted","code":true,"text":"stroke-dasharray=\"10 5\""},{"type":"formatted","text":"，表示先是 "},{"type":"formatted","code":true,"text":"10"},{"type":"formatted","text":" 单位的实线，然后是 "},{"type":"formatted","code":true,"text":"5"},{"type":"formatted","text":" 单位的空隙，如果我们同时指定了 "},{"type":"formatted","code":true,"text":"stroke-dashoffset=\"7\""},{"type":"formatted","text":"，就会产生 "},{"type":"formatted","code":true,"text":"7"},{"type":"formatted","text":" 个单位的偏移，变为先是 "},{"type":"formatted","code":true,"text":"3"},{"type":"formatted","text":" 单位的实线，然后是 "},{"type":"formatted","code":true,"text":"5"},{"type":"formatted","text":" 单位的空隙，然后 "},{"type":"formatted","code":true,"text":"10"},{"type":"formatted","text":" 单位的实线 ..."}]},{"type":"code-block","language":"html","uuid":"d5cccca6-9a9e-4db7-98f8-f8e072481d77","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"06263d2f-d858-4067-a35e-dac9d9402ca2","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<line\n  x1=\"20\"\n  y1=\"20\"\n  x2=\"80\"\n  y2=\"80\"\n  stroke=\"gray\"\n  stroke-width=\"3\"\n  stroke-dasharray=\"10 5\"\n  stroke-dashoffset=\"7\"\n/>","collabId":"7f616569-5a39-462c-96d9-bdead0caf99d","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n\t<line x1=\"20\" y1=\"20\" x2=\"80\" y2=\"80\" stroke=\"gray\" \n      stroke-width=\"3\" stroke-dasharray=\"10 5\"\n      stroke-dashoffset=\"7\" />\n</svg>","collabId":"73b71095-df2f-44d7-b508-725c4e1cfd18","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"875f00fb-e19a-4525-9e90-a1f3b820713b","children":[{"type":"formatted","text":"通过组合 "},{"type":"formatted","code":true,"text":"stroke-dasharray"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"stroke-dashoffset"},{"type":"formatted","text":"，可以实线描边动画的效果"}]},{"type":"code-block","language":"html","uuid":"ba6004aa-045e-43d7-b455-e0e0cd83ff92","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"0b4837bc-ea07-4dd0-a7e6-365e7239e4c7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"200\" height=\"100\" viewBox=\"0 0 200 100\">\n  <rect\n    x=\"10\"\n    y=\"10\"\n    width=\"180\"\n    height=\"80\"\n    fill=\"none\"\n    stroke=\"gray\"\n    stroke-dasharray=\"520\"\n    stroke-dashoffset=\"520\"\n  >\n    <animate\n      attributeName=\"stroke-dashoffset\"\n      attributeType=\"XML\"\n      values=\"520; 0; 520\"\n      begin=\"0s\"\n      dur=\"6s\"\n      repeatCount=\"indefinite\"\n    />\n  </rect>\n</svg>","collabId":"bfb420a5-65ed-439e-b062-4722688c8460","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"200\" height=\"100\" viewBox=\"0 0 200 100\">\n  <rect\n    x=\"10\"\n    y=\"10\"\n    width=\"180\"\n    height=\"80\"\n    fill=\"none\"\n    stroke=\"gray\"\n    stroke-dasharray=\"520\"\n    stroke-dashoffset=\"520\"\n  >\n    <animate\n      attributeName=\"stroke-dashoffset\"\n      attributeType=\"XML\"\n      values=\"520; 0; 520\"\n      begin=\"0s\"\n      dur=\"6s\"\n      repeatCount=\"indefinite\"\n    />\n  </rect>\n</svg>","collabId":"0630e6da-9af9-4915-ac37-691cf38f6982","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"fd598479-ae06-46ff-bbb7-90cac6795bb0","children":[{"type":"formatted","text":"上面动画的思路就是首先设置实线和虚线的长度一样长，为路径的总长度，例如上面矩形的总长度为 "},{"type":"formatted","code":true,"text":"520"},{"type":"formatted","text":"，然后设置 "},{"type":"formatted","code":true,"text":"stroke-dashoffset"},{"type":"formatted","text":" 也为路径的长度，这样就会导致页面是空白的，因为实线的长度正好等于偏移量，然后我们逐渐将 "},{"type":"formatted","code":true,"text":"stroke-dashoffset"},{"type":"formatted","text":" 设置为 "},{"type":"formatted","code":true,"text":"0"},{"type":"formatted","text":"，就会使得实线慢慢的出来，从而实现一种描边动画的效果。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d0e89c05-c5da-4cb6-9355-f32fb07161ee","children":[{"type":"formatted","code":true,"text":"stroke-linecap"},{"type":"formatted","text":" 属性用来指定线帽，线帽有三种"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"50b90f63-9234-4280-b6ca-2797ecb76f21","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6c3d1c2b-f1d7-4220-9be4-791e7c96a1a9","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6689842f-9885-423e-94bb-4f5863076ccb","children":[{"type":"formatted","code":true,"text":"butt"},{"type":"formatted","text":"：默认，方形"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"3efdfc1d-b171-48e2-93f9-1053adc09e9d","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"13aff1c2-d076-49a4-8692-873baaad40fe","children":[{"type":"formatted","code":true,"text":"round"},{"type":"formatted","text":"：圆形"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"8b651b6a-3d92-4fda-a321-e6603dcbdf45","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"41ffe756-adae-478a-864e-390dd3d91af3","children":[{"type":"formatted","code":true,"text":"square"},{"type":"formatted","text":"：正方形"}]}]}]},{"type":"code-block","language":"html","uuid":"fabb6cbe-272c-4e3b-a550-60bd973340da","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c6e8f75b-bf5c-4b6e-8028-83e3c92361e5","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"100\" height=\"100\">\n  <!-- 两条垂直线 -->\n  <line x1=\"10\" y1=\"0\" x2=\"10\" y2=\"90\" stroke=\"red\" st