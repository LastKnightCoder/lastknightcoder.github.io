e642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"500\" height=\"100\" viewBox=\"0 0 500 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      from=\"100\" to=\"400\"\n      begin=\"0s\" dur=\"3s\"\n      fill=\"freeze\"\n      repeatCount=\"indefinite\"\n    />\n  </rect>\n</svg>","collabId":"0641c10b-ee02-4203-8fc7-eb6c4519762d","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a8aa3975-423e-421f-b083-e4112956dabe","children":[{"type":"formatted","text":"当 "},{"type":"formatted","code":true,"text":"fill"},{"type":"formatted","text":" 为 "},{"type":"formatted","code":true,"text":"remove"},{"type":"formatted","text":" 时，动画结束后元素的状态是原始状态而不是动画开始时的状态，二者有何区别，看下面的例子"}]},{"type":"code-block","language":"html","uuid":"4fb4281e-e181-4223-a436-25378dd1c7b6","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b5d5f773-d767-406e-afb6-b70dbd4b37cd","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"500\" height=\"100\" viewBox=\"0 0 500 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\">\n    <animate\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      from=\"0\" to=\"400\"\n      begin=\"0s\" dur=\"3s\"\n      fill=\"remove\"\n    />\n  </rect>\n</svg>","collabId":"d3b57edd-0ac0-4bc7-8d36-c85a1fd7ee52","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b40f00fd-238e-409a-99c3-f3bd0656c76d","children":[{"type":"formatted","text":"我们设置了矩形的原始状态为 "},{"type":"formatted","code":true,"text":"width=\"100\""},{"type":"formatted","text":"，而动画的开始状态为 "},{"type":"formatted","code":true,"text":"from=\"0\""},{"type":"formatted","text":"，它们是不一样的，当 "},{"type":"formatted","code":true,"text":"fill"},{"type":"formatted","text":" 为 "},{"type":"formatted","code":true,"text":"remove"},{"type":"formatted","text":" 时，元素的最终状态为原始状态。"}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"500\" height=\"100\" viewBox=\"0 0 500 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      from=\"0\" to=\"400\"\n      begin=\"0s\" dur=\"3s\"\n      fill=\"remove\"\n    />\n  </rect>\n</svg>","collabId":"4e815c5b-41af-46ed-bc8c-7fe3349ee959","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1826ac92-7d6d-466d-87ec-06d378b09a40","children":[{"type":"formatted","text":"以上动画只有两个关键帧，"},{"type":"formatted","code":true,"text":"from"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"to"},{"type":"formatted","text":"，除此之外，我们可以使用 "},{"type":"formatted","code":true,"text":"values"},{"type":"formatted","text":" 属性指定多个关键帧，关键帧的取值使用分号分隔"}]},{"type":"code-block","language":"html","uuid":"06ab60cf-9d82-4203-8994-75e2d121829e","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"406618b2-15a4-4afe-8013-011d5b8ca908","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"400\" height=\"100\" viewBox=\"0 0 400 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      id=\"rec\"\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      values=\"0;400;0\"\n      begin=\"0s\" dur=\"3s\"\n      repeatCount=\"indefinite\"\n      fill=\"freeze\" />\n  </rect>\n</svg>","collabId":"5fa17552-99ca-4641-aeac-5a8c53b29022","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"400\" height=\"100\" viewBox=\"0 0 400 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      id=\"rec\"\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      values=\"0;400;0\"\n      begin=\"0s\" dur=\"3s\"\n      repeatCount=\"indefinite\"\n      fill=\"freeze\" />\n  </rect>\n</svg>","collabId":"67daefbc-c8a1-41a6-b25b-ba30ca5ee274","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a1298d7c-eb53-4bd0-b771-7da0dbdfacf3","children":[{"type":"formatted","text":"当我们指定多个值时，值与值之间的变化所需的过渡时间是均匀的，比如指定 "},{"type":"formatted","code":true,"text":"values=\"0; 400; 0\""},{"type":"formatted","text":" "},{"type":"formatted","code":true,"text":"dur=\"3s\""},{"type":"formatted","text":"，"},{"type":"formatted","code":true,"text":"0 -> 400"},{"type":"formatted","text":" 以及 "},{"type":"formatted","code":true,"text":"400 -> 0"},{"type":"formatted","text":" 会平分过渡时间，每个需要 "},{"type":"formatted","code":true,"text":"1.5s"},{"type":"formatted","text":"。"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"84f8e269-ef22-435f-8aea-13fcc4a4a0be","children":[{"type":"formatted","text":"我们可以指定 "},{"type":"formatted","code":true,"text":"keyTimes"},{"type":"formatted","text":" 属性来控制每个状态变化的过渡时间，它也是一个数组，它所需的值的个数与 "},{"type":"formatted","code":true,"text":"values"},{"type":"formatted","text":" 指定的值的个数相同，二者值一一对应。比如 "},{"type":"formatted","code":true,"text":"values=\"0; 400; 0\""},{"type":"formatted","text":"，"},{"type":"formatted","code":true,"text":"keyTimes=\"0; 0.667; 1\""},{"type":"formatted","text":"，就表示在 "},{"type":"formatted","code":true,"text":"0%~66.7%"},{"type":"formatted","text":" 时间段，矩形的长度由 "},{"type":"formatted","code":true,"text":"0"},{"type":"formatted","text":" 变成 "},{"type":"formatted","code":true,"text":"400"},{"type":"formatted","text":"，在 "},{"type":"formatted","code":true,"text":"66.7%~100%"},{"type":"formatted","text":" 时间段，矩形长度由 "},{"type":"formatted","code":true,"text":"400"},{"type":"formatted","text":" 变成 "},{"type":"formatted","code":true,"text":"0"}]},{"type":"code-block","language":"html","uuid":"8eac6fdd-e568-4b84-9350-972ab1a2540b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7b3bbcbf-8cb7-45d9-85c8-c35d3402b11b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"400\" height=\"100\" viewBox=\"0 0 400 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      values=\"0; 400; 0\"\n      keyTimes=\"0; .667; 1\"\n      begin=\"0s\" dur=\"3s\"\n      repeatCount=\"indefinite\"\n      fill=\"freeze\" />\n  </rect>\n</svg>","collabId":"a2a5778c-7cda-4ffe-ad6a-010549e80670","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"400\" height=\"100\" viewBox=\"0 0 400 100\">\n  <rect width=\"100\" height=\"100\" x=\"0\" y=\"0\" fill=\"gray\">\n    <animate\n      attributeName=\"width\"\n      attributeType=\"XML\"\n      values=\"0; 400; 0\"\n      keyTimes=\"0; .667; 1\"\n      begin=\"0s\" dur=\"3s\"\n      repeatCount=\"indefinite\"\n      fill=\"freeze\" />\n  </rect>\n</svg>","collabId":"f8eda2b8-996b-42df-8c9c-8bb11797ae31","children":[{"type":"formatted","text":""}]}],"breadcrumb":[{"label":"SVG","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"动画","target":{"key":"doc:project:45:649","type":"doc","id":649}},{"label":"animate","target":{"key":"doc:project:45:650","type":"doc","id":650}}],"prevPage":{"title"