{"version":1,"key":"doc:project:45:655","content":{"id":655,"title":"矩形","content":[{"type":"paragraph","children":[{"type":"formatted","text":"使用 "},{"type":"formatted","text":"<rect>","code":true},{"type":"formatted","text":" 来绘制一个矩形，通过 "},{"type":"formatted","text":"(x, y)","code":true},{"type":"formatted","text":" 规定矩形左上角的坐标，"},{"type":"formatted","text":"width, height","code":true},{"type":"formatted","text":" 规定矩形的宽高"}]},{"type":"code-block","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    stroke-width=\"2\"\n    stroke=\"gray\"\n    fill=\"none\"\n  />\n</svg>","language":"html","uuid":"7c47c426-afd0-483f-9848-08a2d2474c5a","children":[{"type":"formatted","text":""}]},{"type":"html-block","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    stroke-width=\"2\"\n    stroke=\"gray\"\n    fill=\"none\"\n  />\n</svg>","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"注意到我们设置了 "},{"type":"formatted","text":"fill","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"none","code":true},{"type":"formatted","text":"，因为矩形是一个封闭的形状，它会被默认填充为黑色，我们可以通过 "},{"type":"formatted","text":"fill","code":true},{"type":"formatted","text":" 设置其填充色，也可以通过 "},{"type":"formatted","text":"fill-opacity","code":true},{"type":"formatted","text":" 设置透明度"}]},{"type":"code-block","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" fill=\"#1a66ff\" fill-opacity=\".5\" />\n</svg>","language":"html","uuid":"e71c2689-8749-4bbc-b19b-30106b1798ef","children":[{"type":"formatted","text":""}]},{"type":"html-block","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" fill=\"#1a66ff\" fill-opacity=\".5\" />\n</svg>","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"SVG 给我们提供了直接绘制圆角矩形的能力，我们需要指定圆角的半径，分别通过 "},{"type":"formatted","text":"rx","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"ry","code":true},{"type":"formatted","text":" 指定"}]},{"type":"code-block","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    fill=\"#1a66ff\"\n    fill-opacity=\".5\"\n    rx=\"10\"\n    ry=\"10\"\n  />\n</svg>","language":"html","uuid":"d82cf6c0-0149-46d5-ad13-99dd153398f2","children":[{"type":"formatted","text":""}]},{"type":"html-block","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    fill=\"#1a66ff\"\n    fill-opacity=\".5\"\n    rx=\"10\"\n    ry=\"10\"\n  />\n</svg>","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"可以只指定了 "},{"type":"formatted","text":"rx","code":true},{"type":"formatted","text":" 和 "},{"type":"formatted","text":"ry","code":true},{"type":"formatted","text":" 中的一个值，那么认为它们两个相等。"}]},{"type":"highlight-block","color":"yellow","children":[{"type":"paragraph","children":[{"type":"formatted","text":"我们也可以为 "},{"type":"formatted","text":"rx","code":true},{"type":"formatted","text":" "},{"type":"formatted","text":"ry","code":true},{"type":"formatted","text":" 指定百分比，不过这个百分比是相对于视口，而不是矩形，所以不太好用。"}]}]}],"breadcrumb":[{"label":"SVG","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"基本概念","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"基本形状","target":{"key":"doc:project:45:652","type":"doc","id":652}},{"label":"矩形","target":{"key":"doc:project:45:655","type":"doc","id":655}}],"prevPage":{"title":"折线","target":{"key":"doc:project:45:654","type":"doc","id":654}},"nextPage":{"title":"圆和椭圆","target":{"key":"doc:project:45:656","type":"doc","id":656}},"createTime":1703605463637,"updateTime":1743303640565,"projectId":45},"meta":{"type":"doc","publishTime":1743303640565},"pluginRenderers":[{"runtimeVersion":1,"manifest":{"formatVersion":1,"id":"tau.html","name":"HTML","version":"0.1.4","minAppVersion":"0.59.0","apiVersion":1,"platform":"desktop","format":"cjs","main":"main.js","editor":true,"categories":["editor","ai"],"keywords":["HTML","网页","嵌入"],"integrity":{"main.js":"eafe74429244b57e1dce6a889e1e925f0cf178f5942afe95485f081a8fa048bf","main.css":"468f2feb73a33e5711b1583b609e4ab3818e83d5f19a38dcd9d027b77eb269d8"},"styles":"main.css"},"entry":"../../../plugin-assets/tau.html/0.1.4/7b4be5bc83e3b665c52aeaddc0c146d56eb1864201e835bf5ebaba71b8eb1536/main.js","styles":"../../../plugin-assets/tau.html/0.1.4/7b4be5bc83e3b665c52aeaddc0c146d56eb1864201e835bf5ebaba71b8eb1536/style.css","nodeTypes":["html-block","html-inline"]}],"contentStyles":[{"href":"../../styles/07ef9b0bc5f675cae16809d6b062102bc14fa8077abff515eae95472f477def7.css","integrity":"07ef9b0bc5f675cae16809d6b062102bc14fa8077abff515eae95472f477def7"}]}