{"version":1,"key":"doc:project:45:655","content":{"id":655,"title":"矩形","content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"394297bf-fc83-48d3-b634-e6c40cdfc92e","children":[{"type":"formatted","text":"使用 "},{"type":"formatted","code":true,"text":"<rect>"},{"type":"formatted","text":" 来绘制一个矩形，通过 "},{"type":"formatted","code":true,"text":"(x, y)"},{"type":"formatted","text":" 规定矩形左上角的坐标，"},{"type":"formatted","code":true,"text":"width, height"},{"type":"formatted","text":" 规定矩形的宽高"}]},{"type":"code-block","language":"html","uuid":"7c47c426-afd0-483f-9848-08a2d2474c5a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"fed9ecdc-d20c-45e2-8a94-755ad6bd6705","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    stroke-width=\"2\"\n    stroke=\"gray\"\n    fill=\"none\"\n  />\n</svg>","collabId":"37868d2b-7092-421b-93ab-d7406f41d32e","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    stroke-width=\"2\"\n    stroke=\"gray\"\n    fill=\"none\"\n  />\n</svg>","collabId":"8797c3c2-0ec6-4afa-96b8-334d0e14720e","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"834a09c7-4cf7-43d9-a584-428b9ac7f0b8","children":[{"type":"formatted","text":"注意到我们设置了 "},{"type":"formatted","code":true,"text":"fill"},{"type":"formatted","text":" 为 "},{"type":"formatted","code":true,"text":"none"},{"type":"formatted","text":"，因为矩形是一个封闭的形状，它会被默认填充为黑色，我们可以通过 "},{"type":"formatted","code":true,"text":"fill"},{"type":"formatted","text":" 设置其填充色，也可以通过 "},{"type":"formatted","code":true,"text":"fill-opacity"},{"type":"formatted","text":" 设置透明度"}]},{"type":"code-block","language":"html","uuid":"e71c2689-8749-4bbc-b19b-30106b1798ef","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"d9f4c675-1ad4-40dc-bafc-fead59399566","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" fill=\"#1a66ff\" fill-opacity=\".5\" />\n</svg>","collabId":"06664f95-f598-46c4-9b87-29af690a33d8","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect x=\"20\" y=\"20\" width=\"60\" height=\"60\" fill=\"#1a66ff\" fill-opacity=\".5\" />\n</svg>","collabId":"8479999e-2fed-4884-849d-b3ea36606eea","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0b5c9906-549a-4afc-bf7b-72952965efa1","children":[{"type":"formatted","text":"SVG 给我们提供了直接绘制圆角矩形的能力，我们需要指定圆角的半径，分别通过 "},{"type":"formatted","code":true,"text":"rx"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"ry"},{"type":"formatted","text":" 指定"}]},{"type":"code-block","language":"html","uuid":"d82cf6c0-0149-46d5-ad13-99dd153398f2","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"9cd9673f-2f24-46b4-9713-28b3a44fcd34","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    fill=\"#1a66ff\"\n    fill-opacity=\".5\"\n    rx=\"10\"\n    ry=\"10\"\n  />\n</svg>","collabId":"c1d94e3b-5cf9-4d51-a761-0d76def97e42","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\">\n  <rect\n    x=\"20\"\n    y=\"20\"\n    width=\"60\"\n    height=\"60\"\n    fill=\"#1a66ff\"\n    fill-opacity=\".5\"\n    rx=\"10\"\n    ry=\"10\"\n  />\n</svg>","collabId":"09e56866-8d9b-420a-aee2-b42a749224df","children":[{"type":"formatted","text":""}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1909ea2b-e7bd-4484-82ed-122806dcab82","children":[{"type":"formatted","text":"可以只指定了 "},{"type":"formatted","code":true,"text":"rx"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"ry"},{"type":"formatted","text":" 中的一个值，那么认为它们两个相等。"}]},{"type":"highlight-block","color":"yellow","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"218b493a-d877-41a8-a34e-977d40e8640c","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8b9e9c29-3797-4d50-bdf5-f564a2e2a9b4","children":[{"type":"formatted","text":"我们也可以为 "},{"type":"formatted","code":true,"text":"rx"},{"type":"formatted","text":" "},{"type":"formatted","code":true,"text":"ry"},{"type":"formatted","text":" 指定百分比，不过这个百分比是相对于视口，而不是矩形，所以不太好用。"}]}]}],"breadcrumb":[{"label":"SVG","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"基本概念","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"基本形状","target":{"key":"doc:project:45:652","type":"doc","id":652}},{"label":"矩形","target":{"key":"doc:project:45:655","type":"doc","id":655}}],"prevPage":{"title":"折线","target":{"key":"doc:project:45:654","type":"doc",