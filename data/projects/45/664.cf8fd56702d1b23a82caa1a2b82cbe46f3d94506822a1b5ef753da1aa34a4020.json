{"version":1,"key":"doc:project:45:664","content":{"id":664,"title":"蒙版","content":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c78973bc-3e8e-407e-8d3e-1a8c069befdd","children":[{"type":"formatted","text":"为对象添加蒙版可以改变对象的透明度，蒙版透明度的计算如下"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"(0.2125 \\times \\text{red} + 0.7154 \\times \\text{green} + 0.0721 \\times \\text{blue}) \\times \\text{opacity}","collabId":"8ce3a8d7-e5e8-463b-b52b-68fe641a479f","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b2f42bce-c78c-415e-8d1a-8b141fa49588","children":[{"type":"formatted","text":"如果蒙版的颜色为白色，那么透明度就完全由 "},{"type":"formatted","code":true,"text":"opacity"},{"type":"formatted","text":" 决定，如果蒙版的颜色为黑色，那么就是完全透明，看不到了。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6806e50e-abf8-4354-bd5d-e242e00cfa4f","children":[{"type":"formatted","text":"我们通过 "},{"type":"formatted","code":true,"text":"mask"},{"type":"formatted","text":" 来定义蒙版，需要定义其大小及位置，它的单位默认是相对于引用其的形状，也就是说 "},{"type":"formatted","code":true,"text":"maskUnits"},{"type":"formatted","text":" 的默认值是 "},{"type":"formatted","code":true,"text":"objectBoundingBox"},{"type":"formatted","text":"，"},{"type":"formatted","code":true,"text":"mask"},{"type":"formatted","text":" 中的内容中使用的单位可以通过 "},{"type":"formatted","code":true,"text":"maskContentUnits"},{"type":"formatted","text":" 指定，默认值为 "},{"type":"formatted","code":true,"text":"userSpaceOnUse"},{"type":"formatted","text":"。"}]},{"type":"code-block","language":"html","uuid":"0a145a3f-f4e4-49e4-94f7-ce0a0add1076","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"7b006bda-b575-42b6-9275-02c672e123a6","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"<svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\">\n  <defs>\n    <radialGradient id=\"white-black\">\n      <stop offset=\"0\" stop-color=\"white\" />\n      <stop offset=\"1\" stop-color=\"black\" />\n    </radialGradient>\n    <mask \n      id=\"mask-cir\" \n      x=\"0\" \n      y=\"0\" \n      width=\"100\" \n      height=\"100\" \n      maskUnits=\"objectBoundingBox\" \n      maskContentUnits=\"objectBoundingBox\"\n     >\n      <epllise cx=\"50\" cy=\"50\" rx=\"50\" ry=\"50\" fill=\"url(#white-black)\" />\n    </mask>\n  </defs>\n  <image xlink:href=\"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_54a6391a-330c-4a3d-8a26-ac1df7b0acb5.png\"\n  \tx=\"50\" \n    y=\"50\"\n    width=\"100\" \n    height=\"100\"\n    mask=\"url(#mask-cir)\"\n  />\n</svg>","collabId":"e646dabe-b8f9-44d4-9409-467420f715e1","children":[{"type":"formatted","text":""}]}]},{"type":"html-block","tauContract":"ae642145aa1ba86b2ad23b93d4b1f24ed47731812964ef66e868fa9fd81f6554","html":"<svg width=\"200\" height=\"200\" viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"white-black\">\n      <stop offset=\"0\" stop-color=\"white\" />\n      <stop offset=\"1\" stop-color=\"black\" />\n    </radialGradient>\n    <mask \n      id=\"mask-cir\" \n      x=\"0\" \n      y=\"0\" \n      width=\"1\" \n      height=\"1\" \n      maskUnits=\"objectBoundingBox\" \n      maskContentUnits=\"objectBoundingBox\"\n     >\n      <epllise cx=\"0.5\" cy=\"0.5\" rx=\"0.5\" ry=\"0.5\" fill=\"url(#white-black)\" />\n    </mask>\n  </defs>\n  <image xlink:href=\"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_54a6391a-330c-4a3d-8a26-ac1df7b0acb5.png\"\n  \tx=\"50\" \n    y=\"50\"\n    width=\"100\" \n    height=\"100\"\n    mask=\"url(#mask-cir)\"\n  />\n</svg>","collabId":"dc2d3219-5e48-47d3-a3bd-4d2473e7df2b","children":[{"type":"formatted","text":""}]}],"breadcrumb":[{"label":"SVG","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"基本概念","target":{"key":"doc:project:45:648","type":"doc","id":648}},{"label":"蒙版","target":{"key":"doc:project:45:664","type":"doc","id":664}}],"prevPage":{"title":"裁剪","target":{"key":"doc:project:45:663","type":"doc","id":663}},"nextPage":{"title":"动画","target":{"key":"doc:project:45:649","type":"doc","id":649}},"createTime":1703605678714,"updateTime":1791552935000,"projectId":45},"meta":{"type":"doc","publishTime":1791552935000},"pluginRenderers":[{"runtimeVersion":1,"manifest":{"id":"tau.html","name":"HTML","version":"0.1.11","categories":["editor","ai"],"keywords":["HTML","网页","嵌入"],"apiVersion":1,"format":"cjs","main":"main.js","styles":"main.css","skills":["authoring"],"integrity":{"main.js":"968d6dd4153a56e6a91e0990d98b68c75255776b56b323facc1bfd5037fe0602","main.css":"468f2feb73a33e5711b1583b609e4ab3818e83d5f19a38dcd9d027b77eb269d8","skills/authoring/SKILL.md":"5a476fc110584964ab053cb40f0399ec27125bc1d315b6d50b019fbd9b112aa0"},"formatVersion":3,"platform":"portable","profile":"web-v1","description":"在文档中编辑行内与块级 HTML，支持 Tailwind 样式、博客发布和静态导出。","targets":{"desktop":{"minAppVersion":"0.59.5"},"android":{"minAppVersion":"0.2.7"},"ios":{"minAppVersion":"0.2.7"}}},"entry":"../../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/main.js","styles":"../../../plugin-assets/tau.html/0.1.11/fc2c10e9d04101645a92fb3123d7d6c355005213fcb06e9f3dab58168bbab594/style.css","nodeTypes":["html-block","html-inline"]}],"contentStyles":[{"href":"../../styles/55302789dd1e4d975d3bd635c7fdc6b6808b860b7e13096887d41a75d45bc654.css","integrity":"55302789dd1e4d975d3bd635c7fdc6b6808b860b7e13096887d41a75d45bc654"}]}