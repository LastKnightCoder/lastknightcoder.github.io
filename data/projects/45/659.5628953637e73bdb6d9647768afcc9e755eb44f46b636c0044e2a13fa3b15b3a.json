":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f8d77607-1eee-4de9-bad4-ac4c7b29aef6","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ed4b6cd1-4e01-45a4-b5c9-ea756b75af6b","children":[{"type":"formatted","code":true,"text":"pad"},{"type":"formatted","text":"：起点颜色扩散到 "},{"type":"formatted","code":true,"text":"0%"},{"type":"formatted","text":"，终点颜色扩散到 "},{"type":"formatted","code":true,"text":"100%"},{"type":"formatted","text":"。"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"86e4c76a-86dc-4424-9e5c-c0b6d23161b7","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"0f4f07b7-e9e9-4a06-8acf-f870cb421851","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8913a594-a64a-4ea2-bd68-063f14cd4598","children":[{"type":"formatted","text":"假设 "},{"type":"formatted","code":true,"text":"20%"},{"type":"formatted","text":" 是起点，那么 "},{"type":"formatted","code":true,"text":"0%-20%"},{"type":"formatted","text":" 填充为起点颜色"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"2f0882ba-acb7-4f85-8726-abe9500d1713","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e4658f90-b1c8-49cb-8ef4-8666434116b6","children":[{"type":"formatted","text":"假设 "},{"type":"formatted","code":true,"text":"80%"},{"type":"formatted","text":" 是终点，那么 "},{"type":"formatted","code":true,"text":"80%-100%"},{"type":"formatted","text":" 填充为终点颜色"}]}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"bfe7b795