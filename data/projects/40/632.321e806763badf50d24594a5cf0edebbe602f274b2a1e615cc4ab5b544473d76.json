,"tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"1","type":"inline-math"},{"text":"，我们更新一下图","type":"formatted"}],"collabId":"b8bd010e-57b4-4c19-9b98-d740dd822056","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"3c61ecc9-29d2-49b2-9c71-4fe29283153a","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_72b9a66c-8639-447d-ae87-a7d059320b8a.png"},{"children":[{"text":"然后在选择一条路径","type":"formatted"}],"collabId":"de96e7a4-66aa-47c3-8e69-48c3cdbf5f86","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"a9467a8e-ebef-4915-bd0e-8ed7b6554db7","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a8135c51-4276-424d-a7cf-612daa2a6841.png"},{"children":[{"text":"这次我们选择了 ","type":"formatted"},{"children":[{"text":"0 → 2 → 3","type":"formatted"}],"collabId":"87f937ea-6e64-41ef-8993-6b55b632e558","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"0 → 2 → 3","type":"inline-math"},{"text":"，这条路径的流量为 ","type":"formatted"},{"children":[{"text":"2","type":"formatted"}],"collabId":"6591cf5f-b6ca-4e80-a605-ca8b5eba7535","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"2","type":"inline-math"},{"text":"，更新图如下","type":"formatted"}],"collabId":"24783420-c09f-48c2-9943-38b46622e27b","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"f0f2b34c-473f-42d8-b80a-83082db4d419","pasteUploading":false,"tauContra