-41a7-ac98-f6beb87fa91b","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"3","type":"inline-math"},{"text":"，所以剩余能够通过的流量为 ","type":"formatted"},{"children":[{"text":"2","type":"formatted"}],"collabId":"8413f404-a136-44b0-a241-a9a007fa6bda","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"2","type":"inline-math"},{"text":"，我们以 ","type":"formatted"},{"children":[{"text":"2","type":"formatted"}],"collabId":"fd36f69e-6b9d-470c-983f-d0565882dfc5","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"2","type":"inline-math"},{"text":" 来标记这条边，同理我们也以这样的方式标记反向的边，得到下面的这么一个图","type":"formatted"}],"collabId":"ebc47721-6b08-4220-bdd4-cf80943f4c84","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"556feb4b-43bb-4594-9084-a9c30574912d","pasteUploading":false,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","type":"image","url":"https://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_9b5f330e-9bf9-42ba-b863-198c72124507.png"},{"children":[{"text":"黑色表示正向边，红色表示反向边，上面的数值表示能够允许通过的最大流量，可见在最开始反向边是不能允许通过流量的，它们的权值都是 ","type":"formatted"},{"children":[{"text":"0","type":"formatted"}],"collabId":"d45f418b-2c90-4908-8240-a0c996397379","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"0","type":"inline-math"},{"text":"，这个图我们称之为残差图。","type":"formatted"}],"collabId":"e68a3540-4e50-4898-b6a2-338b5ae0b903","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"接下下我们就可以使用上面提到的两步了：","type":"formatted"}],"collabId":"adc0a771-062f-4a68-b4c5-1cbecbd50d28","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"随便找一条路径从源点到汇点，找到路径的最小值，就是这条路径的流量","type":"formatted"}],"collabId":"b4010c91-fb05-4930-b48b-e8190c3b1e15","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"e2c13f6b-af13-45f1-baad-fb64cb7c10e1","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"更新每条边允许通过的流量","type":"formatted"}],"collabId":"e08e0b89-3269-49bd-8086-e3e13448b2c9","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"82cfd4ea-af98-4cab-8b66-a89aebf5a91c","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"42d5d3f6-f3db-40c9-96b6-50cb0160a0b1","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"这个方法就是 Ford-Fulkerson 思想。","type":"formatted"}],"collabId":"461ad325-d7c6-4aed-b6dc-0fedfa7de2a9","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"breadcrumb":[{"label":"数据结构","target":{"key":"doc:project:40:593","type":"doc","id":593}},{"label":"图结构","target":{"key":"doc:project:40:594","type":"doc","id":594}},{"label":"网络流与最大流","target":{"key":"doc:project:40:631","type":"doc","id":631}},{"label":"Ford-Fulkerson 思想","target":{"key":"doc:project:40:632","type":"doc","id":632}}],"prevPage":{"title":"网络流与最大流","target":{"key":"doc:project:40:631","type":"doc","id":631}},"nextPage":{"title":"Edmonds-Karp 算法","target":{"key":"doc:project:40:633","type":"doc","id":633}},"createTime":1702133166954,"updateTime":1793532541869,"projectId":40},"meta":{"type":"doc","publishTime":1793532541869}}