{"version":1,"key":"doc:project:40:618","content":{"id":618,"title":"倒水智力题","content":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"62c341ea-fa0a-4704-a4be-0ebafc42ff11","children":[{"type":"formatted","text":"有两个桶，一个能装 5 升水，一个能装 3 升水，如何得到 4 升水?"}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1f23f85a-9045-4dc8-b6bc-980285987d51","children":[{"type":"formatted","text":"这道题还是将状态看做是一个图的节点，如果状态之间能够互相转变，就说状态之前有一条边。我们定义状态 "},{"type":"formatted","code":true,"text":"<x,y>"},{"type":"formatted","text":" 表示第一个桶有 "},{"type":"formatted","code":true,"text":"x"},{"type":"formatted","text":" 升水，第二个桶有 "},{"type":"formatted","code":true,"text":"y"},{"type":"formatted","text":" 升水。那么 "},{"type":"formatted","code":true,"text":"<x, y>"},{"type":"formatted","text":" 与哪些状态是相连的呢，分为六种情况："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"5c2a2f6e-cde6-4dba-b323-bd41e2ae1979","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9c5d0c85-1e4d-44ea-bb9f-5f596e29a396","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a9dad111-0f4d-4888-bfd4-ad144400e3b5","children":[{"type":"formatted","text":"倒空第一桶水："},{"type":"formatted","code":true,"text":"<x, y> => <0, y>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e6546e02-ff08-43f5-82e0-9802f7fc4477","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b3b84b97-479d-4744-95aa-98e312a4d17e","children":[{"type":"formatted","text":"倒空第二桶水："},{"type":"formatted","code":true,"text":"<x, y> => <x, 0>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"0350d651-8e32-4477-9db2-6b1058a0f491","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"493e668e-6f46-437f-b513-5a2a9dd231a0","children":[{"type":"formatted","text":"加满第一桶水："},{"type":"formatted","code":true,"text":"<x, y> => <5, y>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"8f56422d-565b-4721-baea-6fc35cc8e2dc","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1285834c-53b2-4e1e-a3dc-a5bc7ddabb40","children":[{"type":"formatted","text":"加满第二桶水："},{"type":"formatted","code":true,"text":"<x, y> => <x, 3>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c0bad1ab-ba22-4dff-b685-593b16897045","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"324f6936-37dc-40d0-abf1-392aebf7d72a","children":[{"type":"formatted","text":"第二桶水倒入第一桶水："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"18b5bf22-b849-49ce-92e6-48ae987e61f3","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e1978f5f-364d-41f0-9376-c26f2127dcff","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"863b70bf-e906-4702-ac28-1e7d5f2a67dc","children":[{"type":"formatted","text":"﻿"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x + y \\geq 5","collabId":"3bb20237-af9d-4bac-99b9-dcf4d9ec8519","children":[{"type":"formatted","text":"x + y \\geq 5"}]},{"type":"formatted","text":"："},{"type":"formatted","code":true,"text":"<x, y> => <5, x + y - 5>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"3007b88f-1a63-47c7-b6f0-f4558b0b02f0","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7ade3cdc-082a-495c-a7d4-c6a5b5610ae1","children":[{"type":"formatted","text":"﻿"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x + y < 5","collabId":"57206073-c9e0-40fd-a5ef-2108a7591f00","children":[{"type":"formatted","text":"x + y < 5"}]},{"type":"formatted","text":"："},{"type":"formatted","code":true,"text":"<x, y> => <x + y, 0>"}]}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e63df076-0e76-4675-ba31-d0e2136a8b9a","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f73ec5f8-a540-48c5-a742-7570f7e0d8b9","children":[{"type":"formatted","text":"第一桶水倒入第二桶水："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"56275c61-2ef6-4da0-b4d9-6a172ba41d01","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"86ef9caa-7af7-473b-9780-cf4a40d12c38","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7d97946c-ca54-4ffa-8196-3263c307e058","children":[{"type":"formatted","text":"﻿"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x + y \\geq 3","collabId":"4e38817d-771c-4ebd-adfc-2ed10d94000a","children":[{"type":"formatted","text":"x + y \\geq 3"}]},{"type":"formatted","text":"："},{"type":"formatted","code":true,"text":"<x, y> => <x + y - 3, 3>"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"2e24dff8-16e9-42bf-a6d4-dd2f64191468","children":[{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1d4ee9ad-263b-4033-991e-b18e12276935","children":[{"type":"formatted","text":"﻿"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x + y < 3","collabId":"527a5f50-5172-4ea3-8cf1-9882119ddd47","children":[{"type":"formatted","text":"x + y < 3"}]},{"type":"formatted","text":"："},{"type":"formatted","code":true,"text":"<x, y> => <0, x + y>"}]}]}]}]}]},{"type":"paragraph","tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"16bc0e4d-04c0-4b26-84ec-4d81ef59227f","children":[{"type":"formatted","text":"我们使用一个两位数表示一个状态，十位数表示第一个桶中有多少升水，个位数表示第二个桶中有多少升水，例如 "},{"type":"formatted","code":true,"text":"23"},{"type":"formatted","text":" 表示第一个桶中有 "},{"type":"formatted","code":true,"text":"2"},{"type":"formatted","text":" 升水，第二个桶中有 "},{"type":"formatted","code":true,"text":"3"},{"type":"formatted","text":" 升水。"}]},{"type":"code-block","language":"java","uuid":"9fc31c1f-19ab-478a-880f-af7e5c5bec61","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c9a78d31-505f-489d-8453-9123d98257de","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"import java.util.*;\n\npublic class WaterPuzzle {\n    public Iterable<Integer> waterPuzzle() {\n        HashSet<Integer> visited = new HashSet<>();\n        HashMap<Integer, Integer>  pre = new HashMap<>();\n        Queue<Integer> queue = new LinkedList<>();\n\n        queue.add(0);\n        visited.add(0);\n        pre.put(0, 0);\n        \n        // 保存最后找到的结果\n        int endState = 0;\n        // 用以跳出 while 循环\n        boolean flag = false;\n        \n        while (!queue.isEmpty()) {\n            int state = queue.remove();\n            for (int nextState: adj(state)) {\n                if (!visited.contains(nextState)) {\n                    visited.add(nextState);\n                    queue.add(nextState);\n                    pre.put(nextState, state);\n                    if (nextState / 10 == 4 || nextState % 10 == 4) {\n                        endState = nextState;\n                        flag = true;\n                        break;\n                    }\n                }\n            }\n            if (flag) {\n                break;\n            }\n        }\n\n\n        ArrayList<Integer> result = new ArrayList();\n\n        int cur = endState;\n        result.add(cur);\n        while (pre.get(cur) != 0) {\n            cur = pre.get(cur);\n            result.add(cur);\n        }\n\n        Collections.reverse(result);\n        return result;\n    }\n\n    private Iterable<Integer> adj(int state) {\n        int first = state / 10;\n        int second = state % 10;\n\n        Set<Integer> set = new HashSet<>();\n        set.add(second);\n        set.add(first*10);\n        set.add(5*10 + second);\n        set.add(first * 10 + 3);\n\n        if (first + second >= 5) {\n            set.add(5 * 10 + (first + second) - 5);\n        } else {\n            set.add((first + second) * 10);\n        }\n\n        if (first + second >= 3) {\n            set.add((first + second - 3) * 10 + 3);\n        } else {\n            set.add(first + second);\n        }\n\n        return new ArrayList<>(set);\n    }\n\n    public static void main(String[] args) {\n        WaterPuzzle waterPuzzle = new WaterPuzzle();\n        for (int r: waterPuzzle.waterPuzzle()) {\n            // 在个位数前加上0\n            System.out.print((r >= 10 ? r : \"0\" + r) + \" \");\n        }\n    }\n}","collabId":"e613d979-78ca-46c3-980b-ec4ed9aff395","children":[{"type":"formatted","text":""}]}]}],"breadcrumb":[{"label":"数据结构","target":{"key":"doc:project:40:593","type":"doc","id":593}},{"label":"图结构","target":{"key":"doc:project:40:594","type":"doc","id":594}},{"label":"广度优先遍历","target":{"key":"doc:project:40:614","type":"doc","id":614}},{"label":"倒水智力题","target":{"key":"doc:project:40:618","type":"doc","id":618}}],"prevPage":{"title":"打开转盘锁","target":{"key":"doc:project:40:617","type":"doc","id":617}},"nextPage":{"title":"滑动谜题","target":{"key":"doc:project:40:619","type":"doc","id":619}},"createTime":1702051428077,"updateTime":1743303640550,"projectId":40},"meta":{"type":"doc","publishTime":1743303640550}}