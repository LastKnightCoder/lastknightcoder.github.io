Contract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"输入：n = 3\n输出：5","collabId":"284adec7-2354-4b17-8365-936b7d88b92d","children":[{"type":"formatted","text":""}]}]},{"type":"image","url":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a4285e46-e11e-4098-bae0-0ffc613ba04e.webp","uuid":"5d238c2e-a792-42d6-9573-4c790a8dbb24","pasteUploading":false,"previewUrl":"http://blog-hostimaging.oss-cn-beijing.aliyuncs.com/image_a4285e46-e11e-4098-bae0-0ffc613ba04e.webp","width":675.8333064781306,"tauContract":"9d766f08643a09b151c9500b642decb7d9f8625878621cbd90af820668058ac0","collabId":"a0867bdc-c46a-4c39-b172-661fa382a5d3","children":[{"type":"formatted","text":""}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"2555efbc-2297-44e9-a743-080996a678cb","children":[{"type":"formatted","text":"解题思路"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8a60de47-c33c-4c12-a42f-d662c5fc2076","children":[{"type":"formatted","text":"对于 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n","collabId":"b94a5b2f-8163-4003-b9bf-1aeb33d4fb97","children":[{"type":"formatted","text":"n"}]},{"type":"formatted","text":" 个数，我们分别以每个数作为根节点，因为根节点是不一样的，所以产生的树是不会重复的。我们记 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n","collabId":"1ae95ae9-e356-4363-8222-a60d952c7f18","children":[{"type":"formatted","text":"n"}]},{"type":"formatted","text":" 能够形成 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"G(n)","collabId":"5e930589-e845-41f0-8cb0-8604c3df3a86","children":[{"type":"formatted","text":"G(n)"}]},{"type":"formatted","text":" 个二叉搜索树，以数字 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i","collabId":"3f32eeb9-6d98-4334-afac-444cbfc78da6","children":[{"type":"formatted","text":"i"}]},{"type":"formatted","text":" 为根节点能产生 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"F(i)","collabId":"c07e066e-6a0b-465a-b785-e5983ff29b31","children":[{"type":"formatted","text":"F(i)"}]},{"type":"formatted","text":"  个二叉搜索树，则可以得到"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"G(n) = \\sum_{i = 1}^{n} F(i)","collabId":"1366f312-ee04-4933-b8c9-b3f4e06becb8","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ec1447cf-1b22-4e45-8157-084aa5c968ef","children":[{"type":"formatted","text":"对于以 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i","collabId":"abe9918d-2ef6-4b07-992a-e5aea7970f6b","children":[{"type":"formatted","text":"i"}]},{"type":"formatted","text":" 为节点，那么 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[1, i -1]","collabId":"b4f5242d-f2d1-4231-b573-658084a8965d","children":[{"type":"formatted","text":"[1, i -1]"}]},{"type":"formatted","text":" 总共 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i - 1","collabId":"1c3bb045-7a59-47bc-b989-3d56c8792e4e","children":[{"type":"formatted","text":"i - 1"}]},{"type":"formatted","text":" 个数形成它的左子树，而 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[i + 1, n]","collabId":"b62b3f6d-e3f7-4544-9240-09023bc3db7a","children":[{"type":"formatted","text":"[i + 1, n]"}]},{"type":"formatted","text":" 总共 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n - i","collabId":"04cdab9f-a05a-42e1-aa10-c5526c99b63f","children":[{"type":"formatted","text":"n - i"}]},{"type":"formatted","text":" 个数形成它的右子树，所以我们可以得到。由 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"G(n)","collabId":"29e82dab-0d2a-4285-a73a-65036f488676","children":[{"type":"formatted","text":"G(n)"}]},{"type":"formatted","text":" 的定义可知，左子树总共有 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"G(i - 1)","collabId":"ae2d3e4a-ad11-4627-8bdf-dd7c7b05238a","children":[{"type":"formatted","text":"G(i - 1)"}]},{"type":"formatted","text":" 种可能，而右子树有 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"G(n-i)","collabId":"f3c116b2-4e7c-48c1-a137-3641b32ff7a4","children":[{"type":"formatted","text":"G(n-i)"}]},{"type":"formatted","text":" 种可能，所以得到以 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i","collabId":"4a828370-8712-4bf0-8e50-d5b4872e381e","children":[{"type":"formatted","text":"i"}]},{"type":"formatted","text":" 为根节点，总共有"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"F(i) = G(i - 1) \\times G(n - i)","collabId":"5ca1d20b-5038-4acb-b1d0-4f7cace61749","children":[{"type":"formatted","text":""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"d8c07cde-8aa1-4208-aa44-1efb04876db8","children":[{"type":"formatted","text":"从而得到 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"G(n)","collabId":"9e9ef0d0-2776-4439-9ea3-923e3050f965","children":[{"type":"formatted","text":"G(n)"}]},{"type":"formatted","text":" 的递归表达式"}]},{"type":"block-math","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"G(n) = \\sum_{i = 1}^{n} G(i - 1) \\times G(n - i)","collabId":"97e380cd-23dc-443b-8d68-c142bb39b668","children":[{"type":"formatted","text":""}]},{"type":"code-block","language":"java","uuid":"a976b346-20f0-4c2c-b0e1-42761329734a","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"32e19776-4d57-48b8-9333-db0237d7cefc","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"public int numTrees(int n) {\n    int[] dp = new int[n + 1];\n    dp[0] = 1;\n    dp[1] = 1;\n    if (n == 0 || n == 1) {\n        return dp[n];\n    }\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= i; j++) {\n            dp[i] += (dp[j - 1] * dp[i - j]);\n        }\n    }\n    return dp[n];\n}","collabId":"3529c733-2d95-4bf7-8abd-702bfa546d08","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"a62a456e-07fc-4c21-af57-03a8b3b6ac91","children":[{"type":"formatted","text":"参考"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"07710201-c063-4e22-81d9-faf6cc841a09","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"6a1e76b2-de39-4753-b94d-d7fed32e6a62","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0d649545-98bb-4997-a6c3-7cd4b5b891d6","children":[{"type":"link","url":"https://leetcode-cn.com/problems/unique-binary-search-trees/","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"cbd0de87-2604-43f3-b2a7-3bc398387003","children":[{"type":"formatted","text":"不同的二叉搜索树"}]}]}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"树"},{"label":"不同的二叉搜索树","target":{"key":"doc:project:47:677","type":"doc","id":677}}],"prevPage":{"title":"合并 K 个升序链表","target":{"key":"doc:project:47:692","type":"doc","id":692}},"nextPage":{"title":"二叉树的最近公共祖先","target":{"key":"doc:project:47:725","type":"doc","id":725}},"createTime":1728989957675,"updateTime":1775929133350,"projectId":47},"meta":{"type":"doc","publishTime":1775929133350}}