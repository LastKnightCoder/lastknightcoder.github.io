d-23dc-443b-8d68-c142bb39b668","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"G(n) = \\sum_{i = 1}^{n} G(i - 1) \\times G(n - i)","type":"block-math"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"public int numTrees(int n) {\n    int[] dp = new int[n + 1];\n    dp[0] = 1;\n    dp[1] = 1;\n    if (n == 0 || n == 1) {\n        return dp[n];\n    }\n    for (int i = 2; i <= n; i++) {\n        for (int j = 1; j <= i; j++) {\n            dp[i] += (dp[j - 1] * dp[i - j]);\n        }\n    }\n    return dp[n];\n}","collabId":"3529c733-2d95-4bf7-8abd-702bfa546d08","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"32e19776-4d57-48b8-9333-db0237d7cefc","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"a976b346-20f0-4c2c-b0e1-42761329734a"},{"children":[{"text":"参考","type":"formatted"}],"collabId":"a62a456e-07fc-4c21-af57-03a8b3b6ac91","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"不同的二叉搜索树","type":"formatted"}],"collabId":"cbd0de87-2604-43f3-b2a7-3bc398387003","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://leetcode-cn.com/problems/unique-binary-search-trees/"}],"collabId":"0d649545-98bb-4997-a6c3-7cd4b5b891d6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"6a1e76b2-de39-4753-b94d-d7fed32e6a62","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"07710201-c063-4e22-81d9-faf6cc841a09","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"breadcrumb":[{"label":"LeetCode","target":{"key