t":"\"6\""}]}]},{"type":"detail","title":"示例2","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","collabId":"418b4b85-8cb3-41b7-a466-2d2f769d6e3a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8301580c-ee87-4cc2-9215-7d48f0ef2f4c","children":[{"type":"formatted","text":"输入: "},{"type":"formatted","code":true,"text":"num1 = \"123\""},{"type":"formatted","text":", "},{"type":"formatted","code":true,"text":"num2 = \"456\""}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"377b33fe-8800-4c1a-8e97-697ee29f499c","children":[{"type":"formatted","text":"输出: "},{"type":"formatted","code":true,"text":"\"56088\""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2ca8e27d-3711-4027-b42c-6ca744e899bd","children":[{"type":"formatted","text":"提示："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"9dcc28fd-fb66-433f-832c-d13221bf69e5","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"b8a4f1e3-047e-41b7-85f8-679f80ff17bf","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"2f5d2483-2ebd-43ff-a3df-ebd65099c1b2","children":[{"type":"formatted","code":true,"text":"1 <= num1.length"},{"type":"formatted","text":", "},{"type":"formatted","code":true,"text":"num2.length <= 200"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"302d149d-6f12-49da-a41e-bb23e5cb1956","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"babb3898-46ca-4f1c-b35d-40fa9294052c","children":[{"type":"formatted","code":true,"text":"num1"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"num2"},{"type":"formatted","text":" 只能由数字组成。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"bf27edc4-c7f3-4a30-a3d9-0110be13920f","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3f2944aa-61db-47c4-b707-42d4a27725b6","children":[{"type":"formatted","code":true,"text":"num1"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"num2"},{"type":"formatted","text":" 都不包含任何前导零，除了数字 "},{"type":"formatted","code":true,"text":"0"},{"type":"formatted","text":" 本身。"}]}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"449c7d87-34cd-4a80-bda8-518892141893","children":[{"type":"formatted","text":"解题思路"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"119b8fe7-910e-4a21-9d15-8c2730335998","children":[{"type":"formatted","text":"如果直接解析为数字然后使用乘法，会存在溢出的问题，值会成为正无穷"}]},{"type":"code-block","language":"JavaScript","uuid":"3b856d3e-70c3-4429-912b-fdb92e4633a1","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"d722310f-3efe-4d76-94d9-4c393801f570","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"Number.MAX_VALUE * Number.MAX_VALUE // Infinity","collabId":"64f023df-e88d-4269-bce7-27a21bed29eb","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"bb0a5c78-388a-4a51-a47f-cfb51d214cd5","children":[{"type":"formatted","text":"可以考虑人类是怎么做乘法的，竖式乘法，使用一个数组 "},{"type":"formatted","code":true,"text":"res"},{"type":"formatted","text":" 存储最终的结果，可知 "},{"type":"formatted","code":true,"text":"num1[i] * nums[j]"},{"type":"formatted","text":" 的结果在 "},{"type":"formatted","code":true,"text":"res[i + j]"},{"type":"formatted","text":" 处，这里先不处理进位，最后统一处理进位，思路如下"}]},{"type":"code-block","language":"","uuid":"16bab2cb-0614-456f-8778-580dd7f31abc","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"50db40f5-ad8e-4f4e-935a-f1aea75fb1df","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"        1 2 3\n      × 4 5 6\n--------------\n            18\n         12\n      6\n         15\n      10\n    5\n      12\n    8\n  4\n--------------\n  4 13 28 27 18\n  5  6  0  8  8   <---- 处理进位","collabId":"792e8810-05c5-4a8d-9f86-9c7a8dd1b2a5","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ec505c97-e050-4d3c-96a7-49fb36b904a0","children":[{"type":"formatted","text":"代码如下"}]},{"type":"code-block","language":"JavaScript","uuid":"b83f1079-adfd-4179-8876-9d0cf0b33709","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b79a6e47-d919-4b34-90f1-d477911efe39","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"const multiply = (num1, num2) => {\n  const len1 = num1.length;\n  const len2 = num2.length;\n  const len = len1 + len2 - 1;\n  const res = Array.from({ length: len }, () => 0);\n  for (let i = 0; i < len1; i++) {\n    for (let j = 0; j < len2; j++) {\n      if (!res[len - i - j - 1]) res[len - i - j - 1] = 0;\n      const mulRes = parseInt(num1[len1 - i - 1]) * parseInt(num2[len2 - j - 1]);\n      res[len - i - j - 1] += mulRes;\n    }\n  }\n\n  // 处理进位\n  let addition = 0;\n  for (let i = len - 1; i >= 0; i--) {\n    const n = res[i];\n    res[i] = (n + addition) % 10;\n    addition = Math.floor((n + addition) / 10);\n  }\n  if (addition) {\n    res.unshift(addition);\n  }\n\n  // 前导 0 处理\n  while (res[0] === 0 && res.length > 1) {\n    res.shift();\n  }\n\n  return res.join('');\n}","collabId":"fbd251f6-dd81-4bc5-b1b4-18053e0eeea0","children":[{"type":"formatted","text":""}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"数学"},{"label":"字符串相乘","target":{"key":"doc:project:47:724","type":"doc","id":724}}],"prevPage":{"title":"x 的平方根","target":{"key":"doc:project:47:715","type":"doc","id":715}},"createTime":1739495604557,"updateTime":1744296882777,"projectId":47},"meta":{"type":"doc","publishTime":1744296882777}}