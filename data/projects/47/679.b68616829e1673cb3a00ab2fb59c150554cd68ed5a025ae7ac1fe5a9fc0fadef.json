.0","type":"formatted"}],"collabId":"67e5d6fd-176d-40ac-9025-30258baefbb7","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"-100.0 < x < 100.0","type":"inline-math"},{"text":"﻿","type":"formatted"}],"collabId":"45cbcbcd-a814-4692-a374-d16c4f7ad1b8","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"83b1fb64-a3bd-4c82-b3b3-e2784a6de940","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"﻿","type":"formatted"},{"children":[{"text":"-2^{31} \\leq n \\leq 2^{31} - 1","type":"formatted"}],"collabId":"a66fa265-24ad-4b8e-9d10-6d79501fbf97","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"-2^{31} \\leq n \\leq 2^{31} - 1","type":"inline-math"},{"text":"﻿","type":"formatted"}],"collabId":"3a5f5dbd-5a73-4a98-a7fe-d4ee097fb5e4","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"fd12daa5-ae73-46f1-84a8-4e808066ebf3","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"﻿","type":"formatted"},{"children":[{"text":"-10^4 \\leq x^n \\leq 10^4","type":"formatted"}],"collabId":"51f81347-e789-4b29-9242-49c93259cc87","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"-10^4 \\leq x^n \\leq 10^4","type":"inline-math"},{"text":"﻿","type":"formatted"}],"collabId":"cdab0f36-d246-479d-8949-8f1a61cd75bc","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"01a26846-8a81-49fe-9b3f-1e9a890f7465","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"62797769-ce72-4278-b548-eb9c318cabe9","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"128231f6-33c6-4fe4-afe8-7067d68ae6a4","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"text":"x^n","type":"formatted"}],"collabId":"cc4115fc-6f4e-4a70-9b0f-678494cf8a4d","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^n","type":"inline-math"},{"text":" 的计算分为以下两种情况","type":"formatted"}],"collabId":"d0292926-2b63-4372-be31-3e2e98e889ac","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"07dc0058-5aef-49f4-82fa-918fd1c69094","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"x^n = \n\\begin{cases}\nx^{|n|}, & n > 0 \\\\\n\\dfrac{1}{x^{|n|}}, & n < 0\n\\end{cases}","type":"block-math"},{"children":[{"text":"对 ","type":"formatted"},{"children":[{"text":"x = 0","type":"formatted"}],"collabId":"bd8be05e-e1e0-4b74-b162-a2dcf143ba00","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x = 0","type":"inline-math"},{"text":" 时需要单独考虑，否则当 ","type":"formatted"},{"children":[{"text":"n < 0","type":"formatted"}],"collabId":"66e4131d-a321-4ef4-99f3-c1604108b808","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"n < 0","type":"inline-math"},{"text":"，得到的结果为无穷大，我们认为 ","type":"formatted"},{"children":[{"text":"0^n = 0","type":"formatted"}],"collabId":"ccf97b2a-c898-468a-8d4a-a1e178383b30","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"0^n = 0","type":"inline-math"},{"text":"，所以可以写出这样的代码","type":"formatted"}],"collabId":"ba89537b-1602-494b-b52a-ba8b1df4dd32","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"public double myPow(double x, int n) {\n    if (x == 0) {\n        return 0;\n    }\n    double res = myPowWithPositiveExp(x, Math.abs(n));\n    return n > 0 ? res : 1 / res;\n}","collabId":"8e48c050-c59b-4340-977f-aab1509008b0","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2392d7a8-96de-4370-9cae-30031c9933c6","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"2ba30b32-d2cc-4011-b753-d4ff9305f3d9"},{"children":[{"text":"上面 ","type":"formatted"},{"code":true,"text":"myPowWithPositiveExp","type":"formatted"},{"text":" 方法是计算 ","type":"formatted"},{"children":[{"text":"x^{|n|}","type":"formatted"}],"collabId":"aec51ca2-b61b-4732-9ab0-6b4e2c44c482","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^{|n|}","type":"inline-math"},{"text":" 的方法，它只处理指数为正的情况。很快我们可以写出这样的代码","type":"formatted"}],"collabId":"1d2ecc3a-ce95-49eb-826e-c3644eedf111","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"private double MyPowWithPositiveExp(double x, int n) {\n    if (n == 0) {\n        return 1;\n    }\n\n    double res = 1;\n    for (int i = 0; i < n; i++) {\n        res *= x;\n    }\n\n    return res;\n}","collabId":"9f626164-56a0-4121-8f2e-c024e3c372e2","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"2eb7a900-259a-48e6-8add-c40ae3641dc7","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"91aad660-48bf-401a-8131-6ca669bc64a0"},{"children":[{"text":"这样做行不行，当然可以。不过我们有更快的方法，重新考虑 ","type":"formatted"},{"children":[{"text":"x^n(n>0)","type":"formatted"}],"collabId":"dad096f8-75b9-4020-abfe-8de2f09dde92","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^n(n>0)","type":"inline-math"},{"text":"，我们可以划分为","type":"formatted"}],"collabId":"2fe4bedf-e8b0-40e3-9006-85e3c7d9df0b","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"c54a0846-5f13-4317-ad6c-1aa58b465b7a","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"x^{n} = \n\\begin{cases}\nx^{n/2} * x^{n/2}, & n \\% 2 == 0 \\\\\nx * x^{(n-1)/2} * x^{(n-1)/2}, & n \\% 2 == 1\n\\end{cases}","type":"block-math"},{"children":[{"text":"我们把求解 ","type":"formatted"},{"children":[{"text":"x^n","type":"formatted"}],"collabId":"26944fd0-aa86-4be6-a5f1-24004e20bcaa","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^n","type":"inline-math"},{"text":" 转化为了求解 ","type":"formatted"},{"children":[{"text":"x^{n/2}","type":"formatted"}],"collabId":"07aabb18-c502-431a-bf3d-4192be36de48","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^{n/2}","type":"inline-math"},{"text":"，而 ","type":"formatted"},{"children":[{"text":"x^{n/2}","type":"formatted"}],"collabId":"3e556951-e1e5-4e88-9bb8-30d6d330e4c2","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^{n/2}","type":"inline-math"},{"text":" 又可以转化为求解 ","type":"formatted"},{"children":[{"text":"x^{n/4}","type":"formatted"}],"collabId":"9f54a6c6-c1fc-4972-9b76-e922c33ee3a6","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"x^{n/4}","type":"inline-math"},{"text":"，大大的减少了计算，所以我们很快可以写出这样的代码","type":"formatted"}],"collabId":"7b808b2e-5568-45e0-974a-4fa839936b98","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"private double myPowWithPositiveExp(double x, int n) {\n    if (n == 0) {\n        return 1;\n    }\n    // 当 n 为奇数时 n/2 = (n - 1)/2\n    double res = myPowWithPositiveExp(x, n/2);\n    if (n % 2 == 0) {\n        return res * res;\n    } else {\n        return x * res * res;\n    }\n}","collabId":"13e7764c-16ce-4430-9fbb-d3b961da27f3","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e2764a8c-e2ee-4f05-9cb0-54d35969ec15","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"7b244d59-8d8b-4679-9573-e14fdf4c82ae"},{"children":[{"text":"参考","type":"formatted"}],"collabId":"5ac035d9-c747-44ee-9adf-dc191eeb0325","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"Pow(x, n)","type":"formatted"}],"collabId":"66df434b-a5bb-451a-b769-7e0955a9666a","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://leetcode-cn.com/problems/powx-n/"}],"collabId":"9e8af78f-1522-4ace-a8e2-3b55aca123bd","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"dbe32d46-f34b-48bc-b2d8-4a198ddc1a02","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"8a5f0daf-5604-44f7-baeb-fd57b35fc7d1","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"分治"},{"label":"Pow(x, n)","target":{"key":"doc:project:47:679","type":"doc","id":679}}],"prevPage":{"title":"最长回文字符串","target":{"key":"doc:project:47:713","type":"doc","id":713}},"nextPage":{"title":"两数之和","target":{"key":"doc:project:47:682","type":"doc","id":682}},"createTime":1728990323658,"updateTime":1793532543458,"projectId":47},"meta":{"type":"doc","publishTime":1793532543458}}