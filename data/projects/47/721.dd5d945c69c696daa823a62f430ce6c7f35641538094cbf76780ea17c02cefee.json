em"},{"children":[{"children":[{"text":"开往 0 号加油站，此时油箱有 ","type":"formatted"},{"code":true,"text":"4 - 3 + 2 = 3","type":"formatted"},{"text":" 升汽油","type":"formatted"}],"collabId":"bf7188d7-3953-4735-811c-c24b9d13073c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"54ae6eee-cf20-4762-ae40-edca9b45856e","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"开往 1 号加油站，此时油箱有 ","type":"formatted"},{"code":true,"text":"3 - 3 + 3 = 3","type":"formatted"},{"text":" 升汽油","type":"formatted"}],"collabId":"53faab3a-6203-430d-b669-737a310edbde","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"0aad8258-ceea-4267-8431-a40874de62d6","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"你无法返回 2 号加油站，因为返程需要消耗 4 升汽油，但是你的油箱只有 3 升汽油。","type":"formatted"}],"collabId":"2e206b3e-ec3f-4aab-8564-1a59ca81a2a6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"6bcdf83d-034c-49cd-902e-0a7912068f49","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"因此，无论怎样，你都不可能绕环路行驶一周。","type":"formatted"}],"collabId":"a4172398-e55a-46cb-81ba-a8cafd62a898","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"a6137732-9492-4d70-8ae2-d3f9af24dfc1","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"6368143d-8118-472b-89c9-033b0b3eff94","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"collabId":"a7e5afbe-16d6-4a82-bb57-31bfd13f87be","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","title":"示例 2","type":"detail"},{"children":[{"text":" 提示:","type":"formatted"}],"collabId":"04892e16-3ff3-4daa-a531-c662d772dcc5","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"code":true,"text":"gas.length == n","type":"formatted"}],"collabId":"63ba1431-378d-48c9-bab1-68c3bfb34fec","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"5b6e38e2-cf88-4b68-9bae-251200244eb3","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"cost.length == n","type":"formatted"}],"collabId":"85fb7c68-91da-4f9f-a40c-fb545e4e6fe7","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"084cca8a-a8b1-4533-bba8-830c5616fb6d","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"1 <= n <= 10^5","type":"formatted"}],"collabId":"2a356b9e-3b6a-4e77-83ce-9204a1cbcd68","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"e3921bd7-99dd-4417-bb73-c332e7d2560c","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"code":true,"text":"0 <= gas[i], cost[i] <= 10^4","type":"formatted"}],"collabId":"6da4609f-0647-4654-9dab-cfe18d201d9c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"c41d52f1-fc63-4698-acc1-80b7d6179a34","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"8aaf80ec-ca9c-45bb-abcc-090a4d199dd9","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"11a2e802-9811-445c-b878-a6511ccc9ca9","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"假设从 ","type":"formatted"},{"code":true,"text":"start","type":"formatted"},{"text":" 出发，它最多到达 ","type":"formatted"},{"code":true,"text":"end","type":"formatted"},{"text":"，我们可以知道，对于从 ","type":"formatted"},{"code":true,"text":"[start, end)","type":"formatted"},{"text":" 中间的任一站出发都无法到达 ","type":"formatted"},{"code":true,"text":"end","type":"formatted"},{"text":"，假设从中间的站 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 出发，从 ","type":"formatted"},{"code":true,"text":"start","type":"formatted"},{"text":" 到 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 时一定是有油，身上有油都到不了 ","type":"formatted"},{"code":true,"text":"end","type":"formatted"},{"text":"，更别说身上没油从 ","type":"formatted"},{"code":true,"text":"k","type":"formatted"},{"text":" 出发，更到不了站 ","type":"formatted"},{"code":true,"text":"end","type":"formatted"},{"text":"，通过这种方式可以排除很多的站。","type":"formatted"}],"collabId":"b0a3305d-5125-4477-bf8e-22ace836586a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"function canCompleteCircuit(gas: number[], cost: number[]): number {\n    let start = 0;\n    let step = 0;\n    let leftGas = 0;\n    const n = gas.length;\n    \n    while(start < n) {\n        leftGas += gas[(start + step) % n];\n        leftGas -= cost[(start + step) % n];\n        if (leftGas >= 0) {\n            step++;\n        } else {\n            start += step + 1;\n            step = 0;\n            leftGas = 0;\n            continue;\n        }\n        \n        if (step === n) return start;\n    }\n\n    return -1;\n};","collabId":"4ce9b406-72e0-41b0-9f16-8a7dc68efbca","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e17b0199-a8ec-428a-b91f-b7848fdb1e0d","language":"ts","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"acd09a26-d046-4ba5-9cc7-9bd704563f52"}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"贪心"},{"label":"加油站","target":{"key":"doc:project:47:721","type":"doc","id":721}}],"prevPage":{"title":"罗马数字与数字的转换","target":{"key":"doc:project:47:697","type":"doc","id":697}},"nextPage":{"title":"用最少数量的箭引爆气球","target":{"key":"doc:project:47:723","type":"doc","id":723}},"createTime":1729471371638,"updateTime":1793532544950,"projectId":47},"meta":{"type":"doc","publishTime":1793532544950}}