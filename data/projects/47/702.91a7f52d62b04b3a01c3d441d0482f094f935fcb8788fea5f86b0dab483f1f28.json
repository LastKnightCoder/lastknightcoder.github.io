t":"a_i \\leq a_j","type":"formatted"}],"collabId":"925d8eec-b7e7-4eec-aad7-16a93366871e","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"a_i \\leq a_j","type":"inline-math"},{"text":"，那么不必计算柱 ","type":"formatted"},{"children":[{"text":"(i, a_i)","type":"formatted"}],"collabId":"3b68a4c3-484b-4cb5-9fd4-aae4d8b4d12c","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"(i, a_i)","type":"inline-math"},{"text":" 与其他柱的配对，执行 ","type":"formatted"},{"code":true,"text":"i++","type":"formatted"}],"collabId":"538b2834-fae0-4e91-a826-0b132a24762a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"7701e283-9b27-4677-a85e-77a4b7648eb3","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"如果 ","type":"formatted"},{"children":[{"text":"a_i > a_j","type":"formatted"}],"collabId":"44864d02-1d6c-4366-8c83-18c598a33ae3","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"a_i > a_j","type":"inline-math"},{"text":"，那么不必计算 ","type":"formatted"},{"children":[{"text":"(j, a_j)","type":"formatted"}],"collabId":"9f91576a-9df2-4bb3-8855-3011c583ef77","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"(j, a_j)","type":"inline-math"},{"text":" 与其他柱的配对，执行 ","type":"formatted"},{"code":true,"text":"j--","type":"formatted"}],"collabId":"af7e42f3-1a6f-4b1f-aa15-2739c461853f","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"1a18ff23-dc9a-4aad-aa0c-91f0e0c51881","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"fdd54496-0eb0-44d0-bdf8-12faa6c780ee","tauContract":"3a3b4d6f4d2098952ffe3c6e00baedd170e840beb6fb5fc715467ae5845e0156","type":"numbered-list"},{"children":[{"text":"当 ","type":"formatted"},{"children":[{"text":"i \\geq j","type":"formatted"}],"collabId":"e4113a97-a037-4e1e-81a1-c3b8b2aec92f","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"i \\geq j","type":"inline-math"},{"text":" 时，算法执行结束，此时的最大值即为能够容纳的最大水量。","type":"formatted"}],"collabId":"7e8ae96a-3a7f-4b11-af1f-9d53e8dad057","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"public int maxArea(int[] height) {\n\n    int start = 0;\n    int end = height.length - 1;\n\n    int max= 0;\n    \n    while (start < end) {\n        // 计算两个柱之间能够容纳的水量，如果大于最大值，则更新最大值\n        int s = (end - start) * Math.min(height[start], height[end]);\n        if (max < s) {\n            max = s;\n        }\n        // 如果 a_i <= a_j，则 i++，否则 j--\n        if (height[start] <= height[end]) {\n            start++;\n        } else {\n            end--;\n        }\n    }\n    return max;\n}","collabId":"bb1aacef-59ef-43de-8840-cb36b8b3bd64","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"96211812-f892-4ca4-b88f-2dcc8dfa1f05","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"94eb80ac-ae21-4259-875e-2399bfaf02a3"},{"children":[{"text":"参考","type":"formatted"}],"collabId":"842fa764-c643-4df1-bd71-4b8fc17f86b4","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"盛水最多的容器","type":"formatted"}],"collabId":"9579c12e-64ea-4fc2-855c-88a36ad7ca98","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://leetcode-cn.com/problems/container-with-most-water/submissions/"}],"collabId":"eb68a47a-337e-4e8e-a6f2-2dc0424fc800","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"c7952d67-1be8-40ba-8774-4dface083c78","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"0f0aadb1-2278-4476-bd74-ae987eefc772","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"双指针"},{"label":"盛水最多的容器","target":{"key":"doc:project:47:702","type":"doc","id":702}}],"prevPage":{"title":"删除有序数组中的重复项","target":{"key":"doc:project:47:701","type":"doc","id":701}},"nextPage":{"title":"搜索旋转排序数组II","target":{"key":"doc:project:47:703","type":"doc","id":703}},"createTime":1729001437382,"updateTime":1793532544269,"projectId":47},"meta":{"type":"doc","publishTime":1793532544269}}