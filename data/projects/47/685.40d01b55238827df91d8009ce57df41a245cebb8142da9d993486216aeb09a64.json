,{"type":"formatted","text":" 等不是数组，为了讲解方便使用 "},{"type":"formatted","code":true,"text":"[i]"},{"type":"formatted","text":" 的形式进行索引，实际编程应使用特定的 API 访问，如 "},{"type":"formatted","code":true,"text":"charAt(i)"},{"type":"formatted","text":"。"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"21d89982-53c5-45f3-9b05-02925633a659","children":[{"type":"formatted","text":"所以 "},{"type":"formatted","code":true,"text":"dp[i][j]"},{"type":"formatted","text":" 的递归公式为"}]},{"type":"code-block","language":"java","uuid":"37cf4ddc-6d6c-438d-9e28-563484f3b8ff","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8f6dfd8a-2d6e-401d-9ae2-7679aa192ef3","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"dp[i][j] = (s1[i - 1] == s3[i + j - 1] && dp[i - 1][j]) || (s2[j - 1] == s3[i + j - 1] && dp[i][j - 1])","collabId":"eaf26ca9-fe59-4c13-9450-71a61ad8719e","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"1113d01a-4854-4629-8bc3-353c1b1a3cb3","children":[{"type":"formatted","text":"具体编程时还应考虑 "},{"type":"formatted","code":true,"text":"(i - 1)"},{"type":"formatted","text":" 与 "},{"type":"formatted","code":true,"text":"(j - 1)"},{"type":"formatted","text":" 是否越界，所以上面的程序可以修改为"}]},{"type":"code-block","language":"java","uuid":"c3cddc12-0626-4705-bc47-5a3ac30e2b20","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"17e5fa06-886c-4911-a9af-a595f2fdf975","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"if (i > 0) {\n    dp[i][j] = dp[i][j] || (dp[i - 1][j] && s1.[i - 1] == s3[i + j - 1]);\n}\nif (j > 0) {\n    dp[i][j] = dp[i][j] || (dp[i][j - 1] && s2.[j - 1] == s3.[i + j - 1]);\n}","collabId":"0a7c9436-d35f-46fe-b8bf-979d4846cff0","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"7af081d2-4fd5-408c-b149-6bec0032ed37","children":[{"type":"formatted","text":"完整程序如下"}]},{"type":"code-block","language":"java","uuid":"236a1570-44a9-4cf4-8ebf-f0c08d946cfe","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cf3cd959-c7bf-4548-8e8e-c8c8e0f8f231","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"public boolean isInterleave(String s1, String s2, String s3) {\n    int l1 = s1.length();\n    int l2 = s2.length();\n    int l3 = s3.length();\n    if (l1 + l2 != l3) {\n        return false;\n    }\n    boolean[][] dp = new boolean[l1 + 1][l2 + 1];\n    dp[0][0] = true;\n    for (int i = 0; i <= l1; i++) {\n        for (int j = 0; j <= l2; j++) {\n            if (i > 0) {\n                dp[i][j] = dp[i - 1][j] && s1.charAt(i - 1) == s3.charAt(i + j - 1);\n            }\n            if (j > 0) {\n                dp[i][j] = dp[i][j] || (dp[i][j - 1] && s2.charAt(j - 1) == s3.charAt(i + j - 1));\n            }\n        }\n    }\n    return dp[l1][l2];\n}","collabId":"42a4bb56-ec9a-4a78-862c-b8b6c3da474c","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"52a307a6-1953-4537-92d9-da9dc36c401c","children":[{"type":"formatted","text":"优化：空间压缩"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a6d82fd2-cd4d-4b78-9738-d0540a2eed7c","children":[{"type":"formatted","text":"考虑到 "},{"type":"formatted","code":true,"text":"dp[i][j]"},{"type":"formatted","text":" 每次只用了 "},{"type":"formatted","code":true,"text":"dp[i 