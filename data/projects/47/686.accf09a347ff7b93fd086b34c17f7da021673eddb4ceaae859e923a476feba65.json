Drag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"969b4b76-a26f-40be-b8dd-7505d11be1e1","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"0ae65dfb-c49d-4aec-a001-3a263b5f15c5","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"d1064c09-568a-469e-8a3b-d3025b50d34a","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"这是一道典型的动态规划题目，我们定义 ","type":"formatted"},{"code":true,"text":"dp","type":"formatted"},{"text":" 二维数组，","type":"formatted"},{"code":true,"text":"dp[i][j]","type":"formatted"},{"text":" 表示从 ","type":"formatted"},{"code":true,"text":"start","type":"formatted"},{"text":" 到坐标 ","type":"formatted"},{"code":true,"text":"(i, j)","type":"formatted"},{"text":" 有多少种不同路径，我们可以得到 ","type":"formatted"},{"code":true,"text":"dp[i][j]","type":"formatted"},{"text":" 的更新公式","type":"formatted"}],"collabId":"9acde5f6-5878-4e54-9373-81ea1c96b271","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"","type":"formatted"}],"collabId":"4cf96f20-a9e9-4240-8ad5-027b059997f0","tauContract":"4e356b907f162ad0eb2111e676848e89bc290d4d1bc01f9238aef92a7b5f8861","tex":"dp[i][j] = dp[i][j - 1] + dp[i - 1][j]","type":"block-math"},{"children":[{"text":"即到达 ","type":"formatted"},{"code":true,"text":"(i, j)","type":"formatted"},{"text":" 处的路径数等于到达 ","type":"formatted"},{"code":true,"text":"(i, j - 1)","type":"formatted"},{"text":" (上方) 的路径数加上到达 ","type":"formatted"},{"code":true,"text":"(i - 1, j)","type":"formatted"},{"text":" (左方) 的路径数","type":"formatted"}],"collabId":"8c3b7657-9d4b-44d4-a05d-12ea71fabb74","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"public int uniquePaths(int m, int n) {\n    int[][] dp = new int[m][n];\n    dp[0][0] = 1;\n\n    for (int i = 0; i < m; i++) {\n        for (int j = 0; j < n; j++) {\n            if (i - 1 >= 0) {\n                dp[i][j] += dp[i - 1][j];\n            }\n            if (j - 1 >= 0) {\n                dp[i][j] += dp[i][j - 1];\n            }\n        }\n    }\n\n    return dp[m - 1][n -1];\n}","collabId":"ff422dae-ab30-4810-8c1f-3d4594ba54da","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"4b7f721d-8687-490c-9cc2-318fcdcc8a7d","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"0388703a-d431-45c8-ac08-f7bee58f5703"},{"children":[{"text":"不同路径II","type":"formatted"}],"collabId":"c1b8be2c-aee6-42fe-aae6-c59499d5c21b","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"题目描述","type":"formatted"}],"collabId":"51963ef4-d140-415f-9d1d-fc8d72e105c8","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"一个机器人位于一个 ","type":"formatted"},{"children":[{"text":"m \\times n","type":"formatted"}],"collabId":"864fd9a9-701a-4c74-9b9a-0a02c9d20f22","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"m \\times n","type":"inline-math"},{"text":" 网格的左上角 (起始点在下图中标记为 \"Start\")。机器人每次只能向下或者向右移动一步。机器人试图达到网格的右下角 (在下图中标记为 \"Finish\")。现考虑网格中有障碍物，那么从左上角到右下角将会有多少条不同的路径?","type":"formatted"}],"collabId":"49524642-5c12-4994-bd1c-e2a635a04fbf","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"网格中的障碍物和空位置分别用 1 和 0 来表示。","type":"formatted"}],"collabId":"eb826475-5f1a-4766-b179-cb8706187947","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"示例1：","type":"formatted"}],"collabId":"0e7c28d7-4296-4e1a-8a5a-7af0c9bf7a89","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入：obstacleGrid = [[0,0,0],[0,1,0],[0,0,0]]\n输出：2","collabId":"83d1a8ca-1277-4ac7-980c-79475f714227","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"7bc0d66e-f934-4d76-8fae-beeff13d715f","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"9e8c3578-6037-4d17-ad21-303bba355705"},{"children":[{"text":"示例2：","type":"formatted"}],"collabId":"b480c911-73ce-4307-9c3c-b3e736339ea6","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入：obstacleGrid = [[0,1],[0,0]]\n输出：1","collabId":"b3ee23a1-988e-42b2-88fa-2eb266c19418","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"e63fd706-58d9-496c-bea8-f07c1e8f8875","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"39132075-7c4a-4c05-9613-2ee00247eed8"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"4437c563-f6e6-4480-bbb6-af4cd21ab5fa","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"解题思路同上，对于有障碍物的坐标，我们只需要将其 dp[i][j] = 0 设置为 0 即可","type":"formatted"}],"collabId":"d11b4aee-c6f8-4eab-a172-df3dcba1e62a","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"public int uniquePathsWithObstacles(int[][] obstacleGrid) {\n    int m = obstacleGrid.length;\n    int n = obstacleGrid[0].length;\n    int[][] dp = new int[m][n];\n    if (obstacleGrid[0][0] == 1) {\n        return 0;\n    }\n\n    dp[0][0] = 1;\n    for (int i = 0; i < m; i++) {\n        for (int j = 0; j < n; j++) {\n            if (obstacleGrid[i][j] == 1) {\n                dp[i][j] = 0;\n                continue;\n            }\n            if (i - 1 >= 0) {\n                dp[i][j] += dp[i - 1][j];\n            }\n            if (j - 1 >= 0) {\n                dp[i][j] += dp[i][j - 1];\n            }\n        }\n    }\n\n    return dp[m - 1][n -1];\n}","collabId":"5224f2a2-7e5a-43df-bb58-ef15ef6ec775","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"258f9621-ac24-439e-a837-a05362ba5811","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"be3ae9c6-617a-4821-a201-c40bcede6aff"},{"children":[{"text":"参考链接","type":"formatted"}],"collabId":"a8ad09d9-15c4-4021-8ded-c2af608e25f7","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"children":[{"children":[{"text":"不同路径","type":"formatted"}],"collabId":"bcc20cd8-c76e-44d2-833a-b09f88354714","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","type":"link","url":"https://leetcode-cn.com/problems/unique-paths/"}],"collabId":"cd77ada1-80bd-4551-a2f6-661a18ac0adc","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"d6257595-5aac-4cca-a1cd-59fc55b15785","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"children":[{"text":"不同路径