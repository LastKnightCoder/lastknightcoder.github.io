{"version":1,"key":"doc:project:47:720","content":{"id":720,"title":"除自身以外数组的乘积","content":[{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"d4249a3f-23d1-4bad-9cca-9eb555f6e97c","children":[{"type":"formatted","text":"题目描述"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"358a0241-d043-419c-9ce5-9792bdeb1812","children":[{"type":"formatted","text":"给你一个整数数组 "},{"type":"formatted","code":true,"text":"nums"},{"type":"formatted","text":"，返回 数组 "},{"type":"formatted","code":true,"text":"answer"},{"type":"formatted","text":"，其中 "},{"type":"formatted","code":true,"text":"answer[i]"},{"type":"formatted","text":" 等于 "},{"type":"formatted","code":true,"text":"nums"},{"type":"formatted","text":" 中除 "},{"type":"formatted","code":true,"text":"nums[i]"},{"type":"formatted","text":" 之外其余各元素的乘积 。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a29530d7-5984-4111-801b-e621eb5035aa","children":[{"type":"formatted","text":"题目数据保证数组 "},{"type":"formatted","code":true,"text":"nums"},{"type":"formatted","text":" 之中任意元素的全部前缀元素和后缀的乘积都在 "},{"type":"formatted","code":true,"text":"32"},{"type":"formatted","text":" 位 整数范围内。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"adffebca-bb9a-43d6-8e97-9d523cce914c","children":[{"type":"formatted","text":"请不要使用除法，且在 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(n)","collabId":"9c0c2131-2e5e-43fa-86df-b55ce9d9afb0","children":[{"type":"formatted","text":"O(n)"}]},{"type":"formatted","text":" 时间复杂度内完成此题。"}]},{"type":"detail","title":"示例 1:","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","collabId":"33a4a6ea-b232-4244-9d73-48336fb19393","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8284685d-6dc8-42e3-8517-d1662890e0ef","children":[{"type":"formatted","text":"输入: "},{"type":"formatted","code":true,"text":"nums = [1,2,3,4]"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"38be49fe-3154-468a-90c8-89d4edd6ca48","children":[{"type":"formatted","text":"输出: "},{"type":"formatted","code":true,"text":"[24,12,8,6]"}]}]},{"type":"detail","title":"示例 2:","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","collabId":"40820e6d-4a66-4635-9b35-61900ca750fe","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"8e90f7b9-b381-407f-ad8e-2a4eda6b1119","children":[{"type":"formatted","text":"输入: "},{"type":"formatted","code":true,"text":"nums = [-1,1,0,-3,3]"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"de3267f0-cbd0-4e77-ba77-bd1b3f9c15e5","children":[{"type":"formatted","text":"输出: "},{"type":"formatted","code":true,"text":"[0,0,9,0,0]"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"26e93bb3-2f76-4673-a206-b3519269cc49","children":[{"type":"formatted","text":" 提示："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"f55310a1-ad94-4976-a37c-75cc8fb3e8bb","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"77642873-3692-40c0-adb5-381d26921594","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"805b2947-8cef-43a5-94d3-39977a4b1207","children":[{"type":"formatted","code":true,"text":"2 <= nums.length <= 10^5"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"38d8c7df-e2c7-479f-96f3-55e3b0579f7c","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b7db112e-e07f-4786-8057-19de8125e13c","children":[{"type":"formatted","code":true,"text":"-30 <= nums[i] <= 30"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"402beed2-81cb-47b7-b5ff-dd5477a55fb4","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"19124ddc-0adc-4260-b75f-534c696db4c0","children":[{"type":"formatted","text":"保证数组 "},{"type":"formatted","code":true,"text":"nums"},{"type":"formatted","text":" 之中任意元素的全部前缀元素和后缀的乘积都在 "},{"type":"formatted","code":true,"text":"32"},{"type":"formatted","text":" 位 整数范围内。"}]}]}]},{"type":"highlight-block","color":"red","tauContract":"8d7373dfc1d83f7abd6f07067a85198c9127dba4aebf48d6d59b33956048da37","collabId":"2524a79f-96d4-4bfb-a94e-f91b6ff1ea95","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"45b19b0e-625d-4a5b-af4c-cee51d3a269a","children":[{"type":"formatted","text":"进阶：你可以在 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(1)","collabId":"de91f6ec-dadf-4b0e-9396-456d5504bfc0","children":[{"type":"formatted","text":"O(1)"}]},{"type":"formatted","text":" 的额外空间复杂度内完成这个题目吗？（ 出于对空间复杂度分析的目的，"},{"type":"formatted","bold":true,"text":"输出数组 不被视为额外空间"},{"type":"formatted","text":"。）"}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"f27b3363-c7cd-40b0-9652-b958ff844b1f","children":[{"type":"formatted","text":"解题思路"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"3bdb6079-b7a6-494f-8729-24ef4838857e","children":[{"type":"formatted","text":"除 "},{"type":"formatted","code":true,"text":"nums[i]"},{"type":"formatted","text":" 之外其余各元素的乘积等于它左边所有元素的乘积和右边所有元素的乘积，我们可以使用两个数组 "},{"type":"formatted","code":true,"text":"L"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"R"},{"type":"formatted","text":" 分别表示左边所有元素的乘积和右边所有元素的乘积，可以知道 "},{"type":"formatted","code":true,"text":"L[0] = 1"},{"type":"formatted","text":"，因为第一个元素左边没有元素，同理 "},{"type":"formatted","code":true,"text":"R[n - 1] = 1"},{"type":"formatted","text":"，则 "},{"type":"formatted","code":true,"text":"answer[i] = L[i] * R[i]"}]},{"type":"code-block","language":"ts","uuid":"816b173e-55eb-46cf-bd19-9ad648c508a0","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"ede774b0-bce0-4603-a3b4-0f999b9224fb","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function productExceptSelf(nums: number[]): number[] {\n    const n = nums.length;\n    const L = Array.from({ length: n }).fill(1) as number[];\n    const R = Array.from({ length: n }).fill(1) as number[];\n    const answers = Array.from({ length: n }).fill(1) as number[];\n\n    for (let i = 1; i < n; i++) {\n        L[i] = L[i - 1] * nums[i - 1];\n    }\n\n    for (let j = n - 2; j >=0; j--) {\n        R[j] = R[j + 1] * nums[j + 1];\n    }\n\n    for (let i = 0; i < n; i++) {\n        answers[i] = L[i] * R[i];\n    }\n\n    return answers;\n};","collabId":"12171e2f-9f4b-4f43-b656-347d7ce1f914","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cd12f22f-81c6-4dfb-8c0b-2a3274d510d5","children":[{"type":"formatted","text":"这里创建了两个辅助的数组 "},{"type":"formatted","code":true,"text":"L"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"R"},{"type":"formatted","text":"，空间复杂度为 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"O(n)","collabId":"c2c22398-ac88-4adf-814f-5f8f1a3ee545","children":[{"type":"formatted","text":"O(n)"}]},{"type":"formatted","text":"，其实完全可以利用 "},{"type":"formatted","code":true,"text":"answers"},{"type":"formatted","text":"，先存储 "},{"type":"formatted","code":true,"text":"L"},{"type":"formatted","text":" 的内容，然后倒序乘上右边的值"}]},{"type":"code-block","language":"ts","uuid":"ab8fd00c-cc5b-437b-a930-c03acfe7af59","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"a74b5d67-66e3-4667-8275-c15aaab81f89","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function productExceptSelf(nums: number[]): number[] {\n    const n = nums.length;\n    const answers = Array.from({ length: n }).fill(1) as number[];\n\n    for (let i = 1; i < n; i++) {\n        answers[i] = answers[i - 1] * nums[i - 1];\n    }\n\n    let R = 1;\n    for (let j = n - 1; j >=0; j--) {\n        answers[j] = answers[j] * R;\n        R = R * nums[j];\n    }\n\n    return answers;\n};","collabId":"5b8b0862-0179-4979-8aea-3d3969613179","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a26c7a40-5279-48f7-b223-ca3ff19b3b77","children":[{"type":"formatted","text":"甚至再极致一点，可以在一个循环里面解决，同时进行左右的扫描"}]},{"type":"code-block","language":"ts","uuid":"8d4b5397-ecb1-4d86-8f1c-1d13a6b444e7","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"c6f1b768-4a9d-4991-9369-12904bb7f744","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function productExceptSelf(nums: number[]): number[] {\n  \tconst n = nums.length;\n    const answers = Array.from({ length: n }).fill(1) as number[];\n  \n  \tlet L = 1;\n    let R = 1;\n    for (let i = 0, j = nums.length - 1; i < nums.length && j >=0; i++, j--) {\n        answers[i] = answers[i] * L;\n        answers[j] = answers[j] * R;\n        L = L * nums[i];\n        R = R * nums[j];\n    }\n\n    return answers;\n};","collabId":"670b3cf2-2686-42f5-8952-a567700b344b","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"c6e016a9-6d87-4a97-95e9-9153bb8e6d6f","children":[{"type":"formatted","text":"参考"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"11dfcd78-60e7-41c6-b769-e2486307124f","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"76771329-41fb-44c5-a697-b1fe072f6d90","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dfaaca93-38a1-44a1-ab77-bbbc83345dfc","children":[{"type":"link","url":"https://leetcode.cn/problems/product-of-array-except-self/description/?envType=study-plan-v2&envId=top-interview-150","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"01f9d9ab-1c14-4964-8e79-e93896ccd1cb","children":[{"type":"formatted","text":"除自身以外数组的乘积"}]}]}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"数组"},{"label":"除自身以外数组的乘积","target":{"key":"doc:project:47:720","type":"doc","id":720}}],"prevPage":{"title":"多数元素","target":{"key":"doc:project:47:718","type":"doc","id":718}},"nextPage":{"title":"包含 min 函数的栈","target":{"key":"doc:project:47:674","type":"doc","id":674}},"createTime":1729164158046,"updateTime":1743303640582,"projectId":47},"meta":{"type":"doc","publishTime":1743303640582}}