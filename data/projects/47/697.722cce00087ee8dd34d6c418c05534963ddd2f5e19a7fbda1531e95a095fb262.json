d","text":"1"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"d6a8cf1a-363f-4e40-9f75-6d309e7865bf","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"6084f8ee-bb50-4658-8d1b-6255320b10e4","children":[{"type":"formatted","text":"V"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"99003e7c-cf0f-413a-8528-6d1079f0681e","children":[{"type":"formatted","text":"5"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"61dd189e-de6e-41d5-bfd9-5c22a0613869","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"be05ead2-e2e7-47d2-8b00-f21b1bf60352","children":[{"type":"formatted","text":"X"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"a664c10c-ef5a-4d11-83b3-d5390e388a4b","children":[{"type":"formatted","text":"10"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"c9a1d89f-8cce-442e-b4a5-6a15e4165d6d","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"4985baf7-4d42-4a74-a3fe-e6aff140c9b8","children":[{"type":"formatted","text":"L"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"7f2e0b40-cd47-44a0-95fe-ff0a261b61b4","children":[{"type":"formatted","text":"50"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"b3be90ae-82ad-4cee-9261-ec1cbb10f6db","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"53fb1c1d-eb16-4b21-b53a-2233d6742659","children":[{"type":"formatted","text":"C"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"bc86ee66-e863-4064-956d-76ebbb0ae00d","children":[{"type":"formatted","text":"100"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"08b353f4-3e96-4927-8f4c-0c42b14409e5","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"fc1d3b10-6324-4466-882a-7204551e184f","children":[{"type":"formatted","text":"D"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"25f0d918-c2dc-463b-a336-4e8fd7952a71","children":[{"type":"formatted","text":"500"}]}]},{"type":"table-row","tauContract":"e0390883f5755ceda18769fa110bf264bee6f2391ac403aab2a5f429a086d8ce","collabId":"cbd62d78-4a9d-4757-900a-8d7be2253db2","children":[{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"0bb78459-1253-4850-9888-757684c7ec9f","children":[{"type":"formatted","text":"M"}]},{"type":"table-cell","tauContract":"033eeb00612c0b64d6796a4338e43503442ebcdf1d13aa5fb6bcac9f49abfc20","collabId":"33c4235a-6bb0-4097-a2d6-d41de895033f","children":[{"type":"formatted","text":"1000"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"91aa5e29-1175-435c-acae-a3e75ca51768","children":[{"type":"formatted","text":"例如， 罗马数字 2 写做 II ，即为两个并列的 1。12 写做 XII ，即为 X + II 。 27 写做 XXVII, 即为 XX + V + II 。通常情况下，罗马数字中小的数字在大的数字的右边。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f0ff1454-695f-4359-99db-211273a4e69c","children":[{"type":"formatted","text":"但也存在特例，例如 4 不写做 IIII，而是 IV。数字 1 在数字 5 的左边，所表示的数等于大数 5 减小数 1 得到的数值 4 。同样地，数字 9 表示为 IX。这个特殊的规则只适用于以下六种情况："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"06f55db2-f599-4fe9-94fe-e8ee9573f537","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"4e25e765-b6ad-4f61-9631-0ed62ae670a2","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"683e72e8-50a6-4b1c-a569-a23a361be49e","children":[{"type":"formatted","text":"I 可以放在 V (5) 和 X (10) 的左边，来表示 4 和 9。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"e8f0d97d-6549-4433-886d-fdbddda0baf6","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"15b8a1b4-aa68-499b-932d-9612f5527e1d","children":[{"type":"formatted","text":"X 可以放在 L (50) 和 C (100) 的左边，来表示 40 和 90。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f1aecb4e-7832-457d-8b42-87dfaacd537f","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"6f3b1ef0-a6b9-4427-887b-1637087174e4","children":[{"type":"formatted","text":"C 可以放在 D (500) 和 M (1000) 的左边，来表示 400 和 900。"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"77ae9c61-bdc9-44f3-8b96-8a6b09a81d73","children":[{"type":"formatted","text":"给定一个整数，将其转为罗马数字，输入确保在 1 到 3999 的范围内。"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"08884d14-115d-45bb-b761-a6f24722dc42","children":[{"type":"formatted","text":"解题思路"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"bcb86f0a-8184-42da-bd19-2c8313b06b00","children":[{"type":"formatted","text":"将罗马数字在每个位置的所有可能的取值列出，例如对于个位有如下情况"}]},{"type":"code-block","language":"java","uuid":"a0dbf785-de57-4068-bc21-aa180c9ee741","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"8bdd6453-4dfa-4684-9d27-6ae323d6e4de","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"\"\", \"I\", \"II\", \"III\", \"IV\", \"V\", \"VI\", \"VII\", \"VIII\", \"IX\"","collabId":"ce086197-dce1-449a-b3cf-de6aceac5114","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a449bc79-cac8-4ae9-8abb-802e42bd29df","children":[{"type":"formatted","text":"以上字符分别对应 0-9，然后取出个位的数字，根据数字的大小选择对应的字符，接着取出十位上的数字，找到对应的字符，以此类推"}]},{"type":"code-block","language":"java","uuid":"2fef4990-1ad3-4724-954c-e0105ed7c141","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"b8a5e1f7-1814-4c6a-b29e-e4a0495ec6de","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"import java.util.Stack;\n\npublic class Solution {\n    public String intToRoman(int num) {\n        // 列出每个位置的所有情况\n        String[][] maps = new String[4][];\n        maps[0] = new String[]{\"\", \"I\", \"II\", \"III\", \"IV\", \"V\", \"VI\", \"VII\", \"VIII\", \"IX\"};\n        maps[1] = new String[]{\"\", \"X\", \"XX\", \"XXX\", \"XL\", \"L\", \"LX\", \"LXX\", \"LXXX\", \"XC\"};\n        maps[2] = new String[]{\"\", \"C\", \"CC\", \"CCC\", \"CD\", \"D\", \"DC\", \"DCC\", \"DCCC\", \"CM\"};\n        // 题目规定数字范围在 1-3999，所以这里列到 3000 即可\n        maps[3] = new String[]{\"\", \"M\", \"MM\", \"MMM\"};\n\n        StringBuilder stringBuilder = new StringBuilder();\n        Stack<String> stack = new Stack();\n        // 依次取出个位，十位 ...\n        int index = 0;\n        while (num != 0) {\n            int n = num % 10;\n            num /= 10;\n            stack.push(maps[index][n]);\n            index++;\n        }\n\n        while (!stack.isEmpty()) {\n            stringBuilder.append(stack.pop());\n        }\n\n        return stringBuilder.toString();\n    }\n}","collabId":"73aeae37-4ccc-4a69-866c-905c3642dc94","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"4044c291-6224-4cfb-994b-a9cf4668aad3","children":[{"type":"formatted","text":"另一种思路是贪心法，想想我们是怎么找零钱的，每次都找面值最大的，我们找 154 元，我们首先找面值最大的 100 块，然后剩 54，接着找面值最大的 50，剩 4 元，找 4 个硬币。"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cb4ed2f2-89b9-44c0-82c2-84f693ca67f2","children":[{"type":"formatted","text":"如果我们把要转化的数字看做是要找的零钱，罗马数字就是对应的钞票，我们把罗马数字对应的钞票有多种情况列出来，然后按照找零钱的规则找钱即可"}]},{"type":"code-block","language":"java","uuid":"400eb376-c908-4b13-a0cd-1737935a4389","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"78677559-d02e-4a9f-8cfe-a52aa61479c7","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"import java.util.Stack;\n\npublic class Solution {\n    public String intToRoman(int num) {\n        // 罗马\"钞票\"的面值大小依次排列\n        int[] nums = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};\n        String[] roma = {\"M\", \"CM\", \"D\", \"CD\", \"C\", \"XC\", \"L\", \"XL\", \"X\", \"IX\", \"V\", \"IV\", \"I\"};\n        int index = 0;\n        StringBuilder stringBuilder = new StringBuilder();\n        while (num != 0) {\n            // 使用目前最大的面值\n            if (num >= nums[index]) {\n                stringBuilder.append(roma[index]);\n                num -= nums[index];\n                continue;\n            }\n            index++;\n        }\n\n        return stringBuilder.toString();\n    }\n}","collabId":"804d97c2-3756-4e7e-9740-0ee7f518aaaf","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"fcedfaf4-5726-4a69-bb5c-d73026020079","children":[{"type":"formatted","text":"数字转罗马数字"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"a05169a8-c972-42e6-943f-f216dc401138","children":[{"type":"formatted","text":"题目描述"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c7943242-9f6a-4b76-91b1-1e174e5d5977","children":[{"type":"formatted","text":"罗马数字与数字的转换规则如上题介绍，这道题的要求是将罗马数字转化为数字。"}]},{"type":"header","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"40952251-fda2-4210-bad3-6c257d64f58d","children":[{"type":"formatted","text":"解题思路"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0974da0e-d142-4198-8db2-c258c4471b8b","children":[{"type":"formatted","text":"如果还是将罗马数字看做钞票，将其转化为数字的过程，不就是相当于数钱吗！将钞票转化为对应的数值，然后加起来即可"}]},{"type":"code-block","language":"java","uuid":"67a6c924-5d87-41c6-b938-2ad35e47be59","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"fff2c8ed-9a5b-47e6-9ca3-d35e96dab774","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"public class Solution {\n    public int romanToInt(String s) {\n        // 为了处理方便，将两位的罗马数字转为一位的字符\n        s = s.replace(\"IV\", \"a\");\n        s = s.replace(\"IX\", \"b\");\n        s = s.replace(\"XL\", \"c\");\n        s = s.replace(\"XC\", \"d\");\n        s = s.replace(\"CD\", \"e\");\n        s = s.replace(\"CM\", \"f\");\n        \n        int sum = 0;\n        // 将罗马数字对应的数值加起来即可\n        for (char c: s.toCharArray()) {\n            sum += romaToNum(c);\n        }\n        \n        return sum;\n    }\n    \n    // 罗马数字对应的数值\n    private int romaToNum(char c) {\n        switch (c) {\n            case 'I' : return 1;\n            case 'V': return 5;\n            case 'X': return 10;\n            case 'L': return 50;\n            case 'C': return 100;\n            case 'D': return 500;\n            case 'M': return 1000;\n            case 'a': return 4;\n            case 'b': return 9;\n            case 'c': return 40;\n            case 'd': return 90;\n            case 'e': return 400;\n            case 'f': return 900;\n            default: return 0;\n        }\n    }\n}","collabId":"f855677a-fcba-4183-8cad-400faa851b0c","children":[{"type":"formatted","text":""}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c9da640b-f6ce-4291-abf9-68b48f28738b","children":[{"type":"formatted","text":"还有一种编程的思路，与上面的贪心法一样，直接检查最大的钞票，然后一直加起来"}]},{"type":"code-block","language":"java","uuid":"7b21cab5-c8e0-4a9c-b8be-fb76ce56f368","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"cdeb8802-c60b-4e7c-8942-6eb306907956","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"public class Solution {\n    public int romanToInt(String s) {\n        int[] nums = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};\n        String[] roma = {\"M\", \"CM\", \"D\", \"CD\", \"C\", \"XC\", \"L\", \"XL\", \"X\", \"IX\", \"V\", \"IV\", \"I\"};\n        int index = 0;\n        int sum = 0;\n        while (!\"\".equals(s)) {\n            // 依次查找开头的最大钞票，然后加起来\n            if (s.startsWith(roma[index])) {\n                sum += nums[index];\n                s = s.substring(roma[index].length());\n                continue;\n            }\n            index++;\n        }\n        return sum;\n    }\n}","collabId":"cf05f1bb-01ac-4df0-85ec-76d7ec2b9ed5","children":[{"type":"formatted","text":""}]}]},{"type":"header","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"59e39270-b7f8-445e-8c8a-e6fb2e99ee45","children":[{"type":"formatted","text":"参考"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"692af733-521d-4af7-8ba3-4a642cfec920","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"551b0965-f77b-4f71-a6f8-c0c388e516ad","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0d0a1ce7-5880-4313-87d6-55537d8ce88b","children":[{"type":"link","url":"https://leetcode-cn.com/problems/integer-to-roman/","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"1d297147-11f4-4475-86ba-f076c7dd72cd","children":[{"type":"formatted","text":"整数转罗马数字"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f9623edf-f35e-4025-9a80-1e3df67779b5","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"72d52d7c-b6b5-4f7d-bde9-64ccd5f615a4","children":[{"type":"link","url":"https://leetcode-cn.com/problems/roman-to-integer/","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"46bd370b-a73e-43de-ab1e-fe92b0e0dc28","children":[{"type":"formatted","text":"罗马数字转整数"}]}]}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"贪心"},{"label":"罗马数字与数字的转换","target":{"key":"doc:project:47:697","type":"doc","id":697}}],"prevPage":{"title":"矩阵中的最长递增路径","target":{"key":"doc:project:47:727","type":"doc","id":727}},"nextPage":{"title":"加油站","target":{"key":"doc:project:47:721","type":"doc","id":721}},"createTime":1729000848726,"updateTime":1744296829332,"projectId":47},"meta":{"type":"doc","publishTime":1744296829332}}