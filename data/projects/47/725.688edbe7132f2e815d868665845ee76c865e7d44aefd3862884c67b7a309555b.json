]}]},{"type":"detail","title":"示例2","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","collabId":"f0287fa9-6599-457d-9ca4-938392e8b727","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f65e1ef5-7798-45bd-9593-f907ed5a6d05","children":[{"type":"formatted","text":"输入：root = [3,5,1,6,2,0,8,null,null,7,4], p = 5, q = 4"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0f48c0f4-7da3-4a2b-bb01-b90b8970ac2c","children":[{"type":"formatted","text":"输出：5"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"c27d23f4-fcde-49ec-83ca-7cf2bb9cef4b","children":[{"type":"formatted","text":"解释：节点 5 和节点 4 的最近公共祖先是节点 5 。因为根据定义最近公共祖先节点可以为节点本身"}]}]},{"type":"detail","title":"示例3","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","collabId":"6ae08cc5-3748-470c-ba60-7765c6981373","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5039c4d6-7c3f-4f84-9cdc-79d84f22106c","children":[{"type":"formatted","text":"输入：root = [1,2], p = 1, q = 2"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"959f9ea9-90a4-4e7c-b479-7a460b0a1e4d","children":[{"type":"formatted","text":"输出：1"}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"f3f82209-6013-4a60-922e-84e64e075594","children":[{"type":"formatted","text":"提示："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"e0271a72-dce4-4ed5-b012-af06ae666baf","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"7d0e7d01-5bbe-4727-aae6-de2a738ccd9a","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"dcb6c193-1f82-40ce-b740-f5b1b26ae39d","children":[{"type":"formatted","text":"树中节点数目在范围 "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"[2, 10^5]","collabId":"3d090b8e-c585-46df-b57b-7af897c0db03","children":[{"type":"formatted","text":"[2, 10^5]"}]},{"type":"formatted","text":" 内。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"46474bd6-d6fd-45b0-9e42-039729179550","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"e7a1cb1a-6f56-44c9-90e1-a7f05436a100","children":[{"type":"formatted","text":"﻿"},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"-10^9","collabId":"5347406b-6d14-44d6-8b66-960f37494c32","children":[{"type":"formatted","text":"-10^9"}]},{"type":"formatted","text":" <= "},{"type":"formatted","code":true,"text":"Node.val"},{"type":"formatted","text":" <= "},{"type":"inline-math","tauContract":"346edd25ec1d096575893afc0b9283d5c97b9a3d922ffaebf10ce904509beedc","tex":"10^9","collabId":"e37faaaa-7b77-4f8c-8ec7-b251a6b593e5","children":[{"type":"formatted","text":"10^9"}]},{"type":"formatted","text":"﻿"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"f4ba7c0d-92b0-4f36-95ec-512bfb06c704","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"0746efc9-24e3-493d-9ba4-2e60f8e76e2c","children":[{"type":"formatted","text":"所有 Node.val 互不相同 。"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"17d6be32-dcf8-4b46-9f84-de9920dc4572","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"b0882bd3-0b70-4d9e-acb0-e94b4f0564ab","children":[{"type":"formatted","code":true,"text":"p != q"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"9fc4296b-a379-4fb6-abb1-d34a42048f41","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"bdfa2efa-5b83-4bd5-b1af-7862fea7034f","children":[{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":" 和 "},{"type":"formatted","code":true,"text":"q"},{"type":"formatted","text":" 均存在于给定的二叉树中。"}]}]}]},{"type":"header","disableDrag":false,"level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"0e71f022-2166-48bc-864f-b853bd3bfe1b","children":[{"type":"formatted","text":"解题思路"}]},{"type":"header","disableDrag":false,"level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"396968f8-29ba-4f35-b576-eba9ae2a64bd","children":[{"type":"formatted","text":"收集父节点的路径"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"30026d46-f92f-407e-9c48-f9bc2f6050ac","children":[{"type":"formatted","text":"遍历树，并使用 "},{"type":"formatted","code":true,"text":"Map"},{"type":"formatted","text":" 存储节点和节点的父节点的关系，从 "},{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":" 开始收集所有的父元素路径存储在一个 "},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 中，接着从 "},{"type":"formatted","code":true,"text":"q"},{"type":"formatted","text":" 开始收集父元素，判断是否在 "},{"type":"formatted","code":true,"text":"Set"},{"type":"formatted","text":" 中，第一个在的就是最近公共祖先。"}]},{"type":"code-block","language":"TypeScript","uuid":"58673284-2725-4293-9983-d367a2df263b","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"6ceb62e6-c9da-43c7-8a84-9bb802d9caac","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function lowestCommonAncestor(root: TreeNode | null, p: TreeNode | null, q: TreeNode | null): TreeNode | null {\n\tif (root === null) return null;\n  const map = new Map<TreeNode, TreeNode>();\n  dfs(root, map);\n  const set = new Set<TreeNode>();\n  while(p) {\n    set.add(p);\n    p = map.get(p);\n  }\n\n  while(q) {\n    if (set.has(q)) {\n      return q;\n    }\n    q = map.get(q);\n  }\n\n  return null;\n};\n\nconst dfs = (root:TreeNode | null, map: Map<TreeNode, TreeNode>) => {\n  if (!root) return;\n  if (root.left) {\n    map.set(root.left, root);\n    dfs(root.left, map);\n  }\n  if (root.right) {\n    map.set(root.right, root);\n    dfs(root.right, map);\n  }\n}","collabId":"17528a4e-d74b-4d4f-ab45-d7a4e332d9cd","children":[{"type":"formatted","text":""}]}]},{"type":"header","disableDrag":false,"level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"381e6ce8-f1aa-4a70-9c2b-2ec4b643b159","children":[{"type":"formatted","text":"递归"}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"57a3b6dd-8a65-4655-add8-274c7018064d","children":[{"type":"formatted","text":"需要重新定义下 "},{"type":"formatted","code":true,"text":"lowestCommonAncestor"},{"type":"formatted","text":" 的语义，"},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","text":"如果该树中存在 "},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","code":true,"text":"p"},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","text":", "},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","code":true,"text":"q"},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","text":" 则返回最近公共祖先，如果只有一个存在则返回对应的节点，都不存在返回 "},{"type":"formatted","bold":true,"color":"#e33a32","darkColor":"#fa7873","code":true,"text":"null"},{"type":"formatted","text":"，因为题目保证了一定存在公共祖先，因此该返回的就是最近公共祖先，对子树递归结果的处理分为三种情况："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"3d0e5544-10da-4a10-b8c6-cc1e1781758f","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"d86c96b5-b471-4879-afbe-485e4a513318","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"ca0866cd-160a-4ee2-b07b-d10f3e003159","children":[{"type":"formatted","text":"如果左右子树都返回值，说明值分别在两颗子树中，则返回 "},{"type":"formatted","code":true,"text":"root"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"c16494ff-e41f-4ec3-b443-b04bf7fef137","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"998d6416-1bcb-4ff6-aa59-e1bf2f95e343","children":[{"type":"formatted","text":"如果只有左子树有值，全在左子树中，返回左子树"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"035b9808-bdfa-49cd-9dda-d1ba35329d02","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"46dc2252-2721-4967-a81b-5f91a3fbf7d3","children":[{"type":"formatted","text":"如果只有右子树有值，全在右子树中，返回右子树"}]}]}]},{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"5425e9cd-b2c6-4f37-b168-9b5cdb73ad5f","children":[{"type":"formatted","text":"什么时候终止递归呢？当 "},{"type":"formatted","code":true,"text":"root"},{"type":"formatted","text":" 是 "},{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":" 或 "},{"type":"formatted","code":true,"text":"q"},{"type":"formatted","text":" 的时候，假设 "},{"type":"formatted","code":true,"text":"root === p"},{"type":"formatted","text":"，分为两种情况："}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"b58b37e2-0592-4181-8115-e88bdab5361e","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"82a1c77b-4af7-4aa2-abb4-15f4a10ffc89","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"40ba2590-ef22-4be1-8e5d-1cac6389650c","children":[{"type":"formatted","code":true,"text":"q"},{"type":"formatted","text":" 不在树中，根据函数含义，应当返回 "},{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":"，即 "},{"type":"formatted","code":true,"text":"root"}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"646a8e23-1d8a-4516-929e-f27cc12d87de","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"cf48db3d-4333-409b-a187-5cb4a012baf8","children":[{"type":"formatted","code":true,"text":"q"},{"type":"formatted","text":" 在树中，那么 "},{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":" 本身就是二者的最近公共祖先，返回 "},{"type":"formatted","code":true,"text":"p"},{"type":"formatted","text":"，即 "},{"type":"formatted","code":true,"text":"root"}]}]}]},{"type":"code-block","language":"TypeScript","uuid":"fb7617e6-46df-4a2d-b27d-9d5310026497","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","collabId":"df8c611b-1ef3-4176-af0c-153454d7529b","children":[{"type":"code-step","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","code":"function lowestCommonAncestor(root: TreeNode | null, p: TreeNode | null, q: TreeNode | null): TreeNode | null {\n\tif (root === null) return null;\n  if (p === root || q === root) return root;\n  const left = lowestCommonAncestor(root.left, p, q);\n  const right = lowestCommonAncestor(root.right, p, q);\n  if (left && right) return root;\n  if (left) return left;\n  if (right) return right;\n\n  return null;\n};","collabId":"f0ed60c3-599c-46f9-b2a4-db87938f43b5","children":[{"type":"formatted","text":""}]}]},{"type":"header","disableDrag":false,"level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","collabId":"679f3afc-ec8c-4907-9ae4-c3fbf55f207d","children":[{"type":"formatted","text":"参考"}]},{"type":"bulleted-list","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","collabId":"472ac10e-308b-40d4-9288-6b2291f4268e","children":[{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"3e39aac0-c89c-4a96-a36b-20eb281a8538","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"46738d27-b0ea-4919-a20a-5caf36290694","children":[{"type":"link","url":"https://leetcode.cn/problems/lowest-common-ancestor-of-a-binary-tree/description/","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"9f3e0e62-ea31-4009-bf3a-c8d5d214786b","children":[{"type":"formatted","text":"236. 二叉树的最近公共祖先"}]}]}]},{"type":"list-item","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","collabId":"5bb056e2-984d-48ba-8ee9-52cc6861f928","children":[{"type":"paragraph","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","collabId":"a42e3522-503f-40db-a96f-4e558ed5cc25","children":[{"type":"link","url":"https://leetcode.cn/problems/lowest-common-ancestor-of-a-binary-tree/solutions/238552/er-cha-shu-de-zui-jin-gong-gong-zu-xian-by-leetc-2/comments/2386858/","openEdit":false,"tauContract":"ebf1d56e356279ad64279a16e90d9b28280f70eac20d5071950fc0c4b5c364a6","collabId":"3aada1b7-db7e-4537-afc4-dba3864b6af3","children":[{"type":"formatted","text":"题解及评论"}]}]}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"树"},{"label":"二叉树的最近公共祖先","target":{"key":"doc:project:47:725","type":"doc","id":725}}],"prevPage":{"title":"不同的二叉搜索树","target":{"key":"doc:project:47:677","type":"doc","id":677}},"nextPage":{"title":"简化路径","target":{"key":"doc:project:47:694","type":"doc","id":694}},"createTime":1744808078912,"updateTime":1744859589133,"projectId":47},"meta":{"type":"doc","publishTime":1744859589133}}