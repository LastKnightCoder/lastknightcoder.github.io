rue},{"type":"formatted","text":" 连接。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"示例1:"}],"disableDrag":false},{"type":"code-block","code":"输入：s1 = \"aabcc\", s2 = \"dbbca\", s3 = \"aadbbcbcac\"\n输出：true","language":"java","uuid":"31c886ae-63bd-42d5-99f2-af7859356675","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"示例2:"}],"disableDrag":false},{"type":"code-block","code":"输入：s1 = \"aabcc\", s2 = \"dbbca\", s3 = \"aadbbbaccc\"\n输出：false","language":"java","uuid":"2ce9d6ae-fc27-418b-afae-d7e91a51cfe8","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"解题思路"}],"level":2},{"type":"header","children":[{"type":"formatted","text":"动态规划"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"我们定义一个函数 "},{"type":"formatted","text":"dp[i, j]","code":true},{"type":"formatted","text":" 表示 "},{"type":"formatted","text":"s1","code":true},{"type":"formatted","text":" 的前 "},{"type":"formatted","text":"i","code":true},{"type":"formatted","text":" 个字符与 "},{"type":"formatted","text":"s2","code":true},{"type":"formatted","text":" 的前 "},{"type":"formatted","text":"j","code":true},{"type":"formatted","text":" 个字符能否形成 "},{"type":"formatted","text":"s3","code":true},{"type":"formatted","text":" 前 "},{"type":"formatted","text":"i + j","code":true},{"type":"formatted","text":" 个字符所示交错字符串，定义 "},{"type":"formatted","text":"l1","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"s1","code":true},{"type":"formatted","text":" 的长度，"},{"type":"formatted","text":"l2","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"s2","code":true},{"type":"formatted","text":" 的长度，则原问题结果为求解 "},{"type":"formatted","text":"dp[l1][l2]","code":true},{"type":"formatted","text":" 的值。"}],"disableDrag":false},{"type":"paragraph","children":[{"type":"formatted","text":"而 "},{"type":"formatted","text":"dp[i][j]","code":true},{"type":"formatted","text":" 的取值可如下确定"}],"disableDrag":false},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果 "},{"type":"formatted","text":"s1[i - 1] == s3[i + j - 1]","code":true},{"type":"formatted","text":" 并且 "},{"type":"formatted","text":"dp[i - 1][j]","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"true","code":true},{"type":"formatted","text":"，则 "},{"type":"formatted","text":"dp[i][j] ","code":true},{"type":"formatted","text":"为 "},{"type":"formatted","text":"true","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"如果 "},{"type":"formatted","text":"s2[j - 1] == s3[i + j - 1]","code":true},{"type":"formatted","text":" 并且 "},{"type":"formatted","text":"dp[i][j - 1]","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"true","code":true},{"type":"formatted","text":"，则 "},{"type":"formatted","text":"dp[i][j]","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"true","code":true}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"type":"formatted","text":"否则 "},{"type":"formatted","text":"dp[i][j]","code":true},{"type":"formatted","text":" 为 "},{"type":"formatted","text":"false","code":true}],"disableDrag":false}]}]},{"type":"callout","calloutType":"note","title":"","children":[{"type":"paragraph","children":[{"type":"formatted","text":"注：编程中字符的索引从 "},{"type":"formatted","text":"0","code":true},{"type":"formatted","text":" 开始，所以 "},{"type":"formatted","text":"i - 1","code":true},{"type":"formatted","text":" 表示第 "},{"type":"formatted","text":"i","code":true},{"type":"formatted","text":" 个字符，另 "},{"type":"formatted","text":"s1","code":true},{"type":"formatted","text":" 等不是数组，为了讲解方便使用 "},{"type":"formatted","text":"[i]","code":true},{"type":"formatted","text":" 的形式进行索引，实际编程应使用特定的 API 访问，如 "},{"type":"formatted","text":"charAt(i)","code":true},{"type":"formatted","text":"。"}],"disableDrag":false}]},{"type":"paragraph","children":[{"type":"formatted","text":"所以 "},{"type":"formatted","text":"dp[i][j]","code":true},{"type":"formatted","text":" 的递归公式为"}],"disableDrag":false},{"type":"code-block","code":"dp[i][j] = (s1[i - 1] == s3[i + j - 1] && dp[i - 1][j]) || (s2[j - 1] == s3[i + j - 1] && dp[i][j - 1])","language":"java","uuid":"37cf4ddc-6d6c-438d-9e28-563484f3b8ff","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"具体编程时还应考虑 "},{"type":"formatted","text":"(i - 1)","code":true},{"type":"formatted","text":" 与 "},{"type":"formatted","text":"(j - 1)","code":true},{"type":"formatted","text":" 是否越界，所以上面的程序可以修改为"}],"disableDrag":false},{"type":"code-block","code":"if (i > 0) {\n    dp[i][j] = dp[i][j] || (dp[i - 1][j] && s1.[i - 1] == s3[i + j - 1]);\n}\nif (j > 0) {\n    dp[i][j] = dp[i][j] || (dp[i][j - 1] && s2.[j - 1] == s3.[i + j - 1]);\n}","language":"java","uuid":"c3cddc12-0626-4705-bc47-5a3ac30e2b20","children":[{"type":"formatted","text":""}]},{"type":"paragraph","children":[{"type":"formatted","text":"完整程序如下"}],"disableDrag":false},{"type":"code-block","code":"public boolean isInterleave(String s1, String s2, String s3) {\n    int l1 = s1.length();\n    int l2 = s2.length();\n    int l3 = s3.length();\n    if (l1 + l2 != l3) {\n        return false;\n    }\n    boolean[][] dp = new boolean[l1 + 1][l2 + 1];\n    dp[0][0] = true;\n    for (int i = 0; i <= l1; i++) {\n        for (int j = 0; j <= l2; j++) {\n            if (i > 0) {\n                dp[i][j] = dp[i - 1][j] && s1.charAt(i - 1) == s3.charAt(i + j - 1);\n            }\n            if (j > 0) {\n                dp[i][j] = dp[i][j] || (dp[i][j - 1] && s2.charAt(j - 1) == s3.charAt(i + j - 1));\n            }\n        }\n    }\n    return dp[l1][l2];\n}","language":"java","uuid":"236a1570-44a9-4cf4-8ebf-f0c08d946cfe","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"优化：空间压缩"}],"level":3},{"type":"paragraph","children":[{"type":"formatted","text":"考虑到 "},{"type":"formatted","text":"dp[i][j]","code":true},{"type":"formatted","text":" 每次只用了 "},{"type":"formatted","text":"dp[i - 1]","code":true},{"type":"formatted","text":" 这上一层的数据，因此我们没有必要使用一个二维数组保存状态，使用一个一维数组即可，修改上面的程序如下"}],"disableDrag":false},{"type":"code-block","code":"public boolean isInterleave(String s1, String s2, String s3) {\n    int l1 = s1.length();\n    int l2 = s2.length();\n    int l3 = s3.length();\n    if (l1 + l2 != l3) {\n        return false;\n    }\n    boolean[] dp = new boolean[l2 + 1];\n    dp[0] = true;\n    for (int i = 0; i <= l1; i++) {\n        for (int j = 0; j <= l2; j++) {\n            if (i > 0) {\n                dp[j] = dp[j] && s1.charAt(i - 1) == s3.charAt(i + j - 1);\n            }\n            if (j > 0) {\n                dp[j] = dp[j] || (dp[j - 1] && s2.charAt(j - 1) == s3.charAt(i + j - 1));\n            }\n        }\n    }\n    return dp[l2];\n}","language":"java","uuid":"0b67dea0-777e-4bd7-bd24-cd05a75cb605","children":[{"type":"formatted","text":""}]},{"type":"header","children":[{"type":"formatted","text":"参考"}],"level":2},{"type":"bulleted-list","children":[{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://leetcode-cn.com/problems/interleaving-string/","openEdit":false,"children":[{"type":"formatted","text":"交错的字符串"}]},{"text":"","type":"formatted"}],"disableDrag":false}]},{"type":"list-item","children":[{"type":"paragraph","children":[{"text":"","type":"formatted"},{"type":"link","url":"https://leetcode-cn.com/problems/interleaving-string/solution/jiao-cuo-zi-fu-chuan-by-leetcode-solution/","openEdit":false,"children":[{"type":"formatted","text":"官方题解"}]},{"text":"","type":"formatted"}],"disableDrag":false}]}]}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project: