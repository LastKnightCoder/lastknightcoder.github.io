{"version":1,"key":"doc:project:47:710","content":{"id":710,"title":"组合总数","content":[{"children":[{"text":"组合总数","type":"formatted"}],"collabId":"b1752070-ed52-400d-a7fc-f6f9effe8d09","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"题目描述","type":"formatted"}],"collabId":"5f82afa4-0344-4d00-80fb-c91328493d26","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"给定一个无重复元素的数组 candidates 和一个目标数 target ，找出 candidates 中所有可以使数字和为 target 的组合。","type":"formatted"},{"bold":true,"color":"#6425d0","darkColor":"#a472fc","text":"candidates 中的数字可以无限制重复被选取","type":"formatted"},{"color":"#6425d0","darkColor":"#a472fc","text":"。","type":"formatted"}],"collabId":"8aa13040-e25b-42a3-9efe-776ad300ceb9","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"说明：","type":"formatted"}],"collabId":"34bbd596-2f99-49f1-a3fe-f02cf0abe742","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"children":[{"text":"所有数字 (包括 target) 都是正整数。","type":"formatted"}],"collabId":"be45474b-5a26-4524-86b7-46ff33720320","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"bc51bc3b-a154-4e24-bb11-654bca39ffbc","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"},{"children":[{"children":[{"text":"解集不能包含重复的组合。","type":"formatted"}],"collabId":"42fabf46-e35a-4376-a7d5-28056f6f790c","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"1d9c7659-7c98-4d99-af41-5c66214e55cb","tauContract":"fe3a1fc1f6dcf1c1c317754db368a19bd85cab343431da98cae17d783eaa1c02","type":"list-item"}],"collabId":"2cd60edc-e9cc-4b00-b27c-e5526a791480","tauContract":"b74d37e5bfbf2503c151b31f93763a8fb42e80426564246cbb0af72201a60e8c","type":"bulleted-list"},{"children":[{"text":"示例1：","type":"formatted"}],"collabId":"b9a17e6f-e2b5-4aac-8e71-a615c1b77e96","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入：candidates = [2,3,6,7], target = 7,\n所求解集为：\n[\n  [7],\n  [2,2,3]\n]","collabId":"1c79c8e7-d904-4344-8ab4-3a38a48b1cd0","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"8a5cff21-ab72-4f0e-a979-a19d38c1cb4f","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"de670dab-8b48-4823-8d52-25dc2fbb1f74"},{"children":[{"text":"示例2：","type":"formatted"}],"collabId":"a3e4d578-5008-4921-9767-d386918edfbb","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入：candidates = [2,3,5], target = 8,\n所求解集为：\n[\n  [2,2,2,2],\n  [2,3,3],\n  [3,5]\n]","collabId":"8c2e5d30-f6ec-495e-a4c6-1db096353ad4","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"490a7c1a-4e89-423f-96f2-94dd9f6d4cda","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"466068d0-298f-431f-9a38-510339dbef73"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"713d86d6-35a8-47d0-a8e2-77d1ad10626a","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"class Solution {\n    private List<List<Integer>> results = new ArrayList<>();\n    public List<List<Integer>> combinationSum(int[] candidates, int target) {\n        ArrayList<Integer> path = new ArrayList<>();\n        search(candidates, 0, target, path);\n\n        return results;\n    }\n\n    private void search(int[] candidates, int startLevel, int target, ArrayList<Integer> path) {\n        if (target < 0) {\n            return;\n        }\n\n        if (target == 0) {\n            List<Integer> list = new ArrayList<>(path);\n            results.add(list);\n            return;\n        }\n\n        for (int i = startLevel; i < candidates.length; i++) {\n            path.add(candidates[i]);\n            search(candidates, i, target - candidates[i], path);\n            path.remove(path.size() - 1);\n        }\n    }\n}","collabId":"b1466c59-08bc-4a5a-acf1-aabe3afd2ed7","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1bb4f546-0a18-4a13-9f00-d659220f249b","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"b3e6d633-673d-4878-9f0f-f33912f19a2d"},{"children":[{"text":"组合总数II","type":"formatted"}],"collabId":"431081f3-0c47-4031-ba3c-fc3ff8612427","level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"题目描述","type":"formatted"}],"collabId":"ab622567-d711-45a4-8669-0ae8a3071fb3","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"题目描述同上，不过有一点不同，","type":"formatted"},{"bold":true,"color":"#6425d0","darkColor":"#a472fc","text":"candidates 中的每个数字在每个组合中只能使用一次","type":"formatted"},{"color":"#6425d0","darkColor":"#a472fc","text":"。","type":"formatted"}],"collabId":"e44eabc9-9153-4c2b-b98d-8f5f3fa82151","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"示例1：","type":"formatted"}],"collabId":"184a9bfc-76a9-44cf-bb6f-7d38d2722e1e","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入: candidates = [10,1,2,7,6,1,5], target = 8,\n所求解集为:\n[\n  [1, 7],\n  [1, 2, 5],\n  [2, 6],\n  [1, 1, 6]\n]","collabId":"05cb97a1-8e87-469f-bbc0-c3025cc695ff","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"a9b2acef-0766-4c8b-865c-abd37f3f7589","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"43b8bf27-91c0-4244-978a-795728b779dd"},{"children":[{"text":"示例2：","type":"formatted"}],"collabId":"8fd94214-0f70-473d-b436-9e7a9f806c82","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"输入: candidates = [2,5,2,1,2], target = 5,\n所求解集为:\n[\n  [1,2,2],\n  [5]\n]","collabId":"bc0f4d29-075b-4cdf-b127-ac44f23a69b0","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"0c6e162c-afd2-4af6-a84a-ab7523de4aea","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"9260051a-61d4-49b5-91a4-1cf91e7f700a"},{"children":[{"text":"解题思路","type":"formatted"}],"collabId":"ee17feb1-798e-4875-811e-090e413e82dd","level":3,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"对于这种无重复的问题，首先对数组进行排序，然后在递归的过程中判断当前的数是否与前一个数相同，如果相同，则不用遍历该数，因为包含该数的所有情况已经考虑过了，直接跳过该数即可","type":"formatted"}],"collabId":"6bedcb62-999a-49d7-b4ce-549690b4e911","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"","type":"formatted"}],"code":"class Solution {\n    private List<List<Integer>> results = new ArrayList<>();\n    public List<List<Integer>> combinationSum2(int[] candidates, int target) {\n        if (candidates == null || candidates.length == 0) {\n            return results;\n        }\n\n        // 对数组进行排序\n        Arrays.sort(candidates);\n        search(candidates, target, 0, new ArrayList<Integer>());\n\n        return results;\n    }\n\n    private void search(int[] candidates, int target, int startIndex, ArrayList<Integer> path) {\n        if (target < 0) {\n            return;\n        }\n\n        if (target == 0) {\n            results.add(new ArrayList<>(path));\n            return;\n        }\n\n        for (int i = startIndex; i < candidates.length; i++) {\n            // 如果当前数与前一个数相同，则跳过该数\n            if (i > startIndex && candidates[i] == candidates[i - 1]) continue;\n\n            path.add(candidates[i]);\n            search(candidates, target - candidates[i], i + 1, path);\n            path.remove(path.size() - 1);\n        }\n    }\n}","collabId":"f50c3a4e-3c69-4754-a00d-a39ceb9e8f68","tauContract":"01b01a08366ee00321331f9860d994321d69c2da591e07b067eb5459c9edf05d","type":"code-step"}],"collabId":"1477b5ab-d6a8-4532-a1e2-203ec29ad9cf","language":"java","tauContract":"44e7818805504c164294bff3c403ed0ffed41befee37e5daeb6121e40071bbd6","type":"code-block","uuid":"3eb5d4a4-8f87-47f4-babb-2700307ec1a4"}],"breadcrumb":[{"label":"LeetCode","target":{"key":"doc:project:47:718","type":"doc","id":718}},{"label":"深度优先遍历"},{"label":"组合总数","target":{"key":"doc:project:47:710","type":"doc","id":710}}],"prevPage":{"title":"组合","target":{"key":"doc:project:47:709","type":"doc","id":709}},"nextPage":{"title":"矩阵中的最长递增路径","target":{"key":"doc:project:47:727","type":"doc","id":727}},"createTime":1729002333392,"updateTime":1793532544539,"projectId":47},"meta":{"type":"doc","publishTime":1793532544539}}