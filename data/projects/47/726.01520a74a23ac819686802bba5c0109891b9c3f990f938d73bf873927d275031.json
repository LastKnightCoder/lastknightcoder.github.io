{"version":1,"key":"doc:project:47:726","content":{"id":726,"title":"插入区间","content":[{"children":[{"text":"题目描述","type":"formatted"}],"collabId":"3f1a9544-b8f2-4c3c-a67e-50efccd738ba","disableDrag":false,"level":2,"tauContract":"1b84ef07e920f55d81fccc0601a84826fcd79bf3ee62a898f19b0af7592aa283","type":"header"},{"children":[{"text":"给你一个","type":"formatted"},{"bold":true,"text":"无重叠的","type":"formatted"},{"text":"，按照区间起始端点排序的区间列表 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":"，其中 ","type":"formatted"},{"code":true,"text":"intervals[i] = [starti, endi]","type":"formatted"},{"text":" 表示第 ","type":"formatted"},{"code":true,"text":"i","type":"formatted"},{"text":" 个区间的开始和结束，并且 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":" 按照 ","type":"formatted"},{"code":true,"text":"starti","type":"formatted"},{"text":" 升序排列。同样给定一个区间 ","type":"formatted"},{"code":true,"text":"newInterval = [start, end]","type":"formatted"},{"text":" 表示另一个区间的开始和结束。","type":"formatted"}],"collabId":"a492f324-31eb-4121-bfc0-ded2f17b7a90","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"在 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":" 中插入区间 ","type":"formatted"},{"code":true,"text":"newInterval","type":"formatted"},{"text":"，使得 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":" 依然按照 ","type":"formatted"},{"code":true,"text":"starti","type":"formatted"},{"text":" 升序排列，且区间之间不重叠（如果有必要的话，可以合并区间）。","type":"formatted"}],"collabId":"8cfbe53b-b7a6-477c-ae4f-2cddb1c1ee72","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"返回插入之后的 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":"。注意你不需要原地修改 ","type":"formatted"},{"code":true,"text":"intervals","type":"formatted"},{"text":"。你可以创建一个新数组然后返回它。","type":"formatted"}],"collabId":"017916d4-8a57-4bb4-bb24-737427818e53","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"children":[{"text":"输入：","type":"formatted"},{"code":true,"text":"intervals = [[1,3],[6,9]], newInterval = [2,5]","type":"formatted"}],"collabId":"ce5e4a97-ab4d-4189-b575-c88737719656","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"输出：","type":"formatted"},{"code":true,"text":"[[1,5],[6,9]]","type":"formatted"}],"collabId":"4f2030b0-05ae-4c30-9c8a-9acded5a4aa2","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"}],"collabId":"54561fde-5416-48a9-9c2a-673ae8579bee","open":true,"tauContract":"6f651c7baafe7521ca6995109244b4d914c31407a4c181a83538b42acd722b1e","title":"示例1","type":"detail"},{"children":[{"children":[{"text":"输入：","type":"formatted"},{"code":true,"text":"intervals = [[1,2],[3,5],[6,7],[8,10],[12,16]], newInterval = [4,8]","type":"formatted"}],"collabId":"ecf8f8b4-854c-4929-965b-87e4b8ac9a79","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"输出：","type":"formatted"},{"code":true,"text":"[[1,2],[3,10],[12,16]]","type":"formatted"}],"collabId":"d2a23821-c23a-4884-8339-0f2cf31b74d2","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7772fb1","type":"paragraph"},{"children":[{"text":"解释：这是因为新的区间 ","type":"formatted"},{"code":true,"text":"[4,8]","type":"formatted"},{"text":" 与 ","type":"formatted"},{"code":true,"text":"[3,5],[6,7],[8,10]","type":"formatted"},{"text":" 重叠。","type":"formatted"}],"collabId":"b43fa2f6-57b3-4d8d-b2e0-96687a27d5ba","disableDrag":false,"tauContract":"f4b9b0426991dbd09af21b77c91da8b4112b2e3901b6af87feb71cb3b7